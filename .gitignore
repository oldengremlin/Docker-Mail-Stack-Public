# ── Реальні групи ─────────────────────────────────────────────────────
# У git живе ТІЛЬКИ зразок; усе інше в groups/ — стан конкретного хоста
# (секрети в group.env, токен ACME, дампи схем, згенеровані фрагменти).
#
# Правило навмисно на КАТАЛОГ, а не на імена файлів: перелік того, що
# mailctl кладе в групу, росте з кожним сервісом, і патерн, написаний
# під сьогоднішні імена, завтра пропустить новий файл МОВЧКИ. Саме так
# ледь не поїхав дамп міграції (PITFALLS).
groups/*
!groups/sample.domain.group/

# Залишені окремо навмисно — вони діють і якщо хтось колись звузить
# правило вище, і прямо називають, ЩО саме секретне.
groups/*/group.env

# Докерівські volumes сюди не потрапляють (вони керуються Docker, не файлами
# репозиторію), але про всяк випадок:
*.pyc
__pycache__/
.DS_Store

# Фрагменти підключення груп до проксі — генеруються `mailctl proxy attach`
# з group.env, тобто похідні від файлу, якого в git і так немає.
_proxy/groups.d/*.yml

# Робочі vhost-и проксі — містять реальні домени конкретної установки.
# Комітиться тільки group.conf.example з плейсхолдерами.
_proxy/nginx-config/conf.d/*.conf

# Схема БД у групі — копія канонічної з _template/mysql-init/, кладеться
# через `mailctl db-schema`. Дампи з прода теж сюди: там реальні адреси
# й хеші паролів, у git їм не місце.
groups/*/mysql-init/*.sql

# Архіви. Бекап стека чи холодний архів скриньок у репозиторії робить
# рівно те, від чого цей файл захищає: кладе прод-дані в git одним
# непримітним рядком у `git add -A`.
*.tar.gz
*.tgz
*.tar
*.zip

# Ключовий матеріал — ніколи в git, навіть випадково. Прод-архів несе
# приватні ключі DKIM (по одному на домен) і TLS-ключі Postfix/Dovecot.
*.private
*.key
privkey*.pem

# Параметри конкретного хоста (інтерфейс, публічний префікс).
# Комітиться тільки host.env.example.
host.env

# Параметри мереж конкретного хоста. Комітиться тільки host.json.example.
host.json

# Згенеровані mailctl: підключення мереж групи й похідні адреси.
# Єдине джерело правди — group.env плюс host.json.
groups/*/networks.yml
groups/*/.compose.env

# Креденшали ACME для DNS-01 (API-токен до власної зони-приймача).
# Секрет, тому в репозиторій не їде — як і group.env.
groups/*/acme.ini

# Згенерований mailctl: адреса публікації проксі з host.json
_proxy/.compose.env

