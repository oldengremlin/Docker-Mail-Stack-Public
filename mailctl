# ── env-файли ─────────────────────────────────────────────────────────
# Читаємо, а НЕ виконуємо: group.env і host.env — дані, не шелскрипт.
# Останнє присвоєння перемагає, як і в docker compose --env-file.
sub read_env {
    my ($file) = @_;
    open my $fh, '<', $file or die_msg "не можу прочитати $file: $!";
    my %v;
    while (my $line = <$fh>) {
        $line =~ s/\r?\n\z//;
        next if $line =~ /^\s*(?:#|$)/;
        $line =~ s/^\s*export\s+//;
        next unless $line =~ /^\s*([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)$/;
        my ($k, $val) = ($1, $2);
        # знімаємо лапки, якщо значення в них цілком
        $val =~ s/\s+$//;
        $val = $1 if $val =~ /^"(.*)"$/ or $val =~ /^'(.*)'$/;
        $v{$k} = $val;
    }
    close $fh;
    return \%v;
}

# ── мережі хоста ──────────────────────────────────────────────────────
# host.json, а не host.env: мережа — це ЗАПИС із кількох полів (драйвер,
# режим, інтерфейс, vlan, підмережа, шлюз), і таких записів кілька.
# Плоский env-файл для списку записів дав би NET1_DRIVER, NET2_DRIVER і
# таке інше. JSON::PP — core-модуль, нових залежностей не додає.
my $host_cache;
sub host {
    return $host_cache if $host_cache;
    unless (-f $host_json) {
        die_msg "немає $host_json — а $host_env є. Мережі переїхали в JSON ",
                "(рішення №29): скопіюй host.json.example і перенеси значення, ",
                "старий host.env можна прибрати"
            if -f $host_env;
        die_msg "немає $host_json — скопіюй host.json.example і заповни ",
                "(інтерфейси, підмережі)";
    }
    open my $fh, '<', $host_json or die_msg "не можу прочитати $host_json: $!";
    local $/;
    my $raw = <$fh>;
    close $fh;
    my $h = eval { decode_json($raw) };
    $h or die_msg "$host_json — не валідний JSON: $@";
    ref $h eq 'HASH' && ref($h->{networks} // '') eq 'HASH'
        or die_msg "$host_json мусить містити об'єкт \"networks\" з мережами";
    # ключі-коментарі "//" у JSON — наш спосіб писати пояснення там, де
    # формат їх не передбачає; у даних вони не потрібні
    delete $h->{networks}{'//'};
    for my $n (values %{ $h->{networks} }) { delete $n->{'//'} if ref $n eq 'HASH' }
    return $host_cache = $h;
}

sub host_nets { return host()->{networks} }

# Адреса ХОСТА, на якій спільний nginx публікує 80/443.
#
# Обов'язкова, і причина не формальна. Без неї в шаблоні стояло
# `ports: "443:443"`, тобто bind на 0.0.0.0 — на ВСІ адреси хоста. На
# полігоні це дало `Bind for 203.0.113.94:443 failed: port is already
# allocated`: на тому хості, крім пошти, живуть два інші стеки зі
# своїми Caddy на .93 і .94. Тобто ми намагались забрати порт у
# чужого сервісу, і єдине, що нас врятувало — він уже тримав порт.
#
# Перевірки тут, а не в PITFALLS: обидві помилки, які легко зробити,
# дають невиразний збій. Адреса групи -> `cannot assign requested
# address` (ipvlan-слейв хост не бачить). Адреса з пулу IPAM -> колізія
# з майбутньою групою, причому не зараз, а при наступному `up`.
sub host_proxy {
    my $h = host();
    my $p = $h->{proxy};
    ref $p eq 'HASH'
        or die_msg "у $host_json немає об'єкта \"proxy\" з адресою для ",
                   "nginx. Без неї проксі публікував би 80/443 на ВСІХ ",
                   "адресах хоста й забирав порти в чужих сервісів — саме ",
                   "це й сталось на полігоні. Приклад — host.json.example";
    my $bind = $p->{bind} // '';
    defined ip2n($bind)
        or die_msg "$host_json: proxy.bind='$bind' — не IPv4-адреса";

    # Адреси груп — ipvlan/macvlan-слейви: хост їх НЕ бачить, тож bind
    # на таку адресу не вдасться. Помилка природна («це ж адреса
    # small»), тому ловимо її тут.
    for my $g (list_groups()) {
        my $f = "$groups_dir/$g/group.env";
        next unless -f $f;
        my $e = read_env($f);
        for my $a (parse_addresses($e->{ADDRESSES}, $g)) {
            $a->{ip} eq $bind
                and die_msg "$host_json: proxy.bind=$bind — це адреса групи ",
                            "'$g' (мережа '$a->{net}'). Вона належить ",
                            "ipvlan/macvlan-слейву, якого хост не бачить, ",
                            "тож bind провалився б із `cannot assign ",
                            "requested address`. Потрібна адреса з ",
                            "`ip -4 addr` НА ХОСТІ";
        }
    }
    # Попередження, не помилка: саме так і зроблено на полігоні (хост
    # тримає .93/.94 у тому ж /28, що й ipvlan-мережа). Працює, але
    # IPAM Docker про цю адресу не знає й може видати її групі.
    my $nets = host_nets();
    for my $label (sort keys %$nets) {
        my $sub = $nets->{$label}{subnet} // next;
        next unless ip_in_subnet($bind, $sub);
        say STDERR "mailctl: УВАГА: proxy.bind=$bind лежить у підмережі "
                 . "мережі '$label' ($sub). Так можна (хост і слейви "
                 . "співіснують), але IPAM Docker цю адресу вільною "
                 . "вважає — тримати її поза ADDRESSES груп.";
        last;
    }
    return $bind;
}


# Ім'я docker-мережі ВИВОДИТЬСЯ з мітки, а не задається окремо: дві
# змінні, які мусять узгоджуватись, розійшлися б мовчки.
sub docker_net_name { return "mailstack-$_[0]" }

# parent для ipvlan/macvlan: native — сам інтерфейс, тегована — субінтерфейс
sub net_parent {
    my ($def) = @_;
    my $iface = $def->{iface} // '';
    return $iface unless defined $def->{vlan} && length "$def->{vlan}";
    return "$iface.$def->{vlan}";
}

sub net_check_def {
    my ($key, $def) = @_;
    ref $def eq 'HASH' or die_msg "$host_json: мережа '$key' мусить бути об'єктом";
    my $drv = $def->{driver} // '';
    $drv =~ /^(?:ipvlan|macvlan|bridge)$/
        or die_msg "$host_json: мережа '$key' — driver='$drv', ",
                   "очікується ipvlan, macvlan або bridge";
    if ($drv eq 'ipvlan') {
        my $mode = $def->{mode} // 'l3';
        # l3s — те саме L3, але маршрутизоване ЧЕРЕЗ netfilter хоста,
        # тобто nft бачить трафік між слейвами. Для чистого l3 не бачить.
        $mode =~ /^(?:l2|l3|l3s)$/
            or die_msg "$host_json: мережа '$key' — mode='$mode', ",
                       "очікується l2, l3 або l3s";
    }
    if (defined $def->{isolate}) {
        $drv ne 'bridge'
            or die_msg "$host_json: мережа '$key' — isolate не стосується bridge: ",
                       "там контейнери різних мереж і так не бачать одне одного";
    }
    length($def->{iface} // '') || $drv eq 'bridge'
        or die_msg "$host_json: мережа '$key' — не заданий iface";
    defined +(parse_cidr($def->{subnet} // ''))[0]
        or die_msg "$host_json: мережа '$key' — subnet='", ($def->{subnet} // ''),
                   "' не схожий на CIDR";
    if (length($def->{gateway} // '')) {
        ip_in_subnet($def->{gateway}, $def->{subnet})
            or die_msg "$host_json: мережа '$key' — шлюз $def->{gateway} ",
                       "поза власною підмережею $def->{subnet}";
    }
    if (defined $def->{vlan} && length "$def->{vlan}") {
        $def->{vlan} =~ /^\d+$/ && $def->{vlan} >= 1 && $def->{vlan} <= 4094
            or die_msg "$host_json: мережа '$key' — vlan='$def->{vlan}', ",
                       "очікується 1..4094";
    }
    return 1;
}

sub group_env_path {
    my ($g) = @_;
    -d "$groups_dir/$g"
        or die_msg "групи '$g' немає; є: ", join(' ', list_groups());
    my $f = "$groups_dir/$g/group.env";
    -f $f or die_msg "немає $f — скопіюй group.env.example і заповни";
    return $f;
}

sub list_groups {
    opendir my $dh, $groups_dir or return ();
    my @g = sort grep { !/^\.\.?$/ && -d "$groups_dir/$_" } readdir $dh;
    closedir $dh;
    return @g;
}

# ── адресна арифметика ────────────────────────────────────────────────
# Через Socket, а не через саморобні бітові зсуви: inet_aton сам
# відкидає те, що не є адресою, і не приймає «300.1.2.3».
sub ip2n {
    my ($ip) = @_;
    return undef unless defined $ip && $ip =~ /^\d{1,3}(?:\.\d{1,3}){3}$/;
    my $packed = inet_aton($ip) or return undef;
    return unpack('N', $packed);
}
sub n2ip { return inet_ntoa(pack 'N', $_[0] & 0xFFFFFFFF) }

sub parse_cidr {
    my ($cidr) = @_;
    my ($base, $bits) = split m{/}, ($cidr // ''), 2;
    my $bn = ip2n($base);
    return () unless defined $bn && defined $bits && $bits =~ /^\d+$/ && $bits <= 32;
    my $mask = $bits == 0 ? 0 : (0xFFFFFFFF << (32 - $bits)) & 0xFFFFFFFF;
    return ($bn & $mask, $mask);
}

# Перевірка списку мереж у формі Postfix (кома або пробіл як
# розділювач). Одна функція на два параметри: MYNETWORKS і
# ANVIL_EXCEPTIONS мають однаковий ФОРМАТ і протилежний ЗМІСТ, а дві
# копії цього циклу розійшлися б мовчки при першій же правці.
# $why_all — чим саме поганий 0.0.0.0/0 саме для цього параметра.
sub check_net_list {
    my ($g, $var, $value, $why_all) = @_;
    for my $n (split /[\s,]+/, ($value // '')) {
        next unless length $n;
        # Слово `any` існує рівно для CLEARTEXT_NETWORKS, і там воно
        # обробляється ДО виклику цієї функції. Отже сюди воно доходить
        # у двох різних випадках, і плутати їх у повідомленні не можна:
        # або його написали в іншому списку (формат у всіх трьох
        # однаковий), або змішали зі списком мереж у своєму.
        if (lc $n eq 'any') {
            die_msg "[$g] $var: 'any' не можна змішувати зі списком ",
                    "мереж — або одне слово 'any' (дозвіл з будь-якої ",
                    "адреси), або перелік мереж. Разом це вимагало б ",
                    "вирішувати, що з них сильніше."
                if $var eq 'CLEARTEXT_NETWORKS';
            die_msg "[$g] $var: слово 'any' є лише в ",
                    "CLEARTEXT_NETWORKS. Тут потрібні мережі — $why_all";
        }
        $n ne '0.0.0.0/0'
            or die_msg "[$g] $var містить 0.0.0.0/0 — $why_all";
        next if $n =~ /:/;        # IPv6-форми Postfix'а не розбираємо
        my ($ip, $bits) = $n =~ m{^([^/]+)(?:/(\d{1,2}))?$}
            or die_msg "[$g] $var: '$n' не схоже ні на адресу, ні на CIDR";
        defined ip2n($ip)
            or die_msg "[$g] $var: '$ip' не схожий на IPv4-адресу";
        !defined $bits || $bits <= 32
            or die_msg "[$g] $var: '/$bits' — маска поза межами 0..32";
    }
}

sub ip_in_subnet {
    my ($ip, $cidr) = @_;
    my ($net, $mask) = parse_cidr($cidr);
    return 0 unless defined $net;
    my $n = ip2n($ip);
    return 0 unless defined $n;
    return ($n & $mask) == $net;
}
sub subnet_network   { my ($net, undef) = parse_cidr($_[0]); return defined $net ? n2ip($net) : undef }
sub subnet_broadcast {
    my ($net, $mask) = parse_cidr($_[0]);
    return undef unless defined $net;
    return n2ip($net | (~$mask & 0xFFFFFFFF));
}

# ── запуск зовнішніх команд ───────────────────────────────────────────
# Списком, без шелла: ніяких лапок, ніякого розбиття по пробілах.
sub run {
    my @cmd = @_;
    my $rc = system { $cmd[0] } @cmd;
    return $rc == 0;
}
sub run_or_die {
    run(@_) or die_msg "команда не вдалась: ", join(' ', @_);
}
sub capture {
    my @cmd = @_;
    open my $fh, '-|', @cmd or return undef;
    local $/;
    my $out = <$fh>;
    close $fh;
    return $? == 0 ? ($out // '') : undef;
}

# Те саме, але без stderr: для ПРОБНИХ викликів, де невдача — очікуваний
# результат, а не аварія. Інакше `docker network inspect` на неіснуючій
# мережі вивалює свою помилку поверх нашого зрозумілого повідомлення.
sub capture_quiet {
    my @cmd = @_;
    my $pid = open(my $fh, '-|');
    return undef unless defined $pid;
    unless ($pid) {                      # дитина
        open STDERR, '>', File::Spec->devnull;
        exec { $cmd[0] } @cmd;
        exit 127;
    }
    local $/;
    my $out = <$fh>;
    close $fh;
    return $? == 0 ? ($out // '') : undef;
}

# ── адреси групи ──────────────────────────────────────────────────────
# ADDRESSES=public:203.0.113.82,office:192.168.50.253
# Порядок зберігаємо: він визначає порядок у inet_interfaces/listen, а
# значить і те, що побачить людина в `ss -lntu`.
sub parse_addresses {
    my ($str, $g) = @_;
    my @out;
    for my $pair (split /\s*,\s*/, ($str // '')) {
        next unless length $pair;
        my ($net, $ip) = split /\s*:\s*/, $pair, 2;
        defined $ip && length $ip
            or die_msg "[$g] ADDRESSES: '$pair' — очікується <мережа>:<адреса>";
        push @out, { net => $net, ip => $ip };
    }
    return @out;
}

# ── перевірка інваріантів; повертає розібраний конфіг групи ───────────
sub validate {
    # ЗАУВАЖЕННЯ ПРО РЕЖИМ teardown (див. compose_group): щоб ЗУПИНИТИ
    # групу, робочі значення не потрібні — compose лише прибирає
    # контейнери й мережі проєкту. Вимагати їх означає, що неповний
    # group.env не дає навіть прибрати за собою. Спіймано наживо: група
    # без SA_DB_PASSWORD (створена до появи SpamAssassin) не гасилась, і
    # через це падав наступний `net down` — мережу тримав її ж postfix.
    my ($g) = @_;
    # teardown: перевірки ЗНАЧЕНЬ стають попередженнями, структурні
    # (ім'я групи, адреси, мережі з host.json) лишаються помилками —
    # без них compose не знає, що саме прибирати.
    my %opt = @_[1 .. $#_];
    my $need = $opt{teardown}
        ? sub { say STDERR "mailctl: ПОПЕРЕДЖЕННЯ: ", @_,
                           " — при гасінні це не заважає" }
        : \&die_msg;
    my $f   = group_env_path($g);
    my $e   = read_env($f);
    my $h   = host();

    my $name = $e->{GROUP_NAME}      // '';
    my $cfg  = $e->{GROUP_CONFIG_DIR} // '';
    my $pre  = $e->{INTERNAL_PREFIX} // '';

    length $name or die_msg "[$g] GROUP_NAME не заданий";
    # ім'я compose-проєкту: саме ці символи приймає docker compose
    $name =~ /^[a-z0-9][a-z0-9_-]*$/
        or die_msg "[$g] GROUP_NAME='$name' не годиться як ім'я compose-проєкту: ",
                   "тільки [a-z0-9_-], крапки не можна";

    $cfg eq "../groups/$g"
        or die_msg "[$g] GROUP_CONFIG_DIR='$cfg', має бути '../groups/$g' — ",
                   "інакше група читатиме чужі конфіги";

    $pre =~ /^\d{1,3}(?:\.\d{1,3}){2}$/
        or die_msg "[$g] INTERNAL_PREFIX='$pre' — потрібні рівно три октети, напр. 10.11.11";
    defined ip2n("$pre.0")
        or die_msg "[$g] INTERNAL_PREFIX='$pre' — октети поза межами 0..255";

    length($e->{MAIL_HOSTNAME} // '') or die_msg "[$g] MAIL_HOSTNAME не заданий";

    # Адреса для власних повідомлень сервісів. Перевіряємо форму, а не
    # існування: чи є така скринька, знає тільки БД, і на момент
    # створення групи її ще немає.
    my $pm = $e->{POSTMASTER_ADDRESS} // '';
    $pm =~ /^[^\s\@]+\@[^\s\@]+\.[^\s\@]+$/
        or die_msg "[$g] POSTMASTER_ADDRESS='$pm' — потрібна адреса ",
                   "виду postmaster\@<домен групи>. Складати її з ",
                   "MAIL_HOSTNAME не можна: postmaster\@mail.<домен> ",
                   "лежав би в домені, який поштовим не є, і відповідь ",
                   "на відмову відбилась би назад";

    # Часовий пояс: ловимо описку одразу, бо інакше glibc МОВЧКИ впаде
    # в UTC, і це виглядатиме як «TZ не працює».
    #
    # Перевіряємо по зоні ХОСТА, і це саме перевірка на описку, а не
    # гарантія: набір зон у хоста й у образі може різнитись. Жива
    # перевірка — `docker exec <група>-postfix date`. Приклад різниці
    # знайшовся одразу: `Europe/Kiev` (стара назва) є не всюди, а
    # `Europe/Kyiv` є.
    my $tz = $e->{TZ} // '';

    # Не заданий TZ — це легітимний вибір (UTC монотонний, без стрибків
    # на літній час), але МОВЧАЗНИЙ розхід із хостом таким не є: саме
    # через нього «чому в листах інший час» стає окремим питанням.
    # Тому не відмова, а один рядок на запуск.
    if (!length $tz) {
        my $h = host_tz();
        if (!$tz_warned && defined $h && $h !~ m{^(?:UTC|Etc/UTC)\z}) {
            $tz_warned = 1;
            say STDERR "mailctl: TZ не заданий — контейнери будуть у UTC, ",
                       "а хост у $h. Нічого не ламається (`Date:` у листах ",
                       "ставить клієнт), але `Received:`, логи демонів і ",
                       "`docker logs` будуть у UTC, тобто не збігатимуться ",
                       "з логами хоста. Хочеш локальний час — TZ=$h у ",
                       "group.env; хочеш UTC — TZ=UTC, і це попередження ",
                       "зникне";
        }
    }

    if (length $tz && $tz ne 'UTC') {
        -f "/usr/share/zoneinfo/$tz"
            or die_msg "[$g] TZ='$tz' — такої зони немає в ",
                       "/usr/share/zoneinfo цього хоста. Без валідної ",
                       "зони glibc МОВЧКИ візьме UTC, тобто помилку ",
                       "буде видно лише по часу в логах. Якщо впевнений, ",
                       "що в образі вона є — звір ",
                       "`docker exec <група>-postfix date`. Стара назва ",
                       "Europe/Kiev є не всюди, Europe/Kyiv є";
    }

    # Додаткові джерела для SPF. Потрібні рівно в один момент — при
    # переході, коли пошта доменів виходить і зі старого сервера, і з
    # нового; інакше `-all`/`~all` на новому записі відкидав би свою ж
    # пошту зі старої адреси.
    for my $m (split /\s+/, ($e->{SPF_EXTRA} // '')) {
        next unless length $m;
        # Другий `all` у записі МОВЧКИ ігнорується (SPF зупиняється на
        # першому збігу), тож запис виглядав би правильним і працював
        # інакше. Квантор додає сам генератор.
        $m !~ /^[-~?+]?all$/i
            or die_msg "[$g] SPF_EXTRA містить '$m' — квантор `all` ",
                       "додає генератор. Другий `all` у записі мовчки ",
                       "ігнорується, тобто запис виглядав би правильним ",
                       "і діяв інакше";
        $m =~ m{^(?:ip4:|ip6:|include:|exists:|a(?:[:/]|\z)|mx(?:[:/]|\z)|ptr(?::|\z))}i
            or die_msg "[$g] SPF_EXTRA: '$m' не схоже на механізм SPF ",
                       "(ip4:, ip6:, include:, exists:, a, mx, ptr)";
    }

    # Селектор DKIM потрапляє в ім'я DNS-запису, тобто мусить бути
    # коректною доменною міткою.
    my $sel = $e->{DKIM_SELECTOR} // '';
    $sel =~ /^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$/ && length($sel) <= 63
        or die_msg "[$g] DKIM_SELECTOR='$sel' — потрібна доменна мітка ",
                   "([a-z0-9-], не починається й не кінчається дефісом). ",
                   "Він стає іменем запису <селектор>._domainkey.<домен>";

    # ── Секрети ───────────────────────────────────────────────────────
    # Перевіряємо ТУТ, а не чекаємо, поки контейнер упаде на старті:
    # порожній пароль дає помилку всередині сервісу, тобто на кілька
    # кроків далі від причини. Правило проєкту — прибирати можливість
    # помилки у validate(), а не описувати її в PITFALLS.
    #
    # SA_DB_PASSWORD окремо від поштового: стан SpamAssassin живе в
    # окремій базі з окремим користувачем (рішення №33), саме щоб
    # сканер вмісту не мав доступу до хешів паролів у `usersdb`.
    #
    # ROUNDCUBE_DB_PASSWORD — четвертий секрет, і теж окремий від
    # поштового: вебмейл ходить у БД ТРЬОМА власними користувачами з
    # різними правами, жоден із яких не читає хеші паролів
    # (див. rc_schema). Раніше він брав поштового, тобто бачив
    # `usersdb` цілком.
    for my $sec (qw(MYSQL_ROOT_PASSWORD MYSQL_MAIL_PASSWORD SA_DB_PASSWORD
                    ROUNDCUBE_DB_PASSWORD)) {
        length($e->{$sec} // '')
            or $need->("[$g] $sec не заданий");
    }
    # Їде в SQL-літерал (mysql-init) і в DSN плагіна password, де
    # розділювачами служать ':' і '@'.
    ($e->{ROUNDCUBE_DB_PASSWORD} // '') !~ /['\\\n:\@]/
        or $need->("[$g] ROUNDCUBE_DB_PASSWORD містить лапку, зворотний ",
                   "слеш, двокрапку, \@ або перенос рядка. Перші два ",
                   "зламали б SQL, останні два — DSN вигляду ",
                   "mysql://user:pass\@host/db, і обидва мовчки");

    # ── Вебмейл ──
    # des_key шифрує IMAP-пароль у сесії. Без нього образ генерує ключ
    # САМ при кожному створенні контейнера (бо /var/www/html не на
    # томі), а сесії лежать у базі й перестворення переживають. Разом
    # це дає «сесія є, а пароль у ній не розшифровується», тобто
    # мовчазний вихід усіх користувачів при кожному `up`.
    # 24 символи — вимога дефолтного cipher_method Roundcube.
    my $dk = $e->{ROUNDCUBE_DES_KEY} // '';
    length($dk)
        or $need->("[$g] ROUNDCUBE_DES_KEY не заданий. Згенерувати:\n",
                   "  openssl rand -base64 24 | cut -c1-24");
    length($dk) >= 24
        or $need->("[$g] ROUNDCUBE_DES_KEY коротший за 24 символи (",
                   length($dk), "): дефолтний cipher_method Roundcube ",
                   "вимагає рівно 24, коротший ключ дасть зламане ",
                   "шифрування сесії");
    # Ім'я, за яким користувачі відкривають вебмейл. Воно ж іде в
    # trusted_host_patterns і в сертифікат, тож мусить бути FQDN, а не
    # адресою чи коротким іменем.
    my $wf = $e->{WEBMAIL_FQDN} // '';
    !length($wf) || $wf =~ /\A[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+\z/i
        or die_msg "[$g] WEBMAIL_FQDN='$wf' не схоже на доменне ім'я. ",
                   "Це ім'я йде і в trusted_host_patterns Roundcube, і в ",
                   "сертифікат, і в vhost nginx";
    my $mu = $e->{WEBMAIL_MAX_UPLOAD} // '';
    !length($mu) || $mu =~ /\A[0-9]+[KMG]\z/
        or die_msg "[$g] WEBMAIL_MAX_UPLOAD='$mu' має бути у формі ",
                   "числа з суфіксом K/M/G (наприклад 25M)";
    # Пароль SpamAssassin потрапляє і в SQL-літерал (mysql-init), і в
    # /etc/spamassassin/sql.cf, де рядок до кінця строки — значення.
    # Отже ці символи зробили б тихо зламаний конфіг або зламаний SQL.
    ($e->{SA_DB_PASSWORD} // '') !~ /['\\\n#]/
        or die_msg "[$g] SA_DB_PASSWORD містить лапку, зворотний слеш, ",
                   "решітку або перенос рядка. Такий пароль їде і в SQL, і ",
                   "в конфіг SpamAssassin, тобто зламав би або одне, або ",
                   "інше — і мовчки";

    # DNSBL: позитивний параметр, інвертований у skip_rbl_checks
    # всередині. Перевіряємо тут, щоб опечатка не стала «мовчки
    # вимкнув антиспамові перевірки».
    my $dnsbl = $e->{SA_DNSBL} // 'yes';
    $dnsbl =~ /^(?:yes|no|true|false|1|0)$/
        or die_msg "[$g] SA_DNSBL='$dnsbl' — умію yes і no. Це про DNS-",
                   "блоклисти: з ВЛАСНИМ рекурсивним резолвером вони ",
                   "працюють як задумано, через публічний (8.8.8.8 і ",
                   "подібні) Spamhaus відповідає відмовою, яка виглядає ",
                   "як «занесено»";

    # Greylisting. Вимикач потрібен не для смаку: `check_policy_service`
    # на МЕРТВИЙ сервіс означає 451 на ВСЮ пошту, а рішення №21 вимагає
    # вмикати фільтрацію на isp-подібній групі поетапно. Опечатка тут
    # так само мовчки вимикала б greylisting, як і в SA_DNSBL.
    my $grey = $e->{GREYLIST} // 'yes';
    $grey =~ /^(?:yes|no|true|false|1|0)$/
        or die_msg "[$g] GREYLIST='$grey' — умію yes і no";

    # Межі — не формальність. 20 с і 60 діб стояли й на office, і на
    # isp (пакетні дефолти — 300 с і 35 діб), тож це усталений вибір,
    # а не смак. Але нулі й величезні значення варто ловити: затримка 0
    # робить greylisting декорацією, а термін 0 знищує базу щодня, тобто
    # кожен відправник затримувався б наново вічно.
    # SIEVE_MAX_REDIRECTS — ліміт redirect на ОДИН скрипт, дефолт 4
    # (той самий, що в Pigeonhole). Перевищення не обрізає список
    # отримувачів, а валить скрипт цілком: лист не піде нікому. Верхню
    # межу тримаємо скромною свідомо — скрипт на сотню redirect це вже
    # розсилка, а не пересилання, і такий намір має бути явним.
    # Скільки redirect має кожен живий скрипт групи, показує
    # `mailctl health`: порахувати це тут неможливо, бо скрипти лежать
    # у томі, а `check` мусить працювати й на зупиненій групі.
    # Слабкі схеми паролів (MD5-CRYPT, DES-CRYPT) — прапорець Dovecot 2.4
    # з дефолтом `no`. Потрібен при міграції історичних хешів (№25) і
    # вмикається ГЛОБАЛЬНО, вибірково не буває.
    my $weak = $e->{AUTH_ALLOW_WEAK_SCHEMES} // 'no';
    $weak =~ /^(?:yes|no)$/
        or die_msg "[$g] AUTH_ALLOW_WEAK_SCHEMES='$weak' — умію yes і no";

    # Глобальне розкладання спаму в Junk before-скриптом. Дефолт `no`:
    # для наявних груп нічого не змінюється.
    # `yes` на isp-подібній групі — помилка, і дорога: там усі активні
    # клієнти POP3, а POP3 бачить лише INBOX, тож хибне спрацювання
    # поїхало б у теку, якої абонент не побачить ніколи (рішення №21).
    # `true`/`1` НЕ приймаємо, хоч GREYLIST такі приймає: entrypoint
    # dovecot на них падає, і краще зловити це тут, ніж restart-loop-ом.
    my $s2j = $e->{SPAM_TO_JUNK} // 'no';
    $s2j =~ /^(?:yes|no)$/
        or die_msg "[$g] SPAM_TO_JUNK='$s2j' — умію рівно yes і no";

    # Тип ключа сертифіката. `rsa` потрібен там, де серед клієнтів є
    # старі The Bat/Outlook: ECDSA вони не вміють, і це виглядає як
    # «пошта перестала працювати», а не як проблема сертифіката.
    my $kt = $e->{CERT_KEY_TYPE} // 'ecdsa';
    $kt =~ /^(?:ecdsa|rsa)$/
        or die_msg "[$g] CERT_KEY_TYPE='$kt' — умію ecdsa (дефолт) і rsa. ",
                   "Зміна на вже виданому сертифікаті вимагає ",
                   "`mailctl certs $g --force`";

    for my $pair ([GREYLIST_DELAY => [1, 3600]], [GREYLIST_MAX_AGE => [1, 365]],
                  [SIEVE_MAX_REDIRECTS => [1, 50]]) {
        my ($var, $lim) = @$pair;
        next unless defined $e->{$var} && length $e->{$var};
        $e->{$var} =~ /^\d+$/ && $e->{$var} >= $lim->[0] && $e->{$var} <= $lim->[1]
            or die_msg "[$g] $var='$e->{$var}' — потрібне ціле від ",
                       "$lim->[0] до $lim->[1]";
    }

    # Дія postscreen. Три значення Postfix, і опечатка тут мовчки
    # перетворила б відмову на запис у лог — тобто фільтр стояв би, а
    # не працював. Рівно те, що сталось на isp із закоментованим
    # check_policy_service.
    my $ps = $e->{POSTSCREEN_ACTION} // 'enforce';
    $ps =~ /^(?:ignore|enforce|drop)$/
        or die_msg "[$g] POSTSCREEN_ACTION='$ps' — умію ignore (лише лог, ",
                   "перший етап за рішенням №21), enforce (відмова 550 з ",
                   "причиною в лозі) і drop (розірвати з'єднання)";

    # Метод ACME-перевірки. Типовий `http` нічого не потребує, а
    # `dns-cloudflare` — токена у groups/<g>/acme.ini. Перевіряємо тут,
    # а не в `certs`, бо `check` має ловити це ДО того, як людина
    # дізнається про проблему з невдалого випуску (ліміти Let's Encrypt
    # на невдачі теж витрачаються).
    my $am = $e->{ACME_METHOD} // 'http';
    $am =~ /^(?:http|dns-cloudflare)$/
        or die_msg "[$g] ACME_METHOD='$am' — умію 'http' (типово, перевірка ",
                   "приходить на :80 групи) і 'dns-cloudflare' (коли той :80 ",
                   "належить комусь іншому). Другий потребує acme.ini із ",
                   "токеном до ВЛАСНОЇ зони-приймача; зону домену переносити ",
                   "не треба, там достатньо одного CNAME на _acme-challenge";
    if ($am eq 'dns-cloudflare') {
        my $ini = "$groups_dir/$g/acme.ini";
        -f $ini or die_msg "[$g] ACME_METHOD=dns-cloudflare, але немає $ini";
        my $mode = (stat $ini)[2] & 07777;
        $mode == 0600
            or die_msg sprintf "[%s] %s має права %04o, потрібно 0600: "
                             . "це API-токен. chmod 600 %s", $g, $ini, $mode, $ini;
    }
    my $aw = $e->{ACME_DNS_WAIT} // '';
    !length($aw) || $aw =~ /^\d+$/ && $aw >= 10 && $aw <= 3600
        or die_msg "[$g] ACME_DNS_WAIT='$aw' — секунди очікування поширення ",
                   "TXT, 10..3600 (типово 30)";

    # Параметри мереж переїхали в host.json (рішення №24, №29), а
    # PUBLIC_IP замінений на ADDRESSES. Рядки, що лишились у group.env,
    # шаблон більше не читає — тобто мовчки нічого не роблять.
    for my $stale (qw(PARENT_IFACE PUBLIC_SUBNET PUBLIC_GATEWAY)) {
        next unless length($e->{$stale} // '');
        die_msg "[$g] $stale більше не місце в group.env — мережі описані ",
                "в host.json. Прибери рядок, інакше він тільки вводитиме в оману";
    }
    !length($e->{PUBLIC_IP} // '')
        or die_msg "[$g] PUBLIC_IP більше не задають руками — замінений на ",
                   "ADDRESSES=<мережа>:<адреса>[,...] плюс PRIMARY_NET ",
                   "(рішення №29). Сам PUBLIC_IP генерується як адреса ",
                   "мережі PRIMARY_NET";

    my $nets = host_nets();
    net_check_def($_, $nets->{$_}) for sort keys %$nets;

    my @addr = parse_addresses($e->{ADDRESSES}, $g);
    @addr or die_msg "[$g] ADDRESSES не заданий — потрібна хоча б одна адреса, ",
                     "напр. ADDRESSES=public:203.0.113.82";

    my %seen;
    for my $a (@addr) {
        my ($net, $ip) = ($a->{net}, $a->{ip});
        !$seen{$net}++ or die_msg "[$g] мережа '$net' названа в ADDRESSES двічі";
        my $def = $nets->{$net}
            or die_msg "[$g] ADDRESSES посилається на мережу '$net', якої немає ",
                       "в $host_json; є: ", join(' ', sort keys %$nets);
        defined ip2n($ip) or die_msg "[$g] '$ip' не схожий на IPv4-адресу";
        my $sub = $def->{subnet};
        ip_in_subnet($ip, $sub)
            or die_msg "[$g] адреса $ip поза підмережею мережі '$net' ($sub)";
        $ip ne subnet_network($sub)
            or die_msg "[$g] адреса $ip — це мережева адреса підмережі $sub";
        $ip ne subnet_broadcast($sub)
            or die_msg "[$g] адреса $ip — це бродкаст підмережі $sub";
        !(length($def->{gateway} // '') && $ip eq $def->{gateway})
            or die_msg "[$g] адреса $ip збігається зі шлюзом мережі '$net'";
    }

    # PRIMARY_NET визначає і дефолтний маршрут, і smtp_bind_address, тож
    # мусить бути однією з перелічених мереж, а не чимось третім.
    my $primary = $e->{PRIMARY_NET} // '';
    if (!length $primary) {
        @addr == 1
            or die_msg "[$g] PRIMARY_NET не заданий, а адрес кілька — ",
                       "вкажи, через яку мережу йде вихідна пошта";
        $primary = $addr[0]{net};
    }
    $seen{$primary}
        or die_msg "[$g] PRIMARY_NET='$primary' немає серед ADDRESSES";
    my ($pub) = map { $_->{ip} } grep { $_->{net} eq $primary } @addr;

    # uid/gid власника скриньок — різні між групами (small 8, office 5000),
    # тому мусять бути задані явно, а не успадковані з дефолту.
    ($e->{VMAIL_UID} // '') =~ /^\d+$/
        or die_msg "[$g] VMAIL_UID мусить бути числом. Це власник файлів у ",
                   "/var/mail, і він РІЗНИЙ між групами (small 8, office 5000). ",
                   "Додай у group.env, напр. VMAIL_UID=8";
    ($e->{VMAIL_GID} // '') =~ /^\d+$/
        or die_msg "[$g] VMAIL_GID мусить бути числом. Додай у group.env, напр. VMAIL_GID=8";

    # mynetworks — ДОВІРЕНІ мережі, і з ADDRESSES вони не виводяться
    # (рішення №30): office має офісну адресу й довіряє офісній мережі,
    # small має офісну адресу й НЕ довіряє. Отже окремий параметр, який
    # ми лише перевіряємо на форму, а не вгадуємо.
    check_net_list($g, 'MYNETWORKS', $e->{MYNETWORKS},
                   "це відкритий релей для всього інтернету, а не "
                 . "'широкий mynetworks'");

    # Ліміти anvil (рішення №13). Вимикач — перший етап для
    # isp-подібної групи за рішенням №21: спершу подивитись, що anvil
    # пише в лог, і лише потім вмикати відмови.
    my $anvil = $e->{ANVIL} // 'yes';
    $anvil =~ /^(?:yes|no|true|false|1|0)$/
        or die_msg "[$g] ANVIL='$anvil' — умію yes і no";

    # Винятки з лімітів — той самий формат, що MYNETWORKS, але сенс
    # ПРОТИЛЕЖНИЙ, і плутати їх не можна: MYNETWORKS дає право релею,
    # ANVIL_EXCEPTIONS знімає ліміти. Дефолт Postfix для другого —
    # `$mynetworks`, тобто він якраз і плутає; ми від нього свідомо
    # відходимо (main.cf, блок anvil).
    # Спершу $mynetworks, і лише потім формат: саме цю помилку людина
    # зробить найімовірніше (це ж дефолт Postfix, він сам напрошується),
    # а загальне "не схоже на IPv4" відповіло б їй не на те питання.
    if (($e->{ANVIL_EXCEPTIONS} // '') =~ /\$\{?mynetworks/i) {
        die_msg "[$g] ANVIL_EXCEPTIONS містить \$mynetworks. Це дефолт ",
                "Postfix, від якого проєкт свідомо відходить: рішення №20 ",
                "називає anvil компенсацією за широкий mynetworks, а такий ",
                "виняток вимикає його рівно на довірених мережах — тобто ",
                "саме там, де він потрібен. Якщо якусь мережу справді ",
                "треба звільнити від лімітів, перелічити її адресами.";
    }
    check_net_list($g, 'ANVIL_EXCEPTIONS', $e->{ANVIL_EXCEPTIONS},
                   "це знімає ліміти з УСЬОГО інтернету, тобто вимикає "
                 . "anvil повністю. Якщо саме цього й треба — ANVIL=no");

    # Автентифікація у відкритому вигляді — ТРЕТІЙ список мереж, і
    # формат у нього той самий, а зміст знову інший: ця дає право
    # надсилати пароль без TLS (рішення №14, уточнення 2026-11-13).
    # Порожній — дефолт і нормальний стан: small так і живе.
    #
    # Окремо ловимо $mynetworks, як і в ANVIL_EXCEPTIONS, але з іншої
    # причини: тут це не дефолт, а природна думка «довірена мережа =
    # можна без TLS». Вона хибна за побудовою — MYNETWORKS на isp це
    # чотири публічні блоки провайдера, тобто пароль відкритим текстом
    # із будь-якої абонентської адреси.
    if (($e->{CLEARTEXT_NETWORKS} // '') =~ /\$\{?mynetworks/i) {
        die_msg "[$g] CLEARTEXT_NETWORKS містить \$mynetworks. Ці два ",
                "списки НЕ одне й те саме: MYNETWORKS дає право релею ",
                "без SASL, а цей — право надіслати ПАРОЛЬ без шифрування. ",
                "На isp перший це чотири публічні блоки провайдера, ",
                "тобто виняток накрив би пів-міста. Перелічити мережі ",
                "явно.";
    }
    # `any` — глобальний дозвіл, і він НЕ помилка: на isp точковий
    # список неможливий (один активний абонент заходить зі ~130 адрес
    # за місяць, троє — це Gmail по POP3). Рішення власника: `any` на
    # день міграції, перемикання на TLS — окремою роботою після.
    #
    # Але воно мусить бути ВИДИМИМ щоразу, а не лежати рядком у
    # group.env: це єдиний параметр, який вимикає рішення №14 цілком.
    my $ct = $e->{CLEARTEXT_NETWORKS} // '';
    $ct =~ s/^\s+|\s+$//g;
    if (lc $ct eq 'any') {
        say STDERR "[$g] УВАГА: CLEARTEXT_NETWORKS=any — пароль можна ",
                   "надсилати БЕЗ TLS з будь-якої адреси.";
        say STDERR "  Рішення №14 для цієї групи не діє. Ціна: заражена ",
                   "машина чи будь-хто на шляху бачить пароль у відкритому ",
                   "вигляді;";
        say STDERR "  компенсація — abuse_block з терміном дії (рішення ",
                   "№20) і перехід клієнтів на TLS окремою роботою.";
    }
    else {
        check_net_list($g, 'CLEARTEXT_NETWORKS', $e->{CLEARTEXT_NETWORKS},
                       "це дозволяє надсилати пароль без TLS З УСЬОГО "
                     . "інтернету, тобто рішення №14 перестає діяти взагалі. "
                     . "Виняток має бути точковий: офісна мережа, "
                     . "абонентські блоки. Якщо точковий список справді "
                     . "неможливий (isp), є окреме слово 'any' — воно "
                     . "каже те саме явно й попереджає при кожному check");
    }

    # унікальність між групами — Docker про це скаже лише при up, і не так виразно
    for my $other (list_groups()) {
        next if $other eq $g;
        my $of = "$groups_dir/$other/group.env";
        next unless -f $of;
        my $oe = read_env($of);
        die_msg "[$g] INTERNAL_PREFIX='$pre' уже зайнятий групою '$other' — мережі перетнуться"
            if ($oe->{INTERNAL_PREFIX} // '') eq $pre;
        my %oip = map { $_->{net} . ':' . $_->{ip} => 1 }
                  parse_addresses($oe->{ADDRESSES}, $other);
        for my $a (@addr) {
            die_msg "[$g] адреса $a->{ip} у мережі '$a->{net}' уже зайнята ",
                    "групою '$other'"
                if $oip{"$a->{net}:$a->{ip}"};
        }
        die_msg "[$g] GROUP_NAME='$name' уже зайнятий групою '$other' — проєкти злипнуться"
            if ($oe->{GROUP_NAME} // '') eq $name;
    }

    # Перекриття конфігів мусять бути ВИДНІ. Мовчазна копія в групі,
    # що затінює спільний файл, — та сама пастка, через яку _configs/
    # і з'явились: правка в спільному не діє, а чому — не видно.
    for my $svc (shared_config_services()) {
        my $d = "$groups_dir/$g/$svc-config";
        next unless -d $d;
        opendir my $dh, $d or next;
        my @over = sort grep { !/^\.\.?$/ && !/^\.gitkeep$/
                               && -f "$d/$_" && -f "$root/_configs/$svc/$_" }
                   readdir $dh;
        closedir $dh;
        next unless @over;
        say STDERR "mailctl: [$g] $svc перекриває спільний конфіг: "
                 . join(' ', @over)
                 . '. Якщо це не свідомо — прибери файл(и), і діятиме '
                 . "_configs/$svc/";
    }

    return { dir => $g, env => $e, file => $f, name => $name,
             prefix => $pre, public_ip => $pub,
             primary => $primary, addr => \@addr };
}

# ── генерація того, що шаблон статично описати не може ────────────────
# Зовнішніх мереж у групи від однієї до кількох, і набір різний
# (рішення №27, №29). Compose не вміє циклів, тож підключення postfix
# до них описується згенерованим фрагментом, який домержується другим
# `-f`. Те саме з похідними значеннями: PUBLIC_IP і LISTEN_ADDRESSES
# виводяться з ADDRESSES, і задавати їх руками означало б тримати дві
# змінні, які мусять узгоджуватись.
#
# Обидва файли під .gitignore і перезаписуються при кожному `up`:
# єдине джерело правди — group.env плюс host.json.
sub generated_paths {
    my ($g) = @_;
    return ("$groups_dir/$g/networks.yml", "$groups_dir/$g/.compose.env");
}

sub generate_group_files {
    my ($c) = @_;
    my ($g, $name) = ($c->{dir}, $c->{name});
    my ($yml, $env) = generated_paths($g);
    my $nets = host_nets();

    open my $fh, '>', $yml or die_msg "не можу записати $yml: $!";
    print $fh <<"HDR";
# ЗГЕНЕРОВАНО mailctl із groups/$g/group.env і host.json.
# Не редагувати руками: перезаписується при кожному `mailctl up`.
#
# Підключає postfix до зовнішніх мереж групи. Імена мереж у цьому файлі
# (net_<мітка>) локальні для compose-проєкту; з чимось поза ним мусить
# збігатися тільки значення `name:` — ім'я мережі в `docker network ls`.
networks:
HDR
    for my $a (@{ $c->{addr} }) {
        printf {$fh} "  net_%s:\n    external: true\n    name: %s\n",
               $a->{net}, docker_net_name($a->{net});
    }
    print $fh "services:\n  postfix:\n    networks:\n";
    for my $a (@{ $c->{addr} }) {
        # Дефолтний маршрут — через PRIMARY_NET. internal у шаблоні має 10,
        # тож решта зовнішніх мереж отримує 20: вище за internal (щоб
        # дефолт не пішов у bridge), нижче за первинну.
        my $prio = $a->{net} eq $c->{primary} ? 100 : 20;
        printf {$fh} "      net_%s:\n        ipv4_address: %s\n        gw_priority: %d\n",
               $a->{net}, $a->{ip}, $prio;
    }
    close $fh;

    my $listen = join ' ', map { $_->{ip} } @{ $c->{addr} };
    open my $ef, '>', $env or die_msg "не можу записати $env: $!";
    print $ef <<"ENV";
# ЗГЕНЕРОВАНО mailctl — не редагувати руками.
# Похідні від ADDRESSES і PRIMARY_NET у groups/$g/group.env.
#
# PUBLIC_IP       — адреса мережі PRIMARY_NET ($c->{primary}); саме вона
#                   йде в smtp_bind_address, тобто її бачить приймальна
#                   сторона.
# LISTEN_ADDRESSES — ВСІ зовнішні адреси групи через пробіл, для
#                   inet_interfaces у Postfix і listen у Dovecot.
PUBLIC_IP=$c->{public_ip}
LISTEN_ADDRESSES=$listen
ENV
    close $ef;
    return ($yml, $env);
}

# ── compose ───────────────────────────────────────────────────────────
# Повертає розібраний конфіг групи: виклик validate() недешевий і
# друкує попередження, тож повторювати його заради одного $c->{name}
# не варто.
sub compose_group {
    my ($g, @args) = @_;
    # `down` не має вимагати робочих значень: щоб зупинити групу, секрети
    # не потрібні. Режим виводиться з самої команди, щоб виклики
    # compose_group не довелось правити по всьому файлу (і щоб `restart`
    # гасив м'яко, а піднімав суворо).
    my $c = validate($g, teardown => (@args && $args[0] eq 'down') ? 1 : 0);
    my ($yml, $env) = generate_group_files($c);
    # Порядок --env-file важливий: пізніший перекриває раніший. Згенерований
    # іде ДРУГИМ, бо його значення похідні й мусять перемагати будь-яку
    # застарілу копію в group.env.
    run_or_die('docker', 'compose', '-p', $c->{name},
               '--env-file', "$groups_dir/$g/group.env",
               '--env-file', $env,
               '-f', "$root/_template/docker-compose.yml",
               '-f', $yml, @args);
    return $c;
}

sub compose_proxy {
    my @args = @_;
    # Адреса для публікації приходить НЕ з docker-compose.yml, а звідси:
    # вона хостова, а файл проксі комітиться в git. Той самий прийом, що
    # з groups/<g>/.compose.env — згенерований файл під .gitignore.
    my $bind = host_proxy();
    my $cenv = "$proxy_dir/.compose.env";
    open my $fh, '>', $cenv or die_msg "не можу записати $cenv: $!";
    print $fh "# ЗГЕНЕРОВАНО mailctl — не редагувати руками.\n",
              "# Джерело: proxy.bind у host.json\n",
              "PROXY_BIND=$bind\n";
    close $fh;

    my @files = ('--env-file', $cenv, '-f', "$proxy_dir/docker-compose.yml");
    # фрагменти підключення груп; за їх відсутності проксі просто нікого не обслуговує
    if (opendir my $dh, $fragments) {
        push @files, '-f', "$fragments/$_"
            for sort grep { /\.yml$/ } readdir $dh;
        closedir $dh;
    }
    run_or_die('docker', 'compose', '-p', 'proxy', @files, @args);
}

# ── спільна публічна мережа хоста ─────────────────────────────────────
# Одна на батьківський інтерфейс: Docker відмовляється створити другу
# ipvlan-мережу на тому ж parent ("is already using parent interface").
# Тому вона не частина compose-проєкту групи, а окремий ресурс хоста.
sub net_exists { defined capture_quiet('docker', 'network', 'inspect', $_[0]) }

sub net_create {
    my ($key, $def) = @_;
    my $name = docker_net_name($key);
    if (net_exists($name)) { say "мережа '$name' уже є"; return }
    net_check_def($key, $def);

    my $drv    = $def->{driver};
    my $parent = net_parent($def);
    my @args   = ('-d', $drv, '--subnet', $def->{subnet});
    push @args, '--gateway', $def->{gateway} if length($def->{gateway} // '');

    if ($drv ne 'bridge') {
        # VLAN-субінтерфейс Docker створює САМ — перевірено на полігоні:
        # `net up office` з parent=eno1.8 підняв `138: eno1.8@eno1` без
        # жодної участі з нашого боку. Тому заздалегідь не лаємось; якщо
        # щось не так, скажемо ПІСЛЯ створення, коли це вже факт, а не
        # припущення.
        if (!-d "/sys/class/net/$parent" && $parent !~ /\./) {
            die_msg "інтерфейсу '$parent' немає на цьому хості ",
                    "(мережа '$key' у $host_json)";
        }
        push @args, '-o', "parent=$parent";
        push @args, '-o', 'ipvlan_mode=' . ($def->{mode} // 'l3') if $drv eq 'ipvlan';
        # Слейви ОДНОЇ ipvlan/macvlan-мережі за замовчуванням ходять один
        # до одного всередині драйвера — кадр не виходить на дріт і не
        # потрапляє в netfilter хоста. Для груп на спільній мережі це
        # означає, що ізоляція, перевірена на internal-бриджі, тут не
        # діє. isolate=true просить драйвер рубати цей шлях.
        if ($def->{isolate}) {
            push @args, '-o', $drv eq 'ipvlan' ? 'ipvlan_flag=private'
                                               : 'macvlan_mode=private';
        }
    }

    # ipvlan L3 не ставить контейнеру next-hop — там `default dev eth0`, а
    # далі маршрутизує хост. L2 і macvlan, навпаки, шлюзом користуються.
    if ($drv eq 'ipvlan' && ($def->{mode} // 'l3') =~ /^l3s?$/) {
        my $fwd = do { local (@ARGV, $/) = '/proc/sys/net/ipv4/ip_forward'; <> };
        say STDERR 'mailctl: увага — net.ipv4.ip_forward=0, хост не '
                 . "маршрутизуватиме префікс мережі '$key' у контейнери"
            unless defined $fwd && $fwd =~ /^1/;
    }

    run_or_die('docker', 'network', 'create', @args, $name);

    # Тепер, коли мережа є, можна сказати про субінтерфейс по факту.
    if ($drv ne 'bridge' && $parent =~ /\./ && !-d "/sys/class/net/$parent") {
        my ($iface, $vlan) = split /\./, $parent, 2;
        say STDERR "mailctl: мережа створена, але субінтерфейсу '$parent' ",
                   "на хості немає — Docker його не підняв. Зробити руками: ",
                   "sudo ip link add link $iface name $parent type vlan id $vlan && ",
                   "sudo ip link set $parent up";
    }

    say "створено '$name': $drv"
      . ($drv eq 'ipvlan' ? ' ' . ($def->{mode} // 'l3') : '')
      . ($drv eq 'bridge' ? '' : " на $parent")
      . ", $def->{subnet}"
      . (length($def->{gateway} // '') ? ", шлюз $def->{gateway}" : '');
}

# Сервіси, у яких є СПІЛЬНА база конфігу, — це каталоги в _configs/.
# ── Каталоги перекриття конфігів у групі ──────────────────────────────
#
# Шаблон bind-mount-ить groups/<g>/<сервіс>-config у кожен сервіс. Якщо
# каталогу немає, Docker створює його САМ — і робить це від root. Далі
# користувач не може туди покласти свій файл, а причина виглядає як
# «чомусь немає прав у власному репозиторії».
#
# Тому створюємо самі, від того, хто запустив mailctl. Список беремо З
# ШАБЛОНУ, а не зі свого уявлення: інакше кожен новий сервіс ламав би
# вже створені групи, і рівно це сталось при додаванні clamav.
sub template_config_dirs {
    my $f = "$root/_template/docker-compose.yml";
    open my $fh, '<', $f or die_msg "не можу прочитати $f: $!";
    my %d;
    while (my $line = <$fh>) {
        $d{$1} = 1 while $line =~ m{\$\{GROUP_CONFIG_DIR\}/([^:\s]+):}g;
    }
    close $fh;
    return sort keys %d;
}

sub ensure_group_config_dirs {
    my ($g) = @_;
    for my $d (template_config_dirs()) {
        my $path = "$groups_dir/$g/$d";
        next if -d $path;
        make_path($path);
        -d $path or die_msg "не можу створити $path";
        # mysql-init — не перекриття конфігу, а схема БД; про неї
        # повідомляти як про «спільні конфіги» було б неправдою.
        say "створив $path"
          . ($d eq 'mysql-init'
             ? ' (схема БД; наповнює ./mailctl db-schema)'
             : ' — порожній, тобто діють спільні конфіги з _configs/;'
             . ' свій файл кластиметься сюди');
    }
}

# Каталог у групі, якого шаблон НЕ читає, — мертвий: правка в ньому
# нічого не робить, і це саме той клас мовчазної пастки, проти якого
# у проєкті є конвенція. Найсвіжіший приклад: `spamassassin-rules`
# перейменований у `spamassassin-config`, і старий лишився лежати.
sub warn_stale_config_dirs {
    my ($g) = @_;
    my %known = map { $_ => 1 } template_config_dirs();
    opendir my $dh, "$groups_dir/$g" or return;
    my @stale = sort grep {
        !/^\.\.?$/ && -d "$groups_dir/$g/$_"
        && /-(?:config|rules)$/ && !$known{$_}
    } readdir $dh;
    closedir $dh;
    return unless @stale;
    say STDERR "mailctl: [$g] УВАГА — шаблон НЕ читає ці каталоги: "
             . join(', ', @stale);
    say STDERR "mailctl: [$g] правка в них нічого не змінить. Якщо вони "
             . "порожні — видалити; якщо ні — перенести файли у "
             . "відповідний *-config і видалити";
}

sub shared_config_services {
    opendir my $dh, "$root/_configs" or return ();
    my @s = sort grep { !/^\.\.?$/ && -d "$root/_configs/$_" } readdir $dh;
    closedir $dh;
    return @s;
}

# Сервіси, які ми СОБІ збираємо, — це просто каталоги в _images/.
# Авторитетний перелік усе ще в _images/build.sh, але тримати його ще й
# тут означало б дві копії, які одного дня розійдуться.
sub image_services {
    opendir my $dh, "$root/_images" or return ();
    my @s = sort grep { !/^\.\.?$/ && -f "$root/_images/$_/Dockerfile" } readdir $dh;
    closedir $dh;
    return @s;
}

# Образи, які НЕ є сервісами стеку: їх запускають одноразово, і в
# _template/docker-compose.yml їх немає. Тому `up`/`reload` по них
# працювати не можуть — compose сказав би «no such service».
my %oneshot_image = (certbot => 1);

# Сервіси, які справді живуть у шаблоні. Саме цей список потрібен
# `up` і `reload`; `build` і далі збирає ВСЕ з _images/.
sub service_images {
    return grep { !$oneshot_image{$_} } image_services();
}

# Чи не старіший образ за свій Dockerfile/entrypoint.
#
# Навіщо: збірка в цьому проєкті РУЧНА — образи спільні на всі групи
# (рішення №4), тож `git pull` плюс запуск дає стару логіку з новим
# конфігом. Один раз це вже коштувало кола діагностики: entrypoint без
# гілки `check` пропустив аргумент наскрізь у dovecot, і повідомлення
# вийшло про опцію `-F`, тобто зовсім не про причину.
#
# Це попередження, а не відмова: бувають і легітимні випадки, коли
# правили лише коментар у Dockerfile.
# Коли образ зібраний, у секундах epoch, або undef.
#
# Чому не один `{{.Created}}`: з containerd image store (у нього інший
# вивід `docker images` — із DISK USAGE/CONTENT SIZE) образ, зібраний із
# attestation-манифестами, може не віддати це поле у звичному вигляді.
# Один раз це вже вийшло: перевірка «образ старіший за джерело» просто
# не спрацювала, причому МОВЧКИ.
sub image_built_epoch {
    my ($image) = @_;
    for my $fmt ('{{.Created}}', '{{.Metadata.LastTagTime}}') {
        my $v = capture_quiet('docker', 'image', 'inspect',
                              '--format', $fmt, $image);
        next unless defined $v;
        # RFC3339 в UTC; дробові секунди й зону відкидаємо.
        next unless $v =~ /(\d{4}-\d\d-\d\d)[T ](\d\d:\d\d:\d\d)/;
        my $t = eval { Time::Piece->strptime("$1T$2", '%Y-%m-%dT%H:%M:%S')->epoch };
        # Нульова дата (0001-01-01) означає «поля немає», а не 1 рік.
        return $t if defined $t && $t > 0;
    }
    return undef;
}

# Повне ім'я образу сервісу.
#
# Спільний IMAGE_TAG (`trixie`) годиться не всім: roundcube зібраний не
# з debian, а з ОФІЦІЙНОГО образу Roundcube з доданим плагіном
# (_images/roundcube/Dockerfile), і тег `:trixie` на ньому був би
# брехнею — тією самою, через яку в цьому проєкті вже був образ,
# потегований одним релізом і зібраний з іншого.
#
# Тег для нього читається з FROM у Dockerfile — ТАК САМО, як це робить
# _images/build.sh. Значення, отже, має одне джерело: сам Dockerfile.
# Якщо прочитати не вдалось, повертаємо тег за замовчуванням: тоді
# образ не знайдеться й stale_images поскаржиться вголос, а не
# промовчить.
sub image_ref {
    my ($svc, $tag) = @_;
    my $df = "$root/_images/$svc/Dockerfile";
    if (open my $fh, '<', $df) {
        while (my $line = <$fh>) {
            next unless $line =~ m{^FROM \s+ roundcube/roundcubemail: (\S+)}x;
            my $base = $1;
            $base =~ s/-apache\z//;   # у тезі образу варіант зайвий
            close $fh;
            return "mail/$svc:$base";
        }
        close $fh;
    }
    return "mail/$svc:$tag";
}

sub stale_images {
    my ($tag, @svcs) = @_;
    my @stale;
    for my $svc (@svcs) {
        my $dir = "$root/_images/$svc";
        next unless -d $dir;

        my $src = 0;
        if (opendir my $dh, $dir) {
            for my $f (readdir $dh) {
                next if $f =~ /^\.\.?$/;
                my $m = (stat "$dir/$f")[9];
                $src = $m if defined $m && $m > $src;
            }
            closedir $dh;
        }

        my $built = image_built_epoch(image_ref($svc, $tag));
        unless (defined $built) {
            # НЕ `next`. Мовчки пропустити означало б, що перевірка
            # перестала працювати, а ніхто про це не дізнався — рівно
            # так і сталось: образ зі старим entrypoint запустили, і
            # помилка вийшла не про те. Тепер неможливість перевірити —
            # сама по собі попередження.
            push @stale, "$svc (не вдалось визначити дату образу)";
            next;
        }
        push @stale, $svc if $src > $built;
    }
    return @stale;
}

sub warn_stale_images {
    my @stale = stale_images(@_);
    return unless @stale;
    say STDERR 'mailctl: УВАГА — образ(и) старіші за свої _images/: '
             . join(', ', @stale);
    say STDERR 'mailctl: спершу ./mailctl build, інакше працює ПОПЕРЕДНЯ '
             . 'версія entrypoint, а помилка буде не про те';
    say STDERR 'mailctl: (на цьому вже спіймались двічі — із `check` у '
             . 'dovecot і з MYNETWORKS у spamassassin)'
        if grep { /дату образу/ } @stale;
}

# Короткий вивід git без зайвого шуму: якщо каталог не під git (копія
# релізу, розпакований архів) — просто не показуємо git-рядків.
sub git_out {
    my @out = ('git', '-C', $root, @_);
    my $v = capture_quiet(@out);
    return undef unless defined $v;
    $v =~ s/\s+\z//;
    return length($v) ? $v : undef;
}

sub cmd_version {
    say "Docker-Mail-Stack $PROJECT_VERSION";

    my $commit = git_out('rev-parse', '--short', 'HEAD');
    if (defined $commit) {
        my $branch = git_out('rev-parse', '--abbrev-ref', 'HEAD') // '?';
        my $date   = git_out('log', '-1', '--format=%cs')         // '?';
        # describe --tags: якщо тегів ще немає, віддасть сам хеш — тоді
        # показувати його другий раз немає сенсу.
        my $tag    = git_out('describe', '--tags', '--abbrev=0');
        my $dirty  = defined git_out('status', '--porcelain') ? ', є незакомічені зміни' : '';
        say "  git      $commit ($branch), $date$dirty";
        say "  тег      $tag" if defined $tag;
    }
    else {
        say '  git      каталог не під git — версія лише з самого mailctl';
    }

    say "  perl     $^V";

    # Версії docker тут не для краси: поведінка стеку від них залежить
    # прямо (ipvlan і gw_priority, автоматичне створення VLAN-
    # субінтерфейсу, drop-правила ізоляції з Docker 28). У повідомленні
    # про проблему це перше, що треба знати.
    my $d = capture_quiet('docker', 'version', '--format', '{{.Server.Version}}');
    my $c = capture_quiet('docker', 'compose', 'version', '--short');
    for ($d, $c) { $_ =~ s/\s+\z// if defined }
    say '  docker   ' . (defined $d && length $d ? $d : 'не відповідає');
    say '  compose  ' . (defined $c && length $c ? $c : 'не відповідає');
}

# Перевірка конфігу сервісу в ОДНОРАЗОВОМУ контейнері.
#
# Навіщо окрема команда: коли конфіг зламаний, контейнер падає в
# restart-loop, і `docker exec` у нього вже не зайти — Docker відповідає
# «is restarting, wait until the container is running». Тобто найпотрібніший
# момент — саме той, коли звичайна діагностика недоступна.
# Що саме монтувати й які змінні передати — на сервіс. Імена змінних
# мусять збігатися з `environment:` відповідного сервісу в
# _template/docker-compose.yml: два місця, які узгоджуються вручну.
# Якщо правиш там — правь і тут.
my %config_service = (
    dovecot => {
        mount  => '/etc/dovecot/custom',
        shared => '/etc/dovecot/shared',
        env   => [qw(MYSQL_HOST MYSQL_DB MYSQL_USER MYSQL_PASSWORD
                     LISTEN_ADDRESSES MAIL_HOSTNAME POSTMASTER_ADDRESS
                     VMAIL_UID VMAIL_GID)],
    },
    opendkim => {
        mount  => '/etc/opendkim/config',
        shared => '/etc/opendkim/shared',
        env   => [qw(MYSQL_HOST MYSQL_DB MYSQL_USER MYSQL_PASSWORD
                     MAIL_HOSTNAME DKIM_SELECTOR INTERNAL_PREFIX
                     MYNETWORKS)],
        # Без ключів у томі entrypoint нічого не покаже, тож для
        # перевірки підключаємо той самий том, що й у справжнього
        # контейнера. Ім'я тому — <проєкт>_dkim-keys, бо так його
        # називає compose.
        volume => 'dkim-keys:/etc/opendkim/keys',
        # І мережу групи: цей entrypoint ЧИТАЄ список доменів із БД,
        # тобто мусить достукатись до сервісу `mysql` за іменем. На
        # дефолтному бриджі його немає, і перевірка просто чекала б
        # хвилину й падала. Наслідок: `config opendkim`, на відміну від
        # dovecot і postfix, вимагає ПІДНЯТОЇ групи. Ті двоє до БД при
        # перевірці не ходять — doveconf і postfix check з'єднань не
        # роблять.
        network => 'internal',
    },
    opendmarc => {
        mount  => '/etc/opendmarc/config',
        shared => '/etc/opendmarc/shared',
        env    => [qw(MAIL_HOSTNAME INTERNAL_PREFIX MYNETWORKS)],
    },
    postfix => {
        mount  => '/etc/postfix-custom',
        shared => '/etc/postfix-shared',
        env   => [qw(MYSQL_HOST MYSQL_DB MYSQL_USER MYSQL_PASSWORD
                     LISTEN_ADDRESSES PUBLIC_IP MAIL_HOSTNAME
                     POSTMASTER_ADDRESS MYNETWORKS)],
    },
    spamassassin => {
        mount  => '/etc/spamassassin/config',
        shared => '/etc/spamassassin/shared',
        env   => [qw(MYSQL_HOST SA_DB SA_DB_USER SA_DB_PASSWORD
                     POSTMASTER_ADDRESS MYNETWORKS SA_DNSBL)],
        # До БД `spamassassin --lint` не ходить — він лише розбирає
        # конфіги й компілює правила. Тому, на відміну від opendkim,
        # піднятої групи тут не потрібно.
    },
    clamav => {
        mount  => '/etc/clamav/config',
        shared => '/etc/clamav/shared',
        # ClamAV env не читає взагалі — усе в трьох конфігах. `clamconf`
        # друкує їх ефективні значення й бази вірусів для цього не
        # потребує, тобто перевірка працює й до першого завантаження.
        env    => [],
    },
);

sub cmd_config {
    my ($g, $service) = @_;
    $service //= 'dovecot';
    my $spec = $config_service{$service}
        or die_msg 'config: умію ' . join(' ', sort keys %config_service)
                 . ", а не '$service'";

    my $c = validate($g);
    my (undef, $env) = generate_group_files($c);
    my $e = read_env($env);

    my $dir    = "$groups_dir/$g/$service-config";
    my $shared = "$root/_configs/$service";
    # Не падаємо, якщо каталогу перекриття немає: він порожній у
    # більшості груп і потрібен лише як точка монтування. Падіння тут
    # означало б «новий сервіс зламав усі наявні групи».
    ensure_group_config_dirs($g);
    -d $dir or die_msg "немає $dir";
    -d $shared or die_msg "немає $shared — спільна база конфігів";

    # Змінні передаємо через ВЛАСНЕ середовище (`-e ІМ'Я` без значення),
    # а не `-e ІМ'Я=значення`: інакше пароль до БД видно в `ps`.
    # `--env-file` тут теж не годиться — парсер docker не такий, як у
    # compose: він не знімає лапок, тож значення в лапках приїхало б
    # разом із ними.
    #
    # Відповідність іменам — та сама, що в environment: сервісу dovecot у
    # _template/docker-compose.yml. Два місця, які мусять узгоджуватись;
    # якщо правиш там — правь і тут.
    my %val = (
        MYSQL_HOST         => 'mysql',
        MYSQL_DB           => $c->{env}{MYSQL_MAIL_DB}       // 'mailserver',
        MYSQL_USER         => $c->{env}{MYSQL_MAIL_USER}     // 'mailuser',
        MYSQL_PASSWORD     => $c->{env}{MYSQL_MAIL_PASSWORD} // '',
        MAIL_HOSTNAME      => $c->{env}{MAIL_HOSTNAME}       // '',
        POSTMASTER_ADDRESS => $c->{env}{POSTMASTER_ADDRESS}  // '',
        MYNETWORKS         => $c->{env}{MYNETWORKS}          // '',
        VMAIL_UID          => $c->{env}{VMAIL_UID}           // '',
        VMAIL_GID          => $c->{env}{VMAIL_GID}           // '',
        LISTEN_ADDRESSES   => $e->{LISTEN_ADDRESSES}         // '',
        PUBLIC_IP          => $e->{PUBLIC_IP}                // '',
        DKIM_SELECTOR      => $c->{env}{DKIM_SELECTOR}       // '',
        INTERNAL_PREFIX    => $c->{prefix},
        SA_DB              => $c->{env}{SA_DB}               // 'spamassassin',
        SA_DB_USER         => $c->{env}{SA_DB_USER}          // 'spamd',
        SA_DB_PASSWORD     => $c->{env}{SA_DB_PASSWORD}      // '',
        SA_DNSBL           => $c->{env}{SA_DNSBL}            // 'yes',
        # Дефолти ТІ САМІ, що в _template/docker-compose.yml. Вони
        # потрібні саме тут, бо одноразовий `docker run` йде БЕЗ
        # compose, тобто форма `${VAR:-дефолт}` до нього не доходить
        # взагалі: змінна, якої немає в group.env, приїхала б порожня.
        CLEARTEXT_NETWORKS      => $c->{env}{CLEARTEXT_NETWORKS}      // '',
        AUTH_ALLOW_WEAK_SCHEMES => $c->{env}{AUTH_ALLOW_WEAK_SCHEMES} // 'no',
        SIEVE_MAX_REDIRECTS     => $c->{env}{SIEVE_MAX_REDIRECTS}     // '4',
        SPAM_TO_JUNK            => $c->{env}{SPAM_TO_JUNK}            // 'no',
        GREYLIST                => $c->{env}{GREYLIST}                // 'yes',
        GREYLIST_DELAY          => $c->{env}{GREYLIST_DELAY}          // '20',
        GREYLIST_MAX_AGE        => $c->{env}{GREYLIST_MAX_AGE}        // '60',
        ANVIL                   => $c->{env}{ANVIL}                   // 'yes',
        ANVIL_EXCEPTIONS        => $c->{env}{ANVIL_EXCEPTIONS}        // '',
        TZ                      => $c->{env}{TZ}                      // 'UTC',
    );
    # Передаємо ВСЄ, що знаємо, а НЕ список `$spec->{env}`.
    #
    # Той список був ТРЕТІИМ місцем, яке мусить узгоджуватись із
    # entrypoint-ом і compose, і 27.11.2026 воно розійшлось: `config <g>
    # dovecot` падав на `INTERNAL_PREFIX SIEVE_MAX_REDIRECTS
    # AUTH_ALLOW_WEAK_SCHEMES` — трьох змінних, доданих у entrypoint
    # ПІСЛЯ того, як цей список писався. Зламалось не сьогодні,
    # а 16 листопада — просто досі ніхто не кликав `config`.
    #
    # Асиметрія цін: ЗАЙВА змінна в одноразовому контейнері
    # нікому не шкодить (entrypoint читає ті, що знає), а ВІДСУТНЯ
    # ламає саме той інструмент, яким діагностують інші поломки —
    # і саме тоді, коли він найпотрібніший.
    #
    # `$spec->{env}` лишається в таблиці як довідка про те, що
    # сервісу справді потрібно, але не як ФІЛЬТР.
    my @envargs;
    for my $k (sort keys %val) {
        $ENV{$k} = defined $val{$k} ? $val{$k} : '';
        push @envargs, '-e', $k;
    }

    my $tag = $c->{env}{IMAGE_TAG} // 'trixie';
    warn_stale_images($tag, $service);
    my @vol = $spec->{volume}
            ? ('-v', "$c->{name}_$spec->{volume}") : ();

    my @net;
    if ($spec->{network}) {
        my $n = "$c->{name}_$spec->{network}";
        defined capture_quiet('docker', 'network', 'inspect', $n)
            or die_msg "мережі '$n' немає, тобто група не піднята. ",
                       "Перевірка '$service' читає список доменів із БД, ",
                       "тож без піднятої групи їй нема що перевіряти: ",
                       "спершу ./mailctl up $g";
        @net = ('--network', $n);
    }

    run_or_die('docker', 'run', '--rm', @envargs, @vol, @net,
               '-v', "$shared:$spec->{shared}:ro",
               '-v', "$dir:$spec->{mount}:ro",
               "mail/$service:$tag", 'check');
}

# Перестворити контейнери групи, щоб конфіги прочитались наново.
#
# Навіщо окрема команда: конфіги приходять bind-mount-ом, а читають їх
# entrypoint-и ПРИ СТАРТІ. Для compose при цьому нічого не змінилось —
# опис сервісу той самий, образ той самий, — тож `up` чесно каже
# «Running» і нічого не перестворює. Правка main.cf просто не діє, і
# виглядає це як «виправлення не допомогло». Уже спіймались.
# ── Що саме мусить слухати в живій групі ──────────────────────────────
# Таблиця оголошена ТУТ, бо нею користуються двоє: `health` (повна
# картина) і `reload` (чекає лише те, що перестворив). Друга копія
# списку портів розійшлася б із першою мовчки.
# Куди Postfix ходить. Порядок — як у ланцюгу мілтерів плюс решта.
my @health_probes = (
    # Порти самого Postfix. Пробуються з його ж контейнера, і це не
    # тавтологія: вони кажуть, що master справді підняв postscreen і
    # smtpd, а не просто що контейнер біжить. Через це вже спіймались:
    # `reload` повертав керування, коли dovecot слухав, а 25 ще ні, і
    # наступна ж команда отримувала `Connection refused`.
    # 127.0.0.1 тут законний: він є в `inet_interfaces` (потрібен парі
    # з Dovecot), і це той самий netns.
    [ '127.0.0.1',      25, 'SMTP (postscreen)'  ],
    [ '127.0.0.1',     587, 'submission'         ],
    [ 'opendkim',     8891, 'мілтер DKIM'        ],
    [ 'opendmarc',    8893, 'мілтер DMARC'       ],
    [ 'clamav',       7357, 'мілтер антивірусу'  ],
    [ 'spamassassin', 8894, 'мілтер антиспаму'   ],
    # 783 — сам spamd. До рішення №34 він слухав лише loopback свого
    # контейнера, і перевіряти його з постфікса не було сенсу. Тепер
    # через нього йде ДОНАВЧАННЯ від Dovecot (а той у netns постфікса),
    # і якщо порт закритий, навчання тихо не відбувається: користувач
    # переклав лист у Junk, лист там лежить, і все виглядає гаразд.
    [ 'spamassassin',  783, 'spamd (донавчання)'  ],
    [ 'mysql',        3306, 'база'               ],
    # Вебмейл. Мертвий Roundcube видно й так («не відкривається»), але
    # проба відрізняє «не слухає» від «проксі не доїхав»: nginx живе
    # ПОЗА групою, і при здоровому Roundcube винен був би він.
    [ 'roundcube',      80, 'вебмейл'            ],
    # Четвертим елементом — 'opt': проба показується, але НЕ вважається
    # збоєм. Postgrey свідомо ще не налаштований (у образі стоїть
    # `CMD sleep infinity`, у main.cf його немає) — це етап 2, TODO
    # п.5b. Вважати це збоєм означало б привчати не читати вивід.
    [ 'postgrey',    10023, 'greylisting — ЩЕ НЕ НАЛАШТОВАНИЙ (TODO 5b)', 'opt' ],
    # Пара postfix+dovecot ділить netns, тому loopback (рішення №11).
    [ '127.0.0.1',      24, 'LMTP у Dovecot'     ],
    [ '127.0.0.1',   12345, 'SASL-auth у Dovecot' ],
    # ── ВИХІД НАЗОВНІ ──
    #
    # Усі проби вище — внутрішні, і вони можуть бути чисті на групі, що
    # нікуди не доставляє: саме такий стан ми щойно мали після
    # перейменування NIC (мережа трималась на старому parent).
    #
    # Пробувати ШЛЮЗ для цього НЕ МОЖНА, і на цьому вже спіймались: в
    # ipvlan L3 `gateway` з host.json не стає next-hop'ом (рішення №24),
    # контейнер отримує `default dev eth0 scope link`, а маршрутизує
    # хост. Пінг на шлюз не проходить і на цілком робочій мережі, тобто
    # така проба дає хибний висновок в обидва боки.
    #
    # Тому ЗОВНІШНЯ адреса, і порт 53/tcp: він відкритий у 1.1.1.1 і
    # стосується справи — без DNS Postfix не знайде MX, тобто вихідна
    # пошта не піде нікуди.
    #
    # `opt`, бо політику хоста ми не знаємо: вихід може бути свідомо
    # закритий, і фальшивий ЗБІЙ привчав би не читати вивід (та сама
    # причина, що в postgrey). Текст натомість прямо каже, куди дивитись.
    [ '1.1.1.1',        53, 'вихід назовні — якщо мовчить, вихідна пошта '
                          . 'не піде (перевірити ip_forward і nft на хості)',
                            'opt' ],
);

# ── Чи ПІДНЯЛОСЬ те, що ми щойно перестворили ─────────────────────────
#
# Причина існування: `milter_default_action = accept` у main.cf. Вибір
# свідомий і лишається (втратити пошту гірше, ніж втратити перевірку),
# але наслідок у нього такий: ПОКИ мілтер стартує, пошта проходить без
# перевірки й МОВЧКИ. Вікно невелике — секунди — але воно є, і на ньому
# вже спіймались: лист, надісланий одразу після `reload`, прийшов без
# жодного `X-Spam-*`, і виглядало це як зламаний конфіг.
#
# Отже змінюємо не рішення, а те, що оператор про вікно не знає.
# Проби, скориговані під КОНКРЕТНУ групу.
#
# Потрібно рівно для postgrey: у таблиці він позначений `opt`, бо до
# рішення про greylisting його порт був закритий свідомо. Тепер усе
# залежить від GREYLIST: якщо greylisting увімкнений, закритий 10023 —
# це вже не «ще не налаштовано», а «Postfix відповідає 451 на ВСЮ
# пошту», тобто найважливіший збій у всьому виводі.
#
# Коригуємо копію, а не таблицю: вона спільна й читається двома
# командами.
sub effective_probes {
    my ($c) = @_;
    my $grey = $c->{env}{GREYLIST} // 'yes';
    my $on   = $grey =~ /^(?:yes|true|1)$/;
    my @out = map {
        my @p = @$_;
        if ($p[0] eq 'postgrey') {
            if ($on) { $p[3] = undef; $p[2] = 'greylisting (451 на ВСЮ пошту, якщо мовчить)' }
            else     { $p[2] = 'greylisting — ВИМКНЕНИЙ у group.env (GREYLIST)' }
        }
        [ @p ];
    } @health_probes;

    # ── проби на ВЛАСНІЙ internal-адресі пари postfix+dovecot ──
    #
    # Робляться з контейнера postfix на адресу, якою його бачать СУСІДИ
    # по internal. Виглядає як перевірка самого себе, але перевіряє
    # рівно те, що loopback-проби побачити не можуть: чи входить
    # internal-адреса в `inet_interfaces` Postfix і в `listen` Dovecot.
    #
    # Існує тому, що ця діра вже була, і була ПОЛОВИННОЮ: я додав
    # адресу Dovecot і забув Postfix. Симптом вийшов оманливий — вхід у
    # вебмейл працював (IMAP), а відправка падала з «Не вдалося
    # з'єднатися з сервером» (SMTP). Тобто половина пари виглядала
    # здоровою, і жодна наявна проба цього не ловила.
    #
    # Це шлях ВЕБМЕЙЛУ: Roundcube живе поза netns (рішення №5), тож
    # ходить саме сюди.
    my $pre = $c->{prefix};
    push @out,
        [ "$pre.10",  587, 'submission для вебмейлу (inet_interfaces)' ],
        [ "$pre.10",  143, 'IMAP для вебмейлу (listen Dovecot)'        ];
    return @out;
}

sub probes_for {
    my ($c, @svc) = @_;
    my %svc = map { $_ => 1 } @svc;
    # dovecot власної адреси не має — він у netns постфікса (рішення №5),
    # тому його порти в таблиці підписані як 127.0.0.1 (рішення №11).
    # Але на 127.0.0.1 слухає й сам postfix (25, 587), тож ключ —
    # host:port, а не host: інакше `reload <g> dovecot` чекав би порти
    # постфікса, а `reload <g> postfix` — порти dovecot.
    my $pre   = $c->{prefix};
    my %alias = (
        '127.0.0.1:24'    => 'dovecot', '127.0.0.1:12345' => 'dovecot',
        '127.0.0.1:25'    => 'postfix', '127.0.0.1:587'   => 'postfix',
        # Проби на internal-адресі пари (шлях вебмейлу). Хост тут
        # динамічний, тож статичним літералом не обійтись.
        "$pre.10:587"     => 'postfix', "$pre.10:143"     => 'dovecot',
    );
    return grep {
        my $name = $alias{ "$_->[0]:$_->[1]" } // $_->[0];
        $svc{$name} && (($_->[3] // '') ne 'opt')
    } effective_probes($c);
}

sub wait_for_probes {
    my ($c, $timeout, @svc) = @_;
    my @probes = probes_for($c, @svc);
    return 1 unless @probes;

    # Пробуємо З КОНТЕЙНЕРА POSTFIX — саме він ходить до мілтерів, і
    # перевірка з хоста нічого не доказує (та сама причина, що в health).
    my $pf = "$c->{name}-postfix";
    unless (container_running($pf)) {
        say STDERR "mailctl: $pf не запущений — порти перевірити нізвідки";
        return 0;
    }

    my $script = join '', map {
        "if (exec 3<>/dev/tcp/$_->[0]/$_->[1]) 2>/dev/null; "
      . "then echo 'ok $_->[0]:$_->[1]'; else echo 'FAIL $_->[0]:$_->[1]'; fi; "
    } @probes;

    my $deadline = time + $timeout;
    my %st;
    while (1) {
        my $res = capture_quiet('docker', 'exec', $pf, 'bash', '-c', $script) // '';
        %st = map { /^(ok|FAIL) (\S+)/ ? ($2 => $1) : () } split /\n/, $res;
        last unless grep { ($st{"$_->[0]:$_->[1]"} // 'FAIL') eq 'FAIL' } @probes;
        last if time >= $deadline;
        sleep 1;
    }

    my $all = 1;
    for my $p (@probes) {
        my $key  = "$p->[0]:$p->[1]";
        my $good = ($st{$key} // 'FAIL') eq 'ok';
        $all = 0 unless $good;
        printf "  %-4s %-22s %s\n", ($good ? 'ok' : 'ЗБІЙ'), $key, $p->[2];
    }
    $all or say STDERR
        "mailctl: не всі порти відповіли за $timeout с. ПОКИ ЦЕ ТАК, пошта "
      . "проходить БЕЗ відповідної перевірки\n"
      . "й мовчки — milter_default_action = accept. Дивитись причину:\n"
      . "  ./mailctl health $c->{dir}\n"
      . "  ./mailctl config $c->{dir} <сервіс>      # ефективний конфіг і --lint\n"
      . "  docker logs $c->{name}-<сервіс>";
    return $all;
}

sub cmd_reload {
    my ($g, @svc) = @_;
    @svc = service_images() unless @svc;

    # dovecot живе в network namespace постфікса. Перестворити postfix
    # без dovecot означає лишити dovecot у namespace, якого вже немає.
    my %want = map { $_ => 1 } @svc;
    $want{dovecot} = 1 if $want{postfix};
    $want{postfix} = 1 if $want{dovecot};
    @svc = sort keys %want;

    ensure_group_config_dirs($g);
    say 'перестворюю: ' . join(' ', @svc);
    my $c = compose_group($g, 'up', '-d', '--force-recreate', @svc);

    say '';
    say '── чекаю, поки перестворене почне слухати ──';
    wait_for_probes($c, 60, @svc)
        or exit 1;
}

# Показати DNS-записи DKIM, які треба опублікувати.
#
# Ключі лежать у томі групи, а публічну частину opendkim-genkey кладе
# поруч у <селектор>.txt — у форматі зони BIND, розбитому на рядки по
# 255 символів. Для DNS-панелі потрібне склеєне значення, тож склеюємо
# самі: руками це робиться з помилкою в одному символі з трьох разів.
# Публічні ключі DKIM із тому групи: домен -> склеєне значення TXT.
#
# Список доменів беремо НЕ з БД, а з наявних ключів — і це не лінь, а
# властивість: ключ існує рівно для того домену, який opendkim знайшов
# у `domains` з type='LOCAL'. Отже згенеровані записи DNS за побудовою
# узгоджені з тим, що стек СПРАВДІ підписує, а не з тим, що хтось мав
# на увазі. Побічно `mailctl` лишається без DBI (рішення №28).
sub dkim_records {
    my ($c) = @_;
    my $tag = $c->{env}{IMAGE_TAG} // 'trixie';

    my $out = capture_quiet('docker', 'run', '--rm', '--entrypoint', 'sh',
                            '-v', "$c->{name}_dkim-keys:/keys",
                            "mail/opendkim:$tag", '-c',
                            'for f in /keys/*/*.txt; do '
                          . '[ -s "$f" ] || continue; '
                          . 'echo "@@ $f"; cat "$f"; done');
    defined $out && length $out
        or die_msg "ключів ще немає. Вони з'являються при старті ",
                   "контейнера opendkim, який читає список доменів із БД — ",
                   "тобто спершу `./mailctl up $c->{dir}` і домени в ",
                   "таблиці `domains` з type='LOCAL'";

    my (%rec, $domain, @chunks);
    my $flush = sub {
        return unless defined $domain;
        # opendkim-genkey ріже значення по 255 символів і лапкує кожен
        # кусок — для файлу зони це правильно, для панелі DNS потрібне
        # склеєне. Склеювати руками — помилка в одному символі з трьох.
        $rec{$domain} = join '', @chunks;
        ($domain, @chunks) = (undef);
    };
    for my $line (split /\n/, $out) {
        if ($line =~ m{^\@\@ /keys/([^/]+)/}) { $flush->(); $domain = $1; next }
        push @chunks, $line =~ /"([^"]*)"/g;
    }
    $flush->();
    return \%rec;
}

sub cmd_dkim {
    my ($g)  = @_;
    my $c    = validate($g);
    my $rec  = dkim_records($c);
    my $sel  = $c->{env}{DKIM_SELECTOR};

    for my $d (sort keys %$rec) {
        say $d;
        say "  ім'я   $sel._domainkey.$d";
        say '  тип    TXT';
        say "  зміст  $rec->{$d}";
        say '';
    }
    say 'Прапорця t=y тут НЕМА, і це свідомо: у тестовому режимі підпис';
    say 'нічого не важить. Старі записи на чинних серверах свій t=y';
    say 'зберігають — вони живуть окремо, під іншим селектором.';
}

# Повний набір DNS-записів групи, готовий до публікації.
sub cmd_dns {
    my ($g) = @_;
    my $c   = validate($g);
    my $e   = $c->{env};
    my $rec = dkim_records($c);
    my $sel = $e->{DKIM_SELECTOR};
    my $ip  = $c->{public_ip};
    my $fqdn = $e->{MAIL_HOSTNAME};

    # SPF описує ВИХІДНУ пошту, і джерело в ньому називається ІМЕНЕМ
    # ВУЗЛА, а не адресою (рішення власника 2026-11-18).
    #
    # Чому `a:`, а не `ip4:` — три причини, і жодна не стильова:
    #   * адреса названа ОДИН раз, в A-записі, за яким і так ходять
    #     клієнти й звіряється CN сертифіката. `ip4:` зробив би другий
    #     її примірник, а дві змінні, що мусять узгоджуватись,
    #     розходяться мовчки — те саме правило, яким із group.env
    #     прибрали PUBLIC_IP;
    #   * IPv6 підхоплюється САМ: `a:` бере і A, і AAAA. Нагадування
    #     «додати ip6: одночасно з увімкненням IPv6» зникає як клас;
    #   * переїзд групи на іншу адресу перестає бути правкою в семи
    #     зонах.
    # Ціна: один DNS-lookup із бюджету 10 (RFC 7208 §4.6.4) замість
    # нуля. На записі з одним механізмом це не має значення.
    #
    # `mx` НЕ використовуємо, хоч він теж «на іменах». Рішення №39
    # робить резервний MX можливістю будь-якої групи, і щойно в MX
    # домену з'явиться сторонній сервер, `mx` дав би йому право
    # ВІДПРАВЛЯТИ від нашого імені. Приймання й відправлення — різні
    # ролі, і злипати їх не можна.
    #
    # УМОВА, яку це накладає: A-запис імені вузла містить лише публічні
    # поштові адреси. Офісну сіру адресу (office, 192.168.50.253) у той
    # A-запис ставити не можна — вона потрапила б у SPF. Шкоди від
    # приватної адреси там немає (вона ніколи не зматчиться), але це
    # сміття в записі, за яким потім ніхто не здогадається.
    my @mech = ("a:$fqdn");
    my $extra = $e->{SPF_EXTRA} // '';
    push @mech, split /\s+/, $extra if length $extra;

    say "# ── вузол ─────────────────────────────────────────────────────";
    say "A       $fqdn   $ip";
    say "rDNS    $ip   $fqdn   (замовляти у провайдера, не в своїй зоні)";
    # SPF на самому ВУЗЛІ, а не лише на доменах: при порожньому MAIL FROM
    # перевіряти в конверті нічого, і приймальна сторона бере
    # HELO-ідентичність, тобто це ім'я. Пояснення — нижче у виводі.
    say "TXT     $fqdn";
    say '        "v=spf1 a -all"';
    say '';

    for my $d (sort keys %$rec) {
        say "# ── $d ──";
        say "MX      $d   10 $fqdn.";
        say "TXT     $d";
        say '        "v=spf1 ' . join(' ', @mech) . ' ~all"';
        say "TXT     $sel._domainkey.$d";
        say qq{        "$rec->{$d}"};
        say "TXT     _dmarc.$d";
        # rua= — адреса В ТОМУ Ж домені, а не POSTMASTER_ADDRESS групи
        # (рішення власника 2026-11-18). Це не косметика: RFC 7489 §7.1
        # вимагає згоди приймальної сторони лише для адреси в ЧУЖОМУ
        # домені, тож однодоменна форма прибирає і три записи
        # `_report._dmarc`, і режим збою «записи стоять, звітів немає»,
        # на якому проєкт уже два тижні ловився.
        #
        # Умова: postmaster@<домен> мусить приймати пошту. Вона вже
        # контролюється — `health` показує кожен LOCAL-домен без
        # postmaster@ як ЗБІЙ, — а далі аліас веде звіти туди ж, куди
        # й раніше.
        say qq{        "v=DMARC1; p=none; rua=mailto:postmaster\@$d"};
        say '';
    }

    # ЗАПИСІВ `_report._dmarc` ТУТ БІЛЬШЕ НЕМА, і це не спрощення, а
    # усунення механізму: `rua=` тепер однодоменний (див. вище), а
    # RFC 7489 §7.1 вимагає згоди лише для ЧУЖОГО домену. Якщо колись
    # знадобиться збирати звіти в сторонній домен — згоду треба буде
    # повернути, і симптом її відсутності це тиша, не помилка.

    say '# ── що треба знати про ці записи ──────────────────────────────';
    say '';
    say 'SPF містить ОДНУ нашу адресу — ту, з якої йде вихідна пошта.';
    say 'Якщо пошта цих доменів виходить ще звідкись (під час переходу —';
    say 'зі старого сервера), додати ці джерела в SPF_EXTRA у group.env,';
    say 'а не правити згенероване руками: інакше наступний запуск';
    say 'покаже інше, ніж лежить у DNS.';
    say '';
    say 'SPF на ІМЕНІ ВУЗЛА не дублює доменні записи, а закриває інший';
    say 'випадок. Коли MAIL FROM порожній — а порожній він у всіх DSN,';
    say 'тобто у відмовах і звітах про недоставку, — у конверті перевіряти';
    say 'нічого, і приймальна сторона падає на HELO-ідентичність, тобто на';
    say 'цю назву. Без запису вона дістає `none`: ні pass, ні fail, а DMARC';
    say 'лишається без опори на SPF і тримається самим лише DKIM.';
    say 'Спіймано на small DMARC-звітом Google за 2026-11-14.';
    say '';
    say 'І там, і в доменних записах джерело назване ІМЕНЕМ, а не адресою.';
    say 'Причина не стильова: адреса вже названа A-записом вище, і другий';
    say 'її примірник розійшовся б мовчки. Бонусом IPv6 підхопиться сам —';
    say '`a:` бере і A, і AAAA, тож окремого `ip6:` не знадобиться.';
    say '';
    say '`mx` навмисно НЕ використовується, хоч він теж «на іменах».';
    say 'Резервний MX — можливість будь-якої групи (рішення №39), і щойно';
    say 'в MX домену з`явиться сторонній сервер, `mx` дав би йому право';
    say 'ВІДПРАВЛЯТИ від нашого імені. Приймання й відправлення — різні';
    say 'ролі.';
    say '';
    say 'УМОВА: A-запис імені вузла мусить містити лише публічні поштові';
    say 'адреси. Офісну сіру адресу туди ставити не можна — вона';
    say 'потрапила б у SPF (шкоди немає, бо приватна адреса ніколи не';
    say 'зматчиться, але це сміття, про яке потім не здогадаються).';
    say '';
    say '`-all` на імені вузла доречний навіть на першому етапі: за цим';
    say 'іменем шле рівно один хост, перелічувати більше нічого.';
    say '';
    say 'Квантор `~all` у ДОМЕННИХ записах свідомо: поки не видно за';
    say 'DMARC-звітами, що всі легітимні джерела перелічені, жорстка';
    say 'відмова означає втрачати свою ж пошту. Перехід на `-all` —';
    say 'правка в DNS, не в конфізі.';
    say '';
    say 'DMARC `p=none` — теж перший етап. Він НЕ захищає, він лише';
    say 'збирає звіти; `quarantine`/`reject` вмикати, коли у звітах';
    say 'видно, що своя пошта проходить вирівнювання.';
    say '';
    say qq{ip4:/ip6: руками тут НЕ потрібні — ні зараз, ні з появою};
    say 'IPv6: `a:` бере обидва типи записів. Якщо пошта тимчасово йде';
    say 'ще й з іншої адреси (перехідний період, другий сервер) —';
    say 'додати її в SPF_EXTRA, а не правити згенероване. І прибрати';
    say 'звідти, коли джерело зникне: забутий `ip4:` з часом';
    say 'авторизує адресу, яка вже не наша, і той, кому її віддадуть,';
    say 'зможе шле від нашого домену з spf=pass.';
    say '';
    say 'Другий, резервний MX тут НЕ генерується. Це рішення про';
    say 'архітектуру пошти, а не параметр групи: вторинний MX мусить';
    say 'уміти ставити пошту в чергу й знати список дійсних';
    say 'отримувачів, інакше він перетворюється на джерело backscatter.';
    say '';
    say qq{rua= вказує на postmaster\@ТОГО Ж домену, а не на одну адресу};
    say 'для всіх. Так RFC 7489 §7.1 не вимагає згоди приймальної';
    say 'сторони: вона потрібна лише коли адреса в rua= лежить у ЧУЖОМУ';
    say 'домені, і без неї звіти не надсилаються взагалі — причому';
    say 'симптом це не помилка, а тиша. Куди звіти підуть далі, вирішує';
    say 'аліас; `health` стежить, щоб postmaster@ існував на кожному';
    say 'LOCAL-домені.';
    say '';
    say 'Якщо в домену вже є старий DKIM-запис із t=y — він живе під';
    say 'іншим селектором і цим записам не мішає. Прибирати його (разом';
    say 'із t=y) ПІСЛЯ того, як переконаєшся, що новий стек підписує';
    say 'валідно.';
}

# Застосувати схему стану SpamAssassin до ЖИВОЇ бази.
#
# Навіщо, коли є mysql-init: ті скрипти виконуються лише при ПЕРШОМУ
# старті контейнера MariaDB, тобто на порожньому datadir. Поки стек
# тестовий, `down --volumes` безболісний; на групі, що вже носить пошту,
# знести том неможливо, а схема для нового сервісу потрібна. Без цього
# шляху додавання SpamAssassin до робочої групи було б операцією
# «вивантаж пошту, знеси базу, залий назад» — тобто не операцією, а
# пригодою.
#
# Ідемпотентність: пакетні CREATE TABLE без IF NOT EXISTS, тож повторний
# запуск дав би помилки. Замість --force (який проглинув би й СПРАВЖНІ
# помилки) просто перевіряємо, чи таблиці вже є, і відмовляємось.
sub sa_apply {
    my ($g, $e, $dst) = @_;
    my $file = "$dst/50-spamassassin.sql";
    -f $file or die_msg "немає $file";

    my $name    = $e->{GROUP_NAME} // $g;
    my $ctr     = "$name-mysql";
    my $db      = $e->{SA_DB} // 'spamassassin';
    my $root_pw = $e->{MYSQL_ROOT_PASSWORD} // '';
    container_running($ctr)
        or die_msg "контейнер $ctr не запущений — спершу ./mailctl up $g";

    my $have = mysql_count($ctr, $root_pw, $dst,
        "SELECT COUNT(*) FROM information_schema.tables "
      . "WHERE table_schema='$db'");

    $have >= 0 or die_msg "не вдалось опитати базу в $ctr — пароль root ",
                          "у group.env правильний?";
    if ($have > 0) {
        say "у базі '$db' уже $have таблиць — не чіпаю.";
        say "Якщо схему треба перестворити, це робиться свідомо й вручну: ",
            "там живий bayes.";
        return;
    }

    say "застосовую $file до живої бази в $ctr";
    mysql_exec_file($ctr, $root_pw, $file);
    say "готово. Перезапустити SpamAssassin, щоб він побачив базу: ",
        "./mailctl reload $g spamassassin";
}

# Одне число з БД. Виділено з sa_apply, бо користувачів стало двоє
# (перевірка схеми SpamAssassin і перевірка «чи база вже наповнена»
# перед db-load), а друга копія цієї акуратності з паролем розійшлася
# б із першою.
#
# База — ОКРЕМИМ аргументом, через `database=` у defaults-file, а НЕ
# `база`.таблиця в самому запиті. Причина конкретна й перевірена
# збоєм: запит їде в `sh -c` як -e "$sql", тобто всередині ПОДВІЙНИХ
# лапок, і бектик там виконується ЯК КОМАНДА. Перша версія цієї
# функції саме так і зламалась — `sh: 1: maildb: not found`, а в SQL
# пішло `FROM .users`, тобто повідомлення вказувало на пароль і схему,
# хоч винні були бектики. Той самий клас, що бектики в неквотованому
# heredoc (PITFALLS).
#
# $db опційний: sa_apply питає information_schema ДО того, як база
# існує, і `database=` там зламав би саме підключення.
sub mysql_count {
    my ($ctr, $root_pw, $scratch, $sql, $db) = @_;

    # Сторож, а не коментар: лишити можливість написати бектик і лише
    # описати її — це та сама помилка вдруге.
    $sql =~ tr/`$\\"//
        and die_msg "mysql_count: у запиті символ, який шелл з'їсть ",
                    "(бектик, \$, лапка, зворотний слеш): $sql";

    # База — АРГУМЕНТОМ клієнта, через env-змінну DB, а не `database=`
    # в конфізі: поведінка аргументу очевидна й не залежить від того,
    # чи клієнт читає цю опцію з [client]. Ім'я бази не секрет, тож
    # його видимість у середовищі процесу нічого не коштує — на
    # відміну від пароля, який і далі йде файлом.
    my $sh = 'umask 077; cat > /tmp/.q.cnf; '
        . 'cl=$(command -v mariadb || command -v mysql); '
        . 'if [ -n "$DB" ]; then '
        . "  \$cl --defaults-extra-file=/tmp/.q.cnf \"\$DB\" -N -B -e \"$sql\" "
        . '    > /tmp/.q.out 2>/tmp/.q.err; '
        . 'else '
        . "  \$cl --defaults-extra-file=/tmp/.q.cnf -N -B -e \"$sql\" "
        . '    > /tmp/.q.out 2>/tmp/.q.err; '
        . 'fi; '
        . 'rc=$?; cat /tmp/.q.out; cat /tmp/.q.err >&2; '
        . 'rm -f /tmp/.q.cnf /tmp/.q.out /tmp/.q.err; exit $rc';

    my $cnf = "[client]\nuser=root\npassword=$root_pw\n";
    local $ENV{DB} = defined $db ? $db : '';

    # Вивід потрібен НАМ, не людині, а run_with_stdin віддає його в наш
    # stdout — тож підмінюємо stdout на тимчасовий файл.
    my $tmp = "$scratch/.q-count.$$";
    {
        open my $save, '>&', \*STDOUT or die_msg "не можу зберегти stdout";
        open STDOUT, '>', $tmp or die_msg "не можу відкрити $tmp";
        run_with_stdin($cnf,
                       'docker', 'exec', '-i', '-e', 'DB', $ctr, 'sh', '-c', $sh);
        open STDOUT, '>&', $save or die_msg "не можу повернути stdout";
    }
    return do { open my $fh, '<', $tmp or die_msg "нема $tmp";
                local $/; my $v = <$fh> // ''; unlink $tmp;
                $v =~ /(\d+)/ ? $1 : -1 };
}

# Те саме, що mysql_count, але віддає РЯДКИ, а не одне число. Потрібне
# там, де важливо не «скільки», а «які саме» — наприклад, перелік
# доменів без postmaster@: число нічого не дає, бо лікування адресне.
#
# Окрема функція, а не прапорець у mysql_count: та повертає -1 на збій і
# число на успіх, тобто її контракт на список не натягується без
# двозначності («порожній список» і «збій» виглядали б однаково).
sub mysql_rows {
    my ($ctr, $root_pw, $scratch, $sql, $db) = @_;
    $sql =~ tr/`$\\"//
        and die_msg "mysql_rows: у запиті символ, який шелл з'їсть: $sql";

    my $sh = 'umask 077; cat > /tmp/.r.cnf; '
        . 'cl=$(command -v mariadb || command -v mysql); '
        . "\$cl --defaults-extra-file=/tmp/.r.cnf \"\$DB\" -N -B -e \"$sql\" "
        . '    > /tmp/.r.out 2>/tmp/.r.err; '
        . 'rc=$?; cat /tmp/.r.out; cat /tmp/.r.err >&2; '
        . 'rm -f /tmp/.r.cnf /tmp/.r.out /tmp/.r.err; exit $rc';

    my $cnf = "[client]\nuser=root\npassword=$root_pw\n";
    local $ENV{DB} = defined $db ? $db : '';
    my $tmp = "$scratch/.q-rows.$$";
    my $rc;
    {
        open my $save, '>&', \*STDOUT or die_msg "не можу зберегти stdout";
        open STDOUT, '>', $tmp or die_msg "не можу відкрити $tmp";
        $rc = run_with_stdin($cnf,
                 'docker', 'exec', '-i', '-e', 'DB', $ctr, 'sh', '-c', $sh);
        open STDOUT, '>&', $save or die_msg "не можу повернути stdout";
    }
    my @out;
    if (open my $fh, '<', $tmp) {
        while (my $l = <$fh>) { chomp $l; push @out, $l if length $l }
        close $fh;
    }
    unlink $tmp;
    # undef = запит не виконався; порожній масив = виконався, рядків нема.
    # `run_with_stdin` віддає 1 на УСПІХ (не код виходу) — переплутати
    # легко, і тоді порожній список і збій помінялись би місцями.
    return $rc ? \@out : undef;
}

# ── залити готовий SQL у поштову базу групи ───────────────────────────
#
# Причина існування команди: `mysql-init` виконується лише при ПЕРШОМУ
# старті MariaDB, а дані міграції приходять потім. Робити це рядком у
# документації не можна — найкоротший варіант
# (`docker exec ... mariadb -p"$PW"`) світить пароль root у `ps` на
# хості. Тут він іде тим самим шляхом, що в db-schema --apply.
#
# Відмовляємось, якщо в `users` уже є рядки: конвертор генерує
# INSERT-и без ON DUPLICATE, а `login` має UNIQUE — повторна заливка
# відкотила б транзакцію цілком, і виглядало б це як «SQL зламаний».
#
# Але рівно з цієї причини guard НЕ діє на файл без жодної вставки:
# DDL-патч на вже запущену групу (`_schemas/upgrade/*.sql`) перезаписати
# нічого не може в принципі. Інакше вийшло б гірше, ніж незручність —
# єдиним виходом став би `--force`, тобто той самий ключ, яким потім
# заливають дамп даних, і звичка натискати його переносилась би туди,
# де він справді небезпечний.
sub cmd_db_load {
    my ($g, @args) = @_;
    my ($file, %opt);
    for my $a (@args) {
        if    ($a eq '--force') { $opt{force} = 1 }
        elsif ($a =~ /^-/)      { die_msg "db-load: невідомий ключ '$a'; є --force" }
        elsif (defined $file)   { die_msg "db-load: зайвий аргумент '$a'" }
        else                    { $file = $a }
    }
    defined $file or die_msg "db-load: укажи файл\n",
        "  ./mailctl db-load $g <файл.sql>";
    -f $file or die_msg "немає файла '$file'";

    my $e       = read_env(group_env_path($g));
    my $name    = $e->{GROUP_NAME} // $g;
    my $ctr     = "$name-mysql";
    my $db      = $e->{MYSQL_MAIL_DB} || 'mailserver';
    my $root_pw = $e->{MYSQL_ROOT_PASSWORD} // '';
    container_running($ctr)
        or die_msg "контейнер $ctr не запущений — спершу ./mailctl up $g";

    # Чи є у файлі взагалі вставки даних. Коментарі пропускаємо, бо
    # шапка DDL-патча цілком може згадувати INSERT словами.
    my $data_stmts = 0;
    {
        open my $fh, '<', $file or die_msg "не читається '$file': $!";
        while (my $l = <$fh>) {
            next if $l =~ /^\s*(?:--|#)/;
            $data_stmts++ if $l =~ /\b(?:INSERT|REPLACE|LOAD\s+DATA)\b/i;
        }
        close $fh;
    }

    my $scratch = "$groups_dir/$g";
    my $have = mysql_count($ctr, $root_pw, $scratch,
                           'SELECT COUNT(*) FROM users', $db);
    $have >= 0 or die_msg "не вдалось опитати базу '$db' у $ctr — ",
                          "пароль root у group.env правильний? ",
                          "схема вже застосована?";

    if ($have > 0 && $data_stmts && !$opt{force}) {
        say STDERR "mailctl: у базі '$db' уже $have скриньок — не заливаю.";
        say STDERR "  Конвертор генерує INSERT без ON DUPLICATE, а `login` ",
                   "має UNIQUE,";
        say STDERR "  тож повторна заливка відкотила б транзакцію цілком — ",
                   "і це виглядало б";
        say STDERR "  як «SQL зламаний», хоч він цілий.";
        say STDERR "  Справді треба долити (окремим файлом даних) — --force.";
        exit 1;
    }

    say $data_stmts
        ? "заливаю $file у базу '$db' контейнера $ctr"
        : "застосовую $file до бази '$db' контейнера $ctr (вставок немає)";
    mysql_exec_file($ctr, $root_pw, $file, $db);
    my $now = mysql_count($ctr, $root_pw, $scratch,
                          'SELECT COUNT(*) FROM users', $db);
    if ($data_stmts) {
        say "готово. Скриньок у базі: $now";
        say "Postfix побачить їх ОДРАЗУ (SQL на кожен RCPT), а OpenDKIM — НІ:";
        say "  ./mailctl reload $g opendkim && ./mailctl dkim $g";
    }
    else {
        say "готово. Скриньок у базі: $now (не змінювалось)";
    }
}

# Виконати SQL-файл у контейнері БД від root.
#
# Виділено з sa_apply, бо користувачів стало троє (SpamAssassin,
# Roundcube і db-load), а друга копія цих шести рядків розійшлася б із
# першою — тим паче що в них уся акуратність із паролем.
#
# $db опційний, і різниця не стильова: схеми SpamAssassin і Roundcube
# самі роблять CREATE DATABASE/USE, а ДАНІ міграції — ні, тож без
# `database=` вони падають на першому ж INSERT із `No database
# selected`. Саме так і сталось.
sub mysql_exec_file {
    my ($ctr, $root_pw, $file, $db) = @_;

    # Конфіг і дані — різні потоки: конфіг кладемо файлом у контейнері,
    # SQL подаємо на STDIN клієнта.
    my $apply_sh = 'umask 077; printf "%s" "$MY_CNF" > /tmp/.my.cnf; '
        . 'cl=$(command -v mariadb || command -v mysql); '
        . 'if [ -n "$DB" ]; then $cl --defaults-extra-file=/tmp/.my.cnf "$DB"; '
        . 'else $cl --defaults-extra-file=/tmp/.my.cnf; fi; '
        . 'rc=$?; rm -f /tmp/.my.cnf; exit $rc';

    open my $sqlfh, '<', $file or die_msg "не можу прочитати $file: $!";
    my $sql = do { local $/; <$sqlfh> };
    close $sqlfh;

    # Пароль іде ЗМІННОЮ СЕРЕДОВИЩА (`-e ІМ'Я` без значення), а SQL —
    # на STDIN. Так ні те, ні те не потрапляє в аргументи, тобто не
    # видно в `ps` на хості.
    local $ENV{MY_CNF} = "[client]\nuser=root\npassword=$root_pw\n";
    local $ENV{DB}     = defined $db ? $db : '';
    run_with_stdin($sql, 'docker', 'exec', '-i', '-e', 'MY_CNF', '-e', 'DB',
                   $ctr, 'sh', '-c', $apply_sh)
        or die_msg "не вдалось застосувати $file — див. помилки вище";
}

# Доступи Roundcube до живої бази.
#
# Перевірки «чи вже застосовано» тут НЕ треба, на відміну від
# SpamAssassin: у 60-roundcube.sql усе ідемпотентне — CREATE ... IF NOT
# EXISTS, ALTER USER, GRANT. Таблиць він не створює взагалі (їх робить
# сам образ Roundcube через initdb.sh), а значить і нищити нічого.
# Повторний запуск лише доводить права й пароль до того, що написано в
# group.env — тобто це ще й спосіб застосувати зміну пароля.
sub rc_apply {
    my ($g, $e, $dst) = @_;
    my $file = "$dst/60-roundcube.sql";
    -f $file or die_msg "немає $file — спершу ./mailctl db-schema $g";

    my $name    = $e->{GROUP_NAME} // $g;
    my $ctr     = "$name-mysql";
    my $root_pw = $e->{MYSQL_ROOT_PASSWORD} // '';
    container_running($ctr)
        or die_msg "контейнер $ctr не запущений — спершу ./mailctl up $g";

    say "застосовую $file до живої бази в $ctr";
    mysql_exec_file($ctr, $root_pw, $file);
    say "готово. Базу й таблиці в ній створить сам Roundcube при старті: ",
        "./mailctl reload $g roundcube";
}

# ── TLS: випуск і оновлення сертифікатів ──────────────────────────────
#
# Рішення (TODO п.7): certbot — ОДНОРАЗОВИЙ контейнер під керуванням
# mailctl, а не демон усередині стеку. Три причини, кожна достатня:
#
#   1. Dovecot тримає сертифікат у login-процесах і потребує
#      `doveadm reload`. Контейнер усередині стеку не перезавантажить
#      сусіда, не отримавши docker-сокет, а docker-сокет у контейнері —
#      це root на хості. mailctl уже має доступ до Docker законно.
#   2. Сертифікат вебмейлу — ХОСТОВИЙ (його віддає спільний nginx на всі
#      групи), а не груповий. Один механізм на обидва випадки виходить
#      лише з хоста.
#   3. Збій у хостовому таймері видно, у фоновому циклі в контейнері —
#      ні. А саме цей клас збою й з'їв TLS на всіх трьох джерелах: там
#      renewal-hooks ПОРОЖНІ, тобто сертифікат оновлювався, а демони
#      далі тримали старий.
#
# Виклик без групи обробляє ВСІ групи — саме в такому вигляді це
# ставиться в таймер одним рядком. Група, яка не піднята, пропускається
# з попередженням, а не валить решту: загашена група не має ламати
# оновлення сусідам.

# Том із акаунтом ACME і всіма сертифікатами. ХОСТОВИЙ, бо акаунт один
# на хост; ім'я фіксоване й не параметризується свідомо — це не вибір
# групи. Групі з нього копіюється лише своя пара файлів, тобто чужих
# приватних ключів вона не бачить (рішення №4).
my $LE_VOLUME = 'mailstack-letsencrypt';

sub container_running {
    my ($name) = @_;
    my $st = capture_quiet('docker', 'inspect', '-f', '{{.State.Running}}', $name);
    return defined $st && $st =~ /true/;
}

# Випустити/оновити сертифікат однієї групи. Повертає 1, якщо дійшли до
# кінця, 0 — якщо групу свідомо пропустили.
sub certs_one {
    my ($g, $opt) = @_;
    my $c    = validate($g);
    my $fqdn = $c->{env}{MAIL_HOSTNAME}      // '';
    my $mail = $c->{env}{POSTMASTER_ADDRESS} // '';
    my $tag  = $c->{env}{IMAGE_TAG} // 'trixie';
    length $fqdn or die_msg "[$g] MAIL_HOSTNAME не заданий";
    length $mail or die_msg "[$g] POSTMASTER_ADDRESS не заданий";

    # Метод перевірки. http — типовий; dns-cloudflare — коли зовнішній
    # :80 належить комусь іншому й віддати його не можна (TODO п.7).
    my $method = $c->{env}{ACME_METHOD} // 'http';

    my $pf = "$c->{name}-postfix";
    # Контейнер потрібен в обох методах, але з різних причин: для http —
    # бо certbot слухає :80 у ЙОГО netns (там живуть адреси групи), для
    # dns — бо після випуску треба покласти файл і подзвонити демонам.
    unless (container_running($pf)) {
        say STDERR "mailctl: [$g] пропускаю — контейнер $pf не запущений"
                 . ($method eq 'http'
                    ? ". certbot слухає :80 У МЕРЕЖЕВОМУ NAMESPACE постфікса, "
                    . "бо саме там живуть адреси групи; без нього немає де "
                    . "приймати перевірку HTTP-01"
                    : ". Сам випуск по DNS-01 його не потребує, але покласти "
                    . "сертифікат і перезавантажити демонів нема куди");
        return 0;
    }

    say "── $g: $fqdn ──";
    warn_stale_images($tag, 'certbot');

    # --standalone: certbot сам підіймає HTTP-сервер на :80. Порт вільний,
    # бо Roundcube свідомо виведений із netns постфікса (рішення №5) —
    # поки він там сидів, :80 був зайнятий і цей шлях був закритий.
    #
    # DNS-01 тут не потрібен НІКОЛИ: він обов'язковий лише для wildcard
    # або коли 80/443 недосяжні. Поштовому серверу wildcard не потрібен,
    # отже й API-токен до DNS-провайдера не потрібен — а разом із ним
    # зникає випадок «у абонента чужий DNS, токена не буде».
    my @cb = ('certonly',
              '--non-interactive', '--agree-tos', '--email', $mail,
              # --cert-name фіксуємо явно: інакше certbot виводить ім'я
              # теки з першого -d, і одного дня при зміні порядку доменів
              # отримали б ДРУГИЙ набір файлів замість оновлення першого.
              '--cert-name', $fqdn, '-d', $fqdn);

    # ── Тип ключа ─────────────────────────────────────────────────────
    # certbot за замовчуванням видає ECDSA, і ми успадкували це мовчки.
    # Для small байдуже, а на isp — абоненти зі старими The Bat і
    # Outlook: клієнт без ECDSA отримує помилку рукостискання, тобто для
    # користувача «пошта раптом перестала працювати», і на сертифікат це
    # не вказує ніяк.
    #
    # Дефолт лишається `ecdsa`, щоб поява параметра не змінила поведінку
    # наявних груп.
    #
    # ВАЖЛИВО: на ВЖЕ ВИДАНОМУ сертифікаті зміна типу сама не
    # застосується — `--keep-until-expiring` побачить чинний файл і нічого
    # не зробить. Потрібен `certs <g> --force`, інакше параметр змінено, а
    # сертифікат лишився старим, і дізнаємось про це від користувачів.
    my $kt = $c->{env}{CERT_KEY_TYPE} // 'ecdsa';
    push @cb, '--key-type', $kt;

    push @cb, $opt->{force} ? '--force-renewal' : '--keep-until-expiring';
    push @cb, '--staging' if $opt->{staging};
    push @cb, '--dry-run' if $opt->{'dry-run'};
    # Порт, на якому certbot ЧЕКАЄ перевірку. Зовні Let's Encrypt завжди
    # ходить на 80 — це властивість HTTP-01, і змінити її не можна. Але
    # куди той 80 приходить усередині, вирішуємо ми, і це потрібно рівно
    # тоді, коли зовнішній 80 належить комусь іншому: тоді на шляху стоїть
    # або чужий веб-сервер, що проксує /.well-known/acme-challenge/ сюди,
    # або DNAT на інший порт. Див. TODO п.7, «коли 80 зайнятий чужим
    # сервісом».

    # ── Метод перевірки ───────────────────────────────────────────────
    my (@vol, @net);
    if ($method eq 'http') {
        push @cb, '--standalone', '--preferred-challenges', 'http';
        # Порт, на якому certbot ЧЕКАЄ перевірку. Зовні Let's Encrypt
        # завжди ходить на 80 — це властивість HTTP-01 і змінити її не
        # можна. Але куди той 80 приходить усередині, вирішуємо ми, і це
        # потрібно рівно тоді, коли зовнішній 80 належить комусь іншому:
        # тоді на шляху стоїть або чужий веб-сервер, що проксує
        # /.well-known/acme-challenge/ сюди, або DNAT на інший порт.
        push @cb, '--http-01-port', $opt->{'http-port'} if $opt->{'http-port'};
        # Той самий netns, що в постфікса: адреси групи належать йому.
        @net = ('--network', "container:$pf");
    }
    elsif ($method eq 'dns-cloudflare') {
        my $ini = "$groups_dir/$g/acme.ini";
        -f $ini or die_msg "[$g] ACME_METHOD=dns-cloudflare, але немає ",
                           "$ini. Це файл із API-токеном Cloudflare ",
                           "(права Zone:DNS:Edit), у форматі:\n",
                           "  dns_cloudflare_api_token = <токен>\n",
                           "Токен — до тієї зони, де certbot кластиме TXT: ",
                           "або зона самого домену (коли вона на Cloudflare), ",
                           "або ВЛАСНА зона-приймач, куди з чужої зони веде ",
                           "статичний CNAME на _acme-challenge.\n",
                           "Права — 600, він під .gitignore.";
        my $mode = (stat $ini)[2] & 07777;
        $mode == 0600
            or die_msg sprintf "[%s] %s має права %04o, потрібно 0600: "
                             . "це API-токен. chmod 600 %s", $g, $ini, $mode, $ini;

        push @cb, '--dns-cloudflare',
                  '--dns-cloudflare-credentials', '/acme.ini',
                  # Типові 10 секунд розраховані на запис у власній зоні.
                  # У нас ланцюжок довший: CNAME у чужій зоні веде в нашу,
                  # тож чекати треба поширення НАШОГО TXT плюс кешування
                  # того CNAME. Параметризуємо, бо провайдери різні.
                  '--dns-cloudflare-propagation-seconds',
                  $c->{env}{ACME_DNS_WAIT} // '30';
        push @vol, '-v', "$ini:/acme.ini:ro";
        # netns постфікса тут НЕ потрібен: перевірка йде через DNS, а не
        # через порт. Отже група за NAT випускає сертифікат так само, як
        # група з білою адресою — і це головна причина мати цей метод.
    }
    else {
        die_msg "[$g] ACME_METHOD='$method' — умію 'http' і 'dns-cloudflare'";
    }

    say "  метод: $method";

    run('docker', 'run', '--rm', @net, @vol,
        '-v', "$LE_VOLUME:/etc/letsencrypt",
        "mail/certbot:$tag", @cb)
        or die_msg "[$g] certbot не впорався. Найчастіші причини: ",
                   ($method eq 'http'
                    ? "A-запис $fqdn не вказує на адресу групи; порт 80 не "
                    . "доходить ззовні (на цій адресі або через прокидання); "
                    . ":80 у netns хтось уже слухає — перевірити "
                    . "./mailctl netns $g"
                    : "немає CNAME _acme-challenge.$fqdn на нашу зону-приймач; "
                    . "токен у acme.ini не має прав Zone:DNS:Edit на ту зону; "
                    . "або TXT не встиг поширитись — підняти ACME_DNS_WAIT");

    if ($opt->{'dry-run'}) {
        say "  --dry-run: перевірка пройдена, файлів не чіпаю";
        return 1;
    }

    # ── Доставка в груповий том ───────────────────────────────────────
    # Копіюємо, а не монтуємо підкаталог /etc/letsencrypt/live/<fqdn>:
    # по-перше, там симлінки в ../archive/, тобто монтування підкаталогу
    # дало б битi посилання (звідси й `cp -L`); по-друге, група не мусить
    # мати доступу до тому з ключами ВСІХ груп.
    #
    # `cmp` перед копіюванням — щоб знати, чи був reload потрібен.
    # Викликів буде стільки ж, скільки запусків таймера, тобто щодня, а
    # сертифікат змінюється раз на два місяці: без порівняння ми б
    # щодня дзвонили демонам без причини.
    my $sh = join "\n",
        'set -e',
        "src=/le/live/$fqdn",
        '[ -s "$src/fullchain.pem" ] || { echo "немає $src/fullchain.pem" >&2; exit 1; }',
        'if cmp -s "$src/fullchain.pem" /out/fullchain.pem 2>/dev/null; then',
        '    echo UNCHANGED; exit 0',
        'fi',
        'cp -L "$src/fullchain.pem" /out/.fullchain.new',
        'cp -L "$src/privkey.pem"   /out/.privkey.new',
        # Приватний ключ — 600 root:root, і це НЕ помилка: і Postfix, і
        # Dovecot читають його під root до відкидання привілеїв
        # (smtpd у pre_jail_init, Dovecot у майстрі). Саме такий режим
        # рекомендує документація обох.
        'chmod 644 /out/.fullchain.new',
        'chmod 600 /out/.privkey.new',
        # mv в межах одного тому атомарний: сервіс ніколи не прочитає
        # напівзаписаний ключ.
        'mv /out/.fullchain.new /out/fullchain.pem',
        'mv /out/.privkey.new   /out/privkey.pem',
        'echo CHANGED';

    my $res = capture('docker', 'run', '--rm', '--entrypoint', 'sh',
                      '-v', "$LE_VOLUME:/le:ro",
                      '-v', "$c->{name}_tls-certs:/out",
                      "mail/certbot:$tag", '-c', $sh);
    defined $res or die_msg "[$g] не вдалось покласти сертифікат у том ",
                            "$c->{name}_tls-certs";

    if ($res =~ /UNCHANGED/) {
        say "  сертифікат не змінився — демонів не чіпаю";
        return 1;
    }

    say "  сертифікат оновлений, перечитують демони";
    # Саме reload, а НЕ `mailctl reload`: той перестворює контейнери, і
    # це розірвало б усі клієнтські з'єднання й чергу Postfix заради
    # перечитування одного файлу. Тут потрібне рівно перечитування.
    #
    # Postfix, найімовірніше, обійшовся б і без цього (кожен smtpd читає
    # сертифікат при старті процесу, а вони рециклюються), але
    # розраховувати на це не варто: ціна виклику нульова.
    run('docker', 'exec', "$c->{name}-postfix", 'postfix', 'reload')
        or say STDERR "mailctl: [$g] УВАГА — postfix reload не вдався";
    # Dovecot без цього тримав би СТАРИЙ сертифікат до наступного
    # перезапуску контейнера — тихо, тобто найгіршим можливим способом.
    # Рівно цей дефект лежить на всіх трьох серверах-джерелах.
    run('docker', 'exec', "$c->{name}-dovecot", 'doveadm', 'reload')
        or say STDERR "mailctl: [$g] УВАГА — doveadm reload не вдався";
    return 1;
}

sub cmd_certs {
    my (@args) = @_;
    my (%opt, @want);
    for my $a (@args) {
        if ($a =~ /^--(staging|dry-run|force|proxy)$/) { $opt{$1} = 1 }
        elsif ($a =~ /^--http-port=(\d+)$/) {
            $1 >= 1 && $1 <= 65535 or die_msg "certs: --http-port=$1 поза межами";
            $opt{'http-port'} = $1;
        }
        elsif ($a =~ /^-/) {
            die_msg "certs: невідомий ключ '$a'. Є --staging, --dry-run, ",
                    "--force, --http-port=N, --proxy";
        }
        else { push @want, $a }
    }
    @want = list_groups() unless @want;
    @want or die_msg 'немає жодної групи в groups/';

    if ($opt{staging} || $opt{'dry-run'}) {
        say 'STAGING/DRY-RUN: сертифікат вийде НЕ довірений браузерами. '
          . 'Це правильний режим, поки перевіряється сама процедура — '
          . 'ліміти Let’s Encrypt на справжні сертифікати жорсткі, а на '
          . 'staging практично немає.';
    }

    my $done = 0;
    # --proxy міняє ТРИ речі, і кожна має причину:
    #   ім'я      — WEBMAIL_FQDN замість MAIL_HOSTNAME (вебмейл живе на
    #               адресі проксі, не групи — рішення №23);
    #   метод     — --webroot замість --standalone, бо :80 на тій адресі
    #               вже тримає nginx, і відбирати його немає сенсу: він
    #               сам і віддасть виклик;
    #   кому дзвонити після — nginx, а не postfix/dovecot.
    # Решта (ліміти, --staging, порівняння перед reload) спільна.
    $done += $opt{proxy} ? certs_proxy_one($_, \%opt)
                         : certs_one($_, \%opt)
        for @want;
    $done or die_msg 'жодної групи не оброблено — див. попередження вище';
}

# Сертифікат ВЕБМЕЙЛУ: на WEBMAIL_FQDN, у том проксі, через --webroot.
#
# Чому окремо від certs_one, а не прапорцем усередині: у них різні
# майже всі складові — інше ім'я, інший метод перевірки, інший том,
# інший демон для reload. Спільним лишилось би тільки `docker run`.
sub certs_proxy_one {
    my ($g, $opt) = @_;
    my $c    = validate($g);
    my $fqdn = $c->{env}{WEBMAIL_FQDN}       // '';
    my $mail = $c->{env}{POSTMASTER_ADDRESS} // '';
    my $tag  = $c->{env}{IMAGE_TAG} // 'trixie';

    unless (length $fqdn) {
        say STDERR "mailctl: [$g] пропускаю — WEBMAIL_FQDN не заданий";
        return 0;
    }
    length $mail or die_msg "[$g] POSTMASTER_ADDRESS не заданий";

    # Група має бути підключена до проксі: інакше vhost не існує, і
    # виклик HTTP-01 нікуди не прийде.
    unless (-f "$fragments/$c->{name}.yml") {
        say STDERR "mailctl: [$g] пропускаю — група не підключена до ",
                   "проксі. ./mailctl proxy attach $g";
        return 0;
    }
    unless (container_running('proxy-nginx')) {
        say STDERR "mailctl: [$g] пропускаю — proxy-nginx не запущений. ",
                   "Саме він віддає /.well-known/acme-challenge/, тож без ",
                   "нього перевірка HTTP-01 не дійде. ./mailctl proxy up";
        return 0;
    }

    say "── $g (вебмейл): $fqdn ──";
    warn_stale_images($tag, 'certbot');

    # --webroot, а не --standalone: :80 на адресі проксі вже тримає
    # nginx, і відбирати його немає ні потреби, ні можливості — він сам
    # віддасть виклик із location /.well-known/acme-challenge/.
    # Каталог той самий, що змонтований у nginx як /var/www/acme:ro.
    my $webroot = "$proxy_dir/acme-webroot";
    -d $webroot or die_msg "немає $webroot — його віддає nginx за ",
                           "/.well-known/acme-challenge/";

    my @cb = ('certonly',
              '--non-interactive', '--agree-tos', '--email', $mail,
              '--cert-name', $fqdn, '-d', $fqdn,
              '--webroot', '-w', '/webroot');
    push @cb, $opt->{force} ? '--force-renewal' : '--keep-until-expiring';
    push @cb, '--staging' if $opt->{staging};
    push @cb, '--dry-run' if $opt->{'dry-run'};

    say '  метод: webroot (виклик віддає nginx)';

    run('docker', 'run', '--rm',
        '-v', "$webroot:/webroot",
        '-v', "$LE_VOLUME:/etc/letsencrypt",
        "mail/certbot:$tag", @cb)
        or die_msg "[$g] certbot не впорався. Найчастіші причини: ",
                   "A-запис $fqdn не вказує на proxy.bind із host.json; ",
                   "порт 80 не доходить ззовні; у vhost немає location ",
                   "/.well-known/acme-challenge/ з root /var/www/acme ",
                   "(перевірити $proxy_dir/nginx-config/conf.d/$c->{name}.conf)";

    if ($opt->{'dry-run'}) {
        say "  --dry-run: перевірка пройдена, файлів не чіпаю";
        return 1;
    }

    # ── Доставка в том проксі ─────────────────────────────────────────
    # Шлях ТУТ інший, ніж у груп: vhost посилається на
    # /etc/letsencrypt/live/<fqdn>/..., тобто зберігаємо структуру
    # certbot. Саме за цим шляхом лежить самопідписана заглушка, яку
    # поклав `proxy up`, — отже перезапис на місці, і vhost не
    # змінюється ні на рядок.
    my $sh = join "\n",
        'set -e',
        "src=/le/live/$fqdn",
        "dst=/out/live/$fqdn",
        '[ -s "$src/fullchain.pem" ] || { echo "немає $src/fullchain.pem" >&2; exit 1; }',
        'if cmp -s "$src/fullchain.pem" "$dst/fullchain.pem" 2>/dev/null; then',
        '    echo UNCHANGED; exit 0',
        'fi',
        'mkdir -p "$dst"',
        # -L: у live/ лежать симлінки в ../archive/, і в чужому томі
        # вони були б битими.
        'cp -L "$src/fullchain.pem" "$dst/.fullchain.new"',
        'cp -L "$src/privkey.pem"   "$dst/.privkey.new"',
        'chmod 644 "$dst/.fullchain.new"',
        # 600 root:root: nginx читає ключ майстром, до скидання привілеїв.
        'chmod 600 "$dst/.privkey.new"',
        'mv "$dst/.fullchain.new" "$dst/fullchain.pem"',
        'mv "$dst/.privkey.new"   "$dst/privkey.pem"',
        'echo CHANGED';

    my $res = capture('docker', 'run', '--rm', '--entrypoint', 'sh',
                      '-v', "$LE_VOLUME:/le:ro",
                      '-v', 'proxy_certs:/out',
                      "mail/certbot:$tag", '-c', $sh);
    defined $res or die_msg "[$g] не вдалось покласти сертифікат у том ",
                            "proxy_certs";

    if ($res =~ /UNCHANGED/) {
        say '  сертифікат не змінився — nginx не чіпаю';
        return 1;
    }

    say '  сертифікат оновлений, nginx перечитує';
    # proxy_refresh() робить саме те, що треба: nginx -t, і лише потім
    # reload. Без -t зламаний конфіг лишив би nginx на СТАРОМУ, тобто на
    # заглушці, і виглядало б це як «сертифікат не застосувався».
    proxy_refresh();
    return 1;
}

# ── health: чи справді все піднялось ─────────────────────────────────
#
# Навіщо окрема команда, коли є `ps` і `logs`: `docker ps` каже лише
# «контейнер біжить», а це не те саме, що «сервіс слухає». Контейнер із
# кількома процесами (spamassassin, clamav) може втратити один і
# лишитись «здоровим»; мілтер може не піднятись, і Postfix тоді
# пропускатиме пошту без перевірки — `milter_default_action = accept`
# робить це МОВЧКИ, і саме тому.
#
# Перевіряємо ЗВІДКИ ТРЕБА: порти мілтерів і БД пробуємо з контейнера
# postfix, бо саме він до них ходить, і саме його DNS та netns мають
# значення. Перевірка з хоста нічого не доказує — хост до internal
# групи взагалі не підключений.
#
# `ps` і mysql-клієнта в образах немає свідомо (slim), тож процеси
# читаємо з /proc, а порти пробуємо через /dev/tcp у bash.

# Процеси, яких у контейнері мусить бути БІЛЬШЕ НІЖ ОДИН. Шукаємо в
# cmdline, а не в comm: comm для perl-скрипта — "perl", бо це назва
# виконуваного файлу, а не те, що програма пише собі в argv[0].
my %expect_procs = (
    spamassassin => [ 'spamd', 'spamass-milter' ],
    clamav       => [ 'clamd', 'freshclam', 'clamav-milter' ],
);


# Цикл очікування — СПІЛЬНИЙ для `health <група>` і `health --all`.
# Друга копія цього блоку розійшлася б із першою мовчки: саме так уже
# сталось із циклом копіювання в карті isp, і правити довелось двічі.
sub health_wait_loop {
    my ($c, $pf, $wait) = @_;
    my $deadline = time + $wait;
    my ($ok, $young);
    while (1) {
        ($ok, $young) = health_once($c, $pf);
        last if $ok;
        last if time >= $deadline;
        say '';
        say sprintf '── не все готово; чекаю (лишилось ~%d с) ──',
                    $deadline - time;
        sleep 5;
        say '';
    }
    return ($ok, $young);
}


sub cmd_health {
    my ($g, @args) = @_;
    # --wait[=сек]: перечекати, поки все піднімається. Дефолт 0 —
    # одноразовий знімок.
    my $wait = 0;
    for my $a (@args) {
        if    ($a eq '--wait')            { $wait = 120 }
        elsif ($a =~ /^--wait=(\d{1,4})$/) { $wait = $1 }
        else { die_msg "health: невідомий ключ '$a'; є --wait[=сек] і --all" }
    }

    my $c  = validate($g);
    my $pf = "$c->{name}-postfix";

    my ($ok, $young) = health_wait_loop($c, $pf, $wait);

    # ┌───────────────────────────────────────────────────────────────┐
    # │ Молоді контейнери — найчастіша причина хибного «все погано».  │
    # │                                                               │
    # │ MariaDB на ПОРОЖНЬОМУ datadir спершу ініціалізується: системні │
    # │ таблиці плюс наші init-скрипти, це 30-60 с. До того 3306       │
    # │ закритий. А від БД залежать opendkim (читає список доменів) і  │
    # │ spamassassin (bayes), тобто один неготовий сервіс дає півтора  │
    # │ десятка рядків ЗБІЙ. Плюс ClamAV першим ділом тягне ~1 ГБ бази.│
    # │                                                               │
    # │ Тому про це треба сказати ЯВНО, а не лишати людину з картиною  │
    # │ «стало гірше, ніж було».                                      │
    # └───────────────────────────────────────────────────────────────┘
    # МЕЖА обов'язкова, і без неї підказка шкодить. На small вона
    # спрацювала при `$young = 3107` — тобто через 52 хвилини після
    # старту, — і сказала «найімовірніше просто ще не встигло» про
    # відсутній `postmaster@`, якого не було місяцями. Порада, що
    # вказує НЕ ТУДИ, гірша за відсутність поради: людина перезапускає
    # `--wait` замість читати, що саме зламалось.
    #
    # 300 с — із запасом утричі над найдовшим зі справжніх вікон, які
    # перелічені в коментарі нижче (MariaDB 30-60 с, ClamAV ~40 с плюс
    # ті, хто чекає на БД).
    my $STARTUP_WINDOW = 300;
    if (!$ok && defined $young && $young <= $STARTUP_WINDOW) {
        say '';
        say "УВАГА: наймолодший контейнер піднявся $young с тому, і частина";
        say 'збоїв вище — найімовірніше просто «ще не встигло». На порожньому';
        say 'томі MariaDB ініціалізується 30-60 с, ClamAV тягне базу ~40 с, а';
        say 'opendkim і spamassassin чекають БД.';
        say "Повторити з очікуванням: ./mailctl health $g --wait";
    }

    say '';
    say $ok ? "[$g] усе на місці" : "[$g] Є ЗБОЇ — див. рядки ЗБІЙ вище";
    exit($ok ? 0 : 1);
}

# `health --all` — обхід УСІХ груп репозиторію. Причина існування
# конкретна: 26.11.2026 сервер виключили при перенесенні
# обладнання, і після повернення postfix у isp і backup ліг у
# restart-loop. Дві групи з живою поштою стояли 20 ГОДИН, і
# дізнались ми зі скарг користувачів: `docker ps` виглядав
# здоровим — вісім контейнерів із дев’яти зелені.
#
# ТРИ стани, не два, і третій тут несучий:
#   `ok`         — група піднята й здорова;
#   `ЗБІЙ`       — піднята, але щось не працює; код виходу 1;
#   `не піднята` — контейнерів НЕМА. Це НЕ збій: групу могли
#                  свідомо погасити (так office стоїть до дня міграції).
#                  Але й не тиша — інакше «хост перезавантажился й
#                  нічого не піднялось» виглядало б як норма.
#
# Чому ДРАЙВЕР із підпроцесами, а не цикл усередині: `validate()`
# і `health_once()` при проблемі звуть `die_msg`, а вона робить
# `exit 1` — тобто `eval` її НЕ ловить, і одна група з кривим
# `group.env` обірвала б обхід решти. Підпроцес це ізолює й
# заодно гарантує, що `--all` перевіряє РІВНО те саме, що
# `health <група>`, а не власну копію перевірок.
sub cmd_health_all {
    my @args = grep { $_ ne '--all' } @_;
    for my $a (@args) {
        $a =~ /^--wait(?:=\d{1,4})?$/
            or die_msg "health --all: невідомий ключ '$a'; є лише --wait[=сек]";
    }

    my (@good, @bad, @down);
    for my $g (list_groups()) {
        my $f = "$groups_dir/$g/group.env";
        next unless -f $f;          # sample.domain.group тощо

        # Ім’я compose-проєкту беремо БЕЗ validate(): вона при проблемі
        # виходить із процесу, а тут потрібно лише дізнатись, чи є
        # контейнери взагалі.
        my $e    = eval { read_env($f) } || {};
        my $name = $e->{GROUP_NAME} // $g;
        my $ps   = capture_quiet('docker', 'ps', '-a',
                      '--filter', "label=com.docker.compose.project=$name",
                      '--format', '{{.Names}}');

        say '';
        say '=' x 68;
        say "==  $g";
        say '=' x 68;

        unless (defined $ps && length $ps) {
            say '';
            say "УВАГА  група не піднята — контейнерів немає, перевірки НЕ робимо.";
            say "       Якщо це не навмисно, її пошта ЛЕЖИТЬ: ./mailctl up $g";
            push @down, $g;
            next;
        }

        my $rc = system($^X, $0, 'health', $g, @args);
        if ($rc == 0) { push @good, $g } else { push @bad, $g }
    }

    say '';
    say '=' x 68;
    printf "здорові: %d%s
", scalar(@good),
           @good ? ' (' . join(', ', @good) . ')' : '';
    printf "ЗБОЇ:    %d%s
", scalar(@bad),
           @bad ? ' (' . join(', ', @bad) . ')' : '';
    printf "не підняті: %d%s
", scalar(@down),
           @down ? ' (' . join(', ', @down) . ')' : '';

    # Код виходу — лише від СПРАВЖНІХ збоїв. Погашена група не
    # робить його ненульовим свідомо: інакше ця команда в cron
    # шлала б листа щоночі, поки office чекає на міграцію, і її
    # вивід перестали б читати — той самий клас, що з позначкою
    # `opt` для ненастроєного postgrey.
    exit(@bad ? 1 : 0);
}

# Один знімок. Повертає (усе_ок, вік_наймолодшого_контейнера_в_секундах).
sub health_once {
    my ($c, $pf) = @_;
    my $ok = 1;
    my $young;

    # ── 1. Контейнери ─────────────────────────────────────────────────
    say '── контейнери ──';
    my $ps = capture_quiet('docker', 'ps', '-a',
                           '--filter', "label=com.docker.compose.project=$c->{name}",
                           '--format', '{{.Names}}\t{{.State}}\t{{.Status}}');
    defined $ps && length $ps
        or die_msg "контейнерів групи не видно — чи піднята вона? ",
                   "./mailctl up $c->{dir}";
    for my $line (split /\n/, $ps) {
        my ($name, $state, $status) = split /\t/, $line;
        next unless defined $name;
        my $mark = $state eq 'running' ? 'ok' : 'ЗБІЙ';
        $ok = 0 unless $state eq 'running';
        printf "  %-4s %-28s %s\n", $mark, $name, ($status // $state);
        # Вік беремо з самого Docker, а не з тексту статусу: там
        # локалізоване «Up 13 seconds», і розбирати його мовою системи —
        # заготовлена помилка.
        my $started = capture_quiet('docker', 'inspect', '-f',
                                    '{{.State.StartedAt}}', $name);
        next unless defined $started
                 && $started =~ /(\d{4}-\d\d-\d\d)T(\d\d:\d\d:\d\d)/;
        my $t = eval { Time::Piece->strptime("$1T$2", '%Y-%m-%dT%H:%M:%S')->epoch };
        next unless defined $t;
        my $age = time - $t;
        $young = $age if !defined $young || $age < $young;
    }

    # ── 2. Процеси там, де їх кілька ─────────────────────────────────
    say '';
    say '── процеси в багатопроцесних контейнерах ──';
    for my $svc (sort keys %expect_procs) {
        my $ctr = "$c->{name}-$svc";
        # cmdline, не comm: див. коментар біля %expect_procs.
        my $out = capture_quiet('docker', 'exec', $ctr, 'sh', '-c',
            'for f in /proc/[0-9]*/cmdline; do tr "\\0" " " < "$f" 2>/dev/null; echo; done');
        unless (defined $out) {
            say "  ЗБІЙ $svc — не можу прочитати /proc (контейнер не біжить?)";
            $ok = 0;
            next;
        }
        for my $want (@{ $expect_procs{$svc} }) {
            # Межі обов'язкові: голий підрядок `clamd` знаходиться і в
            # шляху /etc/clamav/clamd.conf, тобто давав би хибне `ok`
            # від чужого процесу, який просто згадує цей файл.
            my $found = $out =~ m{(?:^|/)\Q$want\E(?:\s|$)}m;
            $ok = 0 unless $found;
            printf "  %-4s %s: %s\n", ($found ? 'ok' : 'ЗБІЙ'), $svc, $want;
        }
    }

    # ── 3. Чи слухають порти — з контейнера POSTFIX ──────────────────
    say '';
    say "── досяжність із $pf ──";
    container_running($pf) or die_msg "контейнер $pf не запущений";
    # Один виклик на всі порти: bash із /dev/tcp, бо ні nc, ні ss в
    # образі немає (і ставити їх заради діагностики не варто —
    # `mailctl netns` і так дає інструменти ХОСТА в namespace групи).
    my $script = join '', map {
        my ($h, $port) = ($_->[0], $_->[1]);
        # Без `exec 3<&-` у кінці: `exec` БЕЗ команди перенаправив би
        # stderr САМОГО цього шелла в /dev/null назавжди (пастка в
        # PITFALLS, на якій уже спіймались в entrypoint-ах). Закривати
        # й нічого: fd 3 відкривається в ПІДШЕЛЛІ `( )`.
        "if (exec 3<>/dev/tcp/$h/$port) 2>/dev/null; then echo 'ok $h:$port'; "
      . "else echo 'FAIL $h:$port'; fi; "
    } effective_probes($c);

    my $res = capture_quiet('docker', 'exec', $pf, 'bash', '-c', $script) // '';
    my %got = map { /^(ok|FAIL) (\S+)/ ? ($2 => $1) : () } split /\n/, $res;
    for my $probe (effective_probes($c)) {
        my ($h, $port, $what, $flag) = @$probe;
        my $opt = ($flag // '') eq 'opt';
        my $st  = $got{"$h:$port"} // 'FAIL';
        $ok = 0 if $st eq 'FAIL' && !$opt;
        my $mark = $st eq 'ok' ? 'ok' : ($opt ? '--' : 'ЗБІЙ');
        printf "  %-4s %-22s %s\n", $mark, "$h:$port", $what;
    }

    # ── 4. Запас по sieve_max_redirects ──────────────────────────────
    # Навіщо окрема перевірка: перевищення ліміту не обрізає список
    # отримувачів, а ВАЛИТЬ скрипт цілком — лист не йде нікому, і в
    # користувача це виглядає як «пересилання просто зникло».
    #
    # Рахуємо з ЖИВИХ скриптів, а не з того, що колись згенерував
    # конвертор: користувач міг додати redirect своїм фільтром через
    # ManageSieve, і ліміт у Pigeonhole ГЛОБАЛЬНИЙ — один на всіх.
    #
    # Ліміт беремо з doveconf, а не з group.env: перший — те, що діє
    # зараз, другий — те, що діятиме після reload. Різниця між ними і є
    # найцікавіший випадок.
    #
    # Підрахунок за текстом скрипта — ВЕРХНЯ оцінка: Pigeonhole рахує
    # виконані redirect, тож `redirect` усередині if може й не
    # спрацювати. Для носіїв (де вони безумовні) оцінка точна, для
    # користувацьких фільтрів — песимістична, і це правильний бік
    # помилки.
    say '';
    say '── sieve: запас по redirect ──';
    my ($clear_eff, $ssl_eff);
    my $dc = "$c->{name}-dovecot";
    if (!container_running($dc)) {
        say '  --   контейнер dovecot не запущений, перевірити нічого';
    }
    else {
        my $sieve_sh = <<'SH';
lim=$(doveconf -h sieve_max_redirects 2>/dev/null)
echo "LIMIT|$lim"
echo "CLEAR|$(doveconf -h auth_allow_cleartext 2>/dev/null)"
echo "SSL|$(doveconf -h ssl 2>/dev/null)"
doveadm sieve list -A 2>/dev/null > /tmp/.hsieve || exit 0
while read -r u s a; do
    [ "$a" = ACTIVE ] || continue
    n=$(doveadm sieve get -u "$u" "$s" 2>/dev/null |
        grep -cE '^[[:space:]]*redirect([[:space:]]|$)')
    echo "S|$u|$s|$n"
done < /tmp/.hsieve
rm -f /tmp/.hsieve
SH
        my $out = capture_quiet('docker', 'exec', $dc, 'sh', '-c', $sieve_sh);
        if (!defined $out) {
            say '  ЗБІЙ — не вдалось опитати dovecot';
            $ok = 0;
        }
        else {
            # Ефективне (не те, що в group.env) значення дозволу на
            # пароль без TLS. Показуємо завжди: при `yes` рішення №14
            # для групи не діє, і це мусить бути видно в діагностиці, а
            # не лише в рядку group.env. Не ЗБІЙ — це вибір власника.
            ($clear_eff) = $out =~ /^CLEAR\|(\S*)$/m;
            ($ssl_eff)   = $out =~ /^SSL\|(\S*)$/m;
            my ($lim) = $out =~ /^LIMIT\|(\d+)$/m;
            if (!$lim) {
                say '  ЗБІЙ — doveconf не віддав sieve_max_redirects';
                $ok = 0;
            }
            else {
                say "  ліміт: $lim redirect на один скрипт";
                my $tight = 0;
                my @rows = grep { $_->[2] > 0 }
                           map  { [ (split /\|/, $_)[1, 2, 3] ] }
                           grep { /^S\|/ } split /\n/, $out;
                for my $r (sort { $b->[2] <=> $a->[2] } @rows) {
                    my ($u, $s, $n) = @$r;
                    my $mark = $n >  $lim ? 'ЗБІЙ'
                             : $n == $lim ? 'впритул'
                             :              'ok';
                    $ok    = 0 if $n >  $lim;
                    $tight = 1 if $n >= $lim;
                    # pad(), а не %-8s: маркери кирилицею, а printf
                    # рахує БАЙТИ — колонки поїхали б рівно там, де
                    # найцікавіше (ЗБІЙ і впритул).
                    say '  ', pad($mark, 8), ' ', pad($u, 32), ' ',
                        pad($s, 12), " $n/$lim";
                }
                say '  (скриптів з redirect немає)' unless @rows;
                if ($tight) {
                    say '';
                    say '  Підняти ліміт: SIEVE_MAX_REDIRECTS у group.env, далі';
                    say "  ./mailctl reload $c->{name} dovecot";
                    say '  Опускати його автоматично ми НЕ будемо: ліміт один на';
                    say '  всіх, тобто зачепило б і користувацькі фільтри.';
                }
            }
        }
    }

    # ── 4b. Пароль без TLS ───────────────────────────────────────────
    # Ефективне значення, не те, що в group.env. Показуємо ЗАВЖДИ: при
    # `yes` рішення №14 для групи не діє, і це має бути видно в
    # діагностиці, а не лише рядком у конфізі. Це не ЗБІЙ — вибір
    # власника (на isp точковий список неможливий), але вибір, про
    # який треба пам'ятати, дивлячись на будь-яку скаргу про паролі.
    say '';
    say '── автентифікація без TLS ──';
    if (!defined $clear_eff || $clear_eff eq '') {
        say '  --   не опитано (dovecot не відповів)';
    }
    elsif ($clear_eff eq 'yes') {
        say '  увага  ДОЗВОЛЕНО ГЛОБАЛЬНО (auth_allow_cleartext = yes):';
        say '         пароль можна надіслати без шифрування з будь-якої';
        say '         адреси. Рішення №14 для цієї групи не діє.';
    }
    else {
        say '  ok   заборонено глобально; точкові винятки — remote-блоки';
        say '       з CLEARTEXT_NETWORKS (у doveconf їх видно як remote {})';
    }

    # ssl показується ПОРУЧ, бо саме він вирішує, чи клієнт узагалі
    # може під'єднатись без TLS; auth_allow_cleartext лише про пароль.
    # Пара суперечлива (yes + required) Dovecot не стартує взагалі, тож
    # тут видно не збій, а те, ЯКИМ боком дозвіл реалізований.
    if (defined $ssl_eff && $ssl_eff ne '') {
        say $ssl_eff eq 'required'
            ? '  ok   ssl = required — без TLS з\'єднання не приймається'
            : "  увага  ssl = $ssl_eff — порти 110/143 приймають і без TLS";
    }

    # ── 4a. recipient_policy: мапа підключена? ───────────────────────
    # Перевірка існує тому, що тут два РІЗНІ режими збою, і вони
    # протилежні за ціною.
    #
    # Мапа не підключена (entrypoint її опитав і не отримав відповіді):
    # пошта ходить, блокування за доменом отримувача НЕ діє. На isp
    # це означає, що чорна діра на 297 доменів тихо вимкнена.
    #
    # Мапа підключена, але зараз не відповідає (таблицю знесли,
    # користувача позбавили прав): Postfix трактує збій мапи як збій
    # ПЕРЕВІРКИ і віддає 451 на КОЖЕН RCPT — тобто пошта групи не
    # приймається взагалі.
    #
    # Проба ключем БЕЗ `@` нічого не доказує: запит використовує `%d`,
    # і dict_mysql при нерозкритому `%d` запит не виконує, тихо
    # віддаючи «не знайдено» і на справній мапі, і на зламаній.
    say '';
    say '── recipient_policy (блокування за доменом отримувача) ──';
    my $pfc = "$c->{name}-postfix";
    if (!container_running($pfc)) {
        say '  --   контейнер postfix не запущений, перевірити нічого';
    }
    else {
        my $rp_sh = <<'SH';
echo "MACRO|$(postconf -h recipient_policy_check 2>/dev/null)"
e=$(postmap -q 'probe@rp-probe.invalid' \
      mysql:/etc/postfix/sql/recipient_policy.cf 2>&1 >/dev/null || true)
echo "ERR|$(echo "$e" | sed 's/^postmap: //' | sort -u | tr '\n' ' ')"
p=$(postmap -q 'probe@rp-probe.invalid' \
      proxy:mysql:/etc/postfix/sql/recipient_policy.cf 2>&1 >/dev/null || true)
echo "PERR|$(echo "$p" | sed 's/^postmap: //' | sort -u | tr '\n' ' ')"
SH
        my $out = capture_quiet('docker', 'exec', $pfc, 'sh', '-c', $rp_sh);
        if (!defined $out) {
            say '  ЗБІЙ — не вдалось опитати postfix';
            $ok = 0;
        }
        else {
            my ($macro) = $out =~ /^MACRO\|(.*)$/m;
            my ($err)   = $out =~ /^ERR\|(.*)$/m;
            my ($perr)  = $out =~ /^PERR\|(.*)$/m;
            $macro = '' unless defined $macro;
            for ($err, $perr) { $_ = '' unless defined $_; s/\s+$// }
            my $wired = $macro =~ /check_recipient_access/ ? 1 : 0;
            my $alive = $err eq '' ? 1 : 0;

            # Шлях ЧЕРЕЗ proxymap перевіряємо окремо, бо в нього свій
            # режим збою: `proxy_read_maps` — список дозволених
            # таблиць, і мапа, якої там немає, відкидається вже
            # всередині proxymap. Прямий `mysql:` цього не покаже, а в
            # main.cf стоїть саме `proxy:`.
            if ($wired && $alive && $perr ne '') {
                $ok = 0;
                say '  ЗБІЙ прямий mysql: відповідає, а через proxymap — ні.';
                say '       Це 451 на КОЖЕН RCPT: у main.cf стоїть proxy:.';
                say "       $perr";
                # ДВА різні режими збою під однією шапкою, і лікування в
                # них протилежне. Розрізняє їх текст: сокет proxymap
                # з'являється не в першу секунду після старту Postfix,
                # і поки його немає, помилка — файлова. Відмова самого
                # proxymap (мапи немає в proxy_read_maps) виглядає
                # інакше: він відповідає, але відхиляє таблицю.
                # Без цієї розвилки порада «перезбери образ» їхала б і
                # на звичайне вікно старту.
                if ($perr =~ /No such file or directory|Connection refused/) {
                    say '       Але це НЕ відмова proxymap: сокет іще не створений,';
                    say '       тобто Postfix щойно піднявся. Образ перезбирати НЕ';
                    say "       треба — повтори: ./mailctl health $c->{dir} --wait";
                }
                else {
                    say '       Найімовірніше мапи немає в proxy_read_maps —';
                    say '       entrypoint дописує її туди, тобто образ старий:';
                    say "         ./mailctl build && ./mailctl reload $c->{dir} postfix";
                }
            }
            elsif ($wired && $alive) {
                my $cnt = mysql_count("$c->{name}-mysql",
                    $c->{env}{MYSQL_ROOT_PASSWORD} // '',
                    "$groups_dir/$c->{dir}",
                    'SELECT COUNT(*) FROM recipient_policy',
                    $c->{env}{MYSQL_MAIL_DB} || 'mailserver');
                say '  ok   мапа підключена й відповідає (mysql: і proxy:)',
                    ($cnt >= 0 ? "; записів у таблиці: $cnt" : '');
            }
            elsif ($wired && !$alive) {
                $ok = 0;
                say '  ЗБІЙ мапа ПІДКЛЮЧЕНА, але не відповідає — це 451 на';
                say '       КОЖЕН RCPT, тобто пошта групи НЕ приймається.';
                say "       $err";
                say "       Негайно: ./mailctl reload $c->{dir} postfix";
                say '       (entrypoint сам від\'єднає мапу, і пошта піде';
                say '        без блокування — краще, ніж не приймати її).';
            }
            elsif (!$wired && $alive) {
                $ok = 0;
                say '  ЗБІЙ таблиця з\'явилась, а мапа не підключена —';
                say '       entrypoint опитував її до того, як вона стала';
                say "       доступна. Лікується: ./mailctl reload $c->{dir} postfix";
            }
            else {
                $ok = 0;
                say '  ЗБІЙ мапа не підключена — блокування за доменом';
                say '       отримувача НЕ діє (пошта при цьому ходить).';
                say "       $err" if $err ne '';
                say '       Застосувати схему до живої бази:';
                say "         ./mailctl db-load $c->{dir} _schemas/upgrade/add-recipient-policy.sql";
                say "         ./mailctl reload $c->{dir} postfix";
            }
        }
    }

    # ── 4b. relay_domains: резервний MX (рішення №39) ────────────────
    # Станів тут більше, ніж у recipient_policy, бо «мапа не
    # підключена» САМО ПО СОБІ не є збоєм: група, яка ні для кого не
    # резерв, саме так і виглядає (small сьогодні). Збій — це
    # РОЗБІЖНІСТЬ між таблицею й конфігом.
    #
    # Окремо звіряється `relay_verify_check`: relay_domains без нього —
    # генератор backscatter за побудовою (приймаємо для чужого домену,
    # отримуємо 550 від основного, складаємо баунс підробленому
    # відправнику). Entrypoint ставить обидва разом, тож розбіжність
    # означає старий образ.
    #
    # Ключ проби — ГОЛИЙ домен: запит на `%s`, і саме так його шукає
    # relay_domains. Тут `@` був би іншим ключем, тобто пробою не того.
    say '';
    say '── relay_domains (резервний MX) ──';
    if (!container_running($pfc)) {
        say '  --   контейнер postfix не запущений, перевірити нічого';
    }
    else {
        my $rd_sh = <<'SH';
echo "RD|$(postconf -h relay_domains 2>/dev/null)"
echo "VC|$(postconf -h relay_verify_check 2>/dev/null)"
e=$(postmap -q 'rd-probe.invalid' \
      mysql:/etc/postfix/sql/relay_domains.cf 2>&1 >/dev/null || true)
echo "ERR|$(echo "$e" | sed 's/^postmap: //' | sort -u | tr '\n' ' ')"
p=$(postmap -q 'rd-probe.invalid' \
      proxy:mysql:/etc/postfix/sql/relay_domains.cf 2>&1 >/dev/null || true)
echo "PERR|$(echo "$p" | sed 's/^postmap: //' | sort -u | tr '\n' ' ')"
SH
        my $out = capture_quiet('docker', 'exec', $pfc, 'sh', '-c', $rd_sh);
        if (!defined $out) {
            say '  ЗБІЙ — не вдалось опитати postfix';
            $ok = 0;
        }
        else {
            my %v;
            for my $k (qw(RD VC ERR PERR)) {
                ($v{$k}) = $out =~ /^$k\|(.*)$/m;
                $v{$k} = '' unless defined $v{$k};
                $v{$k} =~ s/\s+$//;
            }
            my $wired = $v{RD} =~ /mysql:/        ? 1 : 0;
            my $verif = $v{VC} =~ /check_recipient_access/ ? 1 : 0;
            my $alive = $v{ERR} eq ''             ? 1 : 0;
            my $cnt   = mysql_count("$c->{name}-mysql",
                $c->{env}{MYSQL_ROOT_PASSWORD} // '',
                "$groups_dir/$c->{dir}",
                "SELECT COUNT(*) FROM domains WHERE type='RELAY'",
                $c->{env}{MYSQL_MAIL_DB} || 'mailserver');

            if ($wired && $alive && $v{PERR} ne '') {
                $ok = 0;
                say '  ЗБІЙ прямий mysql: відповідає, а через proxymap — ні.';
                say '       relay_domains читає resolver на КОЖНОМУ отримувачі,';
                say '       тобто це 451 на ВСЮ пошту, не лише на релейну.';
                say "       $v{PERR}";
                if ($v{PERR} =~ /No such file or directory|Connection refused/) {
                    say '       Але сокет proxymap іще не створений — Postfix щойно';
                    say "       піднявся. Повтори: ./mailctl health $c->{dir} --wait";
                }
                else {
                    say "         ./mailctl build && ./mailctl reload $c->{dir} postfix";
                }
            }
            elsif ($wired && !$alive) {
                $ok = 0;
                say '  ЗБІЙ мапа ПІДКЛЮЧЕНА, але не відповідає. relay_domains';
                say '       читає resolver на кожному отримувачі, тобто пошта';
                say '       групи НЕ приймається взагалі.';
                say "       $v{ERR}";
                say "       Негайно: ./mailctl reload $c->{dir} postfix";
                say '       (entrypoint сам від\'єднає мапу — група перестане';
                say '        бути резервом, але власну пошту прийматиме).';
            }
            elsif ($wired && !$verif) {
                $ok = 0;
                say '  ЗБІЙ relay_domains підключений, а relay_verify_check —';
                say '       НІ. Це генератор backscatter: приймаємо для чужого';
                say '       домену, основний відповідає 550, баунс складаємо МИ';
                say '       і шлемо на (найчастіше підроблену) зворотну адресу.';
                say '       Entrypoint ставить обидва разом, отже образ старий:';
                say "         ./mailctl build && ./mailctl reload $c->{dir} postfix";
            }
            elsif ($wired) {
                say "  ok   мапа підключена, перевірка отримувача ввімкнена",
                    ($cnt >= 0 ? "; доменів у таблиці: $cnt" : '');
                if ($cnt == 0) {
                    say '       Таблиця ПОРОЖНЯ — фактично ні для кого не резерв.';
                }
                else {
                    say "       Домени: ./mailctl domain list $c->{dir}";
                    say '       ПЕРЕВІР ВРУЧНУ: у MX кожного з них мусить стояти';
                    say "       саме $c->{env}{MAIL_HOSTNAME}. Інакше або пошта";
                    say '       до нас не дійде, або (при чужому імені в MX) піде';
                    say '       по колу — Postfix себе в списку MX не впізнає.';
                }
            }
            elsif ($cnt > 0) {
                $ok = 0;
                say "  ЗБІЙ у таблиці $cnt доменів, а мапа НЕ підключена —";
                say '       на MX-запис, що вказує на нас, ми відповідаємо';
                say '       «Relay access denied». Тобто резервний MX мертвий,';
                say '       і відправник це бачить як відмову.';
                say "       $v{ERR}" if $v{ERR} ne '';
                say "       Лікується: ./mailctl reload $c->{dir} postfix";
            }
            else {
                say '  --   група не є резервним MX ні для кого (норма)';
            }
        }
    }

    # ── 4c. abuse_block: тимчасові блокування (рішення №20) ──────────
    # Станів тут ті самі чотири, що в recipient_policy, але один із них
    # означає інше: «мапи не підключені» — це ЗБІЙ, а не норма, бо
    # таблиця є частиною схеми й порожня таблиця нічого не блокує й так.
    # Тобто немає випадку, в якому група свідомо живе без цих мап.
    #
    # Окремо звіряється, що підключені ОБИДВІ: мапи читають ту саму
    # таблицю, тож «працює лише sender» означало б, що заражена машина
    # далі шле, а блокування за IP тихо не діє.
    say '';
    say '── abuse_block (тимчасові блокування) ──';
    if (!container_running($pfc)) {
        say '  --   контейнер postfix не запущений, перевірити нічого';
    }
    else {
        my $ab_sh = <<'SH';
echo "CL|$(postconf -h abuse_client_check 2>/dev/null)"
echo "SN|$(postconf -h abuse_sender_check 2>/dev/null)"
e=$(postmap -q '192.0.2.1' \
      mysql:/etc/postfix/sql/abuse_client.cf 2>&1 >/dev/null || true)
echo "ERR|$(echo "$e" | sed 's/^postmap: //' | sort -u | tr '\n' ' ')"
p=$(postmap -q '192.0.2.1' \
      proxy:mysql:/etc/postfix/sql/abuse_client.cf 2>&1 >/dev/null || true)
echo "PERR|$(echo "$p" | sed 's/^postmap: //' | sort -u | tr '\n' ' ')"
s=$(postmap -q 'probe@ab-probe.invalid' \
      proxy:mysql:/etc/postfix/sql/abuse_sender.cf 2>&1 >/dev/null || true)
echo "SERR|$(echo "$s" | sed 's/^postmap: //' | sort -u | tr '\n' ' ')"
SH
        my $out = capture_quiet('docker', 'exec', $pfc, 'sh', '-c', $ab_sh);
        if (!defined $out) {
            say '  ЗБІЙ — не вдалось опитати postfix';
            $ok = 0;
        }
        else {
            my %v;
            for my $k (qw(CL SN ERR PERR SERR)) {
                ($v{$k}) = $out =~ /^$k\|(.*)$/m;
                $v{$k} = '' unless defined $v{$k};
                $v{$k} =~ s/\s+$//;
            }
            my $wired = ($v{CL} =~ /check_client_access/
                      && $v{SN} =~ /check_sender_access/) ? 1 : 0;
            my $half  = (($v{CL} =~ /check_client_access/ ? 1 : 0)
                      != ($v{SN} =~ /check_sender_access/ ? 1 : 0)) ? 1 : 0;
            my $alive = $v{ERR} eq '' ? 1 : 0;

            if ($half) {
                $ok = 0;
                say '  ЗБІЙ підключена ЛИШЕ одна з двох мап:';
                say "       abuse_client_check = $v{CL}";
                say "       abuse_sender_check = $v{SN}";
                say '       Entrypoint ставить їх разом або не ставить зовсім,';
                say '       отже образ старіший за свій _images/postfix/:';
                say "         ./mailctl build && ./mailctl reload $c->{dir} postfix";
            }
            elsif ($wired && $alive && ($v{PERR} ne '' || $v{SERR} ne '')) {
                $ok = 0;
                say '  ЗБІЙ прямий mysql: відповідає, а через proxymap — ні.';
                say '       Це 451 на КОЖНУ сесію: у main.cf стоїть proxy:.';
                say "       $v{PERR}" if $v{PERR} ne '';
                say "       $v{SERR}" if $v{SERR} ne '' && $v{SERR} ne $v{PERR};
                if ("$v{PERR}$v{SERR}" =~ /No such file or directory|Connection refused/) {
                    say '       Але сокет proxymap іще не створений — Postfix щойно';
                    say "       піднявся. Повтори: ./mailctl health $c->{dir} --wait";
                }
                else {
                    say '       Найімовірніше мапи немає в proxy_read_maps:';
                    say "         ./mailctl build && ./mailctl reload $c->{dir} postfix";
                }
            }
            elsif ($wired && $alive) {
                # Рахуємо ЧИННІ, а не всі: прострочені лишаються в
                # таблиці свідомо, і «записів: 400» нічого не казало б
                # про те, чи когось заблоковано зараз.
                my $act = mysql_count("$c->{name}-mysql",
                    $c->{env}{MYSQL_ROOT_PASSWORD} // '',
                    "$groups_dir/$c->{dir}",
                    'SELECT COUNT(*) FROM abuse_block WHERE expires_at > NOW()',
                    $c->{env}{MYSQL_MAIL_DB} || 'mailserver');
                say '  ok   обидві мапи підключені й відповідають',
                    ($act >= 0 ? "; чинних блокувань: $act" : '');
                say "       Хто саме: ./mailctl block list $c->{dir}" if $act > 0;
            }
            elsif ($wired && !$alive) {
                $ok = 0;
                say '  ЗБІЙ мапи ПІДКЛЮЧЕНІ, але не відповідають — це 451';
                say '       на КОЖНУ сесію, тобто пошта групи НЕ приймається.';
                say "       $v{ERR}";
                say "       Негайно: ./mailctl reload $c->{dir} postfix";
                say '       (entrypoint сам від\'єднає мапи, і пошта піде без';
                say '        блокувань — краще, ніж не приймати її).';
            }
            elsif ($alive) {
                $ok = 0;
                say '  ЗБІЙ таблиця є, а мапи не підключені — entrypoint';
                say '       опитував їх до того, як вона стала доступна.';
                say "       Лікується: ./mailctl reload $c->{dir} postfix";
            }
            else {
                $ok = 0;
                say '  ЗБІЙ мапи не підключені — тимчасові блокування НЕ';
                say '       діють (пошта при цьому ходить). На групі з широким';
                say '       mynetworks це означає, що компенсації за цю широчінь';
                say '       зараз немає взагалі.';
                say "       $v{ERR}" if $v{ERR} ne '';
                say '       Застосувати схему до живої бази:';
                say "         ./mailctl db-load $c->{dir} _schemas/upgrade/add-abuse-block.sql";
                say "         ./mailctl reload $c->{dir} postfix";
            }
        }
    }

    # ── 4d. postmaster@ на кожному LOCAL-домені (RFC 5321) ───────────
    # Перевірка існує тому, що конфігом це НЕ вирішується, і саме через
    # це губиться. Postfix свої повідомлення шле на POSTMASTER_ADDRESS
    # явними адресами (`bounce_notice_recipient` і сусідні), тобто
    # всередині все сходиться — а зовнішній світ пише на
    # `postmaster@<домен>`, і для домену без такого рядка ми відповідаємо
    # 550 через неявну smtpd_reject_unlisted_recipient.
    #
    # Ціна не теоретична: саме на postmaster@ приходять скарги, звіти
    # DMARC (`rua=` сусіднього домену), запити на delisting із
    # блоклистів і попередження від великих приймачів. Жодне з них не
    # повториться.
    #
    # Рядок у `aliases` АБО справжня скринька — обидва варіанти
    # годяться, тож перевіряємо обидва. RELAY-домени не беремо: для них
    # ми не кінцева точка.
    say '';
    say '── postmaster@ на кожному домені (RFC 5321) ──';
    {
        my $miss = mysql_rows("$c->{name}-mysql",
            $c->{env}{MYSQL_ROOT_PASSWORD} // '',
            "$groups_dir/$c->{dir}",
            "SELECT d.domain FROM domains d WHERE d.type = 'LOCAL'"
          . " AND NOT EXISTS (SELECT 1 FROM aliases a WHERE a.domain = d.domain"
          . " AND a.local_part = 'postmaster')"
          . " AND NOT EXISTS (SELECT 1 FROM users u WHERE u.domain = d.domain"
          . " AND u.user = 'postmaster') ORDER BY d.domain",
            $c->{env}{MYSQL_MAIL_DB} || 'mailserver');
        if (!defined $miss) {
            say '  --   не вдалось опитати базу (група піднята?)';
        }
        elsif (!@$miss) {
            say '  ok   усі LOCAL-домени мають postmaster@';
        }
        else {
            $ok = 0;
            say '  ЗБІЙ немає postmaster@ у ', scalar @$miss, ' домен(ах):';
            say "         $_" for @$miss;
            say '       Для цих доменів ми відповідаємо 550 на postmaster@,';
            say '       тобто скарги, звіти DMARC і delisting із блоклистів';
            say '       до нас не доходять — і повторно їх ніхто не надішле.';
            my $pm = $c->{env}{POSTMASTER_ADDRESS} // 'postmaster@<домен>';
            say '       Лікується одною командою на домен:';
            say "         ./mailctl alias add $c->{dir} postmaster\@$_ $pm"
                for @$miss;
        }
    }

    # ── 5. База стану SpamAssassin ───────────────────────────────────
    # Пароль подаємо через STDIN у defaults-file, а не аргументом:
    # інакше він видний у `ps` на ХОСТІ (docker exec ... -pПАРОЛЬ).
    # Той самий прийом, що в entrypoint opendkim.
    say '';
    say '── база стану SpamAssassin ──';
    my $sa_db   = $c->{env}{SA_DB}      // 'spamassassin';
    my $sa_user = $c->{env}{SA_DB_USER} // 'spamd';
    my $root_pw = $c->{env}{MYSQL_ROOT_PASSWORD} // '';
    # Третій запит — ПРО ДОНАВЧАННЯ (рішення №34), і він тут головний.
    # «7 таблиць» означає лише, що схема застосувалась; воно нічого не
    # каже про те, чи навчання хоч раз дійшло до бази. А дійти воно
    # може не дійти тихо: `milter_default_action` до цього шляху не
    # стосується, зате між Dovecot і spamd стоїть і sieve, і pipe, і
    # ACL spamd — чотири місця, де збій не видно нікому.
    #
    # bayes_vars — саме та таблиця, де SpamAssassin тримає підсумок на
    # користувача: скільки спаму й ham він вивчив. Порожня таблиця
    # після перекладання листа в .Junk = донавчання не працює.
    # LEFT JOIN не потрібен: якщо рядків немає, вивід буде порожнім, і
    # це сама відповідь.
    my $sql = "SELECT COUNT(*) AS tables_in_$sa_db FROM information_schema.tables "
            . "WHERE table_schema='$sa_db'; "
            . "SELECT user, host FROM mysql.user WHERE user='$sa_user'; "
            . "SELECT username, spam_count, ham_count, token_count "
            . "FROM $sa_db.bayes_vars ORDER BY username;";
    my $sh = 'umask 077; cat > /tmp/.hc.cnf; '
           . 'cl=$(command -v mariadb || command -v mysql) || '
           . '{ echo "немає клієнта БД в образі" >&2; exit 1; }; '
           . "\$cl --defaults-extra-file=/tmp/.hc.cnf -t -e \"$sql\"; "
           . 'rc=$?; rm -f /tmp/.hc.cnf; exit $rc';

    run_with_stdin("[client]\nuser=root\npassword=$root_pw\n",
                   'docker', 'exec', '-i', "$c->{name}-mysql",
                   'sh', '-c', $sh)
        or do { say '  ЗБІЙ — не вдалось опитати базу'; $ok = 0 };
    # Текст УМОВНИЙ за формулюванням, а не за кодом: вивід запиту йде
    # прямо в наш stdout (run_with_stdin), тож ми не знаємо, чи були
    # рядки. Перша версія цього рядка стверджувала «порожня» і
    # друкувалась під НЕпорожньою таблицею — безглуздо.
    say '  (якщо рядків вище немає — донавчання ще нічого не записало,';
    say '   і це не збій, поки ніхто не перекладав листів у .Junk)';

    # ── 6. Чи дивиться світ на цю групу ────────────────────
    # Розділ існує через 23.11.2026: група office простояла піднятою
    # після фази 1 півтора доби, і за цей час прийняла 208 листів, яких
    # адресати не побачили: клієнти сидять на ДЖЕРЕЛІ, а сусідня група
    # доставляла сюди (тоді — через hostname у вбудованому DNS; див.
    # NB у шаблоні). Конкретну діру закрито, але САМ СТАН — група
    # приймає пошту для доменів, чиї MX ще дивляться не на неї — лишився,
    # і достатньо ОДНОГО резолвера, що вкаже сюди, щоб він повторився.
    #
    # Це УВАГА, а НЕ ЗБІЙ, і $ok тут не збивається свідомо: між фазою 1 і
    # фазою 3 це НОРМАЛЬНИЙ стан міграції, а `health --wait` крутився б
    # до таймауту і навчив би ігнорувати весь вивід.
    #
    # Відповідь береться резолвером ХОСТА, тож рядок у /etc/hosts на ньому
    # на цей розділ впливає — і такий рядок у нас передбачений планом
    # системної пошти (mail.<домен> -> internal-адреса). Тому при розході
    # кажемо, ЗВІДКИ відповідь, а не просто «світ бачить так».
    say '';
    say '── A-запис імені вузла ──';
    my $hfqdn = $c->{env}{MAIL_HOSTNAME} // '';
    my $hown  = $c->{public_ip}          // '';
    my $hres  = capture_quiet('getent', 'ahostsv4', $hfqdn);
    my %haddr;
    if (defined $hres) { $haddr{$1} = 1 while $hres =~ /^(\d+\.\d+\.\d+\.\d+)\b/mg }
    my $hlist = join ', ', sort keys %haddr;
    if (!%haddr) {
        printf "  %-5s %s не резолвиться резолвером хоста\n", 'УВАГА', $hfqdn;
        say '        За цим іменем ходять клієнти й за ним звіряється CN';
        say '        сертифіката, тож без A-запису група непрацездатна знадвору.';
    } elsif ($haddr{$hown}) {
        printf "  ok    %s -> %s (адреса цієї групи)\n", $hfqdn, $hlist;
    } else {
        printf "  %-5s %s -> %s, а група живе на %s\n",
               'УВАГА', $hfqdn, $hlist, $hown;
        say '        Група ПІДНЯТА й ПРИЙМАЄ пошту для своїх доменів, але світ';
        say '        слатиме їх пошту ЗА ЦИМ A-записом, тобто на старий сервер.';
        say '        Допоки це так: лист, який все ж дійшов сюди, ляже в скриньку,';
        say '        якої ніхто не читає, і буде зтертий при наступному копіюванні';
        say '        пошти з джерела. Це НОРМАЛЬНИЙ стан між фазою 1 і фазою 3';
        say '        міграції — але саме в ньому 23.11.2026 застрягло 208 листів office.';
        say "        Перевіряти: docker exec <сусід>-postfix getent hosts $hfqdn";
    }

    return ($ok, $young);
}

# Запустити команду, подавши дані на STDIN. Вивід іде ПРЯМО в наш
# stdout/stderr — дитина успадковує дескриптори.
#
# Навіщо взагалі: щоб секрет не потрапив у аргументи. Аргументи видні в
# `ps` будь-кому на хості, тобто `docker exec ... -pПАРОЛЬ` світить
# пароль усій машині. STDIN — ні.
#
# Чому вивід НЕ збираємо в змінну: перша версія робила саме так, через
# другий пайп, і це дедлок за побудовою — дитина наповнює пайп виводу,
# а батько ще не дочитав, бо чекає, поки допише вхід. На 20 тисячах
# рядків воно й справді зависло. Другий пайп тут не потрібен: усе, що
# команда друкує, ми однаково показуємо людині.
#
# Повертає 1 при нульовому коді виходу, інакше 0.
sub run_with_stdin {
    my ($input, @cmd) = @_;
    my $pid = open(my $in, '|-');
    return 0 unless defined $pid;
    unless ($pid) {                      # дитина
        exec { $cmd[0] } @cmd;
        exit 127;
    }
    print $in $input;
    # close на пайпі чекає дитину й виставляє $?.
    close $in;
    return $? == 0 ? 1 : 0;
}

sub cmd_net {
    my ($sub, @rest) = @_;
    $sub //= 'status';
    my $nets = host_nets();
    %$nets or die_msg "у $host_json немає жодної мережі";

    # Можна назвати одну мітку: `mailctl net up office`
    my @keys = @rest ? @rest : sort keys %$nets;
    for my $k (@keys) {
        $nets->{$k} or die_msg "мережі '$k' немає в $host_json; є: ",
                               join(' ', sort keys %$nets);
    }

    if    ($sub eq 'up')   { net_create($_, $nets->{$_}) for @keys }
    elsif ($sub eq 'down') {
        my $busy = 0;
        for my $k (@keys) {
            my $name = docker_net_name($k);
            net_exists($name) or do { say "мережі '$name' немає"; next };
            # Docker відмовляє, якщо в мережі лишились endpoint-и, і його
            # текст доводиться читати впоперек. Питаємо САМІ й називаємо
            # винних: саме так виглядає типова помилка — одна група не
            # погасилась, і `net down` падає на ПЕРШІЙ же мережі, не
            # дійшовши до решти.
            my $who = capture_quiet('docker', 'network', 'inspect',
                '-f', '{{range .Containers}}{{.Name}} {{end}}', $name);
            $who = defined $who ? join(' ', split ' ', $who) : '';
            if (length $who) {
                say STDERR "мережу '$name' тримають: $who";
                say STDERR "  спершу погасіть їхні групи: ./mailctl down <група>";
                $busy++;
                next;
            }
            run_or_die('docker', 'network', 'rm', $name);
        }
        # Ненульовий код, але ЛИШЕ після обходу всіх мереж: решта тим
        # часом погашена, і повторний запуск доробить залишок.
        exit 1 if $busy;
    }
    elsif ($sub eq 'status') {
        for my $k (@keys) {
            my $name = docker_net_name($k);
            unless (net_exists($name)) {
                say "[$k] мережі '$name' немає — підніми: ./mailctl net up $k";
                next;
            }
            # docker inspect --format і сам додає \n, тож свій не ставимо:
            # інакше між заголовком мережі й списком контейнерів вилазить
            # порожній рядок.
            my $head = capture('docker', 'network', 'inspect', $name, '--format',
                "[$k] {{.Name}}: {{.Driver}}"
              . ' {{with index .Options "ipvlan_mode"}}{{.}} {{end}}'
              . '{{with index .Options "ipvlan_flag"}}{{.}} {{end}}'
              . '{{with index .Options "macvlan_mode"}}{{.}} {{end}}'
              . 'parent={{index .Options "parent"}}'
              . ' {{range .IPAM.Config}}{{.Subnet}} gw={{.Gateway}}{{end}}') // '';
            my $who = capture('docker', 'network', 'inspect', $name, '--format',
                '{{range .Containers}}    {{.Name}} {{.IPv4Address}}' . "\n" . '{{end}}') // '';
            $head =~ s/\s+\z//; $who =~ s/\s+\z//;
            say $head;
            say length($who) ? $who : '    (нікого)';
        }
    }
    else { die_msg "невідома підкоманда net: $sub (up|down|status [мітка...])" }
}

# ── діагностика мережі групи ──────────────────────────────────────────
# В образах немає ні `ip`, ні `ss` (debian:trixie-slim), тому дивимось
# їхніми ж хостовими бінарниками, але в namespace контейнера. Postfix —
# власник netns групи, тож те саме видно й за Dovecot.
sub nsenter_run {
    my ($pid, @cmd) = @_;
    my @pre = $< == 0 ? () : ('sudo');
    return run(@pre, 'nsenter', '-t', $pid, '-n', @cmd);
}

sub cmd_netns {
    my ($g, @cmd) = @_;
    my $c   = validate($g);
    my $ctr = "$c->{name}-postfix";
    my $pid = capture_quiet('docker', 'inspect', '-f', '{{.State.Pid}}', $ctr);
    $pid = defined $pid ? ($pid =~ /(\d+)/ ? $1 : 0) : 0;
    $pid or die_msg "контейнер $ctr не запущений — спершу ./mailctl up $g";

    if (@cmd) { nsenter_run($pid, @cmd); return }

    say "── $ctr (з ним у цьому ж namespace і dovecot) ──";
    say 'адреси:';   nsenter_run($pid, 'ip', '-brief', 'addr');
    say 'маршрути:'; nsenter_run($pid, 'ip', 'route');
    say 'слухають:'; nsenter_run($pid, 'ss', '-lntu') or say '  (ss на хості немає)';
}

# ── схема БД у групу ──────────────────────────────────────────────────
sub cmd_db_schema {
    my ($g, @args) = @_;
    my %opt;
    for my $a (@args) {
        $a eq '--apply' ? ($opt{apply} = 1)
                        : die_msg "db-schema: невідомий ключ '$a'; є --apply";
    }
    my $e = read_env(group_env_path($g));
    # Схеми не однакові між групами: частина прод-серверів на PostgreSQL
    # (рішення №36: СУБД у НОВОМУ стеку одна — MariaDB; PostgreSQL на
    # джерелах лишається фактом, із яким працює конвертор міграції)
    # з іншою структурою. Варіант обирається в group.env.
    my $schema = $e->{DB_SCHEMA} || 'mysql-mail';
    my $src    = "$root/_schemas/$schema";
    unless (-d $src) {
        opendir my $dh, "$root/_schemas";
        my @have = sort grep { !/^\.\.?$/ && -d "$root/_schemas/$_" } readdir $dh;
        closedir $dh;
        die_msg "немає схеми '$schema'; є: ", join(' ', @have);
    }
    my $dst = "$groups_dir/$g/mysql-init";
    make_path($dst);
    opendir my $dh, $src or die_msg "не можу прочитати $src: $!";
    my @sql = sort grep { /\.sql$/ } readdir $dh;
    closedir $dh;
    @sql or die_msg "у схемі '$schema' немає жодного *.sql";
    require File::Copy;
    File::Copy::copy("$src/$_", "$dst/$_")
        or die_msg "не можу скопіювати $_: $!" for @sql;
    say "покладено схему '$schema' у $dst/";

    sa_schema($g, $e, $dst);
    rc_schema($g, $e, $dst);

    if ($opt{apply}) { sa_apply($g, $e, $dst); rc_apply($g, $e, $dst); return }

    print <<"TXT";

Виконається при ПЕРШОМУ старті контейнера MySQL (порожній datadir).
Якщо група вже піднімалась — знести том:
  ./mailctl down $g --volumes
Дані (дамп з прода) класти туди ж окремим файлом 02-*.sql —
вони під .gitignore і в репозиторій не потраплять.
TXT
}

# Доступ Roundcube до баз групи: ТРИ користувачі замість одного.
#
# Схему своєї бази Roundcube створює САМ — образ виконує
# `bin/initdb.sh --dir=$PWD/SQL --update` при старті (звірено з
# docker-entrypoint.sh у образі). Тому тут немає жодного CREATE TABLE:
# нам треба лише база, користувачі й права. Звідси ж вимога GRANT:
# користувачеві потрібні CREATE/ALTER, а не лише CRUD.
#
# Чому троє, а не один. Раніше шаблон давав Roundcube поштового
# користувача БД, тобто доступ до `usersdb` — до ХЕШІВ ПАРОЛІВ усіх
# користувачів групи. Рішення №33 уже відмовило в цьому SpamAssassin;
# Roundcube гірший за нього, бо він єдиний сервіс стеку, кого видно
# назовні через проксі.
#
# Пароль у всіх трьох ОДИН, і це не недогляд: усі три DSN лежать в
# одному конфізі Roundcube, тож хто прочитав конфіг — має всі три.
# Сенс розділення не в паролях, а в ПРАВАХ.
sub rc_schema {
    my ($g, $e, $dst) = @_;

    my $db      = $e->{ROUNDCUBE_DB}          // 'roundcubemail';
    my $maildb  = $e->{MYSQL_MAIL_DB}         // 'mailserver';
    my $sadb    = $e->{SA_DB}                 // 'spamassassin';
    my $user    = $e->{ROUNDCUBE_DB_USER}     // 'roundcube';
    my $puser   = $e->{ROUNDCUBE_PASSWD_USER} // 'rcpasswd';
    my $fuser   = $e->{ROUNDCUBE_PREFS_USER}  // 'rcprefs';
    my $pass    = $e->{ROUNDCUBE_DB_PASSWORD} // '';
    my $pre     = $e->{INTERNAL_PREFIX}       // '';

    length $pass or die_msg "[$g] ROUNDCUBE_DB_PASSWORD не заданий — ",
                            "без нього вебмейл не дістанеться до своєї бази";
    # Та сама перевірка, що для SA_DB_PASSWORD, і з тієї ж причини:
    # значення їде в SQL-літерал, а екранування тут було б тихою пасткою.
    $pass !~ /['\\\n]/
        or die_msg "[$g] ROUNDCUBE_DB_PASSWORD містить лапку, зворотний ",
                   "слеш або перенос рядка — такий пароль не покласти в ",
                   "SQL-літерал без екранування";

    my $out = "$dst/60-roundcube.sql";
    open my $fh, '>', $out or die_msg "не можу записати $out: $!";
    # 0644 з тієї ж причини, що й 50-spamassassin.sql: init-скрипти
    # виконує контейнер MariaDB від uid 999, а файл належить власнику.
    # Детальне обґрунтування — там же.
    chmod 0644, $out;
    print $fh <<"SQL";
-- ─────────────────────────────────────────────────────────────
--  ЗГЕНЕРОВАНО `mailctl db-schema $g`. Правити немає сенсу:
--  перезапишеться наступним викликом.
--
--  ТАБЛИЦЬ ТУТ НЕМА СВІДОМО. Схему своєї бази Roundcube створює
--  сам: офіційний образ виконує `bin/initdb.sh --update` при
--  старті. Отже вона за побудовою відповідає версії образу, а не
--  нашій пам'яті про неї — той самий принцип, що в рішенні №33.
--
--  УВАГА: файл містить пароль. Права 0644 (інакше його не
--  прочитає контейнер MariaDB), під .gitignore — як і group.env.
-- ─────────────────────────────────────────────────────────────

-- ── 1. Своя база вебмейлу: сесії, контакти, налаштування ──
CREATE DATABASE IF NOT EXISTS `$db`
    CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci;

-- Доступ лише з internal-мережі ЦІЄЇ групи, не з '%' (рішення №4).
-- CREATE + ALTER, а не лише CREATE: `IF NOT EXISTS` пароля НЕ оновлює,
-- тож після зміни ROUNDCUBE_DB_PASSWORD файл давав би тихо старий.
CREATE USER IF NOT EXISTS '$user'\@'$pre.%' IDENTIFIED BY '$pass';
ALTER  USER '$user'\@'$pre.%' IDENTIFIED BY '$pass';
-- ALL, а не CRUD: initdb.sh мусить мати CREATE/ALTER/INDEX. Але ТІЛЬКИ
-- на свою базу — до поштової цей користувач не має доступу взагалі.
GRANT ALL PRIVILEGES ON `$db`.* TO '$user'\@'$pre.%';

-- ── 2. Зміна власного пароля (плагін password) ──
-- Тут уся суть розділення. MySQL вимагає SELECT на стовпці, які
-- згадані у WHERE, тому без `user` і `domain` UPDATE не виконався б.
-- А SELECT на `passwd` НЕ видається — отже вебмейл може ЗМІНИТИ хеш і
-- не може його ПРОЧИТАТИ.
-- `login` доданий тому, що ключів для пошуку користувача два
-- (рішення №15): без нього на isp і office не працювали б ні зміна
-- пароля, ні плагін mailstack_identity, бо короткий логін не
-- збігається з CONCAT(user,'\@',domain) у 240 випадках із 312. Запит у config.inc.php ріже адресу через
-- CONCAT(user,'\@',domain), тобто читає рівно ці два стовпці: права й
-- запит збігаються за побудовою.
CREATE USER IF NOT EXISTS '$puser'\@'$pre.%' IDENTIFIED BY '$pass';
ALTER  USER '$puser'\@'$pre.%' IDENTIFIED BY '$pass';
GRANT SELECT (`user`, `domain`, `login`), UPDATE (`passwd`)
   ON `$maildb`.`users` TO '$puser'\@'$pre.%';

-- ── 3. Власні правила SpamAssassin (плагін sauserprefs) ──
-- Користувач створюється НАПЕРЕД, хоч плагіна ще немає в образі
-- (він не вбудований, потрібен composer — TODO п.6). Причина
-- практична: mysql-init виконується лише при ПЕРШОМУ старті БД, тож
-- додати користувача пізніше означало б ручну операцію на живій базі
-- або `db-schema --apply`. Створити наперед — безкоштовно: без
-- плагіна до нього ніхто не підключається.
-- Рівно одна таблиця: до bayes_* і до поштових даних доступу немає.
CREATE USER IF NOT EXISTS '$fuser'\@'$pre.%' IDENTIFIED BY '$pass';
ALTER  USER '$fuser'\@'$pre.%' IDENTIFIED BY '$pass';
GRANT SELECT, INSERT, UPDATE, DELETE
   ON `$sadb`.`userpref` TO '$fuser'\@'$pre.%';
SQL
    close $fh;
    say "покладено доступи Roundcube у $out (база '$db'; користувачі ",
        "'$user', '$puser', '$fuser'\@'$pre.%')";
}

# Схема стану SpamAssassin: bayes, AWL, userpref (рішення №33).
#
# Пакетні SQL-файли дістаємо З ОБРАЗУ, а не тримаємо свою копію в
# _schemas/. Причина: так схема за побудовою відповідає ВСТАНОВЛЕНІЙ
# версії SpamAssassin, а не нашій пам'яті про те, якою вона була. Той
# самий принцип, що зі списком доменів для DKIM — брати з джерела,
# яке не може розійтись із реальністю.
#
# Окрема база з окремим користувачем, а не таблиці поруч із поштовими:
# інакше контейнер SpamAssassin отримав би доступ до `usersdb`, тобто
# до хешів паролів усіх користувачів групи.
sub sa_schema {
    my ($g, $e, $dst) = @_;

    my $db   = $e->{SA_DB}          // 'spamassassin';
    my $user = $e->{SA_DB_USER}     // 'spamd';
    my $pass = $e->{SA_DB_PASSWORD} // '';
    my $pre  = $e->{INTERNAL_PREFIX} // '';
    length $pass or die_msg "[$g] SA_DB_PASSWORD не заданий — без нього ",
                            "SpamAssassin не дістанеться до свого стану";
    # Лапки в паролі зламали б SQL. Перевіряємо тут, а не в validate(),
    # бо саме тут значення потрапляє в SQL-літерал.
    $pass !~ /['\\\n]/
        or die_msg "[$g] SA_DB_PASSWORD містить лапку, зворотний слеш або ",
                   "перенос рядка — такий пароль не покласти в SQL-літерал ",
                   "без екранування, а екранування тут було б тихою пасткою";

    my $tag = $e->{IMAGE_TAG} // 'trixie';

    # Шукаємо файли, а не вписуємо шлях: у Debian доки подекуди
    # стиснуті, а місце між версіями пакета змінювалось. `zcat -f`
    # працює і зі стиснутим, і зі звичайним файлом.
    #
    # Шукаємо по всьому /usr, а не лише в /usr/share/doc: перший варіант
    # цього коду припускав doc/spamassassin/sql/ і не знайшов нічого.
    # При невдачі ДРУКУЄМО діагностику — де шукали й що там узагалі є,
    # щоб відповідь прийшла з першого запуску, а не з другого.
    my $sh = <<'FIND';
set -e
miss=
for n in bayes_mysql awl_mysql userpref_mysql; do
    f=$(find /usr -type f \( -name "$n.sql" -o -name "$n.sql.gz" \) 2>/dev/null | head -1)
    if [ -z "$f" ]; then miss="$miss $n"; continue; fi
    echo "-- >>> $n (з $f)"
    zcat -f "$f"
done
if [ -n "$miss" ]; then
    {
        echo "NOTFOUND:$miss"
        echo "-- що є схожого на SQL-схеми в образі:"
        find /usr -type f \( -name "*.sql" -o -name "*.sql.gz" \) 2>/dev/null | head -40
        echo "-- вміст каталогу документації spamassassin:"
        find /usr/share/doc/spamassassin -maxdepth 2 2>/dev/null | head -40
        echo "-- файли пакета, що містять 'sql' у назві:"
        dpkg -L spamassassin 2>/dev/null | grep -i sql | head -40
    } >&2
    exit 1
fi
FIND

    my $sql = capture('docker', 'run', '--rm', '--entrypoint', 'sh',
                      "mail/spamassassin:$tag", '-c', $sh);
    defined $sql && length $sql
        or die_msg "не вдалось дістати схему SpamAssassin з образу ",
                   "mail/spamassassin:$tag. Діагностика — вище: там видно, ",
                   "які SQL-файли в образі взагалі є. Якщо пакет їх не ",
                   "містить, схему доведеться покласти в _schemas/ самим";

    my $out = "$dst/50-spamassassin.sql";
    open my $fh, '>', $out or die_msg "не можу записати $out: $!";
    # ┌───────────────────────────────────────────────────────────────┐
    # │ 0644, і це НЕ недогляд — 0600 тут ЛАМАЄ все, причому тихо.    │
    # │                                                               │
    # │ Файл виконує НЕ ми, а docker-entrypoint контейнера MariaDB, і │
    # │ читає його від користувача `mysql` (uid 999 у образі). Файл    │
    # │ належить тому, хто запустив mailctl (зазвичай uid 1000), тож   │
    # │ при 0600 контейнер його просто не прочитає. Наслідок, який ми  │
    # │ вже отримали: 01-schema.sql (0644 від копіювання) виконався, а │
    # │ цей — ні. Бази з таблицями немає, користувача spamd немає,     │
    # │ spamd із --sql-config не стартує, мілтер не слухає — три рядки │
    # │ ЗБІЙ у `health` від одного chmod.                             │
    # │                                                               │
    # │ Чи це розкриває пароль: ні, не більше, ніж уже розкрито. Той   │
    # │ самий пароль лежить у group.env поруч, обидва під .gitignore,  │
    # │ обидва в домашньому каталозі власника. Хто дістався до одного, │
    # │ дістався й до другого.                                        │
    # │                                                               │
    # │ Якщо колись знадобиться строгіше — шлях інший: не init-файл, а │
    # │ окремий крок після старту БД, щоб пароль не лягав на диск      │
    # │ узагалі. Це помітно складніше (клієнт, очікування готовності), │
    # │ і зараз не виправдано.                                        │
    # └───────────────────────────────────────────────────────────────┘
    chmod 0644, $out;
    print $fh <<"HDR";
-- ─────────────────────────────────────────────────────────────
--  ЗГЕНЕРОВАНО `mailctl db-schema $g`. Правити немає сенсу:
--  перезапишеться наступним викликом.
--
--  Стан SpamAssassin — bayes, AWL, userpref — в ОКРЕМІЙ базі з
--  ОКРЕМИМ користувачем (рішення №33). Не серед поштових таблиць:
--  інакше контейнер SpamAssassin мав би доступ до `usersdb`, тобто
--  до хешів паролів усіх користувачів групи.
--
--  Структура таблиць узята З ОБРАЗУ mail/spamassassin:$tag, тобто
--  з пакета, а не написана нами. Отже вона відповідає встановленій
--  версії SpamAssassin за побудовою.
--
--  УВАГА: цей файл містить пароль. Права 0600, під .gitignore.
-- ─────────────────────────────────────────────────────────────

CREATE DATABASE IF NOT EXISTS `$db`
    CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci;

-- Доступ лише з internal-мережі ЦІЄЇ групи, а не з '%': ізоляція
-- груп (рішення №4) не має залежати від того, що чужий контейнер
-- "все одно не дістанеться".
CREATE USER IF NOT EXISTS '$user'\@'$pre.%' IDENTIFIED BY '$pass';
GRANT SELECT, INSERT, UPDATE, DELETE ON `$db`.* TO '$user'\@'$pre.%';

USE `$db`;

HDR
    print $fh $sql;
    close $fh;
    say "покладено схему стану SpamAssassin у $out (база '$db', ",
        "користувач '$user'\@'$pre.%')";
    say "   УВАГА: файл містить пароль і має права 0644 — інакше його не ",
        "прочитає";
    say "   контейнер MariaDB, який ці скрипти й виконує. Він під ",
        ".gitignore, як і group.env";
}

# Привести nginx у відповідність до конфігів НА ДИСКУ.
#
# Потрібно тому, що `docker compose up -d` для вже наявного контейнера —
# no-op: compose дивиться на свій файл, а не на вміст змонтованого
# каталогу. Отже після `proxy attach <group>` новий vhost лежить на
# диску, а nginx про нього не знає. Той самий клас, що й `mailctl
# reload` для груп.
#
# Два стани розрізняються свідомо:
#   running     — перечитати конфіг (`nginx -s reload`), але СПЕРШУ
#                 `nginx -t`: reload зі зламаним конфігом не вбиває
#                 робочий процес, він просто лишається на старому, і
#                 виглядає це як «правка не подіяла»;
#   restarting  — перезапустити. Інакше чекати, поки Docker дійде до
#                 наступної спроби за своїм backoff. На полігоні цей
#                 backoff доріс до ХВИЛИНИ, тобто заглушка лягла в
#                 08:52, а nginx піднявся о 08:53:07 — сам, не нашою
#                 командою.
sub proxy_container_id {
    my $id = capture_quiet('docker', 'inspect', '-f', '{{.Id}}', 'proxy-nginx');
    return undef unless defined $id;
    $id =~ s/\s+\z//;
    return length($id) ? $id : undef;
}

sub proxy_refresh {
    my $ctr = 'proxy-nginx';
    my $st  = capture_quiet('docker', 'inspect', '-f', '{{.State.Status}}', $ctr);
    defined $st or return;          # контейнера немає — up -d його щойно створив
    $st =~ s/\s+\z//;

    if ($st ne 'running') {
        say "nginx у стані '$st' — перезапускаю, щоб не чекати ",
            "docker-івський backoff (він доростає до хвилини)";
        run('docker', 'restart', $ctr)
            or die_msg "не вдалось перезапустити $ctr";
        return;
    }

    # Перевірка ДО reload: з поганим конфігом nginx лишиться на старому
    # й не скаже про це нічого.
    unless (run('docker', 'exec', $ctr, 'nginx', '-t')) {
        say STDERR "mailctl: nginx -t незадоволений (вивід вище) — reload ",
                   "НЕ роблю, бо він тихо лишив би старий конфіг";
        return;
    }
    run('docker', 'exec', $ctr, 'nginx', '-s', 'reload')
        or die_msg "не вдалось перечитати конфіг nginx";
    say 'nginx перечитав конфіги';
}

# ── підключення групи до спільного проксі ─────────────────────────────
sub cmd_attach {
    my ($g) = @_;
    my $c = validate($g);
    my ($name, $prefix) = ($c->{name}, $c->{prefix});
    make_path($fragments);
    my $file = "$fragments/$name.yml";
    open my $fh, '>', $file or die_msg "не можу записати $file: $!";
    print $fh <<"FRAG";
# ЗГЕНЕРОВАНО mailctl proxy attach $g — не редагувати руками.
# Підключає спільний nginx до internal-мережі групи '$g'.
# Мережа створюється проєктом групи (-p $name), тут вона external.
networks:
  ${name}_internal:
    external: true
services:
  nginx:
    networks:
      ${name}_internal:
        ipv4_address: ${prefix}.100
FRAG
    close $fh;
    say "створено $file (${prefix}.100 у ${name}_internal)";

    # ── vhost ────────────────────────────────────────────────────────
    # Раніше TODO п.8 казав «vhost генерувати не плануємо: там доменні
    # імена, сертифікати й правила, які в кожної групи свої». Змінено, і
    # причина конкретна: усі три плейсхолдери з group.conf.example
    # (мітка upstream, INTERNAL_PREFIX, WEBMAIL_FQDN) виводяться з
    # group.env МЕХАНІЧНО, тобто «своє в кожної групи» зводилось до
    # підстановки трьох значень руками. А ручна підстановка
    # INTERNAL_PREFIX — це рівно той клас помилки, через який vhost
    # однієї групи тихо показував би Roundcube іншої.
    #
    # Своє у групи все одно буває, тому файл НЕ перезаписується, якщо
    # вже існує: перекриття робиться правкою на місці, як і в
    # _configs/<service>/. Щоб перегенерувати — прибрати файл.
    my $fqdn  = $c->{env}{WEBMAIL_FQDN} // '';
    my $maxup = $c->{env}{WEBMAIL_MAX_UPLOAD} // '25M';
    my $vh   = "$proxy_dir/nginx-config/conf.d/$name.conf";
    if (!length $fqdn) {
        say "WEBMAIL_FQDN не заданий — vhost не генерую";
    }
    elsif (-e $vh) {
        say "vhost $vh уже є — не чіпаю (перегенерувати: прибрати файл)";
    }
    else {
        open my $vf, '>', $vh or die_msg "не можу записати $vh: $!";
        print $vf <<"VHOST";
# ЗГЕНЕРОВАНО `mailctl proxy attach $g`. Файл НЕ перезаписується: якщо
# групі треба щось своє, правити тут, на місці.
#
# Мітка upstream довільна — видима лише в межах цього файлу.
# А ${prefix}.50 і $fqdn — НЕ довільні: перше мусить збігатися з
# INTERNAL_PREFIX групи, друге з ім'ям у DNS і в сертифікаті.
upstream ${name}_webmail {
    # Статична адреса, а не ім'я `roundcube`: коли проксі підключений до
    # кількох груп, цей alias зареєстрований у КОЖНІЙ, і вбудований DNS
    # Docker поверне будь-який із них.
    server ${prefix}.50:80;
}

server {
    listen 80;
    server_name $fqdn;

    # HTTP-01 для вебмейл-сертифіката: certbot --webroot складає виклики
    # сюди. Шлях зарезервований RFC 8615, конфліктувати ні з чим не може.
    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    location / {
        return 301 https://\$host\$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name $fqdn;

    ssl_certificate     /etc/letsencrypt/live/$fqdn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/$fqdn/privkey.pem;

    location / {
        proxy_pass http://${name}_webmail;
        proxy_set_header Host              \$host;
        proxy_set_header X-Real-IP         \$remote_addr;
        proxy_set_header X-Forwarded-For   \$proxy_add_x_forwarded_for;
        # Без цього Roundcube генерував би http:// посилання на
        # https:// сторінці. Він довіряє цим заголовкам лише від
        # ${prefix}.100 — див. proxy_whitelist у _configs/roundcube/.
        proxy_set_header X-Forwarded-Proto \$scheme;
    }

    # Має бути НЕ МЕНШЕ за WEBMAIL_MAX_UPLOAD групи, інакше nginx
    # відрубає вкладення раніше, ніж Roundcube скаже про ліміт.
    client_max_body_size $maxup;
}
VHOST
        close $vf;
        say "створено vhost $vh (для $fqdn)";
    }
    say "далі: ./mailctl proxy up";
}

# Самопідписані заглушки для вебмейл-vhost.
#
# Замкнене коло, у яке ми вже вступили на полігоні: згенерований vhost
# містить `listen 443 ssl` із сертифікатом Let's Encrypt, якого ще
# немає; nginx падає з `cannot load certificate`; а без живого nginx на
# :80 не пройде HTTP-01, тобто сертифікат не отримати НІКОЛИ.
#
# Рішення те саме, що вже працює для пошти: заглушка лягає туди, де
# потім ляже справжній сертифікат, тож vhost не доводиться ні
# переписувати, ні тримати у двох станах. CN заглушки й справжнього
# однаковий, тому після видачі змінюється лише вміст файлів.
#
# Один контейнер на всі групи, а не N: перевірка дешева, а N запусків
# docker — ні.
sub proxy_stub_certs {
    my @fqdn;
    if (opendir my $dh, $fragments) {
        for my $f (sort grep { /\.yml$/ } readdir $dh) {
            (my $name = $f) =~ s/\.yml$//;
            # Фрагмент названий за GROUP_NAME, а каталог групи — за
            # доменом, і це РІЗНІ речі. Шукаємо групу, чий GROUP_NAME
            # збігається з іменем фрагмента.
            for my $g (list_groups()) {
                my $gf = "$groups_dir/$g/group.env";
                next unless -f $gf;
                my $e = read_env($gf);
                next unless ($e->{GROUP_NAME} // '') eq $name;
                push @fqdn, $e->{WEBMAIL_FQDN} if length($e->{WEBMAIL_FQDN} // '');
                last;
            }
        }
        closedir $dh;
    }
    @fqdn or return;

    my $tag = 'trixie';
    # Тег беремо з першої групи, що його задає: образи спільні на хост.
    for my $g (list_groups()) {
        my $gf = "$groups_dir/$g/group.env";
        next unless -f $gf;
        my $e = read_env($gf);
        $tag = $e->{IMAGE_TAG} if length($e->{IMAGE_TAG} // '');
        last;
    }

    my $sh = <<'STUB';
set -e
for fqdn in $FQDNS; do
    d="/etc/letsencrypt/live/$fqdn"
    if [ -s "$d/fullchain.pem" ] && [ -s "$d/privkey.pem" ]; then
        echo "  $fqdn — сертифікат уже є, не чіпаю"
        continue
    fi
    mkdir -p "$d"
    # 90 днів — як у Let's Encrypt: заглушка не має жити довше, ніж
    # справжній сертифікат, інакше про неї забудуть.
    openssl req -new -x509 -days 90 -nodes -newkey rsa:2048 \
        -subj "/CN=$fqdn" -addext "subjectAltName=DNS:$fqdn" \
        -keyout "$d/privkey.pem" -out "$d/fullchain.pem" 2>/dev/null
    chmod 600 "$d/privkey.pem"
    echo "  $fqdn — покладено САМОПІДПИСАНУ заглушку (браузер лаятиметься)"
done
STUB
    say '── сертифікати вебмейлу ──';
    local $ENV{FQDNS} = join ' ', @fqdn;
    run('docker', 'run', '--rm', '-e', 'FQDNS',
        '-v', 'proxy_certs:/etc/letsencrypt',
        '--entrypoint', 'sh', "mail/certbot:$tag", '-c', $sh)
        or die_msg "не вдалось покласти заглушки. Образ mail/certbot:$tag ",
                   "зібраний? (./mailctl build)";
}

sub cmd_detach {
    my ($g) = @_;
    my $c    = validate($g);
    my $file = "$fragments/$c->{name}.yml";
    if (unlink $file) { say "прибрано $file" }
    else              { say "фрагмента $file не було" }
}

# ── зведення по групах ────────────────────────────────────────────────
sub cmd_groups {
    printf "%-24s %-12s %-9s %-16s %s\n",
           qw(GROUP GROUP_NAME VMAIL INTERNAL АДРЕСИ);
    for my $g (list_groups()) {
        my $f = "$groups_dir/$g/group.env";
        unless (-f $f) { printf "%-24s %s\n", $g, '(немає group.env)'; next }
        my $e    = read_env($f);
        my $name = $e->{GROUP_NAME} // '';
        my $prim = $e->{PRIMARY_NET} // '';
        my @a    = parse_addresses($e->{ADDRESSES}, $g);
        # первинну мережу помічаємо зірочкою: саме з неї йде вихідна пошта
        my $addr = join ', ', map {
            $_->{net} . ':' . $_->{ip}
          . ((!length $prim && @a == 1) || $_->{net} eq $prim ? '*' : '')
        } @a;
        printf "%-24s %-12s %-9s %-16s %s\n",
            $g, $name,
            (($e->{VMAIL_UID} // '') . ':' . ($e->{VMAIL_GID} // '')),
            (($e->{INTERNAL_PREFIX} // '') . '.0/24'),
            ($addr . (-f "$fragments/$name.yml" ? '  [proxy]' : ''));
    }
    say '';
    say '* — PRIMARY_NET: дефолтний маршрут і smtp_bind_address';
}

# Попередження, а не помилка: без DBI працює все, крім `user` і
# `domain`. Але дізнаватись про це посеред міграції, коли треба
# завести 312 скриньок, — не найкращий момент, тож кажемо завчасно.
sub warn_no_dbi {
    return if eval { require DBI; 1 }
           && grep { $_ eq 'MariaDB' || $_ eq 'mysql' } DBI->available_drivers;
    say STDERR 'mailctl: немає DBI або драйвера MySQL/MariaDB — команди '
             . "`user`, `domain`, `alias`, `policy` і `block` не "
             . "працюватимуть.\n"
             . '  apt install libdbi-perl libdbd-mariadb-perl';
}

# ── Чи не застаріла КОПІЯ схеми в групі ───────────────────────────────
#
# `db-schema` КОПІЮЄ _schemas/<варіант>/*.sql у groups/<g>/mysql-init/,
# і далі копія живе своїм життям. Це той самий клас, що перекриття
# конфігів: правка джерела мовчки не доїжджає до групи.
#
# Ціна помилки тут вища, ніж здається, і вже заплачена: схему оновили,
# знесли том MariaDB, підняли групу — і застосувалась СТАРА копія. Усе
# піднялось без жодної помилки, а `user list` упав на
# `Unknown column 'login'` вже потім, коли шукали зовсім інше.
sub warn_stale_schema {
    my ($g) = @_;
    my $dir = "$groups_dir/$g/mysql-init";
    return unless -d $dir;
    my $e   = read_env(group_env_path($g));
    my $src = "$root/_schemas/" . ($e->{DB_SCHEMA} || 'mysql-mail');
    return unless -d $src;

    opendir my $dh, $src or return;
    my @sql = sort grep { /\.sql$/ } readdir $dh;
    closedir $dh;

    my @stale;
    for my $f (@sql) {
        my $copy = "$dir/$f";
        if (!-f $copy) { push @stale, "$f (немає в групі)"; next }
        push @stale, $f if slurp_file("$src/$f") ne slurp_file($copy);
    }
    return unless @stale;

    say STDERR "mailctl: [$g] КОПІЯ СХЕМИ ВІДСТАЛА від _schemas/: ",
               join(', ', @stale);
    say STDERR "  Застосовується саме копія, і лише при ПЕРШОМУ старті ",
               "MariaDB. Оновити:";
    say STDERR "    ./mailctl db-schema $g";
    say STDERR "  Після цього зміни підхопить тільки свіжий том ",
               "(на групі з живою поштою том НЕ зносити).";
}

sub slurp_file {
    open my $fh, '<', $_[0] or return '';
    local $/;
    my $t = <$fh>;
    close $fh;
    return $t // '';
}

sub cmd_check {
    my (@args) = @_;
    warn_no_dbi();
    if (@args) {
        validate($args[0]);
        # Каталогів НЕ створюємо: `check` нічого не змінює, у тому числі
        # на диску. Але попередити про мертвий каталог — його робота.
        warn_stale_config_dirs($args[0]);
        warn_stale_schema($args[0]);
        say "[$args[0]] ok";
        return;
    }
    # Без аргументу перевіряємо всі групи, але група без group.env — це не
    # помилка: у репозиторії лежить sample.domain.group з самим лише
    # .example, і падати на ньому при першому ж `check` безглуздо.
    for my $g (list_groups()) {
        if (-f "$groups_dir/$g/group.env") {
            validate($g); warn_stale_config_dirs($g); warn_stale_schema($g);
            say "[$g] ok";
        }
        else { say "[$g] пропущено — немає group.env (шаблон)" }
    }
}

# Перший позиційний аргумент більшості команд — ГРУПА.
#
# Перевірка існування тут, а не в кожній команді, через найчастішу
# описку: пропущену групу. `user passwd u1@polygon.test` читається як
# група з іменем 'u1@polygon.test', адреси після неї не лишається, і
# помилка виходить «вкажи адресу» — тобто показує НЕ НА ТЕ, і виглядає
# як баг: адресу ж вказано.
sub need_group {
    @_ or die_msg 'вкажи групу';
    my $g = $_[0];
    return $g if -d "$groups_dir/$g";

    my @have = list_groups();
    my $hint = @have ? "Є: " . join(', ', @have) : 'Груп у repo немає взагалі.';
    die_msg "'$g' схоже на поштову адресу, а першим аргументом ",
            "очікується ГРУПА.\n",
            "  ./mailctl <команда> <group> <email> ...\n", "  $hint"
        if $g =~ /\@/;
    die_msg "немає групи '$g' (шукав $groups_dir/$g). $hint";
}

# ── Поштова БД групи: домени й скриньки ───────────────────────────────
#
# Саме заради цих команд mailctl і переписувався з bash на Perl
# (рішення №28): email, коментар і пароль приходять від людини, і в
# bash це була б конкатенація SQL із шелл-лапками, тобто заготовлена
# інʼєкція. Тут — DBI з прив'язкою параметрів.
#
# DBI підключається ЛІНИВО, тільки в цих командах. Решта mailctl (up,
# check, health, certs, dns) мусить і далі працювати на голому perl:
# на свіжому хості перша команда — `net up`, а не `user add`.
#
# Чому з хоста напряму, а не `docker exec` у контейнер БД: `internal` —
# звичайний bridge (не `internal: true`), отже в хоста є
# connected-маршрут на ${INTERNAL_PREFIX}.0/24, і база досяжна як
# ${INTERNAL_PREFIX}.20:3306. Публікувати порт назовні НЕ потрібно.
# Адреса `.20` — з таблиці імен шаблону; якщо вона там зміниться,
# змінити й тут.
sub db_connect {
    my ($c) = @_;

    eval { require DBI; 1 } or die_msg
        "немає модуля DBI. Він потрібен ЛИШЕ командам `user`, `domain`\n",
        "і `policy`; решта mailctl працює без нього (рішення №28).\n",
        "  apt install libdbi-perl libdbd-mariadb-perl";

    my %have = map { $_ => 1 } DBI->available_drivers;
    my ($drv) = grep { $have{$_} } qw(MariaDB mysql);
    $drv or die_msg
        "DBI є, а драйвера MySQL/MariaDB немає.\n",
        "  apt install libdbd-mariadb-perl    (або libdbd-mysql-perl)";

    my $e    = $c->{env};
    my $db   = $e->{MYSQL_MAIL_DB}       // 'mailserver';
    my $user = $e->{MYSQL_MAIL_USER}     // 'mailuser';
    my $pass = $e->{MYSQL_MAIL_PASSWORD} // '';
    my $host = "$c->{prefix}.20";

    # RaiseError вимкнений навмисно: помилки віддаємо через die_msg, щоб
    # людина бачила зрозумілий текст, а не стек DBI.
    my %attr = (RaiseError => 0, PrintError => 0, AutoCommit => 1);
    $attr{mysql_enable_utf8mb4} = 1 if $drv eq 'mysql';

    my $dbh = DBI->connect("dbi:$drv:database=$db;host=$host;port=3306",
                           $user, $pass, \%attr);
    unless ($dbh) {
        # `no warnings 'once'` тут по справі: DBI підключається лише в
        # цих командах, тож на етапі компіляції пакета DBI ще немає, і
        # $DBI::errstr виглядає як одноразова змінна з опискою.
        no warnings 'once';
        die_msg "не можу підключитись до $host:3306 ",
                "(база '$db', користувач '$user'): ",
                $DBI::errstr // '?', "\n",
                "Якщо група не запущена — ./mailctl up $c->{dir}";
    }
    return $dbh;
}

# Підключення РОБИТЬ КОЖНА ГІЛКА, і робить ПІСЛЯ розбору аргументів.
# Інакше описка в адресі вимагала б, щоб група була піднята: спершу
# впало б «не можу підключитись», і людина пішла б чинити мережу
# замість того, щоб побачити зайвий символ у email.
sub db_open {
    my ($g) = @_;
    my $c = validate($g);
    return ($c, db_connect($c));
}

# Дані з БД — у БАЙТИ, і це не причіпка.
#
# DBD::MariaDB декодує рядки завжди (DBD::mysql — лише з
# mysql_enable_utf8mb4), тобто віддає СИМВОЛИ. А решта mailctl
# працює з байтами: літерали українською лежать у файлі без
# `use utf8`, і pad() навмисно рахує continuation-байти
# `[\x80-\xBF]`, щоб вирівнювати колонки по видимій ширині.
#
# Змішування давало два дефекти одразу. Перший видимий:
# `Wide character in say` на кожному рядку з українським
# коментарем — впіймалось на скриньках-носіях, чий comment пише
# сам конвертор. Другий ТИХИЙ і гірший: pad() на декодованому
# рядку бачить символи, а не байти, тобто вирівнює не те —
# і саме цей клас помилки вже раз правили в `user list`.
#
# `utf8::encode` лише коли рядок справді декодований: на
# байтовому він подвоїв би кодування.
sub db_bytes {
    my ($v) = @_;
    my $r = ref $v;
    if    ($r eq 'HASH')  { db_bytes($_) for values %$v }
    elsif ($r eq 'ARRAY') { db_bytes($_) for @$v }
    elsif (!$r && defined $v && utf8::is_utf8($v)) { utf8::encode($_[0]) }
    return $v;
}

# Параметри запиту — у СИМВОЛИ, і це ДЗЕРКАЛО db_bytes() вище.
#
# db_bytes існує тому, що DBD::MariaDB завжди ВІДДАЄ символи, а решта
# mailctl працює з байтами. Але той самий драйвер і ПРИЙМАЄ символи:
# на запису він сам кодує рядок у UTF-8. А наші значення приходять із
# ARGV, тобто вже готовими UTF-8 БАЙТАМИ — і кожен байт кодувався
# вдруге.
#
# Симптом видно лише при читанні НАЗАД, і він не схожий на помилку
# запису: `block list` друкував «ÐºÐ¾Ð½ÑÑÐ¾Ð»ÑÐ½Ð°» замість
# «контрольна». У базі при цьому лежало подвійне кодування, тобто
# зіпсовані дані, а не лише зіпсований вивід.
#
# Чому не було видно раніше: усе, що mailctl писав через DBI до цього,
# було ASCII (адреси, домени, дії Postfix), а неASCII-коментарі
# приїжджали дампом через клієнт `mariadb`, тобто іншим шляхом.
#
# `is_utf8` обов'язковий: на вже декодованому рядку повторний
# `utf8::decode` зіпсував би його. `utf8::decode` повертає хибу на
# невалідному UTF-8 — тоді лишаємо байти як були (latin1-вхід краще
# записати як є, ніж замінити на `?`).
sub db_chars {
    my @out;
    for my $v (@_) {
        if (!defined $v || ref $v || utf8::is_utf8($v)
            || $v !~ /[\x80-\xFF]/) { push @out, $v; next }
        my $s = $v;
        utf8::decode($s) or $s = $v;
        push @out, $s;
    }
    return @out;
}

sub db_do {
    my ($dbh, $sql, @bind) = @_;
    my $rv = $dbh->do($sql, undef, db_chars(@bind));
    defined $rv or die_msg 'SQL не вдався: ', $dbh->errstr // '?';
    return $rv;
}
sub db_all {
    my ($dbh, $sql, @bind) = @_;
    my $r = $dbh->selectall_arrayref($sql, { Slice => {} }, db_chars(@bind));
    defined $r or die_msg 'SQL не вдався: ', $dbh->errstr // '?';
    db_bytes($r);
    return $r;
}
sub db_one {
    my ($dbh, $sql, @bind) = @_;
    my $r = $dbh->selectrow_arrayref($sql, undef, db_chars(@bind));
    return undef unless $r;
    db_bytes($r);
    return $r->[0];
}

# ── Розбір адреси ─────────────────────────────────────────────────────
# Межі беремо зі СХЕМИ, а не з голови: users.user — varchar(32),
# users.domain — varchar(128). Без перевірки MariaDB або обрізала б
# тихо, або лаялась незрозуміло, залежно від strict mode.
sub split_email {
    my ($a) = @_;
    defined $a or die_msg 'вкажи адресу';
    $a = lc $a;
    my ($l, $d) = $a =~ /^([^\@\s]+)\@([^\@\s]+)$/
        or die_msg "'$a' не схоже на адресу виду user\@domain";
    length($l) <= 32
        or die_msg "localpart довший за 32 символи (users.user — varchar(32))";
    valid_domain($d);
    return ($l, $d);
}

sub valid_domain {
    my ($d) = @_;
    length($d) <= 128
        or die_msg "домен довший за 128 символів (users.domain — varchar(128))";
    $d =~ /^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$/ && $d =~ /\./
        or die_msg "'$d' не схоже на домен";
    return 1;
}

# Канонічний шлях скриньки. ОДНЕ джерело: та сама формула, що в
# поданні usersdb (CONCAT('/var/mail/', domain, '/', user)) і в томі
# vmail-data (рішення №8). Якщо колись зміниться розкладка — міняти в
# обох місцях свідомо, а не виявляти розходження по зниклій пошті.
sub mailbox_path { return "/var/mail/$_[1]/$_[0]" }

# ── Схема паролів ─────────────────────────────────────────────────────
# Читаємо з ЕФЕКТИВНОГО dovecot.conf, а не тримаємо власну копію
# значення: дві змінні, які мусять узгоджуватись, розійшлися б мовчки —
# і наслідком був би користувач, якого Dovecot не автентикує.
# Порядок той самий, що в entrypoint: груповий файл перекриває спільний.
sub password_scheme {
    my ($g) = @_;
    for my $f ("$groups_dir/$g/dovecot-config/dovecot.conf",
               "$root/_configs/dovecot/dovecot.conf") {
        next unless -f $f;
        open my $fh, '<', $f or next;
        while (my $l = <$fh>) {
            next if $l =~ /^\s*#/;
            if ($l =~ /^\s*default_password_scheme\s*=\s*(\S+)/) {
                close $fh;
                return uc $1;
            }
        }
        close $fh;
    }
    return undef;
}

# ── Хешування ─────────────────────────────────────────────────────────
# Хешує ДOVECOT, а не ми: схема (ARGON2ID, рішення №16) і її параметри —
# його, і повторювати їх у Perl означало б мати другу реалізацію, яка
# одного дня розійдеться з першою. На хості doveadm-а немає й не має
# бути.
sub dovecot_pw {
    my ($c, $g, $plain) = @_;

    my $scheme = password_scheme($g) or die_msg
        "не знайшов default_password_scheme у dovecot.conf ",
        "(ні в групі, ні в _configs/dovecot/)";

    my $ctr = "$c->{name}-dovecot";
    container_running($ctr) or die_msg
        "контейнер $ctr не запущений, а хешувати мусить саме Dovecot ",
        "(схема $scheme — його).\n  ./mailctl up $g";

    # Пароль іде ЗМІННОЮ СЕРЕДОВИЩА (`-e ІМ'Я` без значення), не в
    # аргументах: в аргументах його видно в `ps` на хості.
    # `doveadm pw` без tty читає пароль зі STDIN і питає ДВІЧІ —
    # звідси подвоєний printf.
    local $ENV{MC_PW} = $plain;
    my $sh = 'printf "%s\n%s\n" "$MC_PW" "$MC_PW" | doveadm pw -s "$1"';
    my @cmd = ('docker', 'exec', '-e', 'MC_PW', $ctr, 'sh', '-c', $sh, 'sh', $scheme);

    # Спершу тихо: doveadm пише запит пароля в stderr, і він тут —
    # шум, а не інформація.
    my $out = capture_quiet(@cmd) // '';
    my ($hash) = $out =~ /^(\{\Q$scheme\E\}\S+)\s*$/m;
    return $hash if $hash;

    # Не розібралось — показуємо все, що він насправді сказав.
    say STDERR "mailctl: doveadm pw віддав не те, що очікувалось:";
    run(@cmd);
    die_msg "не вдалось отримати хеш (схема $scheme)";
}

# ── Звідки береться пароль ────────────────────────────────────────────
# `--password=...` НЕ існує і не з'явиться: аргументи видно в `ps` на
# хості й вони лягають в історію шелла. Лишається два шляхи —
# --random (ми згенерували, показали один раз) або STDIN.
sub gen_password {
    # Без 0/1/l/I/O: пароль іноді диктують голосом.
    my @a = ('a'..'z', 'A'..'Z', '2'..'9');
    my $n   = scalar @a;
    my $max = int(256 / $n) * $n;   # відсікаємо хвіст, щоб не було зсуву
    open my $fh, '<:raw', '/dev/urandom' or die_msg 'немає /dev/urandom';
    my $out = '';
    while (length($out) < 16) {
        read($fh, my $buf, 64) or die_msg 'не читається /dev/urandom';
        for my $b (unpack 'C*', $buf) {
            next if $b >= $max;
            $out .= $a[$b % $n];
            last if length($out) >= 16;
        }
    }
    close $fh;
    return $out;
}

sub ask_password {
    my ($random) = @_;

    # Згенерований пароль ТУТ НЕ ДРУКУЄТЬСЯ: виклик стоїть до INSERT, і
    # при збої вставки (наприклад, застаріла схема в mysql-init —
    # `Unknown column 'login'`) користувач бачив пароль від скриньки,
    # якої не існує. Друкує той, хто дізнався, що запис ліг.
    return gen_password() if $random;

    if (-t STDIN) {
        # stty, а не Term::ReadKey: другий не core-модуль (рішення №28).
        my $quiet = run('stty', '-echo');
        $quiet or say STDERR 'mailctl: stty не вдався — пароль буде видно при наборі';
        my @p;
        for my $prompt ('пароль: ', 'ще раз: ') {
            print STDERR $prompt;
            my $l = <STDIN>;
            print STDERR "\n";
            last unless defined $l;
            chomp $l;
            push @p, $l;
        }
        # Echo повертаємо ДО будь-якої перевірки: die_msg виходить із
        # програми, і вимкнений echo лишився б у терміналі людини.
        run('stty', 'echo') if $quiet;
        @p == 2 or die_msg 'пароль не введений';
        $p[0] eq $p[1] or die_msg 'паролі не збіглись';
        length $p[0] or die_msg 'порожній пароль';
        return $p[0];
    }

    my $l = <STDIN>;
    defined $l or die_msg
        "пароль не передано. Або --random, або подай його на STDIN:\n",
        "  printf '%s' \"\$PW\" | ./mailctl user add <group> <email>";
    chomp $l;
    $l =~ s/\r\z//;
    length $l or die_msg 'порожній пароль';
    return $l;
}

sub no_password_flag {
    my ($arg) = @_;
    $arg =~ /^--password/ and die_msg
        "пароля в аргументах НЕ буває: їх видно в `ps` на хості й вони ",
        "лягають в історію шелла.\nАбо --random, або подай пароль на STDIN.";
    return 0;
}

# ── domain ────────────────────────────────────────────────────────────
sub cmd_domain {
    my ($sub, @rest) = @_;
    my $g = need_group(@rest);
    shift @rest;
    my @args = @rest;

    if ($sub eq 'list') {
        my (undef, $dbh) = db_open($g);
        my $rows = db_all($dbh, 'SELECT domain, type, last_modified FROM domains '
                              . 'ORDER BY domain');
        @$rows or do { say "[$g] доменів немає"; return };
        printf "%-40s %-8s %-8s %s\n", 'ДОМЕН', 'ТИП', 'СКРИНЬОК', 'ЗМІНЕНО';
        for my $r (@$rows) {
            my $n = db_one($dbh, 'SELECT COUNT(*) FROM users WHERE domain = ?',
                           $r->{domain}) // 0;
            printf "%-40s %-8s %-8s %s\n",
                   $r->{domain}, $r->{type}, $n, $r->{last_modified} // '';
        }
        return;
    }

    if ($sub eq 'add') {
        my ($d, @opt) = @args;
        $d or die_msg 'вкажи домен: ./mailctl domain add <group> <domain> [--type=LOCAL]';
        my $type = 'LOCAL';
        for my $o (@opt) {
            $o =~ /^--type=(LOCAL|RELAY|VIRTUAL)$/
                ? ($type = $1)
                : die_msg "невідомий аргумент '$o'";
        }
        $d = lc $d;
        valid_domain($d);
        my ($c, $dbh) = db_open($g);
        db_one($dbh, 'SELECT id FROM domains WHERE domain = ?', $d)
            and die_msg "домен '$d' уже є";
        db_do($dbh, 'INSERT INTO domains (domain, type) VALUES (?, ?)', $d, $type);
        say "[$g] додано домен $d (type=$type)";
        say 'Postfix побачить його ОДРАЗУ: virtual_mailbox_domains читається з SQL '
          . 'на кожен RCPT (рішення №18), reload не потрібен.';
        if ($type eq 'LOCAL') {
            say "А DKIM-ключ — НІ: KeyTable будується при старті OpenDKIM з БД.";
            say "  ./mailctl reload $g opendkim && ./mailctl dkim $g";
            # RFC 5321 вимагає postmaster@ на КОЖНОМУ домені, і конфігом
            # це не вирішується: Postfix свої повідомлення шле на
            # POSTMASTER_ADDRESS явними адресами, а зовнішній світ пише
            # на postmaster@<домен>. Без рядка в aliases ми відповідаємо
            # 550 — і скарги, звіти DMARC та delisting не доходять.
            my $pm = $c->{env}{POSTMASTER_ADDRESS} // 'postmaster@<домен>';
            say '';
            say "RFC 5321 вимагає postmaster\@$d — зараз його НЕМА:";
            say "  ./mailctl alias add $g postmaster\@$d $pm";
            say '(./mailctl health показує всі домени без postmaster@)';
        }
        if ($type eq 'RELAY') {
            my $mh = $c->{env}{MAIL_HOSTNAME} // '<MAIL_HOSTNAME>';
            say '';
            say 'RELAY означає: приймаємо пошту для цього домену й віддаємо її';
            say 'далі за DNS/MX (рішення №38, №39). Скриньок тут не буде —';
            say 'тобто група стала РЕЗЕРВНИМ MX для нього.';
            say '';
            say 'ТРИ РЕЧІ, ЯКІ ТРЕБА ЗРОБИТИ ЗА МЕЖАМИ ЦІЄЇ КОМАНДИ:';
            say "  1. У зоні $d додати MX на $mh з ГІРШИМ приоритетом,";
            say '     ніж в основного сервера (наприклад MX 10 основний,';
            say "     MX 20 $mh).";
            say "  2. Переконатись, що в MX стоїть саме $mh — ім'я мусить";
            say '     збігатися з myhostname, інакше Postfix себе в списку MX';
            say '     не впізнає, вважатиме себе найкращим MX, і пошта піде по';
            say '     колу до "loops back to myself".';
            say '  3. Перевірити, що основний сервер приймає RCPT-проби:';
            say '     reject_unverified_recipient пробує отримувача на ньому,';
            say '     і саме це не дає нам стати генератором backscatter.';
            say '';
            say "  ./mailctl health $g   — розділ relay_domains";
        }
        return;
    }

    if ($sub eq 'del') {
        my ($d) = @args;
        $d or die_msg 'вкажи домен';
        $d = lc $d;
        valid_domain($d);
        my (undef, $dbh) = db_open($g);
        my $t = db_one($dbh, 'SELECT type FROM domains WHERE domain = ?', $d)
            or die_msg "домену '$d' немає";
        my $u = db_one($dbh, 'SELECT COUNT(*) FROM users WHERE domain = ?', $d) // 0;
        $u and die_msg "у домені '$d' ще $u скриньок. Прибери спершу їх ",
                       "(./mailctl user list $g $d), інакше вони лишились би ",
                       "в базі непридатними: Postfix їх уже не приймає, а ",
                       "Dovecot ще автентикує.";
        my $a = db_one($dbh, 'SELECT COUNT(*) FROM aliases WHERE domain = ?', $d) // 0;
        $a and die_msg "у домені '$d' ще $a аліасів";
        db_do($dbh, 'DELETE FROM domains WHERE domain = ?', $d);
        my $was_relay = ($t // '') eq 'RELAY';
        say "[$g] домен $d видалено. DKIM-ключ лишився в томі dkim-keys — ",
            "приберіть DNS-запис, якщо домен більше не ваш.";
        if ($was_relay) {
            say 'Це був домен РЕЛЕЮ. Приберіть і MX-запис, що вказував на нас:';
            say 'інакше відправники й далі приходитимуть, а ми тепер відповідаємо';
            say '"Relay access denied" — тобто для них це відмова, не резерв.';
        }
        return;
    }

    die_msg "невідома підкоманда domain: $sub (list|add|del)";
}

# ── alias: віртуальні аліаси (остання річ, що вставлялась SQL-ом) ─────
#
# Схема аліаси МАЛА з самого початку (`aliases` + в'ю `aliasesview`), і
# `virtual_alias_maps` у `main.cf` налаштований — тобто вони працювали,
# але вставлялись руками. Це рішення №28 навпаки й формально четверта
# ручна операція: на small так заїхали 31 рядок, на isp доведеться
# ще й ВИКИДАТИ чужі.
#
# КОНТРАКТ СХЕМИ, який тут важливий:
#   `local_part` varchar(64)  — ширше за `users.user` (32), тож свій
#                               валідатор, не split_email();
#   `recipients` text         — СПИСОК через кому, рівно в тому вигляді,
#                               якого чекає virtual_alias_maps;
#   KEY (local_part, domain)  — НЕ UNIQUE. Отже два рядки з однаковим
#                               ключем можливі, і dict_mysql склеїв би
#                               їх через кому. Працювало б, але `del`
#                               став би неоднозначним — тому `add`
#                               перевіряє наявність сам.

# Ключ аліаса. Порожня локальна частина — це catch-all (`@example.com`),
# штатна форма Postfix, і в дампі isp такий рядок є (`@dead.example.net`).
sub alias_split_key {
    my ($k) = @_;
    defined $k && length $k or die_msg 'вкажи аліас';
    $k = lc $k;
    $k =~ /^([^\@\s]*)\@([^\@\s]+)$/
        or die_msg "'$k' не схоже на аліас виду user\@domain ",
                   "(або \@domain — catch-all на весь домен)";
    my ($lp, $dom) = ($1, $2);
    length($lp) <= 64
        or die_msg "localpart довший за 64 символи ",
                   "(aliases.local_part — varchar(64))";
    length($lp) == 0 || $lp =~ /^[a-z0-9._%+-]+$/
        or die_msg "у localpart лишень літери, цифри і . _ % + -";
    valid_domain($dom);
    return ($lp, $dom);
}

sub alias_key { return length($_[0]) ? "$_[0]\@$_[1]" : "\@$_[1]" }

# Отримувачі. Лише повні адреси: Postfix у virtual_alias_maps приймає й
# голий localpart, але він тоді тлумачиться відносно $myorigin, тобто
# значення залежить від конфігу, а не від даних. Повна адреса однозначна.
sub alias_parse_recipients {
    my ($str) = @_;
    my @r;
    for my $one (split /\s*,\s*/, ($str // '')) {
        next unless length $one;
        my $a = lc $one;
        $a =~ /^[^\@\s]+\@[^\@\s]+$/
            or die_msg "'$one' не схоже на адресу виду user\@domain. ",
                       "Голий localpart тут не беремо: Postfix тлумачив би ",
                       "його відносно \$myorigin, тобто зміст залежав би від ",
                       "конфігу, а не від даних";
        my (undef, $d) = $a =~ /^([^\@]+)\@(.+)$/;
        valid_domain($d);
        push @r, $a;
    }
    @r or die_msg 'вкажи хоч одного отримувача';
    # Дедуплікація зі збереженням порядку: дубль у списку означав би
    # ДВІ копії листа тому самому отримувачу.
    my (%seen, @out);
    for (@r) { push @out, $_ unless $seen{$_}++ }
    return @out;
}

sub cmd_alias {
    my ($sub, @rest) = @_;
    my $g = need_group(@rest);
    shift @rest;
    my @args = @rest;

    # ── list ─────────────────────────────────────────────────────────
    if ($sub eq 'list') {
        my ($dom, $like, $limit, $all);
        for my $o (@args) {
            if    ($o =~ /^--like=(.+)$/)   { $like  = lc $1 }
            elsif ($o =~ /^--limit=(\d+)$/) { $limit = $1 }
            elsif ($o eq '--all')           { $all   = 1 }
            elsif ($o !~ /^--/)             { $dom   = lc $o }
            else { die_msg "невідомий аргумент '$o'" }
        }
        my (undef, $dbh) = db_open($g);
        my (@w, @b);
        if (defined $dom)  { push @w, 'domain = ?';      push @b, $dom }
        if (defined $like) { push @w, 'CONCAT(local_part, "@", domain) LIKE ?';
                             push @b, "%$like%" }
        my $where = @w ? ' WHERE ' . join(' AND ', @w) : '';
        my $n = db_one($dbh, "SELECT COUNT(*) FROM aliases$where", @b) // 0;
        $n or do { say "[$g] аліасів немає",
                       defined $dom ? " в домені $dom" : ''; return };
        $limit = $all ? 0 : ($limit // 50);
        my $sql = "SELECT local_part, domain, recipients FROM aliases$where"
                . ' ORDER BY domain, local_part';
        $sql .= " LIMIT $limit" if $limit;
        my $rows = db_all($dbh, $sql, @b);
        say "[$g] аліасів: $n", ($limit && $n > $limit ? ", показано $limit" : '');
        say '  ', pad('АЛІАС', 36), ' ОТРИМУВАЧІ';
        for my $r (@$rows) {
            say '  ', pad(alias_key($r->{local_part}, $r->{domain}), 36),
                ' ', ($r->{recipients} // '');
        }
        say "  ... ще ", $n - $limit, " (--all)" if $limit && $n > $limit;
        return;
    }

    # ── add ──────────────────────────────────────────────────────────
    if ($sub eq 'add') {
        my ($key, $rcpt, @opt) = @args;
        ($key && $rcpt && $key !~ /^--/ && $rcpt !~ /^--/) or die_msg
            "вкажи аліас і отримувачів:\n",
            "  ./mailctl alias add <group> <аліас> <addr>[,<addr>...]\n",
            "  аліас: user\@domain або \@domain (catch-all на весь домен)";
        my ($replace, $force);
        for my $o (@opt) {
            if    ($o eq '--replace') { $replace = 1 }
            elsif ($o eq '--force')   { $force   = 1 }
            else { die_msg "невідомий аргумент '$o'" }
        }
        my ($lp, $dom) = alias_split_key($key);
        my $k = alias_key($lp, $dom);
        my @rcpts = alias_parse_recipients($rcpt);

        my ($c, $dbh) = db_open($g);
        my @stop;

        # ── 1. домен КЛЮЧА мусить бути нашим ────────────────────────
        # Інакше аліас тихо «працює» лише для тих, кому дозволено релей
        # (mynetworks / SASL): для решти світу ми не приймаємо пошту для
        # чужого домену взагалі, бо його немає ні у virtual_mailbox_domains,
        # ні у virtual_alias_domains. Саме таких на isp знайшлось 22 —
        # вони виглядали чинними роками.
        my $own = db_one($dbh, 'SELECT type FROM domains WHERE domain = ?', $dom);
        my $mh  = lc($c->{env}{MAIL_HOSTNAME} // '');
        if (!defined $own && $dom ne $mh) {
            push @stop, "'$dom' НЕ домен цієї групи. Аліас у чужому домені "
                      . "спрацює лише для тих, хто має право релею "
                      . "(mynetworks/SASL) — для решти світу ми пошту для "
                      . "нього не приймаємо взагалі";
        }
        if ($dom eq $mh) {
            say STDERR "mailctl: УВАГА: $dom — це ІМ'Я ВУЗЛА групи. ",
                       "postmaster\@ і abuse\@ на ньому вже дає inline-мапа ",
                       "entrypoint-а, і вона стоїть ПЕРШОЮ в списку — ",
                       "рядок у БД для цих двох не спрацює ніколи";
        }
        if (defined $own && $own ne 'LOCAL') {
            push @stop, "'$dom' має type=$own, а не LOCAL. Аліаси "
                      . "розгортаються в отримувачів, яких ми доставляємо "
                      . "самі; для домену релею це не має сенсу";
        }

        # ── 2. ключ НЕ має бути наявною скринькою ───────────────────
        # virtual_alias_maps читається ПЕРЕД virtual_mailbox_maps, тож
        # аліас коротко замикає скриньку: пошта в неї перестає падати
        # МОВЧКИ. Та сама причина, через яку конвертор не створює аліаса
        # для адреси носія (рішення про sieve-пересилання).
        if (length $lp) {
            my $box = db_one($dbh,
                'SELECT id FROM users WHERE user = ? AND domain = ?', $lp, $dom);
            push @stop, "'$k' — НАЯВНА СКРИНЬКА. virtual_alias_maps "
                      . "читається ПЕРЕД virtual_mailbox_maps, тож аліас "
                      . "коротко замкне її: пошта перестане падати в "
                      . "скриньку МОВЧКИ"
                if defined $box;
        }

        # ── 3. зовнішні отримувачі — не аліасом ─────────────────────
        # Рішення власника (2026-11-09): зовнішнє пересилання переїхало
        # в sieve. Аліас на чужий домен не вміє поставити НАШУ адресу в
        # MAIL FROM, тож SPF на боці приймача не сходиться за побудовою;
        # `redirect` у Dovecot це вміє (sieve_redirect_envelope_from).
        my @ext = grep { my $d = (split /\@/, $_, 2)[1];
                         !defined db_one($dbh,
                            'SELECT id FROM domains WHERE domain = ?', $d) }
                  @rcpts;
        if (@ext) {
            push @stop, "зовнішні отримувачі (" . join(', ', @ext) . "): "
                      . "аліас лишає MAIL FROM чужим, тож SPF у приймача не "
                      . "сходиться за побудовою. Зовнішнє пересилання — "
                      . "скринька-носій зі sieve (redirect :copy плюс "
                      . "sieve_redirect_envelope_from = recipient)";
        }

        if (@stop) {
            die_msg "не додаю $k: ", join('; ', @stop),
                    ". Якщо це справді те, що потрібно — --force"
                unless $force;
            say STDERR "mailctl: УВАГА, --force: $_" for @stop;
        }

        # ── попередження, не відмови ────────────────────────────────
        # Отримувач у нашому домені, якого немає ні як скриньки, ні як
        # аліаса: лист розгорнеться й одразу відбʼється «User unknown».
        # Не відмова — ланцюги аліасів законні, і порядок створення
        # буває зворотним.
        for my $a (@rcpts) {
            my ($rl, $rd) = split /\@/, $a, 2;
            next unless defined db_one($dbh,
                'SELECT id FROM domains WHERE domain = ?', $rd);
            next if defined db_one($dbh,
                'SELECT id FROM users WHERE user = ? AND domain = ?', $rl, $rd);
            next if defined db_one($dbh,
                'SELECT id FROM aliases WHERE local_part = ? AND domain = ?',
                $rl, $rd);
            say STDERR "mailctl: УВАГА: '$a' — наш домен, але ні скриньки, ",
                       "ні аліаса з такою адресою немає: лист відбився б ",
                       "«User unknown in virtual mailbox table»";
        }

        # KEY (local_part, domain) НЕ unique, тож наявність перевіряємо
        # самі. Два рядки з одним ключем dict_mysql склеїв би через кому —
        # працювало б, але `del` став би неоднозначним.
        my $dups = db_one($dbh,
            'SELECT COUNT(*) FROM aliases WHERE local_part = ? AND domain = ?',
            $lp, $dom) // 0;
        $dups > 1 and die_msg
            "у базі ВЖЕ $dups рядків для '$k' (ключ у схемі не UNIQUE). ",
            "Приберіть зайве: ./mailctl alias del $g $k — і додайте знову";
        my $had;
        if ($dups == 1) {
            $had = db_one($dbh,
                'SELECT recipients FROM aliases WHERE local_part = ? AND domain = ?',
                $lp, $dom);
            $replace or die_msg
                "аліас '$k' уже є -> ", ($had // ''), "\n",
                "  Перезаписати: --replace (список замінюється ЦІЛКОМ, не ",
                "доповнюється)";
        }

        my $value = join(',', @rcpts);
        if (defined $had) {
            db_do($dbh, 'UPDATE aliases SET recipients = ? '
                      . 'WHERE local_part = ? AND domain = ?', $value, $lp, $dom);
            say "[$g] оновлено $k";
            say "  було:  $had";
            say "  стало: $value";
        }
        else {
            db_do($dbh, 'INSERT INTO aliases (local_part, domain, recipients) '
                      . 'VALUES (?, ?, ?)', $lp, $dom, $value);
            say "[$g] додано $k -> $value";
        }
        say 'Postfix побачить це ОДРАЗУ: virtual_alias_maps читається з SQL '
          . 'на кожен RCPT.';
        say "Що саме він віддасть: ./mailctl alias test $g $k";
        return;
    }

    # ── del ──────────────────────────────────────────────────────────
    if ($sub eq 'del') {
        my @keys = grep { !/^--/ } @args;
        my @bad  = grep {  /^--/ } @args;
        @bad and die_msg "невідомий аргумент '$bad[0]'";
        @keys or die_msg 'вкажи аліас (можна кілька)';
        my (undef, $dbh) = db_open($g);
        my $gone = 0;
        for my $raw (@keys) {
            my ($lp, $dom) = alias_split_key($raw);
            my $k = alias_key($lp, $dom);
            my $rows = db_all($dbh,
                'SELECT id, recipients FROM aliases '
              . 'WHERE local_part = ? AND domain = ?', $lp, $dom);
            unless (@$rows) { say "  немає: $k"; next }
            db_do($dbh, 'DELETE FROM aliases WHERE local_part = ? AND domain = ?',
                  $lp, $dom);
            $gone += scalar @$rows;
            say "  прибрано: $k -> $_->{recipients}" for @$rows;
            say "  (рядків було ", scalar @$rows, " — ключ у схемі не UNIQUE)"
                if @$rows > 1;
        }
        say "[$g] прибрано рядків: $gone";
        # НІ ОДНОГО збігу при непорожньому списку — найімовірніше
        # помилка виклику, і вона тиха: `add` приймає (ключ,
        # ОТРИМУВАЧІ), `del` — тільки КЛЮЧІ, а форма аргументів у них
        # однакова. Спіймано на живому small: `del <ключ> <отримувач>`
        # пройшов із двома «немає» й кодом 0. Тут пощастило, що
        # отримувач був СКРИНЬКОЮ; якби він сам був аліасом — зник би
        # без жодного запитання.
        unless ($gone) {
            say STDERR "mailctl: не знайдено жодного з названих аліасів. ",
                       "Нагадування: `del` приймає КЛЮЧІ (що видалити), ",
                       "а не отримувачів — на відміну від `add <ключ> ",
                       "<отримувачі>`";
            exit 1;
        }
        return;
    }

    # ── test ─────────────────────────────────────────────────────────
    # Питаємо САМ Postfix, обома каналами. І відтворюємо послідовність
    # ключів, як у `block test`: для virtual_alias_maps Postfix пробує
    # повну адресу, потім (знявши розширення) `user@domain`, і нарешті
    # `@domain` — catch-all. Проба лише точного ключа не показала б, що
    # адресу насправді ловить catch-all.
    if ($sub eq 'test') {
        my ($raw) = @args;
        $raw or die_msg "вкажи адресу: ./mailctl alias test $g <user\@domain>";
        my ($lp, $dom) = alias_split_key($raw);
        my @keys;
        if (length $lp) {
            push @keys, "$lp\@$dom";
            if ($lp =~ /^([^+]+)\+/) { push @keys, "$1\@$dom" }
        }
        push @keys, "\@$dom";
        for my $k (@keys) {
            $k =~ /^[a-z0-9._%+@-]*\@[a-z0-9.-]+$/
                or die_msg "'$k' містить символи, яких я не пропускаю в ",
                           "команду контейнера";
        }
        my $c   = validate($g);
        my $ctr = "$c->{name}-postfix";
        container_running($ctr)
            or die_msg "контейнер $ctr не запущений — ./mailctl up $c->{dir}";
        say 'ключі, які пробує Postfix: ', join(' -> ', @keys);
        say '';
        for my $via ('mysql', 'proxy:mysql') {
            my ($hit, $err);
            for my $k (@keys) {
                my $out = capture_quiet('docker', 'exec', $ctr, 'sh', '-c',
                    "postmap -q '$k' $via:/etc/postfix/sql/virtual_aliases.cf 2>&1");
                $out = '' unless defined $out;
                $out =~ s/\s+$//;
                if ($out =~ /^postmap:/m) { $err = $out; last }
                if (length $out) { $hit = [ $k, $out ]; last }
            }
            if (defined $err) {
                say pad($via, 12), ' ЗБІЙ мапи:';
                say "  $_" for split /\n/, $err;
            }
            elsif ($hit) {
                say pad($via, 12), " ключ '$hit->[0]' -> $hit->[1]";
            }
            else {
                say pad($via, 12), ' немає збігу (аліаса немає — пошта',
                    ' піде у скриньку, якщо вона є)';
            }
        }
        return;
    }

    die_msg "невідома підкоманда alias: $sub (list|add|del|test)";
}

# ── policy: блокування за доменом ОТРИМУВАЧА (рішення №19) ────────────
#
# Чому команда взагалі потрібна: таблиця `recipient_policy` — це те, що
# на isp зроблено транспортом `discard:silently` на 297 доменів, плюс
# імпортований список cip.gov.ua на 50+ тисяч. Вставляти це голим SQL
# означало б ручну операцію, якої в списку дозволених трьох немає
# (рішення №28), а на 50 тисячах рядків — ще й конкатенацію SQL.
#
# `source` розділяє СВОЄ й ІМПОРТОВАНЕ, і це не декоративне поле:
# `import` синхронізує рівно в межах свого `source`, тож зовнішній
# список можна переливати скільки завгодно, не чіпаючи ручних записів.

# Дозволені дії. Перевіряємо не для краси: `action` їде в Postfix як
# відповідь на RCPT, і помилка тут тиха в обидва боки.
#
# OK/PERMIT ЗАБОРОНЕНІ — та сама причина, що в abuse_block (рішення
# №20): рядок із таким action перетворює таблицю на БІЛИЙ список, який
# коротко замикає всі наступні перевірки в тому ж списку обмежень
# (greylisting, abuse_block, reject_unknown_recipient_domain). Для
# винятку всередині заблокованого батьківського домену є DUNNO: він
# означає «рішення немає, йди далі», тобто знімає блокування й нічого
# не дозволяє наперед. Разом із `ORDER BY LENGTH(domain) DESC` це й є
# штатний спосіб зробити дірку в широкому правилі.
#
# HOLD заборонений окремо: лист ляже в hold-чергу, тобто для
# відправника він прийнятий, а для отримувача не існує — і доки хтось
# не подивиться в чергу, цього не видно нікому.
my %POLICY_BAD = (
    OK       => 'перетворює таблицю на БІЛИЙ список і коротко замикає '
              . 'усі наступні перевірки (greylisting, abuse_block). '
              . 'Для винятку всередині ширшого правила (піддомен, '
              . 'адреса в заблокованій підмережі) — DUNNO',
    PERMIT   => 'те саме, що OK',
    HOLD     => 'лист ляже в hold-чергу: для відправника прийнятий, для '
              . 'отримувача не існує, і це не видно нікому, доки хтось '
              . 'не подивиться в чергу',
    FILTER   => 'перенаправляє лист у content_filter, якого в нас немає '
              . '(рішення №31, №32: фільтруємо мілтерами)',
    REDIRECT => 'тихо відправляє лист ІНШОМУ отримувачу — це не '
              . 'блокування, а підміна адреси',
    BCC      => 'додає скритого отримувача, тобто копіює чужу пошту',
);
my @POLICY_OK = qw(DISCARD REJECT DEFER DEFER_IF_PERMIT DEFER_IF_REJECT
                   DUNNO WARN INFO);

# Другий аргумент — як зветься опція для коментаря в ТІЙ команді, що
# викликає (у policy це --comment, у block --reason). Дрібниця, але
# порада «напиши українською в --comment» із `block` відправляла б
# користувача в неіснуючий аргумент.
sub policy_check_action {
    my ($a, $comment_opt) = @_;
    $comment_opt = '--comment' unless defined $comment_opt;
    defined $a && length $a or die_msg 'action порожній';
    $a !~ /[\r\n]/ or die_msg 'action у один рядок, без переносів';

    # Текст відмови їде в DSN, а там не-ASCII без SMTPUTF8
    # неприпустимий. Те саме правило вже коштувало нам
    # `local_transport = error:...` з українським текстом.
    $a !~ /[^\x20-\x7E]/
        or die_msg "action мусить бути ASCII: текст відмови їде в DSN, ",
                   "а там не-ASCII без SMTPUTF8 неприпустимий. ",
                   "Коментар українською — у $comment_opt";

    my ($word) = $a =~ /^(\S+)/;
    my $up = uc $word;
    if (my $why = $POLICY_BAD{$up}) {
        die_msg "action '$up' тут заборонений: $why";
    }
    return $a if $up =~ /^[45]\d\d$/;
    grep { $_ eq $up } @POLICY_OK
        or die_msg "невідомий action '$word'. Можна: ",
                   join(', ', @POLICY_OK), ", або код 4xx/5xx із текстом";
    return $a;
}

# Наші власні домени блокувати не можна — це зупинило б пошту групи
# для її ж отримувачів. Один запит, тож перевірка дешева й на 50
# тисячах рядків.
sub policy_own_domains {
    my ($dbh) = @_;
    my $rows = db_all($dbh, 'SELECT domain FROM domains');
    return { map { $_->{domain} => 1 } @$rows };
}

# Домен із рядка списку. Провідні крапки ЗНІМАЄМО — їх замінює
# include_subdomains (рішення №19). На isp 296 із 297 записів мають
# провідну крапку, тобто блокують лише піддомени, а сам домен — ні; за
# словами власника, задум був протилежний.
sub policy_norm_domain {
    my ($d) = @_;
    $d = lc $d;
    $d =~ s/^\.+//;
    $d =~ s/\.+$//;
    return $d;
}

sub cmd_policy {
    my ($sub, @rest) = @_;
    my $g = need_group(@rest);
    shift @rest;
    my @args = @rest;

    # ── list ─────────────────────────────────────────────────────────
    # Без фільтра друкуємо ЗВЕДЕННЯ, а не рядки, і це не лінь: у
    # таблиці очікується 50+ тисяч записів, тож `policy list` без
    # обмежень змів би термінал. Рядки — за --source або --like.
    if ($sub eq 'list') {
        my ($src, $like, $limit, $all);
        for my $o (@args) {
            if    ($o =~ /^--source=(.+)$/) { $src   = $1 }
            elsif ($o =~ /^--like=(.+)$/)   { $like  = $1 }
            elsif ($o =~ /^--limit=(\d+)$/) { $limit = $1 }
            elsif ($o eq '--all')           { $all   = 1 }
            else { die_msg "невідомий аргумент '$o'" }
        }
        my (undef, $dbh) = db_open($g);

        my $total = db_one($dbh, 'SELECT COUNT(*) FROM recipient_policy') // 0;
        $total or do { say "[$g] recipient_policy порожня"; return };

        unless (defined $src || defined $like || $all) {
            say "[$g] recipient_policy, записів: $total";
            say '';
            my $rows = db_all($dbh,
                'SELECT source, COUNT(*) AS n,'
              . ' SUM(include_subdomains) AS subs,'
              . ' SUBSTRING_INDEX(action, " ", 1) AS act'
              . ' FROM recipient_policy GROUP BY source, act'
              . ' ORDER BY n DESC');
            say '  ', pad('SOURCE', 20), ' ', pad('ДІЯ', 10), ' ',
                pad('ЗАПИСІВ', 9), ' З ПІДДОМЕНАМИ';
            for my $r (@$rows) {
                say '  ', pad($r->{source}, 20), ' ', pad($r->{act}, 10),
                    ' ', pad($r->{n}, 9), ' ', ($r->{subs} // 0);
            }
            say '';
            say 'Рядки: --source=<ім\'я>, --like=<підрядок> або --all';
            say "Перевірити, що насправді віддасть Postfix: ",
                "./mailctl policy test $g <email>";
            return;
        }

        $limit = defined $limit ? $limit : ($all ? 0 : 50);
        my (@w, @b);
        if (defined $src)  { push @w, 'source = ?';     push @b, $src }
        if (defined $like) { push @w, 'domain LIKE ?';  push @b, "%$like%" }
        my $where = @w ? ' WHERE ' . join(' AND ', @w) : '';
        my $n = db_one($dbh, "SELECT COUNT(*) FROM recipient_policy$where", @b) // 0;
        $n or do { say "[$g] нічого не знайдено"; return };
        my $sql = "SELECT domain, include_subdomains, action, source, comment"
                . " FROM recipient_policy$where ORDER BY domain";
        $sql .= " LIMIT $limit" if $limit;
        my $rows = db_all($dbh, $sql, @b);
        say "[$g] знайдено $n", ($limit && $n > $limit ? ", показано $limit" : '');
        say '  ', pad('ДОМЕН', 40), ' ', pad('+SUB', 5), ' ',
            pad('SOURCE', 14), ' ДІЯ';
        for my $r (@$rows) {
            say '  ', pad($r->{domain}, 40), ' ',
                pad($r->{include_subdomains} ? 'так' : '—', 5), ' ',
                pad($r->{source}, 14), ' ', $r->{action};
        }
        say "  ... ще ", $n - $limit, " (--limit=0 або --all)"
            if $limit && $n > $limit;
        return;
    }

    # ── add ──────────────────────────────────────────────────────────
    if ($sub eq 'add') {
        my ($d, @opt) = @args;
        $d or die_msg 'вкажи домен: ./mailctl policy add <group> <domain> ',
                      '[--action=...] [--source=...] [--comment=...] ',
                      '[--no-subdomains]';
        # Дія за замовчуванням — REJECT із текстом, а НЕ DISCARD, хоч у
        # схемі дефолт саме DISCARD (його там тримає сумісність із
        # історичними 297 записами isp). Причина в рішенні №19: мовчки
        # з'їдений лист не діагностується ні відправником, ні адміном.
        # Для нового, свідомо доданого запису правильний бік помилки —
        # сказати відправнику, що сталось.
        my $action = 'REJECT recipient domain blocked by local policy';
        my $source = 'local';
        my ($comment, $subs, $force) = (undef, 1, 0);
        for my $o (@opt) {
            if    ($o =~ /^--action=(.+)$/)  { $action  = $1 }
            elsif ($o =~ /^--source=(.+)$/)  { $source  = $1 }
            elsif ($o =~ /^--comment=(.*)$/) { $comment = $1 }
            elsif ($o eq '--no-subdomains')  { $subs    = 0 }
            elsif ($o eq '--force')          { $force   = 1 }
            else { die_msg "невідомий аргумент '$o'" }
        }
        $d = policy_norm_domain($d);
        valid_domain($d);
        policy_check_action($action);
        $source =~ /^[A-Za-z0-9._-]{1,64}$/
            or die_msg "source: літери, цифри, точка, дефіс, підкреслення, ",
                       "до 64 символів";

        my (undef, $dbh) = db_open($g);
        my $own = policy_own_domains($dbh);
        if ($own->{$d} && !$force) {
            die_msg "'$d' — ВЛАСНИЙ домен групи. Блокування за доменом ",
                    "отримувача зупинило б пошту його ж користувачам. ",
                    "Якщо це справді те, що потрібно — --force";
        }
        my $had = db_one($dbh,
            'SELECT action FROM recipient_policy WHERE domain = ?', $d);
        db_do($dbh,
            'INSERT INTO recipient_policy'
          . ' (domain, include_subdomains, action, source, comment)'
          . ' VALUES (?, ?, ?, ?, ?)'
          . ' ON DUPLICATE KEY UPDATE include_subdomains = VALUES(include_subdomains),'
          . ' action = VALUES(action), source = VALUES(source),'
          . ' comment = VALUES(comment)',
            $d, $subs, $action, $source, $comment);
        say defined $had ? "[$g] оновлено $d (було: $had)"
                         : "[$g] додано $d";
        say "  дія: $action";
        say "  піддомени: ", ($subs ? 'теж блокуються' : 'НЕ блокуються');
        say 'Postfix побачить це ОДРАЗУ: мапа читається з SQL на кожен RCPT.';
        return;
    }

    # ── del ──────────────────────────────────────────────────────────
    if ($sub eq 'del') {
        my @doms = grep { !/^--/ } @args;
        my @bad  = grep {  /^--/ } @args;
        @bad and die_msg "невідомий аргумент '$bad[0]'";
        @doms or die_msg 'вкажи домен (можна кілька)';
        my (undef, $dbh) = db_open($g);
        my $gone = 0;
        for my $raw (@doms) {
            my $d = policy_norm_domain($raw);
            my $r = db_one($dbh,
                'SELECT source FROM recipient_policy WHERE domain = ?', $d);
            unless (defined $r) { say "  немає: $d"; next }
            db_do($dbh, 'DELETE FROM recipient_policy WHERE domain = ?', $d);
            $gone++;
            say "  прибрано: $d";
            # Запис із чужого source повернеться при наступному
            # імпорті — синхронізація в межах source саме для цього й
            # існує. Казати це тут, а не ловити подив потім.
            say "    УВАГА: source='$r' — повернеться при наступному ",
                "`policy import --source=$r`. Щоб прибрати назавжди, ",
                "правити ДЖЕРЕЛО списку."
                if $r ne 'local';
        }
        say "[$g] видалено $gone із ", scalar(@doms);
        return;
    }

    # ── import ───────────────────────────────────────────────────────
    # Синхронізація В МЕЖАХ source: додати нові, оновити змінені,
    # прибрати зниклі. НЕ `TRUNCATE` — інакше імпорт зовнішнього списку
    # зносив би ручні записи, і це був би саме той клас помилки, через
    # який поле `source` узагалі існує.
    if ($sub eq 'import') {
        my ($file, $src, $action, $subs, $force, $dry) =
           (undef, undef, undef, 1, 0, 0);
        for my $o (@args) {
            if    ($o =~ /^--source=(.+)$/) { $src    = $1 }
            elsif ($o =~ /^--action=(.+)$/) { $action = $1 }
            elsif ($o eq '--no-subdomains') { $subs   = 0 }
            elsif ($o eq '--force')         { $force  = 1 }
            elsif ($o eq '--dry-run')       { $dry    = 1 }
            elsif ($o =~ /^-/)              { die_msg "невідомий аргумент '$o'" }
            elsif (defined $file)           { die_msg "зайвий аргумент '$o'" }
            else                            { $file   = $o }
        }
        defined $file or die_msg
            "вкажи файл: ./mailctl policy import <group> --source=<ім'я> <файл>";
        defined $src or die_msg
            "--source обов'язковий: синхронізація йде РІВНО в його межах, ",
            "і без нього імпорт не знав би, що саме йому можна прибирати";
        $src =~ /^[A-Za-z0-9._-]{1,64}$/
            or die_msg "source: літери, цифри, точка, дефіс, підкреслення, ",
                       "до 64 символів";
        $src ne 'local' || $force
            or die_msg "source='local' — це мітка РУЧНИХ записів. Імпорт у ",
                       "неї прибрав би все, що додано руками. Дай спискові ",
                       "власне ім'я (наприклад --source=cip.gov.ua), або ",
                       "--force, якщо це справді те, що потрібно";
        -f $file or die_msg "немає файла '$file'";

        $action = "REJECT recipient domain blocked by policy list ($src)"
            unless defined $action;
        policy_check_action($action);

        # Файл: один домен на рядок, `#` — коментар. Провідні крапки
        # знімаються (рішення №19).
        my (%want, @invalid, $dups);
        open my $fh, '<', $file or die_msg "не читається '$file': $!";
        my $line = 0;
        while (my $l = <$fh>) {
            $line++;
            $l =~ s/\r?\n\z//;
            $l =~ s/#.*//;
            $l =~ s/^\s+|\s+$//g;
            next unless length $l;
            my ($d) = split /[\s,;]+/, $l;
            $d = policy_norm_domain($d);
            # Своя перевірка, а не valid_domain(): той падає, а тут
            # потрібно ПЕРЕЛІЧИТИ погані рядки — у списку на 50 тисяч
            # помилка в одному рядку не має валити весь імпорт без
            # пояснення, де саме.
            unless ($d =~ /^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$/
                    && length($d) <= 255) {
                push @invalid, "$line: $l";
                next;
            }
            $dups++ if $want{$d}++;
        }
        close $fh;

        %want or die_msg "у '$file' немає жодного домену";
        if (@invalid) {
            say STDERR "mailctl: у '$file' рядків, не схожих на домен: ",
                       scalar(@invalid);
            say STDERR "  $_" for @invalid[0 .. ($#invalid > 9 ? 9 : $#invalid)];
            say STDERR '  ...' if @invalid > 10;
            # IDN тут не підтримується НАВМИСНО: Postfix бачить домен
            # конверта в punycode, тож і в таблиці він мусить лежати
            # так само. Кириличний рядок просто ніколи не збігся б, і
            # це була б тиха дірка в чорному списку.
            say STDERR "  (IDN записувати в punycode: xn--... — саме в ",
                       "такому вигляді домен приходить у конверті)"
                if grep { /[^\x00-\x7F]/ } @invalid;
            $force or die_msg "імпорт зупинений. Виправити файл, або ",
                              "--force, щоб пропустити ці рядки";
            say STDERR 'mailctl: --force — пропускаю їх.';
        }

        my (undef, $dbh) = db_open($g);
        my $own = policy_own_domains($dbh);
        my @clash = grep { $own->{$_} } sort keys %want;
        if (@clash && !$force) {
            die_msg "у списку ", scalar(@clash), " ВЛАСНИХ доменів групи (",
                    join(', ', @clash[0 .. ($#clash > 4 ? 4 : $#clash)]),
                    @clash > 5 ? ', ...' : '',
                    "). Блокування за доменом отримувача зупинило б пошту ",
                    "їхнім же користувачам. Прибрати їх зі списку, або ",
                    "--force";
        }
        delete @want{@clash} if @clash && $force;

        my $have = db_all($dbh,
            'SELECT domain, include_subdomains, action FROM recipient_policy'
          . ' WHERE source = ?', $src);
        my %cur = map { $_->{domain} => $_ } @$have;

        my @add = grep { !$cur{$_} } sort keys %want;
        my @upd = grep { $cur{$_}
                         && ($cur{$_}{action} ne $action
                             || ($cur{$_}{include_subdomains} ? 1 : 0) != $subs)
                       } sort keys %want;
        my @del = grep { !$want{$_} } sort keys %cur;

        # Запобіжник проти ОБРІЗАНОГО файла. Завантаження, що впало на
        # середині, дало б валідний список — просто коротший, — і
        # синхронізація мовчки прибрала б решту. На чорній дірі в 50
        # тисяч доменів це означає, що спам раптом пішов абонентам.
        if (@$have > 100 && keys(%want) * 2 < @$have && !$force) {
            die_msg "у файлі ", scalar(keys %want), " доменів, а в source ",
                    "'$src' уже ", scalar(@$have), " — тобто імпорт прибрав ",
                    "би більше половини. Найімовірніше файл обрізаний ",
                    "(недовантажився). Якщо список справді так ",
                    "скоротився — --force";
        }

        say "[$g] source='$src': доменів у файлі ", scalar(keys %want),
            ($dups ? " (повторів: $dups)" : '');
        say "  додати: ", scalar(@add),
            ", оновити: ", scalar(@upd),
            ", прибрати: ", scalar(@del);
        say "  дія: $action";
        if ($dry) {
            say '';
            say '  --dry-run: нічого не записано.';
            for my $d (@add[0 .. ($#add > 4 ? 4 : $#add)]) { say "    + $d" }
            say '    + ...' if @add > 5;
            for my $d (@del[0 .. ($#del > 4 ? 4 : $#del)]) { say "    - $d" }
            say '    - ...' if @del > 5;
            return;
        }

        # Одна транзакція на весь імпорт: інакше збій на середині
        # залишив би список напів-оновленим, і це найгірший стан —
        # частина доменів блокується, частина ні, а причина не видна.
        $dbh->begin_work or die_msg 'не можу почати транзакцію: ',
                                    $dbh->errstr // '?';
        my $ok = eval {
            if (@add || @upd) {
                my $ins = $dbh->prepare(
                    'INSERT INTO recipient_policy'
                  . ' (domain, include_subdomains, action, source)'
                  . ' VALUES (?, ?, ?, ?)'
                  . ' ON DUPLICATE KEY UPDATE'
                  . ' include_subdomains = VALUES(include_subdomains),'
                  . ' action = VALUES(action), source = VALUES(source)')
                    or die $dbh->errstr . "\n";
                for my $d (@add, @upd) {
                    $ins->execute($d, $subs, $action, $src)
                        or die "$d: " . $ins->errstr . "\n";
                }
            }
            if (@del) {
                my $rm = $dbh->prepare(
                    'DELETE FROM recipient_policy WHERE domain = ? AND source = ?')
                    or die $dbh->errstr . "\n";
                $rm->execute($_, $src) or die "$_: " . $rm->errstr . "\n"
                    for @del;
            }
            1;
        };
        unless ($ok) {
            my $err = $@ || 'невідома помилка';
            $dbh->rollback;
            die_msg "імпорт відкочений цілком: $err";
        }
        $dbh->commit or die_msg 'commit не вдався: ', $dbh->errstr // '?';

        my $total = db_one($dbh, 'SELECT COUNT(*) FROM recipient_policy') // 0;
        say "[$g] готово. У таблиці всього: $total";
        say 'Postfix побачить це ОДРАЗУ: мапа читається з SQL на кожен RCPT.';
        return;
    }

    # ── test ─────────────────────────────────────────────────────────
    # Питаємо САМ POSTFIX, а не повторюємо запит на Perl. Друга копія
    # логіки з генерацією кандидатів розійшлася б із першою мовчки, а
    # тут ще й важливо перевірити ВЕСЬ шлях — разом із proxymap і його
    # списком дозволених таблиць.
    #
    # Ключ МУСИТЬ містити `@`: запит використовує `%d`, і dict_mysql при
    # нерозкритому `%d` запит не виконує взагалі, тихо віддаючи «немає
    # збігу» (PITFALLS).
    if ($sub eq 'test') {
        my ($addr) = @args;
        $addr or die_msg
            "вкажи адресу або домен: ./mailctl policy test $g <email>";
        $addr = lc $addr;
        $addr = "probe\@$addr" unless $addr =~ /\@/;
        # Набір символів звужений СВІДОМО, бо далі адреса їде в `sh -c`
        # усередині одинарних лапок. Так не лишається жодного символу,
        # який там щось означає, і не потрібно нічого екранувати —
        # екранування під чужий шелл у цьому проєкті вже тричі
        # виконалось як команда (бектики, PITFALLS).
        $addr =~ /^[a-z0-9._%+-]+\@[a-z0-9.-]+$/
            or die_msg "'$addr' не схоже на адресу (літери, цифри і ",
                       ". _ % + - до '\@', домен після)";
        my $c   = validate($g);
        my $ctr = "$c->{name}-postfix";
        container_running($ctr)
            or die_msg "контейнер $ctr не запущений — ./mailctl up $c->{dir}";
        for my $via ('mysql', 'proxy:mysql') {
            my $out = capture_quiet('docker', 'exec', $ctr, 'sh', '-c',
                "postmap -q '$addr'"
              . " $via:/etc/postfix/sql/recipient_policy.cf 2>&1");
            $out = '' unless defined $out;
            $out =~ s/\s+$//;
            if ($out =~ /^postmap:/m) {
                say pad($via, 12), ' ЗБІЙ мапи:';
                say "  $_" for split /\n/, $out;
            }
            elsif (length $out) { say pad($via, 12), " -> $out" }
            else                { say pad($via, 12), ' немає збігу (пошта пройде)' }
        }
        return;
    }

    die_msg "невідома підкоманда policy: $sub (list|add|del|import|test)";
}

# ── block: тимчасові блокування за IP і відправником (рішення №20) ────
#
# Навіщо команда. `mynetworks` на isp-подібній групі широкий НАВМИСНО
# (усі абоненти провайдера шлють без авторизації), на office те саме з
# офісною мережею. Звужувати це не можна — вимога власника. Отже
# компенсацією є можливість вийняти з довіри конкретного порушника на
# конкретний час, і вона мусить бути КОМАНДОЮ: SQL руками — це рівно та
# четверта ручна операція, якої в мети проєкту немає.
#
# Вхідні дані для неї вже існують: на isp у `fail2ban.log` 19 тисяч
# невдалих спроб за місяць, і `anvil_status_update_time` пише в лог
# «max connection rate N/60s for (smtp:ADDR)».
#
# Розблокування як операції НЕМА: запит мап має `expires_at > NOW()`,
# тож рядок просто перестає матчитись. `block del` існує для іншого
# випадку — заблокували не те, і чекати до кінця терміну не можна.

# Скільки секунд у `--for`. Доба за замовчуванням не передбачена
# свідомо: термін дії — несуча частина механізму, і «забув указати»
# не має давати тихо вибраний нами строк.
sub block_duration {
    my ($v) = @_;
    my ($n, $u) = $v =~ /^(\d+)\s*([mhdwy])$/i
        or die_msg "--for: очікується <число><m|h|d|w|y>, напр. 30m, 2h, 3d, 1w, 2y";
    my %mul = (m => 60, h => 3600, d => 86400, w => 604800, y => 365 * 86400);
    my $sec = $n * $mul{lc $u};
    $sec > 0 or die_msg '--for: нуль — це не блокування';
    # Рік тут стояв стелею, а повідомлення радило recipient_policy. Порада
    # була хибна: recipient_policy блокує за ОТРИМУВАЧЕМ, тож ні клієнтська
    # адреса, ні відправник у неї не кладуться взагалі.
    # Постійних блокувань не робимо свідомо (рішення власника 2026-11-21:
    # про перманентне тупо забувається). Довгий термін — робить те саме, але
    # сам прибирає за собою: рядок перестає матчитись, і четвертої ручної
    # операції не з'являється.
    $sec <= 10 * 365 * 86400
        or die_msg "--for: більше за десять років. Постійних блокувань у ",
                   "цьому механізмі немає свідомо — термін дії і є тим, що ",
                   "не дає таблиці перетворитись на забутий спадок";
    return $sec;
}

# Людяний залишок часу. Хвилини показуємо лише коли їх менше доби:
# «блокування скінчиться через 3 дні» важливіше за «через 4387 хв».
sub block_left {
    my ($sec) = @_;
    return 'скінчилось' if $sec <= 0;
    return sprintf('%d хв',  int($sec / 60 + 0.5))   if $sec < 3600;
    return sprintf('%.1f год', $sec / 3600)          if $sec < 86400;
    return sprintf('%.1f дн',  $sec / 86400)  if $sec < 365 * 86400;
    return sprintf('%.1f р',   $sec / (365 * 86400));
}

# Форма ключа визначає scope, і це не вгадування: `check_client_access`
# підставляє адресу або її префікс, `check_sender_access` — адресу
# пошти або домен. Перетину між цими формами немає, тож scope
# виводиться однозначно, а --scope лишається для контролю (розхід —
# помилка, а не тихе перевизначення).
#
# CIDR приймаємо, але ЛИШЕ кратний октету: Postfix у access-мапах
# пробує `a.b.c.d`, `a.b.c`, `a.b`, `a`, тобто /32, /24, /16, /8. Маска
# /27 у такій таблиці не виражається взагалі, і прийняти її «майже
# правильно» означало б блокування, якого немає.
sub block_parse_key {
    my ($raw) = @_;
    my $k = lc $raw;
    $k =~ s/^\s+|\s+$//g;
    length $k or die_msg 'порожній ключ';

    # ── IPv6: відмова з причиною, а не тихе «не схоже на адресу» ─────
    if ($k =~ /:/ && $k !~ /\@/) {
        die_msg "'$raw': IPv6. Групи поки без IPv6-адрес ",
                "(inet_protocols виводиться з ADDRESSES), а правила ",
                "усічення ключа в Postfix для IPv6 інші — зробимо ",
                "разом із самим IPv6";
    }

    # ── client: адреса, префікс або CIDR, кратний октету ─────────────
    if ($k =~ m{^(\d{1,3}(?:\.\d{1,3})*)(?:/(\d{1,2}))?$}) {
        my ($ip, $bits) = ($1, $2);
        my @o = split /\./, $ip;
        @o <= 4 or die_msg "'$raw': більше чотирьох октетів";
        for (@o) { $_ <= 255 or die_msg "'$raw': октет $_ > 255" }
        if (defined $bits) {
            $bits =~ /^(8|16|24|32)$/
                or die_msg "'$raw': маска /$bits не виражається в ",
                           "access-мапі. Postfix пробує ключі a.b.c.d, ",
                           "a.b.c, a.b, a — тобто лише /32, /24, /16, /8. ",
                           "Візьми найближчу ширшу або кілька вужчих";
            @o == 4 or die_msg "'$raw': із маскою вказуй усі чотири октети";
            @o = @o[0 .. $bits / 8 - 1];
        }
        return { scope => 'client', key => join('.', @o),
                 octets => scalar @o };
    }

    # ── sender: повна адреса, `localpart@` або домен ─────────────────
    if ($k eq '<>') {
        return { scope => 'sender', key => '<>', null => 1 };
    }
    if ($k =~ /\@/) {
        my ($lp, $dom) = split /\@/, $k, 2;
        length $lp or die_msg "'$raw': порожня локальна частина";
        $lp =~ /^[a-z0-9._%+-]+$/
            or die_msg "'$raw': у локальній частині лишень літери, цифри ",
                       "і . _ % + -";
        if (length $dom) { valid_domain($dom) }
        return { scope => 'sender', key => $k, domain => $dom };
    }
    $k =~ /\./ or die_msg
        "'$raw': без точки й без '\@' — не адреса, не домен і не IP. ",
        "Домен верхнього рівня блокувати цією таблицею не треба";
    valid_domain($k);
    return { scope => 'sender', key => $k, domain => $k };
}

# Що не можна заблокувати, не поклавши власну пошту. Усе через --force,
# бо випадки «саме це й треба» бувають, але вгадувати їх не нам.
sub block_guard {
    my ($c, $p, $dbh, $force) = @_;
    my @stop;

    if ($p->{scope} eq 'client') {
        # Пересилання через носіїв (рішення №37) іде Dovecot-ом на
        # 127.0.0.1:25, а Roundcube — з internal-адреси. Блокування
        # цих префіксів виглядало б як «вебмейл не відправляє» і
        # «пересилання зникло», причому в логах — як чужий abuse.
        push @stop, "це loopback: через 127.0.0.1:25 Dovecot віддає "
                  . "sieve-пересилання (рішення №37)"
            if $p->{key} eq '127' || $p->{key} =~ /^127\./;

        # Збіг перевіряємо В ОБИДВА БОКИ, і це не причіпка: ключ може
        # бути і ШИРШИЙ за internal-мережу (`10.11` — /16, що її
        # містить), і ВУЖЧИЙ (`10.11.11.50` — адреса самого Roundcube).
        # Перша версія ловила лише перший випадок, тобто рівно той, що
        # трапляється рідше: блокують конкретну адресу, а не /16.
        my $pre = $c->{prefix} // '';
        push @stop, "це internal-мережа групи ($pre.0/24): звідти ходить "
                  . "Roundcube, тобто вебмейл перестав би відправляти"
            if length $pre && ($p->{key} eq $pre
                               || index("$pre.",        "$p->{key}.") == 0
                               || index("$p->{key}.",   "$pre.")      == 0);

        for my $a (@{ $c->{addr} || [] }) {
            next unless $a->{ip} eq $p->{key}
                     || index("$a->{ip}.", "$p->{key}.") == 0;
            push @stop, "це власна адреса групи ($a->{ip})";
        }
    }
    else {
        # Блокувати ВЛАСНУ адресу — головний випадок цієї таблиці
        # (скомпрометований акаунт). Блокувати власний ДОМЕН цілком —
        # ні: це зупинило б вихідну пошту всім його користувачам.
        if (!$p->{domain} || $p->{key} eq $p->{domain}) {
            my $dom = $p->{domain} // '';
            if (length $dom) {
                my $own = db_one($dbh,
                    'SELECT type FROM domains WHERE domain = ?', $dom);
                push @stop, "'$dom' — ВЛАСНИЙ домен групи ($own), і ключ "
                          . "тут доменний: "
                          . ($own eq 'RELAY'
                             ? 'ми його резервний MX, тобто відмовляли б '
                             . 'усій пошті, яку беремось для нього приймати'
                             : 'це зупинило б вихідну пошту ВСІМ його '
                             . 'користувачам')
                          . '. Блокуй конкретну адресу'
                    if defined $own;
            }
            my $mh = lc($c->{env}{MAIL_HOSTNAME} // '');
            push @stop, "це ім'я вузла групи: з нього йдуть наші ж DSN "
                      . "(double-bounce\@, MAILER-DAEMON\@)"
                if length $mh && $dom eq $mh;
        }
        # `localpart@` — ключ, який Postfix пробує ОКРЕМО від домену,
        # тобто блокує цю локальну частину в УСІХ доменах, свої
        # включно. Не відмова (випадок буває: та сама `info@` з сотні
        # підроблених доменів), але сказати треба.
        say STDERR "mailctl: УВАГА: ключ '$p->{key}' — це локальна частина ",
                   "в ЛЮБОМУ домені, включно з власними ",
                   "(Postfix пробує 'localpart\@' окремим ключем)"
            if $p->{key} =~ /\@$/;

        my $pm = lc($c->{env}{POSTMASTER_ADDRESS} // '');
        push @stop, "це POSTMASTER_ADDRESS групи"
            if length $pm && $p->{key} eq $pm;

        push @stop, "'<>' — порожній відправник (ключ "
                  . "smtpd_null_access_lookup_key), тобто ВСІ баунси й "
                  . "DSN, включно з потрібними"
            if $p->{null};
    }

    return unless @stop;
    die_msg "не блокую $p->{key}: ", join('; ', @stop),
            ". Якщо це справді те, що потрібно — --force"
        unless $force;
    say STDERR "mailctl: УВАГА, --force: $_" for @stop;
}

# Послідовність ключів, яку пробує САМ Postfix. Це не друга копія
# запиту (запит лишається в .cf) — це копія документованої поведінки
# access(5), і без неї `block test` брехав би в найчастішому випадку:
# заблокували /24, тестують адресу, точного ключа в таблиці немає,
# postmap віддає «немає збігу» — і виглядає, ніби блокування не діє.
#
#   client — повна адреса, потім a.b.c, a.b, a;
#   sender — повна адреса, потім `localpart@`, потім домен, і лише
#            ЯКЩО smtpd_access_maps є в parent_domain_matches_subdomains,
#            його батьківські домени.
sub block_test_keys {
    my ($p, $parents) = @_;
    if ($p->{scope} eq 'client') {
        my @o = split /\./, $p->{key};
        return map { join('.', @o[0 .. $_]) } reverse 0 .. $#o;
    }
    return ($p->{key}) if $p->{key} eq '<>';
    my @k = ($p->{key});
    if (my $d = $p->{domain}) {
        if ($p->{key} ne $d) {
            my ($lp) = split /\@/, $p->{key}, 2;
            push @k, "$lp\@";
        }
        push @k, $d unless $p->{key} eq $d;
        if ($parents) {
            my @lab = split /\./, $d;
            while (@lab > 2) { shift @lab; push @k, join('.', @lab) }
        }
    }
    return @k;
}

sub block_map_file {
    return $_[0] eq 'client' ? 'abuse_client.cf' : 'abuse_sender.cf';
}

sub cmd_block {
    my ($sub, @rest) = @_;
    my $g = need_group(@rest);
    shift @rest;
    my @args = @rest;

    # ── list ─────────────────────────────────────────────────────────
    # За замовчуванням ЧИННІ. Прострочені лишаються в таблиці як єдина
    # історія інцидентів, яка в нас є, але в щоденному виводі вони шум:
    # питання майже завжди «кого зараз заблоковано».
    if ($sub eq 'list') {
        my ($all, $scope, $limit) = (0, undef, 50);
        for my $o (@args) {
            if    ($o eq '--all')            { $all   = 1 }
            elsif ($o =~ /^--scope=(.+)$/)   { $scope = lc $1 }
            elsif ($o =~ /^--limit=(\d+)$/)  { $limit = $1 }
            else { die_msg "невідомий аргумент '$o'" }
        }
        !defined $scope || $scope =~ /^(client|sender)$/
            or die_msg "--scope: client або sender";
        my (undef, $dbh) = db_open($g);

        my (@w, @b);
        push @w, 'expires_at > NOW()' unless $all;
        if (defined $scope) { push @w, 'scope = ?'; push @b, $scope }
        my $where = @w ? ' WHERE ' . join(' AND ', @w) : '';
        my $n = db_one($dbh, "SELECT COUNT(*) FROM abuse_block$where", @b) // 0;
        unless ($n) {
            say "[$g] ", ($all ? 'abuse_block порожня'
                               : 'чинних блокувань немає'),
                defined $scope ? " (scope=$scope)" : '';
            say 'Прострочені теж показати: --all' unless $all;
            return;
        }
        my $sql = "SELECT scope, block_key, action, reason, added_by,"
                . " TIMESTAMPDIFF(SECOND, NOW(), expires_at) AS left_s"
                . " FROM abuse_block$where"
                . " ORDER BY expires_at DESC, scope, block_key";
        $sql .= " LIMIT $limit" if $limit;
        my $rows = db_all($dbh, $sql, @b);
        say "[$g] ", ($all ? 'усі записи' : 'чинні блокування'), ": $n",
            ($limit && $n > $limit ? ", показано $limit" : '');
        say '  ', pad('SCOPE', 7), ' ', pad('КЛЮЧ', 32), ' ',
            pad('ЛИШИЛОСЬ', 12), ' ', pad('ДІЯ', 8), ' ПРИЧИНА';
        for my $r (@$rows) {
            my ($act) = ($r->{action} // '') =~ /^(\S+)/;
            say '  ', pad($r->{scope}, 7), ' ', pad($r->{block_key}, 32),
                ' ', pad(block_left($r->{left_s} // 0), 12), ' ',
                pad($act // '', 8), ' ', ($r->{reason} // '');
        }
        say "  ... ще ", $n - $limit, " (--limit=0)" if $limit && $n > $limit;
        return;
    }

    # ── add ──────────────────────────────────────────────────────────
    if ($sub eq 'add') {
        my ($raw, @opt) = @args;
        $raw && $raw !~ /^--/ or die_msg
            "вкажи ключ і термін: ./mailctl block add <group> <ключ> ",
            "--for=<2h|3d|1w> [--reason=...] [--action=...]\n",
            "  ключ: IP, IP/8|16|24|32, адреса пошти або домен ",
            "(scope виводиться з форми)";
        my ($for, $reason, $scope, $by, $force);
        my $action = 'REJECT temporarily blocked for abuse';
        for my $o (@opt) {
            if    ($o =~ /^--for=(.+)$/)     { $for    = $1 }
            elsif ($o =~ /^--reason=(.*)$/)  { $reason = $1 }
            elsif ($o =~ /^--action=(.+)$/)  { $action = $1 }
            elsif ($o =~ /^--scope=(.+)$/)   { $scope  = lc $1 }
            elsif ($o =~ /^--by=(.+)$/)      { $by     = $1 }
            elsif ($o eq '--force')          { $force  = 1 }
            else { die_msg "невідомий аргумент '$o'" }
        }
        defined $for or die_msg
            "--for обов'язковий: блокування тут ТИМЧАСОВЕ за побудовою ",
            "(розблокування як операції немає — рядок перестає ",
            "матчитись сам). Напр. --for=2h, --for=3d, --for=1w";
        my $sec = block_duration($for);
        my $p   = block_parse_key($raw);
        !defined $scope || $scope eq $p->{scope}
            or die_msg "--scope=$scope, а ключ '$raw' за формою ",
                       "$p->{scope}. Один із двох помилковий — не вгадую";
        # Той самий валідатор, що в policy: набір дозволених дій і
        # причини заборон однакові, бо це однакові відповіді Postfix на
        # RCPT. Друга копія таблиці розійшлася б із першою мовчки.
        policy_check_action($action, '--reason');
        say STDERR "mailctl: УВАГА: DISCARD з'їсть лист мовчки — ",
                   "відправник (а це найчастіше наш же абонент) не ",
                   "дізнається, що його заблоковано"
            if $action =~ /^\s*DISCARD\b/i;

        my ($c, $dbh) = db_open($g);
        block_guard($c, $p, $dbh, $force);
        $by = $ENV{SUDO_USER} || $ENV{USER} || 'mailctl' unless defined $by;

        my $had = db_one($dbh,
            'SELECT TIMESTAMPDIFF(SECOND, NOW(), expires_at)'
          . ' FROM abuse_block WHERE scope = ? AND block_key = ?',
            $p->{scope}, $p->{key});
        # Термін лічить СУБД, а не ми: мапа порівнює з її ж NOW(), тож
        # інший годинник тут давав би блокування, що «скінчилось
        # раніше» — рівно той клас тихої помилки, якого ми уникаємо.
        db_do($dbh,
            'INSERT INTO abuse_block'
          . ' (scope, block_key, action, reason, expires_at, added_by)'
          . ' VALUES (?, ?, ?, ?, NOW() + INTERVAL ? SECOND, ?)'
          . ' ON DUPLICATE KEY UPDATE action = VALUES(action),'
          . ' reason = VALUES(reason), expires_at = VALUES(expires_at),'
          . ' added_by = VALUES(added_by), added_at = NOW()',
            $p->{scope}, $p->{key}, $action, $reason, $sec, $by);

        say defined $had
            ? "[$g] оновлено $p->{scope} $p->{key} (лишалось: "
              . block_left($had) . ')'
            : "[$g] заблоковано $p->{scope} $p->{key}";
        say "  дія:      $action";
        say "  до:       ", block_left($sec), " від цієї хвилини";
        say "  причина:  $reason" if defined $reason && length $reason;
        if ($p->{scope} eq 'client' && ($p->{octets} // 4) < 4) {
            my $bits = ($p->{octets} // 4) * 8;
            say "  ШИРИНА:   /$bits, тобто ",
                ($bits == 8 ? '16 мільйонів адрес' :
                 $bits == 16 ? '65 тисяч адрес' : '256 адрес');
        }
        say 'Postfix побачить це ОДРАЗУ: мапа читається з SQL на кожну сесію.';
        say "Що саме він віддасть: ./mailctl block test $g $p->{key}";
        return;
    }

    # ── del ──────────────────────────────────────────────────────────
    # Потрібен не для «розблокувати» (це робить сам термін), а для
    # «заблокували не те»: чекати кінець терміну, поки офіс без пошти,
    # не варіант.
    if ($sub eq 'del') {
        my @keys = grep { !/^--/ } @args;
        my @opt  = grep {  /^--/ } @args;
        my $scope;
        for my $o (@opt) {
            if ($o =~ /^--scope=(.+)$/) { $scope = lc $1 }
            else { die_msg "невідомий аргумент '$o'" }
        }
        @keys or die_msg 'вкажи ключ (можна кілька)';
        my (undef, $dbh) = db_open($g);
        my $gone = 0;
        for my $raw (@keys) {
            my $p = block_parse_key($raw);
            my $sc = $scope // $p->{scope};
            my $r = db_one($dbh,
                'SELECT TIMESTAMPDIFF(SECOND, NOW(), expires_at)'
              . ' FROM abuse_block WHERE scope = ? AND block_key = ?',
                $sc, $p->{key});
            unless (defined $r) { say "  немає: $sc $p->{key}"; next }
            db_do($dbh,
                'DELETE FROM abuse_block WHERE scope = ? AND block_key = ?',
                $sc, $p->{key});
            $gone++;
            say "  прибрано: $sc $p->{key} (лишалось: ", block_left($r), ')';
        }
        say "[$g] прибрано записів: $gone";
        return;
    }

    # ── test ─────────────────────────────────────────────────────────
    # Питаємо САМ Postfix обома каналами. Прямий `mysql:` показує, що
    # таблиця й запит живі; `proxy:` — що мапа дозволена в
    # proxy_read_maps, а в main.cf стоїть саме proxy:.
    #
    # Ключ підставляємо ТОЧНО як Postfix: для клієнта — адресу, для
    # відправника — повну адресу пошти. Усічення робить сам Postfix,
    # тож проба по /24-ключу перевірила б не той шлях.
    if ($sub eq 'test') {
        my ($raw) = @args;
        $raw or die_msg
            "вкажи ключ: ./mailctl block test $g <IP|адреса|домен>";
        my $p   = block_parse_key($raw);
        my $map = block_map_file($p->{scope});
        my $c   = validate($g);
        my $ctr = "$c->{name}-postfix";
        container_running($ctr)
            or die_msg "контейнер $ctr не запущений — ./mailctl up $c->{dir}";

        # Чи розгортає Postfix батьківські домени в access-мапах —
        # питаємо його, а не пам'ять: список залежить від
        # compatibility_level, і саме на цьому вже обпікся relay_domains.
        my $pdms = capture_quiet('docker', 'exec', $ctr,
            'postconf', '-h', 'parent_domain_matches_subdomains') // '';
        my $parents = $pdms =~ /smtpd_access_maps/ ? 1 : 0;

        my @keys = block_test_keys($p, $parents);
        # Набір символів звужений СВІДОМО: далі ключі їдуть у `sh -c`
        # усередині одинарних лапок, і так не лишається жодного
        # символу, який там щось означає (бектики в цьому проєкті вже
        # тричі виконались як команда).
        for my $k (@keys) {
            $k =~ /^(?:<>|[a-z0-9._%+@-]+)$/
                or die_msg "'$k' містить символи, яких я не пропускаю в ",
                           "команду контейнера";
        }
        say "scope=$p->{scope}, мапа $map";
        say 'ключі, які пробує Postfix: ', join(' -> ', @keys);
        say '  (батьківські домени ', ($parents ? 'розгортаються' :
            'НЕ розгортаються'), ": parent_domain_matches_subdomains)"
            if $p->{scope} eq 'sender';
        say '';

        for my $via ('mysql', 'proxy:mysql') {
            my ($hit, $err);
            for my $k (@keys) {
                my $out = capture_quiet('docker', 'exec', $ctr, 'sh', '-c',
                    "postmap -q '$k' $via:/etc/postfix/sql/$map 2>&1");
                $out = '' unless defined $out;
                $out =~ s/\s+$//;
                if ($out =~ /^postmap:/m) { $err = $out; last }
                if (length $out) { $hit = [ $k, $out ]; last }
            }
            if (defined $err) {
                say pad($via, 12), ' ЗБІЙ мапи:';
                say "  $_" for split /\n/, $err;
            }
            elsif ($hit) {
                say pad($via, 12), " ЗАБЛОКОВАНО за ключем '$hit->[0]'";
                say ' ' x 13, "-> $hit->[1]";
            }
            else {
                say pad($via, 12), ' немає збігу ні на жодному ключі',
                    ' (не заблоковано)';
            }
        }
        return;
    }

    die_msg "невідома підкоманда block: $sub (list|add|del|test)";
}

# ── user ──────────────────────────────────────────────────────────────
sub cmd_user {
    my ($sub, @rest) = @_;
    my $g = need_group(@rest);
    shift @rest;
    my @args = @rest;

    if ($sub eq 'list') {
        # --hash показує САМ хеш, не лише схему.
        #
        # Потрібен там, де питання не «яка схема», а «чи змінився
        # запис». На полігоні це вже коштувало хибного висновку: після
        # зміни пароля у вебмейлі ми дивились на схему (ARGON2ID) і на
        # `doveadm auth test`, але не бачили, що хеш узагалі не
        # мінявся — крок зі зміною пропустили, а схема була та сама,
        # бо її пише й `doveadm pw`.
        #
        # Знадобиться й при міграції: рішення №25 вимагає явного
        # префікса в КОЖНОГО рядка, і перевіряти це доведеться оком.
        my @opt = grep { /^--/ } @args;
        my $show_hash = grep { $_ eq '--hash' } @opt;
        for my $o (@opt) {
            $o eq '--hash' or die_msg "невідомий аргумент '$o'; є --hash";
        }
        my ($dom) = grep { !/^--/ } @args;
        if (defined $dom) { $dom = lc $dom; valid_domain($dom) }
        my (undef, $dbh) = db_open($g);
        my $rows = db_all($dbh,
            'SELECT `user`, domain, login, passwd, home, quota, active, comment FROM users '
          . (defined $dom ? 'WHERE domain = ? ' : '')
          . 'ORDER BY domain, `user`',
            (defined $dom ? ($dom) : ()));
        @$rows or do { say "[$g] скриньок немає"; return };
        # Логін показуємо окремим стовпцем: на групах isp-типу він не
        # виводиться з адреси, тож без нього з виводу не видно, ЧИМ
        # користувач входить. Прочерк означає «лише повною адресою».
        # pad(), а не printf("%-40s"): printf рахує БАЙТИ, а заголовки тут
        # українські, тобто двобайтові. Через це заголовок «АДРЕСА» (6
        # символів, 12 байтів) з'їдав 6 позицій ширини, і шапка
        # розходилася з даними на кожній колонці.
        say join ' ', pad('АДРЕСА', 40), pad('ЛОГІН', 18), pad('АКТИВ', 6),
                      pad('КВОТА', 6), pad('СХЕМА', 12),
                      ($show_hash ? 'ХЕШ' : 'ПРИМІТКИ');
        for my $r (@$rows) {
            my ($scheme) = ($r->{passwd} // '') =~ /^\{([^}]+)\}/;
            my @note;
            push @note, $r->{comment} if defined $r->{comment} && length $r->{comment};
            # Розходження обчисленого home з записаним — матеріал для
            # міграції (див. шапку схеми). Для нових скриньок його не
            # буває, бо ми пишемо канонічний шлях одразу.
            my $canon = mailbox_path($r->{user}, $r->{domain});
            push @note, "home=$r->{home} (не $canon)"
                if defined $r->{home} && $r->{home} ne $canon;
            say join ' ',
                pad("$r->{user}\@$r->{domain}", 40),
                pad((defined $r->{login} && length $r->{login}
                         ? $r->{login} : '-'), 18),
                pad($r->{active} // '?', 6),
                pad($r->{quota} // '-', 6),
                pad($scheme // 'БЕЗ ПРЕФІКСА', 12),
                ($show_hash ? ($r->{passwd} // '') : join('; ', @note));
        }
        return;
    }

    if ($sub eq 'add') {
        my ($email, @opt) = @args;
        my ($quota, $comment, $random, $inactive, $login);
        for my $o (@opt) {
            no_password_flag($o);
            if    ($o =~ /^--quota=(\d+)$/)    { $quota    = $1 }
            elsif ($o =~ /^--comment=(.*)$/s)  { $comment  = $1 }
            elsif ($o =~ /^--login=(.+)$/)     { $login    = lc $1 }
            elsif ($o eq '--no-login')         { $login    = '' }
            elsif ($o eq '--random')           { $random   = 1 }
            elsif ($o eq '--inactive')         { $inactive = 1 }
            else { die_msg "невідомий аргумент '$o'" }
        }
        # Короткий логін (рішення №15). Форма — як у локальної частини, і
        # без '@': із ним він збігся б із простором адрес, а запит Dovecot
        # розрізняє гілки саме за наявністю '@'.
        #
        # Логін НЕ мусить бути пов'язаний з адресою: на джерелах бувають
        # і 'eml_user' при скриньці user@domain, і 'user' при user@domain,
        # і цілком сторонні набори символів. Тому перевіряємо лише форму.
        if (defined $login && length $login) {
            $login =~ /^[a-z0-9][a-z0-9._-]{0,63}$/
                or die_msg "--login='$login': очікується до 64 символів ",
                           "[a-z0-9._-], перший — літера або цифра, без '\@'";
        }
        my ($l, $d) = split_email($email);
        my ($c, $dbh) = db_open($g);

        # Перевірка, якої бракувало: без запису в `domains` Postfix
        # відповідає `Relay access denied`, і причину шукають у
        # restrictions, а не в базі.
        my $type = db_one($dbh, 'SELECT type FROM domains WHERE domain = ?', $d);
        defined $type or die_msg
            "домену '$d' немає в таблиці `domains`, а без нього Postfix ",
            "відповідає на RCPT `Relay access denied`.\n",
            "  ./mailctl domain add $g $d";
        $type eq 'LOCAL' or die_msg
            "домен '$d' має type='$type'. Локальні скриньки бувають лише ",
            "в LOCAL: virtual_mailbox_domains відбирає саме його.";

        db_one($dbh, 'SELECT id FROM users WHERE `user` = ? AND domain = ?', $l, $d)
            and die_msg "скринька $l\@$d уже є";

        # ДЕФОЛТ: короткий логін дорівнює локальній частині адреси.
        # Так користувач user@domain заходить і як 'user', і повною
        # адресою — найчастіший випадок, і саме його очікують.
        #
        # Але дефолт мусить уміти ВІДСТУПИТИ: логін унікальний на всю
        # групу, а однакові локальні частини в різних доменах — не
        # рідкість (на isp 3 випадки, на office 11). Другий info@ не
        # має падати з помилкою через перший — він просто лишається
        # доступним за повною адресою.
        my $explicit = defined $login;
        if (!$explicit) {
            my $taken = db_one($dbh, 'SELECT id FROM users WHERE login = ?', $l)
                     || db_one($dbh, 'SELECT id FROM users WHERE `user` = ? '
                                   . 'AND domain <> ? LIMIT 1', $l, $d);
            if ($taken) {
                say STDERR "mailctl: короткий логін '$l' уже зайнятий у цій ",
                           "групі — скринька буде доступна лише за повною ",
                           "адресою.";
                say STDERR "  Потрібен короткий вхід — задайте свій: ",
                           "--login=<логін>";
                $login = '';
            }
            else { $login = $l }
        }

        if (defined $login && length $login) {
            db_one($dbh, 'SELECT id FROM users WHERE login = ?', $login)
                and die_msg "логін '$login' уже зайнятий. Він унікальний на ",
                            "всю групу: вводиться без домену, тож двох ",
                            "однакових Dovecot розрізнити не може.";
            # КОЛІЗІЯ ЛОГІНА З ЧУЖОЮ АДРЕСОЮ — рівно той випадок, що вже
            # є на office (login='office' при скриньці account@, тоді як
            # office@ має логін 'ofice'). Запит Dovecot шукає за двома
            # стовпцями, тож власник такого логіна, увівши
            # <логін>@<домен>, потрапляє в ЧУЖИЙ рядок: пароль не
            # зійдеться, і це виглядатиме як «пароль раптом не підходить».
            my $clash = db_one($dbh,
                'SELECT CONCAT(`user`, \'@\', domain) FROM users '
              . 'WHERE `user` = ? LIMIT 1', $login);
            !defined $clash or die_msg
                "логін '$login' збігається з локальною частиною наявної ",
                "скриньки $clash.\n",
                "  Dovecot приймає і логін, і повну адресу, тож власник ",
                "цього логіна, увівши '$login\@$d', потрапить у рядок ",
                "$clash — зі своїм паролем, тобто отримає відмову без ",
                "видимої причини.\n",
                "  Оберіть інший логін, або не задавайте його взагалі: ",
                "тоді вхід буде за повною адресою.";
        }

        my $pass = ask_password($random);
        my $hash = dovecot_pw($c, $g, $pass);
        my $home = mailbox_path($l, $d);

        # Стовпці — з нашого ж літерального списку, значення — через
        # прив'язку. quota й comment додаються лише коли задані, щоб
        # діяли DEFAULT-и схеми, а не наша копія їхніх значень.
        my @col = ('`user`', 'domain', 'passwd', 'home', 'active');
        my @val = ($l, $d, $hash, $home, $inactive ? 'N' : 'Y');
        # Порожній рядок означає «без короткого логіна». У БД це NULL, бо
        # UNIQUE не дозволив би двох порожніх рядків, а NULL — дозволяє.
        if (defined $login) {
            push @col, 'login';
            push @val, (length $login ? $login : undef);
        }
        if (defined $quota)   { push @col, 'quota';   push @val, $quota }
        if (defined $comment) { push @col, 'comment'; push @val, $comment }
        db_do($dbh, 'INSERT INTO users (' . join(', ', @col) . ') VALUES ('
                  . join(', ', map { '?' } @col) . ')', @val);

        # Пароль показуємо ЛИШЕ тепер, коли запис точно ліг.
        if ($random) {
            say "пароль: $pass";
            say '(показується ОДИН раз — у базі лишається тільки хеш)';
        }
        say "[$g] створено $l\@$d" . ($inactive ? ' (active=N)' : '');
        say "Вхід: $l\@$d" . (length($login // '') ? " або '$login'"
                                                    : ' (короткого логіна немає)');
        say "Скриньку $home створить Dovecot при першій доставці або вході — ",
            "руками створювати не треба.";
        return;
    }

    if ($sub eq 'passwd') {
        my ($email, @opt) = @args;
        my $random;
        for my $o (@opt) {
            no_password_flag($o);
            $o eq '--random' ? ($random = 1) : die_msg "невідомий аргумент '$o'";
        }
        my ($l, $d) = split_email($email);
        my ($c, $dbh) = db_open($g);
        db_one($dbh, 'SELECT id FROM users WHERE `user` = ? AND domain = ?', $l, $d)
            or die_msg "скриньки $l\@$d немає";
        my $pass = ask_password($random);
        my $hash = dovecot_pw($c, $g, $pass);
        db_do($dbh, 'UPDATE users SET passwd = ? WHERE `user` = ? AND domain = ?',
              $hash, $l, $d);
        # Після UPDATE, не до нього: при збої показаний пароль не діяв би,
        # а старий лишався чинним — і це найгірший варіант для людини,
        # якій його вже продиктували.
        if ($random) {
            say "пароль: $pass";
            say '(показується ОДИН раз — у базі лишається тільки хеш)';
        }
        say "[$g] пароль $l\@$d змінено";
        say 'Діє одразу — passdb читається з SQL на кожну автентифікацію. ',
            'Але ВЖЕ ВІДКРИТІ сесії IMAP/POP3 не рвуться: клієнт із старим ',
            'паролем читає пошту, поки не перепідключиться.';
        return;
    }

    if ($sub eq 'del') {
        my ($email, @opt) = @args;
        my $purge;
        for my $o (@opt) {
            $o eq '--purge' ? ($purge = 1) : die_msg "невідомий аргумент '$o'";
        }
        my ($l, $d) = split_email($email);
        my ($c, $dbh) = db_open($g);
        db_one($dbh, 'SELECT id FROM users WHERE `user` = ? AND domain = ?', $l, $d)
            or die_msg "скриньки $l\@$d немає";
        db_do($dbh, 'DELETE FROM users WHERE `user` = ? AND domain = ?', $l, $d);
        say "[$g] запис $l\@$d видалено";

        my $path = mailbox_path($l, $d);
        unless ($purge) {
            say "Файли скриньки ЛИШИЛИСЬ: $path у томі vmail-data.";
            say 'Прибрати разом із записом — --purge.';
            return;
        }
        my $ctr = "$c->{name}-dovecot";
        container_running($ctr)
            or die_msg "запис видалено, а файли ні: контейнер $ctr не запущений";
        # Шлях будуємо САМІ з перевірених localpart і домену, а не
        # беремо users.home: при міграції там може лежати що завгодно, і
        # `rm -rf` на цьому — остання річ, яку хочеться побачити.
        say "видаляю $path";
        run('docker', 'exec', $ctr, 'rm', '-rf', '--', $path)
            or die_msg "не вдалось видалити $path";
        say 'готово';
        return;
    }

    if ($sub eq 'disable' || $sub eq 'enable') {
        my ($email) = @args;
        my ($l, $d) = split_email($email);
        my $to = $sub eq 'disable' ? 'N' : 'Y';
        my (undef, $dbh) = db_open($g);
        db_one($dbh, 'SELECT id FROM users WHERE `user` = ? AND domain = ?', $l, $d)
            or die_msg "скриньки $l\@$d немає";
        db_do($dbh, 'UPDATE users SET active = ? WHERE `user` = ? AND domain = ?',
              $to, $l, $d);
        if ($to eq 'N') {
            say "[$g] $l\@$d вимкнено (active=N)";
            # Рішення №25: вимкнення — прапорець у таблиці, а не
            # зіпсований хеш. `{DISABLE}` на office не схема: Dovecot
            # про неї не знає, і рядок просто не спрацьовує.
            say 'Запис зникає з подання usersdb, тобто ні автентифікації, ні ',
                'доставки. Файли й пароль лишаються — enable повертає як було.';
        } else {
            say "[$g] $l\@$d увімкнено (active=Y)";
        }
        return;
    }

    die_msg "невідома підкоманда user: $sub ",
            "(list|add|del|passwd|disable|enable)";
}

# ── Заголовки доставленого листа ──────────────────────────────────────
#
# Існує тому, що ту саму перевірку робили вручну шість разів, і двічі
# вона дала ХИБНИЙ результат:
#
#   - `grep -E "^(X-Spam|...)"` губить ПРОДОВЖЕННЯ згорнутих рядків
#     (RFC 5322 folding), тож список правил SpamAssassin виглядав
#     обрізаним на першому;
#   - `ls -t | head -1` одразу після `swaks` віддавав ПОПЕРЕДНІЙ лист:
#     `250 Ok: queued` означає «прийнято в чергу», а не «лежить у
#     Maildir». Тема й відправник ті самі, тож підміну не видно.
#
# Тому: з ID — ЧЕКАЄМО, поки лист із ним з'явиться (гонка зникає за
# побудовою, бо ID Postfix друкує і в `250`, і в `Received:`); без ID —
# найновіший. І друкуємо БЛОК заголовків цілком, а не вибрані рядки.
sub cmd_headers {
    my ($g, $email, @args) = @_;
    my $id;
    for my $a (@args) {
        $a =~ /^--id=(.+)$/ ? ($id = $1)
                            : ($a =~ /^-/ ? die_msg "невідомий аргумент '$a'"
                                          : ($id = $a));
    }
    my ($l, $d) = split_email($email);
    my $mb = mailbox_path($l, $d);

    my $c   = validate($g);
    my $ctr = "$c->{name}-dovecot";
    container_running($ctr) or die_msg
        "контейнер $ctr не запущений — скриньки нізвідки читати.\n",
        "  ./mailctl up $g";

    # Скрипт у контейнері; $mb і $id ідуть ПОЗИЦІЙНИМИ аргументами, не
    # підстановкою в текст — інакше будь-яка лапка в них ламала б усе.
    my $sh = <<'SH';
mb=$1; id=$2
[ -d "$mb" ] || { echo "немає каталогу $mb — скринька ще не створена (Dovecot робить це при першій доставці)" >&2; exit 1; }
f=
if [ -n "$id" ]; then
    i=0
    while [ "$i" -lt 20 ]; do
        f=$(grep -rl -- "$id" "$mb/new" "$mb/cur" 2>/dev/null | head -1)
        [ -n "$f" ] && break
        i=$((i + 1)); sleep 1
    done
    [ -n "$f" ] || { echo "за 20 с лист з ID '$id' не з'явився у $mb" >&2; exit 1; }
else
    f=$(ls -t "$mb/new"/* "$mb/cur"/* 2>/dev/null | head -1)
    [ -n "$f" ] || { echo "у $mb немає листів" >&2; exit 1; }
fi
echo "== $f"
# До першого порожнього рядка: це межа заголовків. Рядки-продовження
# починаються з пробілу, тобто під /^[[:space:]]*$/ не підпадають.
sed -n '/^[[:space:]]*$/q;p' "$f"
SH
    run('docker', 'exec', $ctr, 'sh', '-c', $sh, 'sh', $mb, $id // '')
        or exit 1;
}

# ── диспетчер ─────────────────────────────────────────────────────────
my %cmd = (
    build => sub { run_or_die("$root/_images/build.sh") },
    net   => sub { cmd_net($_[0]) },

    up => sub {
        my $g = need_group(@_);
        my $c = validate($g);
        for my $a (@{ $c->{addr} }) {
            my $n = docker_net_name($a->{net});
            net_exists($n)
                or die_msg "мережі '$n' немає — спершу ./mailctl net up $a->{net}";
        }
        warn_stale_images($c->{env}{IMAGE_TAG} // 'trixie', service_images());
        # ДО compose: інакше Docker створить відсутні каталоги
        # перекриття сам і від root.
        ensure_group_config_dirs($g);
        warn_stale_config_dirs($g);
        compose_group($g, 'up', '-d');

        # Без цього `up` віддає керування, щойно Docker ЗАПУСТИВ
        # контейнери, а не коли вони готові. Наступна ж команда в тому
        # самому блоці (`domain add`, `db-load`, `user add`) отримує
        # "Can't connect to server", і це не збій групи, а гонка —
        # видно її лише за текстом помилки, що проскакує у виводі.
        #
        # На першому запуску backup (2026-11-20) вона з'їла три
        # `domain add` підряд: група піднялась, а таблиця relay_domains
        # лишилась ПОРОЖНЬОЮ, тобто резервний MX ні для кого не був
        # резервом. Знайшлось лише тому, що `health` друкує кількість
        # доменів окремим рядком.
        #
        # Те саме вже було полагоджено в `reload` — і не зроблено тут.
        # 180 с, а не 60: на ПЕРШОМУ старті clamd читає базу сигнатур
        # (~40 с), а MariaDB створює datadir і виконує mysql-init.
        say '';
        say '── чекаю, поки сервіси почнуть слухати ──';
        wait_for_probes($c, 180, service_images())
            or exit 1;
    },
    down => sub {
        my $g = need_group(@_);
        my $vol = grep { $_ eq '--volumes' } @_[1 .. $#_];
        compose_group($g, 'down', $vol ? ('-v') : ());
    },
    # Згенероване показуємо окремою командою: при розборі «чому воно
    # піднялось не так» перше питання — що саме пішло в compose.
    generated => sub {
        my $g = need_group(@_);
        my $c = validate($g);
        my ($yml, $env) = generate_group_files($c);
        for my $f ($env, $yml) {
            say "── $f ──";
            open my $fh, '<', $f or next;
            print <$fh>;
            close $fh;
        }
    },
    restart => sub {
        my $g = need_group(@_);
        compose_group($g, 'down');
        my $c = compose_group($g, 'up', '-d');
        say '';
        say '── чекаю, поки сервіси почнуть слухати ──';
        wait_for_probes($c, 180, service_images())
            or exit 1;
    },
    ps => sub {
        @_ ? compose_group($_[0], 'ps') : run_or_die('docker', 'ps');
    },
    logs      => sub { my $g = need_group(@_); compose_group($g, 'logs', '-f', @_[1 .. $#_]) },
    check     => sub { cmd_check(@_) },
    netns     => sub { my $g = need_group(@_); cmd_netns($g, @_[1 .. $#_]) },
    'db-schema' => sub { my $g = need_group(@_); cmd_db_schema($g, @_[1 .. $#_]) },
    'db-load'   => sub { my $g = need_group(@_); cmd_db_load($g, @_[1 .. $#_]) },
    groups    => sub { cmd_groups() },
    config    => sub { my $g = need_group(@_); cmd_config($g, $_[1]) },
    reload    => sub { my $g = need_group(@_); cmd_reload($g, @_[1 .. $#_]) },
    dkim      => sub { cmd_dkim(need_group(@_)) },
    dns       => sub { cmd_dns(need_group(@_)) },
    certs     => sub { cmd_certs(@_) },
    # `--all` перехоплюється ДО need_group(): група тут не вказується,
    # і без цього need_group поскаржилась б на «групу --all».
    health    => sub {
        return cmd_health_all(@_) if grep { $_ eq '--all' } @_;
        my $g = need_group(@_);
        cmd_health($g, @_[1 .. $#_]);
    },
    headers   => sub {
        my $g = need_group(@_);
        $_[1] or die_msg 'headers <group> <email> [<queue-id>]';
        cmd_headers($g, @_[1 .. $#_]);
    },
    version   => sub { cmd_version() },
    '--version' => sub { cmd_version() },

    # Ручні операції №2 і №3 з мети проєкту: додати/видалити
    # користувача і змінити йому пароль. Порядок аргументів як у
    # `proxy attach <group>`: підкоманда, потім група.
    user => sub {
        my $sub = shift // die_msg 'user list|add|del|passwd|disable|enable <group> ...';
        cmd_user($sub, @_);
    },
    domain => sub {
        my $sub = shift // die_msg 'domain list|add|del <group> ...';
        cmd_domain($sub, @_);
    },
    policy => sub {
        my $sub = shift // die_msg
            'policy list|add|del|import|test <group> ...';
        cmd_policy($sub, @_);
    },

    block => sub {
        my $sub = shift // die_msg
            'block list|add|del|test <group> ...';
        cmd_block($sub, @_);
    },

    alias => sub {
        my $sub = shift // die_msg
            'alias list|add|del|test <group> ...';
        cmd_alias($sub, @_);
    },

    proxy => sub {
        my $sub = shift // die_msg 'proxy up|down|ps|reload|attach|detach';
        my %p = (
            up     => sub {
                proxy_stub_certs();
                # Контейнер, який compose щойно СТВОРИВ, уже стартував зі
                # свіжим конфігом, і reload йому не потрібен. Ба більше,
                # шкідливий: PID-файл ще не записаний, і `nginx -s reload`
                # падає з `invalid PID number ""` — виглядає як поломка
                # конфігу, хоч nginx цілком здоровий.
                # Порівнюємо саме ID, а не «чи існував»: при зміні
                # compose-файла контейнер перестворюється, і новий ID
                # означає той самий свіжий старт.
                my $before = proxy_container_id();
                compose_proxy('up', '-d');
                my $after  = proxy_container_id();
                if (defined $before && defined $after && $before eq $after) {
                    proxy_refresh();
                }
                else {
                    say 'nginx створено заново — конфіги прочитані при старті';
                }
            },
            # Окремо, бо потрібно й без up: правка vhost руками — це
            # штатний випадок (файл не перезаписується, якщо вже є).
            reload => sub { proxy_refresh() },
            down   => sub { compose_proxy('down') },
            ps     => sub { compose_proxy('ps') },
            attach => sub { cmd_attach(need_group(@_)) },
            detach => sub { cmd_detach(need_group(@_)) },
        );
        ($p{$sub} || sub { die_msg "невідома підкоманда proxy: $sub" })->(@_);
    },

    help     => sub { usage() },
    '-h'     => sub { usage() },
    '--help' => sub { usage() },
);

@ARGV or do { usage(); exit 1 };
my $what = shift @ARGV;
($cmd{$what} || sub { die_msg "невідома команда: $what (спробуй ./mailctl help)" })->(@ARGV);
