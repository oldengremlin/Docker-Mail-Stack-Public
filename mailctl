# Доповнення рядка пробілами до ВИДИМОЇ ширини. Потрібне там, де в
# колонці трапляється кирилиця: printf("%-20s") рахує байти, тож
# український заголовок займає вдвічі менше позицій, ніж просить.
# Рахуємо символи UTF-8 без Encode (рішення №28 — лише core, а тягнути
# модуль заради довжини рядка зайве): довжина в символах — це довжина в
# байтах мінус кількість байтів-продовжень 10xxxxxx.
sub pad {
    my ($str, $width) = @_;
    $str = '' unless defined $str;
    my $cont = () = $str =~ /[\x80-\xBF]/g;
    my $vis  = length($str) - $cont;
    my $need = $width - $vis;
    return $need > 0 ? $str . (' ' x $need) : $str;
}

# Зона ХОСТА — щоб сказати, коли вона розходиться з контейнерами.
sub host_tz {
    if (open my $fh, '<', '/etc/timezone') {
        my $t = <$fh>;
        close $fh;
        if (defined $t) { $t =~ s/\s+//g; return $t if length $t }
    }
    my $l = readlink '/etc/localtime';
    return $1 if defined $l && $l =~ m{zoneinfo/(.+)\z};
    return undef;
}
my $tz_warned = 0;

