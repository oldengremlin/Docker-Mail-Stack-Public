# certbot — випуск і оновлення сертифікатів Let's Encrypt.
#
# Образ без ENTRYPOINT-скрипта і без власної логіки: це НЕ сервіс стеку,
# а одноразовий контейнер, яким керує `mailctl certs` (рішення в
# TODO п.7). Демона тут немає свідомо — Dovecot тримає сертифікат у
# login-процесах і потребує `doveadm reload`, а перезавантажити сусідній
# контейнер зсередини можна лише отримавши docker-сокет, тобто root на
# хості.
#
# Чому збираємо самі, а не беремо certbot/certbot із Docker Hub: те саме
# рішення №1, що й для поштових сервісів. Пакет із Debian оновлюється
# разом із базою й ставить залежності з того ж дистрибутива, а не з pip.
FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive

# openssl у цьому образі потрібен НЕ certbot-ові, а `mailctl proxy up`:
# він цим образом робить САМОПІДПИСАНУ ЗАГЛУШКУ для вебмейл-vhost. Без
# неї nginx не стартує («cannot load certificate»), а без живого nginx
# на :80 не пройде HTTP-01 — замкнене коло, у яке ми вже вступили.
# Вказаний явно, хоч ca-certificates його й так тягне: урок із `spamd`
# — перевіряти не «чи є пакет», а чи є те, що ми запускаємо.
#
# Коментар стоїть ТУТ, а не в списку пакетів нижче, і це не стиль:
# усередині `apt-get install ... \` рядки склеюються, тож `#` з'їв би
# решту списку, і пакети після нього тихо не встановились би.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        certbot \
        python3-certbot-dns-cloudflare \
        ca-certificates \
        openssl \
 && rm -rf /var/lib/apt/lists/*

# Чому ОДИН DNS-плагін, і саме Cloudflare.
#
# Типовий шлях — HTTP-01 (`--standalone`), і він не потребує плагінів
# узагалі. DNS-01 потрібен у єдиному випадку: зовнішній :80 належить
# комусь іншому, і віддати його на час перевірки не можна.
#
# Тут важливо те, що знімає з DNS-01 головне заперечення: він НЕ
# вимагає керувати зоною домену, для якого випускається сертифікат.
# Сторонній DNS прописує ОДИН статичний запис, раз і назавжди:
#
#   _acme-challenge.mail.example.com.  CNAME  mail-example.acme.<наша-зона>.
#
# Let's Encrypt іде за CNAME, і TXT створюється вже в НАШІЙ зоні. Тобто
# токен потрібен до свого DNS, а чужий робить одне одноразове прохання,
# яке в них нічого не ламає. Зона-приймач може бути ОДНА на всі домени
# й усі групи.
#
# Cloudflare, а не PowerDNS, бо плагін до нього пакетований у Debian
# (рішення №1: беремо з дистрибутива, а не з pip). Для PowerDNS
# офіційного пакета немає, і довелось би або pip, або
# `--manual-auth-hook` власним скриптом. Якщо колись знадобиться — це
# додається другим методом, не замінює цей.

# ENTRYPOINT саме certbot, щоб `docker run <образ> certonly ...` читалось
# як сама команда. Для копіювання готових файлів mailctl підміняє його
# на sh (`--entrypoint sh`).
ENTRYPOINT ["certbot"]
