# Roundcube з доданим плагіном SAUserPrefs.
#
# Рішення №1 («Roundcube — офіційний образ») це НЕ порушує: база
# лишається офіційною, ми лише кладемо в неї один каталог. Власний
# образ потрібен рівно тому, що sauserprefs не вбудований, а
# альтернатива — ROUNDCUBEMAIL_COMPOSER_PLUGINS — тягне плагін з
# інтернету при КОЖНОМУ старті контейнера. Тобто без мережі група не
# піднялась би, а версія плагіна мінялась би сама собою.
#
# ВЕРСІЯ БАЗИ І ТЕГ ОБРАЗУ мусять збігатися, тому build.sh виводить тег
# із цього самого FROM (sed по рядку нижче), а не задає його окремо.
# Причина історична: у цьому проєкті вже був образ, потегований одним
# релізом Debian і зібраний з іншого.
#
# ── Чому НЕ composer ──────────────────────────────────────────────────
# Апстрім рекомендує `composer require johndoh/sauserprefs`, і це
# працювало б. Але composer у образі Roundcube оновив би й РЕШТУ
# залежностей (composer.lock перераховується), тобто наш образ тихо
# перестав би відповідати офіційному — а саме на офіційності тримається
# рішення №1.
# README плагіна прямо допускає другий шлях: скопіювати каталог у
# plugins/ і додати ім'я в $config['plugins']. Залежностей у нього
# немає (composer.json: лише php і roundcube/plugin-installer, а
# installer потрібен тільки щоб покласти файли). Отже копіювання дає
# той самий результат без побічних ефектів.
# Ціна: за версією плагіна стежимо самі. Вона тут і запінена.

# Версія плагіна. Міняти — ТІЛЬКИ разом із перевіркою, що він працює з
# версією Roundcube нижче: апстрім заявляє `min-version: 1.5` і не
# заявляє верхньої межі, тобто сумісність з 1.7 не обіцяна, а лише не
# заборонена.
ARG SAUSERPREFS_VERSION=1.21

# ── Стадія 1: дістати й розпакувати ───────────────────────────────────
# Окремою стадією, щоб не ставити curl і tar у кінцевий образ і не
# залежати від того, що в ньому є. База та сама, що в решті наших
# образів.
FROM debian:trixie-slim AS fetch
ARG SAUSERPREFS_VERSION

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Архів тега, а не гілки: гілка з часом поїде, і образ, зібраний
# завтра, відрізнявся б від зібраного сьогодні без жодної зміни в нас.
RUN set -eu; \
    url="https://github.com/johndoh/roundcube-sauserprefs/archive/refs/tags/${SAUSERPREFS_VERSION}.tar.gz"; \
    echo "fetch: $url"; \
    curl -fsSL "$url" -o /tmp/sauserprefs.tar.gz; \
    mkdir -p /out/sauserprefs; \
    tar -xzf /tmp/sauserprefs.tar.gz -C /out/sauserprefs --strip-components=1; \
    test -f /out/sauserprefs/sauserprefs.php \
      || { echo "у архіві немає sauserprefs.php — тег не той?" >&2; exit 1; }

# ── Стадія 2: власне образ ────────────────────────────────────────────
FROM roundcube/roundcubemail:1.7.x-apache

# Каталог плагінів офіційного образу. Шлях НЕ довільний — це те місце,
# де Roundcube шукає плагіни; змінювати не можна.
COPY --from=fetch /out/sauserprefs /var/www/html/plugins/sauserprefs

# ┌───────────────────────────────────────────────────────────────────┐
# │ config.inc.php плагіна тут НЕ створюємо — і наслідок із цього     │
# │ більший, ніж здається.                                            │
# │                                                                   │
# │ Той файл кладе plugin-installer (копією з config.inc.php.dist), і │
# │ саме в ньому живуть УСІ дефолти плагіна. Ми плагін копіюємо, а не │
# │ ставимо composer-ом, тож файлу немає — отже немає й дефолтів,     │
# │ ЖОДНОГО. Усе, що плагіну потрібно, задано явно в спільному        │
# │ _configs/roundcube/config.inc.php; там же й пояснення, чого це    │
# │ коштувало.                                                        │
# │                                                                   │
# │ Покласти його сюди — НЕ вихід: Roundcube зливає конфіг плагіна    │
# │ ПОВЕРХ основного, тобто приклад                                   │
# │ `mysql://username:password@localhost/database` з .dist перекрив   │
# │ би наш справжній DSN.                                             │
# └───────────────────────────────────────────────────────────────────┘

# ── Власний плагін: дефолтна ідентичність із поштової бази ────────────
# Не з інтернету й не composer-ом — лежить у цьому ж каталозі, тобто
# версіонується разом зі стеком. Обґрунтування, чому він узагалі
# потрібен (і чому virtuser_query/mail_domain/new_user_identity не
# годяться) — у шапці самого файлу.
COPY mailstack_identity /var/www/html/plugins/mailstack_identity
