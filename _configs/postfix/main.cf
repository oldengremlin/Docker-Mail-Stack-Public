# ─────────────────────────────────────────────────────────────────────
#  Postfix — СТАТИЧНА частина main.cf групи.
#
#  ЕТАП 1: «пошта ходить». Прийом, доставка через LMTP у Dovecot, SASL,
#  submission, TLS-заглушка. Фільтрації тут НЕМА свідомо — postscreen
#  (№13), мілтери OpenDKIM/OpenDMARC (№10), політики в SQL (№18),
#  SpamAssassin і postgrey приходять ЕТАПОМ 2. Причина порядку: поки
#  пошта не доставляється, налагоджувати фільтри нема на чому.
#
#  У main.cf немає механізму include, тому група-специфічні значення
#  (адреси, mynetworks, FQDN) НЕ шаблонізуються тут, а накладаються
#  entrypoint-ом через `postconf -e`. Перелік того, що накладається, —
#  у самому entrypoint; `postconf -n` показує результат злиття.
#  Нічого з того переліку НЕ дублювати в цьому файлі.
# ─────────────────────────────────────────────────────────────────────

# Фіксуємо рівень сумісності явно: інакше при оновленні Postfix частина
# дефолтів змінюється мовчки, а в лозі з'являються попередження про
# "using backwards-compatible default setting". Той самий мотив, що в
# рішенні №26 для Dovecot.
compatibility_level = 3.10

# ── Логи ──────────────────────────────────────────────────────────────
# У контейнері syslog-у немає. Postfix 3.4+ умієте писати напряму, і це
# працює рівно з `postfix start-fg` плюс сервіс postlog у master.cf
# (у Debian він є).
maillog_file = /dev/stdout

# ── Хто ми ────────────────────────────────────────────────────────────
# myhostname, mydomain, myorigin накладає entrypoint.
#
# mydestination ПОРОЖНІЙ, і це найважливіший рядок у файлі.
#
# На джерелі small `mydestination` перетинався з
# `virtual_mailbox_domains`, тобто пошта для small.example.org йшла ЛОКАЛЬНИМ
# транспортом, а не віртуальним — і працювала випадково. Тут усі домени
# групи віртуальні без винятку, локальної доставки немає взагалі.
mydestination =
# Текст тут АНГЛІЙСЬКИЙ і ASCII свідомо: він потрапляє в DSN і в
# SMTP-відповідь, а туди не-ASCII без SMTPUTF8 класти не можна. Те саме
# стосуватиметься текстів `REJECT ...` у майбутніх таблицях політик
# (рішення №19, №20) — коментарі українською, значення ASCII.
local_transport = error:local delivery is disabled, all domains are virtual
# Без локального транспорту ці мапи не потрібні, а порожніми вони ще й
# знімають попередження про відсутній /etc/aliases.db.
alias_maps =
alias_database =

# ── Банер, розмір листа, межі сесії ──────────────────────────────────
# Банер БЕЗ назви продукту. Версії Postfix у дефолтному банері немає й
# не було (`$myhostname ESMTP $mail_name`, де mail_name = Postfix), тож
# прибирається саме НАЗВА — на одну підказку сканеру менше, а ціна
# нульова.
#
# На isp тут роками стояло `Microsoft ESMTP MAIL Service ready`. Як
# приколька це своє відпрацювало, але діагностику воно ускладнює: у
# логах чужої сторони наш сервер виглядає тим, чим не є.
smtpd_banner = $myhostname ESMTP

# 40 МіБ, і число не кругле НАВМИСНО.
#
# Вимога власника — «вкладення до 25 МБ мусять проходити». Але
# message_size_limit міряє ЛИСТ НА ДРОТІ, а вкладення їде в base64, що
# додає третину, плюс заголовки й MIME-обв'язка. Отже ліміт 25 МБ
# пропустив би вкладення максимум ~18 МБ, і симптом був би
# «надсилаю 20 МБ — не йде», при формально правильному числі в конфізі.
#
# 25 МБ * 4/3 ≈ 34 МБ, тобто мінімум був би 35 МіБ.
#
# ПІДНЯТО ДО 40 МіБ 2026-11-20, і причина не «про запас»: рівно
# стільки стоїть на office, а isp і backup — резервні MX для його
# доменів. Інваріант «усі MX домену приймають однаковий розмір»
# (TODO п.9g) тут несучий: лист на 38 МБ, який основний сервер
# приймає, не має відбиватись від резервного — відправник побачив би
# випадковий збій, що залежить від того, який MX відповів.
# Значення взяте з живого office (`message_size_limit = 41943040`), а
# не вигадане; три сервери-джерела мали 10/20/40, тобто «правильного»
# серед них немає, і виграє найбільший — зміна в бік послаблення
# нічого не ламає.
#
# Усі три ліміти ClamAV це вже покривають: MaxFileSize 50 МіБ,
# StreamMaxLength 100 МіБ (перевірено `clamconf` на образі — дефолт
# там НЕ 25 МіБ, як я спершу припустив). mailbox_size_limit лишається
# дефолтним 51200000, тобто вище за новий ліміт, і Postfix не лається.
#
# Для довідки: на isp стояло 20 МБ (вкладення ~14 МБ), у Postfix
# дефолт 10 МБ (~7 МБ вкладення).
message_size_limit = 41943040

# Скільки отримувачів в ОДНОМУ листі. Дефолт Postfix — 1000, на isp
# стояло 10.
#
# Рішення власника: провайдерський SMTP — не про розсилки, хто хоче
# розсилати, підіймає свій сервер. Лишаємо низьким.
#
# АЛЕ це інший механізм, ніж обмеження ШВИДКОСТІ, і плутати їх не варто:
# тут ліміт на один лист (Postfix віддає `452`, і клієнт МОЖЕ розбити
# лист на кілька сесій — а може й не вміти), а потік обмежує anvil
# (`smtpd_client_recipient_rate_limit = 120`, рішення №13). Тобто від
# розсилок захищає другий, а цей радше ріже «лист на весь відділ».
#
# 25, а не 10: лист на два десятки колег — нормальна робоча пошта, і
# ламати її не було мети. Хто вперся — у логах видно `too many
# recipients`, і число тут єдине місце, де його міняти.
smtpd_recipient_limit = 25

# Адреси виду user+мітка@домен. Postfix відкидає `+мітка` при пошуку
# скриньки, тож `user+shop@` потрапляє до `user@`.
#
# УВАГА: це ПАРНА зміна. Dovecot мусить знати той самий роздільник —
# інакше Postfix лист ПРИЙМЕ (бо мапа скриньок знайде `user@`), а LMTP
# відмовить, бо userdb шукатиме `user+shop@` буквально. Половинчаста
# правка тут гірша за відсутність: вона дає відмову вже ПІСЛЯ прийому.
# Значення в dovecot.conf мусить збігатися.
recipient_delimiter = +

# ── Резервний MX (рішення №39) ────────────────────────────────────────
# relay_domains — список доменів, для яких ми ПРИЙМАЄМО пошту, не маючи
# тут скриньок, і доставляємо її далі. Це і є «бути резервним MX».
#
# На isp-джерелі саме цей параметр став дірою: через
# `relay_domains = $transport_maps` туди потрапили всі 297 доменів
# чорної діри, для яких сервер почав оголошувати себе релеєм
# (рішення №19). Тому тут він НЕ виводиться ні з чого — лише з рядків
# таблиці `domains` із `type='RELAY'` — тобто звідти ж, звідки й
# власні домени, і без другої таблиці, яка мусила б із першою
# узгоджуватись. Один домен не може бути LOCAL і RELAY одночасно за
# побудовою: це значення ОДНОГО стовпця, а не дві таблиці.
#
# ЯК ДОСТАВЛЯЄТЬСЯ: за DNS/MX, без жодного транспорту (рішення №38).
# Postfix при доставці сам викидає зі списку MX себе і всі записи з
# РІВНИМ або ГІРШИМ приоритетом, тож резерв на `MX 40` віддає пошту на
# 5/10/20/30 і петлі не робить.
#
# НЕСУЧА УМОВА, і вона єдина: ім'я в MX-записі мусить збігатися з
# `myhostname` (або бути серед `proxy_interfaces`). Інакше Postfix себе
# в списку MX не впізнає, вважатиме себе найкращим MX і лист піде по
# колу до `mail for <домен> loops back to myself`.
#
# Значення підставляє entrypoint — із тієї ж причини й тим же прийомом,
# що й `recipient_policy_check` нижче: збій SQL-мапи тут дає 451 на ВСЮ
# пошту групи, бо `relay_domains` читає resolver на КОЖНОМУ отримувачі,
# не лише на релейних.
relay_domains =

# ── Віртуальні домени й скриньки (SQL) ────────────────────────────────
# Файли мап генерує entrypoint у /etc/postfix/sql/: там пароль до БД,
# тому в репозиторії їх бути не може.
#
# `proxy:` — щоб запити йшли через proxymap і не плодили з'єднань з БД
# на кожен smtpd-процес (рішення №18).
virtual_mailbox_domains = proxy:mysql:/etc/postfix/sql/virtual_domains.cf
virtual_mailbox_maps    = proxy:mysql:/etc/postfix/sql/virtual_mailboxes.cf
# `$hostname_aliases` ПЕРЕД мапою з БД — див. блок про власне ім'я
# вузла нижче. Порядок значущий лише тим, що inline-мапа коротка й
# відповідає першою; перекрити нічого вона не може, бо ключі в неї
# рівно два й обидва в домені `$myhostname`, якого в БД немає.
virtual_alias_maps      = $hostname_aliases proxy:mysql:/etc/postfix/sql/virtual_aliases.cf

# ── Пошта на ВЛАСНЕ ІМ'Я ВУЗЛА (`$myhostname`) ───────────────────────
# `mydestination` у нас порожній свідомо (вище), тож без цього блоку
# лист на `postmaster@mail.example.com` отримав би `450`: домен не в
# `virtual_mailbox_domains`, не в `relay_domains`, не в
# `mydestination`. А зсередини (з `mynetworks`) він пішов би ще гірше —
# `permit_mynetworks` його пропустив би, resolver віддав дефолтний
# транспорт, MX-пошук привів би на нас самих, і лист закінчився б
# `loops back to myself`.
#
# ЧОМУ ЦЕ ВАЖЛИВО, а не формальність: на isp-джерелі
# `postmaster@mail.isp.example.net` був ЖИВИМ аліасом
# (`mydestination = $myhostname …` плюс `alias_maps =
# $virtual_alias_maps`), і хтось його свідомо налаштував. Чужий
# адміністратор, який бачить у заголовках `mail.isp.example.net`, пише
# саме на це ім'я, а не на домен.
#
# Обидва параметри — МАКРОСИ, і entrypoint наповнює їх РАЗОМ або не
# наповнює взагалі. Поодинці вони дають гірше, ніж нічого:
# `virtual_alias_domains` без мапи зробив би ім'я вузла доменом
# отримувача, у якому НЕМА жодної адреси, тобто `550 User unknown` на
# все, включно з postmaster.
#
# `virtual_alias_domains` тут ЗАМІНЮЄ дефолт (`$virtual_alias_maps`), і
# це безпечно: наш запит шукає `alias='%s'`, а ключі в таблиці — повні
# адреси (`local@domain`) або catch-all (`@domain`). Lookup ГОЛОГО
# домену, який робить `virtual_alias_domains`, не збігається з жодним
# із них ніколи. Тобто дефолт у нас і так порожній — просто неявно.
hostname_aliases =
hostname_alias_domain =
virtual_alias_domains = $hostname_alias_domain

# ── Доставка ──────────────────────────────────────────────────────────
# Рішення №11: LMTP на 127.0.0.1. Postfix і Dovecot ділять network
# namespace, тож loopback тут — точний опис зв'язку, а не виняток із
# правила «тільки за іменами».
#
# Порт 24 МУСИТЬ збігатися з `service lmtp` у dovecot.conf.
virtual_transport = lmtp:inet:127.0.0.1:24

# Dovecot сам знає про Maildir і квоти, Postfix у це не лізе.
# Обмеження на одночасні доставки лишаємо дефолтним.

# ── SASL (через Dovecot) ──────────────────────────────────────────────
# Порт 12345 МУСИТЬ збігатися з `service auth` у dovecot.conf. Ім'я
# сервісу авторизації — `dovecot`, це тип, а не хост.
smtpd_sasl_type = dovecot
smtpd_sasl_path = inet:127.0.0.1:12345

# Авторизація оголошується і на 25, а не лише на submission: на джерелах
# клієнти шлють саме через 25, і рішення №12 додає 587 НЕ замість, а
# поруч. Ламати наявних клієнтів заради чистоти не входило в задачу.
smtpd_sasl_auth_enable = yes

# Рішення №14: лише під TLS. Без цього рядка PLAIN/LOGIN оголошувались
# би й у відкритій сесії.
smtpd_tls_auth_only = yes

# Чуже ім'я в MAIL FROM при авторизованій сесії — окреме питання
# (на office для цього є ext_sender). Поки не обмежуємо, бо це вже
# фільтрація, тобто етап 2.

# ── TLS ───────────────────────────────────────────────────────────────
# ЗАГЛУШКА, як і в Dovecot: поки certbot не зроблений (TODO п.7),
# entrypoint генерує самопідписаний сертифікат. Шляхи мусять збігатися
# з тим, що пише entrypoint.
smtpd_tls_cert_file = /etc/postfix/tls/fullchain.pem
smtpd_tls_key_file  = /etc/postfix/tls/privkey.pem

# `may`, а не `encrypt`: на порту 25 вимагати TLS не можна — половина
# світу шле без нього, і це була б втрата пошти, а не безпека.
smtpd_tls_security_level = may
smtp_tls_security_level  = may
smtp_tls_CApath = /etc/ssl/certs
smtpd_tls_loglevel = 1

# ── Обмеження (мінімум, решта — етап 2) ───────────────────────────────
smtpd_helo_required = yes

# VRFY дозволяє стороннім перебирати адреси: сервер чесно відповідає,
# яка існує, а яка ні. Дефолт Postfix — УВІМКНЕНО, і перша ж жива
# сесія це показала (`250-VRFY` в оголошенні EHLO). Нам він не потрібен
# ні для чого.
disable_vrfy_command = yes

# ETRN — команда для dial-up: «я підключився, віддай мою чергу». Таких
# клієнтів тут немає й не буде, а поверхня для зловживань є.
smtpd_etrn_restrictions = reject

# І не оголошувати те, що відмовляємо. Перша жива сесія показала
# `250-VRFY` і `250-ETRN` в EHLO навіть після заборони самих команд —
# бо це два незалежні механізми. Оголошувати команду й відмовляти її —
# неправда в протоколі, та ще й зайвий відпечаток для фільтрів.
smtpd_discard_ehlo_keywords = vrfy, etrn

# Дефолт Postfix 3.x, виписаний явно: саме цей список не дає стати
# відкритим релеєм, і саме його варто бачити очима, а не припускати.
smtpd_relay_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    defer_unauth_destination

# Консервативно: відкидаємо лише те, що є або протоколним порушенням,
# або гарантовано недоставним. Нічого «на здогад» — рішення №21 про
# поетапність стосується й цього.
# ── postscreen і адаптивна затримка (рішення №13) ─────────────────────
#
# Це те, що було в Exim і загубилось при переході на Postfix. Ідея
# проста: ПОЧЕКАТИ, перш ніж привітатись. За RFC 5321 клієнт мусить
# дочекатись банера 220; бот майже завжди починає говорити одразу, щоб
# не витрачати час. Отже сама пауза відсіює тих, хто порушує протокол,
# нічого про них не знаючи — ні адреси, ні репутації, ні вмісту.
#
# Чому це ДЕШЕВО і чому варто було ставити першим: бот, що висить у
# postscreen, не займає ні smtpd, ні MySQL, ні жодного з чотирьох
# мілтерів. Тобто ця пауза розвантажує все, що стоїть за нею.
#
# `postscreen_greet_action` задає entrypoint із POSTSCREEN_ACTION у
# group.env: дефолт Postfix — лише лог, а нам потрібна відмова (на
# isp — після статистики, рішення №21).
#
# Решту лишаємо на дефолтах Postfix СВІДОМО:
#   postscreen_greet_wait = ${stress?2}${stress:6}s — 6 секунд у
#     нормальному стані й 2 під навантаженням. Саме це робить затримку
#     АДАПТИВНОЮ: коли черга забита, Postfix сам скорочує тест, щоб не
#     стати причиною відмов. Руками таке підбирати не варто;
#   postscreen_access_list = permit_mynetworks — довірені мережі тестів
#     не проходять узагалі (рішення №20: абоненти isp мусять
#     відправляти без перешкод);
#   postscreen_greet_ttl = 1d — клієнт, що пройшов тест, добу не
#     перевіряється повторно.
#
# ГЛИБОКІ тести (pipelining, non_smtp_command, bare_newline) НЕ
# вмикаємо. Вони вимагають від клієнта ПОВТОРНОГО з'єднання, тобто
# затримують і легальну пошту, а рішення №21 вимагає поетапності.
#
# postscreen_dnsbl_sites теж НЕ задаємо, і це не забутий рядок: урок
# Validity (PITFALLS) — DNSBL, який відмовляє у відповіді, виглядає як
# «занесено». На рівні postscreen це означало б відмову при з'єднанні,
# тобто втрачену пошту, а не зайвий бал. Вмикати лише зі своїм
# рекурсивним резолвером і лише після перевірки кожного списку окремо.

# ── Затримка на помилках (друга половина рішення №13) ─────────────────
# Postscreen ловить ботів, які не вміють чекати. Ці три параметри —
# проти тих, що вміють, але перебирають адреси або паролі.
#
# Механіка: перші smtpd_soft_error_limit помилок у сесії безкарні,
# далі КОЖНА наступна коштує smtpd_error_sleep_time секунд, а на
# smtpd_hard_error_limit сесія рветься. Тобто ціна зростає з
# наполегливістю — рівно те, чого хотілось від Exim.
#
# Значення, а не дефолти (1s/10/20): 3 помилки — більше, ніж робить
# будь-який справний клієнт за сесію, і менше, ніж треба для перебору.
# 5 секунд на помилку перетворюють перебір із тисячі спроб у кілька
# годин, не заважаючи тому, хто просто помилився адресою.
smtpd_error_sleep_time = 5s
smtpd_soft_error_limit = 3
smtpd_hard_error_limit = 10

# ── anvil: ліміти на клієнта (третя й остання частина рішення №13) ────
#
# Postscreen ловить тих, хто не вміє чекати. smtpd_error_sleep_time —
# тих, хто помиляється в межах ОДНІЄЇ сесії. Anvil — тих, хто все
# робить формально правильно, але РОЗКЛАДАЄ спроби по багатьох сесіях:
# перепідключається після кожної невдалої автентифікації, шле тисячу
# листів поспіль, перебирає отримувачів по одному на з'єднання.
# Окремо жодна його сесія не виглядає аномальною — аномалія видна лише
# в сумі по клієнтській адресі, і саме її веде anvil.
#
# ┌───────────────────────────────────────────────────────────────────┐
# │ ГОЛОВНЕ ТУТ — НЕ ЦІ П'ЯТЬ ЧИСЕЛ, А `_event_limit_exceptions`      │
# │ нижче. Дефолт Postfix для нього — `$mynetworks`, тобто ліміти НЕ  │
# │ діють рівно на тих, заради кого вони й потрібні: на довірені      │
# │ мережі, звідки відправляють без автентифікації (рішення №20).     │
# │ Заражена робоча станція абонента за таким дефолтом не             │
# │ обмежується ВЗАГАЛІ — мовчки, бо нічого не зламано.               │
# │ Ми цей дефолт звужуємо; подробиці біля самого параметра.          │
# └───────────────────────────────────────────────────────────────────┘
#
# Відмова при перевищенні — `450`, тобто ТИМЧАСОВА, і для ВСІХ п'яти
# лімітів однаково (перевірено на полігоні: ліміт AUTH теж 450, не 454
# з RFC 4954). Пошта не губиться: легальний відправник повторить і
# пройде, а той, хто довбить без повторів, просто не пройде.
# У лозі це `warning: AUTH command rate limit exceeded: N from
# unknown[ADDR] for service submission`, де N — накопичений лічильник
# за вікно, тобто видно й масштаб, не лише факт. Це узгоджено з рішенням №21: перший етап
# нічого не ламає незворотно.
#
# Значення підібрані так, щоб ловити АНОМАЛІЮ, а не роботу. Вікно —
# `anvil_rate_time_unit`, дефолтна хвилина; не чіпаємо.
#
#   connection_count = 20 — ОДНОЧАСНИХ сесій з адреси. Дефолт 50.
#     Рахуються ті, що вже пройшли postscreen. Офіс за NAT стільки не
#     тримає: SMTP-сесія живе секунди, на відміну від IMAP (а IMAP тут
#     ні до чого — це Dovecot, інший демон);
#   connection_rate = 30/хв — той, хто перепідключається частіше ніж
#     раз на дві секунди, або зламаний, або перебирає;
#   message_rate = 60/хв — лист на секунду безперервно. Для людини
#     недосяжно, для розсилки з зараженої машини — тісно;
#   recipient_rate = 120/хв — удвічі більше за листи, бо лист із
#     кількома отримувачами нормальний;
#   auth_rate = 10/хв — НАЙЦІННІШЕ з п'яти. Справний клієнт
#     автентифікується раз на сесію і кешує; десять спроб за хвилину —
#     це вже підбір пароля. Саме цей ліміт робить брутфорс по 312
#     акаунтах isp безнадійним.
#
# `smtpd_client_new_tls_session_rate_limit` НЕ задаємо: він проти
# вичерпання CPU на handshake, а не проти зловживання поштою. На
# нашому залізі TLS дешевий, зате ліміт ударив би по клієнтах без
# session resumption — тобто по старих, а не по шкідливих.
smtpd_client_connection_count_limit  = 20
smtpd_client_connection_rate_limit   = 30
smtpd_client_message_rate_limit      = 60
smtpd_client_recipient_rate_limit    = 120
smtpd_client_auth_rate_limit         = 10

# Порожньо тут НАВМИСНО — значення підставляє entrypoint з
# ANVIL_EXCEPTIONS (дефолт: лише loopback). Причина та сама, що в
# greylist_policy: інакше в entrypoint з'явилась би друга копія.
#
# ЧОМУ МИ ВІДХОДИМО ВІД ДЕФОЛТУ `$mynetworks`, хоч правило проєкту —
# не чіпати дефолти без причини. Причина пряма: рішення №20 називає
# anvil «другим шаром» компенсації за широкий mynetworks, а дефолт
# вимикає його рівно на тому першому шарі. Два наші рішення при
# дефолті суперечили б одне одному.
# Рішення №30 каже те саме з іншого боку: наявність адреси в довіреній
# мережі — це дозвіл на РЕЛЕЙ без SASL, а не обіцянка, що звідти не
# прилетить зловживання.
#
# Ціна названа: якщо офіс за одним NAT справді впреться в ліміт, його
# пошта почне відкладатись (450), а не зникати. У логах це буде видно
# як `Connection rate limit exceeded` з конкретною адресою — тобто
# лікується додаванням її сюди, а не навмання.
smtpd_client_event_limit_exceptions =

# `anvil_status_update_time` лишаємо дефолтним (600s). Його рядки в
# лозі — «max connection rate N/60s for (smtp:ADDR)» — це і є ВХІДНІ
# ДАНІ для рішення №20: кого заносити в abuse_block і з яким порогом.
# Тобто anvil корисний не лише тим, що відмовляє, а й тим, що показує,
# кого відмовляти.

# ── Greylisting ───────────────────────────────────────────────────────
# Параметр ПОРОЖНІЙ тут навмисно: значення підставляє entrypoint із
# GREYLIST у group.env. Так список обмежень нижче лишається В ОДНОМУ
# місці — інакше entrypoint мусив би перевизначати його цілком, і
# з'явилась би друга копія, яка одного дня розійдеться з першою мовчки.
#
# Порожнє значення = greylisting вимкнений: Postfix розбирає список і
# за комами, і за пробілами, тож зникнення одного елемента нічого не
# ламає.
greylist_policy =

# ── recipient_policy (рішення №19) ───────────────────────────────────
# Так само ПОРОЖНІЙ навмисно, і з ще серйознішої причини, ніж вище.
# Збій SQL-мапи Postfix трактує як збій перевірки, тобто відповідає
# 451 на КОЖЕН RCPT. А таблиці `recipient_policy` на будь-якій групі,
# піднятій до появи цього коду, немає: `mysql-init` виконується лише
# при ПЕРШОМУ старті MariaDB.
#
# Тому мапу підключає entrypoint — і лише після того, як сам її
# опитає. Ціна помилки несиметрична: «блокування не діє» видно в
# `mailctl health` і лікується одною командою, а «пошта не
# приймається» на isp означає втрачений тендер або звіт.
recipient_policy_check =

# ── abuse_block (рішення №20) ────────────────────────────────────────
# Два макроси, обидва порожні тут і наповнювані entrypoint-ом з тих
# самих причин, що й recipient_policy_check вище: таблиці на групі,
# піднятій до появи цього коду, немає, а збій SQL-мапи означає 451 на
# кожен RCPT.
#
# ЧОМУ ДВА, ЯКЩО ТАБЛИЦЯ ОДНА. Це дві РІЗНІ перевірки Postfix із
# різними ключами: check_client_access питає про IP (і його префікси),
# check_sender_access — про адресу відправника (і її домен). Одним
# обмеженням це не виражається.
#
# Підключаються ОБИДВА або НІ ОДИН: мапи читають ту саму таблицю, тож
# стан «працює лише sender» означав би, що заражена машина далі шле, а
# ми вважаємо, що блокування діє.
#
# ПОРЯДОК у списку обмежень — спершу client, потім sender, і він не
# косметичний: Postfix зупиняється на першому вердикті, тож заражена
# машина відмовляється раніше, ніж ми встигнемо подивитись, від кого
# саме лист. Для скомпрометованого акаунта порядок зворотний і нас не
# цікавить: він однаково дійде до другої перевірки.
abuse_client_check =
abuse_sender_check =

# ── Захист резервного MX від backscatter (рішення №39) ────────────────
# Резервний MX без перевірки отримувача — це генератор backscatter за
# побудовою: він приймає лист для неіснуючої скриньки, отримує 550 від
# основного сервера й складає баунс на (найчастіше підроблену) зворотну
# адресу. Саме це зараз і відбувається на isp-джерелі:
# `line.example.com` має `MX 20 mail.isp.example.net`, а `relay_recipient_maps`
# там не заданий.
#
# ЧОМУ НЕ СПІЛЬНИЙ СПИСОК ОТРИМУВАЧІВ (`relay_recipient_maps`): він
# вимагав би доступу до БД іншої групи, тобто ламав би ізоляцію
# (рішення №4), або синхронізації між групами, якої ми не будуємо
# (рішення №23). `reject_unverified_recipient` не вимагає ні того, ні
# того: Postfix пробує отримувача на основному сервері RCPT-ом і
# кешує відповідь.
#
# ПЕРШЕ ЗАПЕРЕЧЕННЯ, І ВОНО ЗНІМАЄТЬСЯ КЕШЕМ: «коли основний лежить —
# тобто рівно тоді, коли резерв і потрібен — проба не пройде, і ми
# віддамо 450 на все, отже сенсу нуль». Це було б правдою без
# ПОЗИТИВНОГО кешу: `address_verify_positive_expire_time` = 31 день,
# тож отримувачі, яким пошта через нас уже приходила, приймаються З
# КЕШУ навіть при недосяжному основному. Невідомі адреси при цьому
# відкладаються, а не баунсяться. Саме цей кеш і робить механізм
# робочим — тому він лежить на томі (див. address_verify_map нижче).
#
# ЦІНА НАЗВАНА: отримувач, якому через нас НІКОЛИ не писали, під час
# аварії основного отримає відкладення. Гірше за «прийняли», краще за
# «прийняли й склали баунс невинному».
#
# Значення — ОДНА мапа на двох параметрах, і це навмисно: той самий
# файл стоїть у `relay_domains` (там значення ігнорується, важлива
# лише наявність рядка) і тут (там значення — назва обмеження; access(5)
# це дозволяє). Дві окремі мапи з однаковим WHERE розійшлися б мовчки,
# і тоді ми або приймали б пошту без перевірки, або перевіряли те, для
# чого не є релеєм.
relay_verify_check =

# Кеш перевірки отримувачів. Дефолт Postfix 3.x саме такий — виписаний
# явно, бо від нього залежить працездатність резервного MX під час
# аварії основного, а `$data_directory` (/var/lib/postfix) через це
# МУСИТЬ лежати на томі. Без тому кеш зникав би на кожному
# `mailctl reload`, тобто рівно перед тим моментом, коли він потрібен.
address_verify_map = btree:$data_directory/verify

# Решта address_verify_* лишається на дефолтах, і три з них варто знати:
#   positive_expire_time = 31d — скільки живе ПІДТВЕРДЖЕНИЙ отримувач.
#       Це і є запас на аварію основного сервера;
#   negative_expire_time = 3d, negative_refresh_time = 3h — невідомі
#       адреси перепитуються часто, тобто нова скринька на основному
#       почне прийматись за години, а не за тижні;
#   poll_count = ${stress?{1}:{3}} — smtpd чекає результату проби до
#       ~9 с на холодному кеші, але під навантаженням не чекає зовсім.
#       Тобто затримка на RCPT є, і вона сама зникає при сплеску.
#
# `address_verify_sender` теж дефолтний — `double-bounce@$myhostname`.
# Це реальна адреса, і SPF-запис на саме ім'я вузла (`v=spf1 a -all`,
# його друкує `mailctl dns`) робить нашу пробу SPF-валідною для
# приймальної сторони. Порожній відправник `<>` тут був би не кращим:
# частина серверів відкидає RCPT-проби від `<>`.
#
# `unverified_recipient_reject_code` лишаємо 450, а НЕ 550. Основний
# сервер міг відповісти 550 помилково (зламана мапа, перезапуск,
# мігрована скринька), і тоді 550 від нас означав би остаточно
# втрачений лист. 450 коштує відправнику кількох днів ретраїв, після
# чого баунс складає ВІН, а не ми. Та сама несиметрія цін, що в
# рішенні №19.

# ┌───────────────────────────────────────────────────────────────────┐
# │ КОМЕНТАРІ ДО ЦЬОГО СПИСКУ — ТУТ, А НЕ ВСЕРЕДИНІ ЗНАЧЕННЯ.        │
# │                                                                   │
# │ У Postfix рядок, що починається з пробілу, продовжує попереднє    │
# │ логічне значення. Чи робиться виняток для індентованого `#`,      │
# │ документація дає прочитати двозначно, а наслідок помилки — `#` і  │
# │ текст коментаря стають ЕЛЕМЕНТАМИ списку обмежень. Тому пишемо    │
# │ так, щоб було правильно за будь-якого прочитання.                 │
# └───────────────────────────────────────────────────────────────────┘
#
# ПОРЯДОК у списку значущий: Postfix іде згори вниз і зупиняється на
# першому вердикті.
#
#   1-3. дешеві відмови: протокольне порушення або гарантовано
#        недоставний отримувач. Першими, бо немає сенсу затримувати на
#        20 секунд лист, який ми й так відкинемо;
#   4.   recipient_policy (рішення №19) — блокування за доменом
#        $recipient_policy_check, а не сама перевірка: наповнюється в
#        entrypoint лише коли мапа відповідає (див. вище).
#        ОТРИМУВАЧА. Саме ВИЩЕ permit_mynetworks, і це не стиль: на
#        isp ця таблиця блокує насамперед ВИХІДНУ пошту абонентів,
#        тобто тих, хто сидить у mynetworks. Нижче вони проскочили б
#        усі до одного, і чорна діра на 297 доменів перестала б
#        існувати, не подавши жодного знаку;
#   4a-b. abuse_block (рішення №20): спершу за КЛІЄНТОМ (заражена
#        машина), потім за ВІДПРАВНИКОМ (скомпрометований акаунт).
#        Обидві ВИЩЕ permit_mynetworks, і це несуча деталь, а не
#        порядок заради порядку: саме з mynetworks і йде зловживання,
#        під яке ця таблиця існує — там релей дозволений без жодної
#        авторизації. Нижче permit_mynetworks порушник проскочив би,
#        а таблиця лишилась би заповненою й недіючою;
#   5-6. permit_mynetworks і permit_sasl_authenticated — свої НЕ
#        затримуються;
#   7.   greylisting, і лише після двох permit вище. Інакше абонент
#        isp чекав би затримку на кожен свій перший лист до нового
#        отримувача (рішення №20 — там mynetworks широкий навмисно), а
#        власний користувач — на кожен лист із Roundcube чи телефона.
#        Greylisting має сенс лише проти ЧУЖИХ, які не повторюють спроб.
smtpd_recipient_restrictions =
    reject_unauth_pipelining,
    reject_non_fqdn_recipient,
    reject_unknown_recipient_domain,
    $recipient_policy_check
    $abuse_client_check
    $abuse_sender_check
    permit_mynetworks,
    permit_sasl_authenticated,
    # Двійник `reject_unknown_recipient_domain` вище, і доданий він
    # не з симетрії, а за чергою isp 24.11.2026: як резервний
    # MX ми ПРИЙМАЛИ лист для `line.example.com`, а основний сервер
    # відмовляв рівно за відправником
    # (`450 ... Sender address rejected: Domain not found`). При 450 такий
    # лист лежить у нас добу за добою, при 550 ми складаємо баунс
    # на (підроблену) зворотну адресу — тобто стаємо генератором
    # backscatter. Тепер відмова йде в ЖИВІЙ сесії, і баунс складає
    # той, хто під'єднався — та сама логіка, що в рішеннях ℙ32 і ℙ19.
    #
    # МІСЦЕ НЕСУЧЕ: ПІСЛЯ обох `permit`. Вище вона зачепила б
    # ВИХІДНУ пошту абонентів (рішення ℙ20, ℙ30), а серед трьохсот
    # неодмінно є хтось із доменом без DNS — це було б рівно те,
    # що забороняє рішення ℙ21: зламати наявне заради нового.
    #
    # `unknown_address_reject_code` СВІДОМО не задаємо — діє дефолт 450.
    # Він ГЛОБАЛЬНИЙ: 550 зробив би остаточними й відмови
    # `reject_unknown_recipient_domain`, тобто одна зміна на дві
    # перевірки. Ціна дефолту названа: 450 не стримує — відправник
    # повертається знову, зате ми нічого не губимо при збої власного
    # резолвера. Перехід на 550 — окреме рішення власника.
    reject_unknown_sender_domain,
    $relay_verify_check
    $greylist_policy
    permit

# ── Мілтери ───────────────────────────────────────────────────────────
# Рішення №10: спершу OpenDKIM, потім OpenDMARC. Порядок не косметичний:
# OpenDMARC сам DKIM не перевіряє — він читає заголовок
# Authentication-Results, який ставить OpenDKIM. Поставити його першим
# означало б оцінювати DMARC без результату DKIM, тобто завжди по SPF.
#
# За іменами, не за адресами: обидва — звичайні контейнери в
# internal-мережі групи (виняток для 127.0.0.1 стосується лише пари
# postfix+dovecot, яка ділить netns).
# ПОРЯДОК ЗНАЧУЩИЙ, і не лише для DKIM/DMARC:
#   1. opendkim     — підписати вихідну / перевірити вхідну;
#   2. opendmarc    — DMARC читає Authentication-Results від opendkim,
#                     тож мусить бути ПІСЛЯ нього;
#   3. clamav       — перед антиспамом свідомо: Postfix викликає мілтери
#                     послідовно й на першій відмові решту не питає, тож
#                     заражений лист не доходить до SpamAssassin і не
#                     витрачає його CPU;
#   4. spamassassin — останній, бо найдорожчий і бо правила на DKIM/DMARC
#                     працюють лише коли Authentication-Results уже є.
smtpd_milters = inet:opendkim:8891, inet:opendmarc:8893,
                inet:clamav:7357, inet:spamassassin:8894

# non_smtpd_milters — пошта, що з'явилась НЕ через smtpd: те, що Postfix
# складає сам (відмови, повідомлення собі) і те, що подали через
# sendmail/pickup. Її теж треба підписувати, інакше наші ж DSN виходять
# без підпису.
#
# Але БЕЗ OpenDMARC, і тому списки більше не однакові: DMARC відповідає
# на питання «чи має право ЦЕЙ сервер відправляти від ТОГО домену», а
# для пошти, яку склав сам Postfix, відповідь відома заздалегідь.
# Оцінювати її означало б перевіряти себе й витрачати DNS-запити на
# завжди однакову відповідь.
non_smtpd_milters = inet:opendkim:8891

# ┌───────────────────────────────────────────────────────────────────┐
# │ Власний параметр, НЕ стандартний Postfix. Ім'я довільне; на нього │
# │ посилається `-o smtpd_milters=$submission_milters`, який          │
# │ entrypoint ставить сервісу submission у master.cf.                │
# │                                                                   │
# │ Навіщо окремий список для 587:                                    │
# │   - OpenDKIM ТУТ ПОТРІБЕН — це вихідна пошта, її треба підписати; │
# │   - ClamAV ТУТ ПОТРІБЕН, і це не перестороженість: заражена       │
# │     робоча станція, яка розсилає через наш SMTP із нашою          │
# │     репутацією, — рівно той сценарій, під який існує abuse_block  │
# │     (рішення №20, №30). Антивірус на вихідній ловить його раніше; │
# │   - OpenDMARC НЕ потрібен: він відповідає на питання «чи має      │
# │     право цей сервер відправляти від того домену», а тут          │
# │     відправник уже автентикований, тобто відповідь відома;        │
# │   - SpamAssassin НЕ потрібен: маркувати X-Spam-* пошту, яка йде   │
# │     НАЗОВНІ, безглуздо — заголовки читає наш же Dovecot і sieve,  │
# │     яких на цьому шляху немає. Плюс spamass-milter шукав би       │
# │     per-user prefs за адресою зовнішнього отримувача.             │
# └───────────────────────────────────────────────────────────────────┘
submission_milters = inet:opendkim:8891, inet:clamav:7357

# Якщо мілтер не відповідає ВЗАГАЛІ (контейнер лежить) — пропускаємо
# пошту без підпису, а не відкидаємо. Вибір свідомий: втратити підпис
# гірше за норму, але втратити ПОШТУ гірше в разів. Протилежний вибір
# всередині самого OpenDKIM (`On-InternalError tempfail`) стосується
# іншого випадку: мілтер відповів, але не змог.
milter_default_action = accept

# Версія протоколу 6 — та, якою говорять сучасні мілтери; дефолт
# Postfix і так 6, пишемо явно, щоб не залежати від зміни дефолту.
milter_protocol = 6

# ── Куди Postfix пише САМ СОБІ ────────────────────────────────────────
# Повними адресами, а не через alias_maps: локальної доставки тут немає,
# тож `postmaster` без домену нікуди б не привів. Самі адреси накладає
# entrypoint із POSTMASTER_ADDRESS.
notify_classes = resource, software, 2bounce

# ── Різне ─────────────────────────────────────────────────────────────
# Зворотна сумісність із клієнтами, які шлють CRLF неправильно, і
# подібне — не вмикаємо, поки не побачимо потреби.
biff = no
append_dot_mydomain = no
readme_directory = no
