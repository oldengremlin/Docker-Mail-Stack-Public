# Глобальний скрипт доставки: спам у Junk ДО користувацьких правил.
#
# Підключається лише при SPAM_TO_JUNK=yes (параметр ГРУПИ) — див.
# group.env.example. Увімкнення всім було б помилкою: на isp-подібній
# групі всі активні клієнти POP3, а POP3 бачить тільки INBOX, тож хибне
# спрацювання поїхало б у теку, якої абонент не побачить НІКОЛИ
# (рішення №21 — спершу лише маркування).
#
# Узято з office (`sieve_before = /var/mail/sieve_global/skip-spam.sieve`,
# діяв на всіх 235 користувачів), але З ОДНІЄЮ ЗМІНОЮ: там стоїть
# `fileinto :copy "Junk"`, а `:copy` НЕ скасовує implicit keep — тобто
# спам лягає і в Junk, і в INBOX. На office друга половина механізму
# лежала в персональних `~/sieve/skip-spam.sieve` (ті самі 199 байт у
# десятка людей), які роблять `fileinto` без `:copy` і keep скасовують.
# У кого персонального скрипта не було — отримував спам двічі. У нас
# `mailbox Junk { auto = subscribe }`, тобто тека є в кожного, і дефект
# проявився б одразу в усіх. Тому без `:copy`.
#
# `stop` тут СВІДОМО немає: він зупинив би й користувацький скрипт, а
# на office той на спамі виконується. Скасованого keep досить — лист
# уже має явне призначення, а повторний `fileinto "Junk"` із
# персонального скрипта Sieve склеює в одну копію.
require ["fileinto"];

# rule:[X-Spam-Flag]
if header :contains "X-Spam-Flag" "YES"
{
	fileinto "Junk";
}
# rule:[Not exists "From","Date"]
# Лист без From або Date не відповідає RFC 5322 і легальним не буває.
if not exists ["From","Date"]
{
	fileinto "Junk";
}
