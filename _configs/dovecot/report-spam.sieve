# ─────────────────────────────────────────────────────────────────────
#  Користувач переклав лист У .Junk -> учимо як СПАМ.
#
#  Запускається не при доставці, а на IMAP-подію COPY (рішення №34).
#  Саме тому воно безпечне: копії, які поклав у .Junk сам sieve при
#  доставці, цього скрипта НЕ запускають, отже фільтр не вчиться на
#  власних здогадах. Механізм office був відкинутий рівно за це
#  (див. _configs/spamassassin/local.cf).
# ─────────────────────────────────────────────────────────────────────
require ["vnd.dovecot.pipe", "copy", "imapsieve", "environment", "variables"];

# Чиїм іменем учимо. Bayes у нас PER-USER (рішення №31: ключ — повна
# адреса, яку мілтер передає в spamc через -u/-e), тож навчання мусить
# іти від того самого ключа, інакше воно писало б у чужу/порожню базу.
#
# imap.email проти imap.user: у групах типу small логін дорівнює
# адресі й різниці немає, але в office логін короткий (рішення №15).
# Потрібна саме АДРЕСА, тому imap.email перший, а imap.user — запас на
# випадок, коли адреса невідома.
if environment :matches "imap.email" "*" {
    set "learn_as" "${1}";
}
if string :is "${learn_as}" "" {
    if environment :matches "imap.user" "*" {
        set "learn_as" "${1}";
    }
}

# Без ключа не вчимо взагалі: навчання «нікого» зіпсувало б спільну
# базу тим, що мало бути персональним.
if not string :is "${learn_as}" "" {
    # :copy — щоб pipe не скасовував implicit keep: лист мусить
    # лишитись у теці, куди його переклали.
    pipe :copy "spamc-learn" [ "spam", "${learn_as}" ];
}
