# ─────────────────────────────────────────────────────────────────────
#  Користувач витяг лист З .Junk назовні -> учимо як HAM.
#
#  Це ЗВОРОТНА дія до report-spam.sieve: користувач побачив у .Junk
#  легальний лист і витяг його. Тобто виправлення хибного спрацювання,
#  і найцінніший для bayes сигнал — саме такий, а не підтвердження
#  того, у чому фільтр і так був упевнений.
#
#  Підключається блоком `imapsieve_from Junk`, а не `mailbox`: подія
#  тут — поява листа в ІНШІЙ теці, а умова — що він прийшов із Junk.
# ─────────────────────────────────────────────────────────────────────
require ["vnd.dovecot.pipe", "copy", "imapsieve", "environment", "variables"];

# ── КУДИ саме переклали лист ─────────────────────────────────────────
# Це не підстраховка, а виправлення справжнього дефекту, знайденого на
# живій пошті 2026-11-17.
#
# `imapsieve_from Junk` спрацьовує на ВИХІД листа з Junk, і йому
# байдуже, куди саме. А видалення листа в Thunderbird (і в Roundcube, і
# в будь-якому клієнті з текою смітника) — це MOVE у Trash, тобто теж
# вихід із Junk. Отже найприродніша дія користувача («почистив теку
# Спам») навчала фільтр, що весь той спам — легальна пошта.
# Виміряно на small: ham_count 14 -> 77 за одну чистку, а spam_count
# 11 -> 0, бо bayes_seen на кожному листі ЗНІМАВ попередній
# спам-зразок. Тобто не просто «не навчилось», а база зіпсувалась у
# протилежний бік — і мовчки.
#
# Перелік тек нижче — це «користувач ВИКИНУВ лист», а не «визнав
# легальним». Якщо в групі смітник зветься інакше або namespace має
# prefix (на office очікується `INBOX.`) — дописати його форму сюди.
if environment :matches "imap.mailbox" "*" {
    set "dest" "${1}";
}

# Порожній `dest` означає, що куди переклали — невідомо, і тоді ми НЕ
# вчимо. Несиметрія цін: зіпсована база діє на всю подальшу пошту й
# непомітна, а пропущений зразок — це лише втрачений сигнал. Контроль
# на це є: якщо `imap.mailbox` недосяжний, то й перенос Junk -> INBOX
# перестане збільшувати ham_count, тобто видно одразу.
if allof (not string :is "${dest}" "",
          not string :is "${dest}" [ "Trash", "INBOX.Trash", "INBOX/Trash" ]) {

    # Чиїм іменем учимо. Bayes у нас PER-USER (рішення №31: ключ — повна
    # адреса, яку мілтер передає в spamc через -u/-e), тож навчання мусить
    # іти від того самого ключа, інакше воно писало б у чужу/порожню базу.
    #
    # imap.email проти imap.user: у групах типу small логін дорівнює
    # адресі й різниці немає, але в office логін короткий (рішення №15).
    # Потрібна саме АДРЕСА, тому imap.email перший, а imap.user — запас на
    # випадок, коли адреса невідома.
    if environment :matches "imap.email" "*" {
        set "learn_as" "${1}";
    }
    if string :is "${learn_as}" "" {
        if environment :matches "imap.user" "*" {
            set "learn_as" "${1}";
        }
    }

    # Без ключа не вчимо взагалі: навчання «нікого» зіпсувало б спільну
    # базу тим, що мало бути персональним.
    if not string :is "${learn_as}" "" {
        # :copy — щоб pipe не скасовував implicit keep: лист мусить
        # лишитись у теці, куди його переклали.
        pipe :copy "spamc-learn" [ "ham",  "${learn_as}" ];
    }
}
