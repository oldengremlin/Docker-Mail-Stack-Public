# ─────────────────────────────────────────────────────────────────────
#  SpamAssassin — спільний конфіг на всі групи.
#
#  Правити ТУТ, а не копією в групі: копія затінює цей файл, і правка
#  спільного перестає діяти мовчки. Якщо групі потрібне інше —
#  groups/<група>/spamassassin-config/local.cf, і `mailctl check` про
#  перекриття попередить.
#
#  Підключення до БД (bayes, AWL, userpref) тут НЕ описане: воно
#  містить пароль і генерується entrypoint-ом у /etc/spamassassin/sql.cf
#  з env. Рішення №33 — окрема база, окремий користувач.
# ─────────────────────────────────────────────────────────────────────

# ── Що робити зі спамом ───────────────────────────────────────────────
# Порог. Дефолт SpamAssassin, лишаємо явно: число, яке ВАРТО бачити в
# конфізі, бо саме його крутять першим.
required_score          5.0

# ┌───────────────────────────────────────────────────────────────────┐
# │ report_safe 0 — НЕ косметика і не вибір смаку.                    │
# │                                                                   │
# │ Одиниця загортає підозрілий лист у MIME-вкладення. По-перше, з    │
# │ мілтером це технічно недоступно: мілтер змінює заголовки, а не    │
# │ тіло (рішення №31). По-друге, воно й не потрібне — загортання     │
# │ ламає користувацькі sieve-правила, які дивляться в `body`, а      │
# │ таких на джерелах 41 скрипт у 13 користувачів.                    │
# │                                                                   │
# │ Отже маркування лишається рівно заголовками X-Spam-*, і саме на   │
# │ них спираються sieve-правила.                                     │
# └───────────────────────────────────────────────────────────────────┘
report_safe             0

# Subject НЕ переписуємо. Спокуса є («*****SPAM***** …» видно одразу),
# але це ламає групування в тред у більшості клієнтів і робить
# неможливими правила на точний Subject. Рішення №21 хоче маркування, і
# заголовків для цього достатньо.
#rewrite_header Subject  [SPAM _SCORE_]

# ── Bayes ─────────────────────────────────────────────────────────────
use_bayes               1
bayes_auto_expire       1

# ┌───────────────────────────────────────────────────────────────────┐
# │ bayes_auto_learn 1 — ЄДИНИЙ автоматичний зворотний зв'язок, який  │
# │ ми лишаємо, і він лишається свідомо.                              │
# │                                                                   │
# │ Той, який ми ПРИБИРАЄМО, інший: на office скрипт раз на 10 хвилин │
# │ учив як спам усе, що лежить у .Junk, включно з копіями, які       │
# │ поклав туди сам sieve. Тобто фільтр учився на власних здогадах і  │
# │ сам себе переконував у помилці — пряме пояснення скарг на         │
# │ порізаних легальних відправників. Замість нього — навчання лише   │
# │ на ДІЮ КОРИСТУВАЧА через imapsieve (TODO п.5).                    │
# │                                                                   │
# │ bayes_auto_learn інший за природою: він учить лише те, що лягло   │
# │ далеко за межами порога (нижче 0.1 і вище 12 при порозі 5), тобто │
# │ там, де сумніву немає. Без нього свіжа база не наповнюється       │
# │ взагалі.                                                          │
# └───────────────────────────────────────────────────────────────────┘
bayes_auto_learn        1

# ── Мережеві перевірки ────────────────────────────────────────────────
# ┌───────────────────────────────────────────────────────────────────┐
# │ ПАСТКА: DNSBL через ПУБЛІЧНИЙ резолвер не працює.                 │
# │                                                                   │
# │ Spamhaus (і не лише він) відмовляє запитам, що приходять із       │
# │ відкритих резолверів — 8.8.8.8, 1.1.1.1 і подібних. Відмова       │
# │ виглядає як відповідь «занесено», тобто правило SpamAssassin      │
# │ спрацьовує НА ВСЕ, і раптом уся пошта стає спамом. Або навпаки,   │
# │ залежно від коду.                                                 │
# │                                                                   │
# │ Контейнер успадковує resolv.conf хоста. Отже перед тим як          │
# │ покладатись на DNSBL, переконатись, що резолвер — свій            │
# │ рекурсивний, а не публічний.                                      │
# └───────────────────────────────────────────────────────────────────┘
#
# ЗНАЧЕННЯ ТУТ НЕ СТОЇТЬ НАВМИСНО: воно параметр ГРУПИ, бо відповідь
# залежить від того, чий резолвер бачить контейнер, а це властивість
# хоста, не стеку. У `group.env` — `SA_DNSBL=yes|no` (типово yes),
# entrypoint пише з нього `skip_rbl_checks` у згенерований sql.cf.
# Інвертування там навмисне: у параметрі стоїть те, чого людина хоче
# («DNSBL вмикаю»), а не те, що треба вимкнути, щоб це сталось.
#
# Змінюється не на льоту: spamd читає конфіг при старті, тож після
# правки — `./mailctl reload <група> spamassassin`.

# ┌───────────────────────────────────────────────────────────────────┐
# │ СПИСКИ VALIDITY — ВИМКНЕНІ, і це не смак, а виправлення дефекту.  │
# │                                                                   │
# │ Перший же тестовий лист на полігоні отримав score 4.0 при порозі  │
# │ 5.0, і 3.6 з них дали ТРИ правила:                                │
# │                                                                   │
# │   RCVD_IN_VALIDITY_CERTIFIED_BLOCKED                              │
# │   RCVD_IN_VALIDITY_RPBL_BLOCKED                                   │
# │   RCVD_IN_VALIDITY_SAFE_BLOCKED                                   │
# │                                                                   │
# │ Суфікс `_BLOCKED` означає не «відправника занесено», а «Validity  │
# │ ВІДМОВИЛА у відповіді». З 2021 року її списки вимагають платної   │
# │ підписки, і запит від непідписаного резолвера отримує відмову.    │
# │ SpamAssassin 4 навмисно робить цю відмову помітною — нараховує    │
# │ бал, щоб адміністратор звернув увагу.                             │
# │                                                                   │
# │ Що це означає на практиці: БУДЬ-ЯКИЙ лист стартує з ~3.6 з 5.0.   │
# │ Тобто фабрика хибних спрацювань, і помітна вона лише тому, що ми  │
# │ подивились у заголовки тестового листа.                           │
# │                                                                   │
# │ ЦЕ НЕ ТЕ САМЕ, ЩО ПАСТКА З ПУБЛІЧНИМ РЕЗОЛВЕРОМ ВИЩЕ. Там лікує   │
# │ власний рекурсивний резолвер; тут не лікує ніщо, крім підписки —  │
# │ Validity відмовляє за відсутністю договору, а не за адресою.      │
# │ Тому `SA_DNSBL=yes` (а в власника саме так) проблему не знімає.   │
# │                                                                   │
# │ Вимикаємо ЗАПИТИ, а не лише бали. `score ... 0` лишило б сам      │
# │ запит у мережу на кожен лист — марний трафік до служби, яка нам   │
# │ усе одно не відповідає. Нулі нижче лишені як другий шар і як      │
# │ видимий намір: якщо правило колись з'явиться під іншим іменем,    │
# │ `spamassassin --lint` про це скаже.                               │
# │                                                                   │
# │ Інших DNSBL це НЕ стосується — обмеження точкове, за іменами.     │
# └───────────────────────────────────────────────────────────────────┘
dns_query_restriction   deny  bl.score.senderscore.com
dns_query_restriction   deny  sa-accredit.habeas.com
dns_query_restriction   deny  sa-trusted.bondedsender.org

score RCVD_IN_VALIDITY_CERTIFIED_BLOCKED 0
score RCVD_IN_VALIDITY_RPBL_BLOCKED      0
score RCVD_IN_VALIDITY_SAFE_BLOCKED      0

# razor2/pyzor не встановлені в образі (див. Dockerfile: кожен — ще
# один вихідний канал у мережу). Вимикаємо явно, щоб у логах не було
# скарг на відсутній плагін.
use_razor2              0
use_pyzor               0

# ── Мови й кодування ──────────────────────────────────────────────────
# ok_locales НЕ обмежуємо. Спокуса поставити `en uk ru` і покінчити з
# частиною спаму є, але ціна — тихо вищий бал будь-якому легальному
# листу іншою мовою. Пошта тут не лише внутрішня.
