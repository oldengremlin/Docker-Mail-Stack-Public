# {GROUP} — ім'я КАТАЛОГУ в groups/, не довільне. Коментар — окремим
# рядком: env-файл читається як дані, і кінцевий '# ...' став би
# частиною значення.
GROUP_CONFIG_DIR=../groups/{GROUP}
GROUP_NAME={NAME}
MAIL_HOSTNAME={HOSTNAME}

# Адреса, від якої сервіси групи шлють власні повідомлення: відмови за
# переповненням скриньки, автовідповіді sieve vacation, згодом DMARC-звіти.
# МУСИТЬ бути реальною скринькою в одному з доменів групи.
#
# Складати її з MAIL_HOSTNAME автоматично НЕ можна, і це не дрібниця:
# вийшло б postmaster@mail.example.net, тобто адреса в домені, який
# поштовим не є — відповідь на відмову відбилась би назад. Зрізати перший
# мітку теж не можна: у групи може бути чотири домени, і жоден не
# зобов'язаний збігатися з іменем вузла.
POSTMASTER_ADDRESS=postmaster@{DOMAIN}
IMAGE_TAG=trixie

# ── Часовий пояс контейнерів ──
# Без цього рядка все падає в UTC: `Received:`-заголовки, логи всіх
# демонів і `docker logs` — тобто кожне звіряння з логами хоста вимагає
# арифметики в голові. На `Date:` у листах не впливає, його ставить
# клієнт.
#
# Ціна локальної зони — стрибок на годину двічі на рік при переході на
# літній час. Ціна UTC — та сама арифметика щоразу. Вибір за власником;
# дефолт UTC, щоб без рядка поведінка не змінювалась.
TZ=Europe/Kyiv

# ── мережа ──
# Адреси групи: <мітка мережі>:<адреса>, через кому. Мітки — з
# host.json, де описані самі мережі (драйвер, інтерфейс, vlan,
# підмережа). Мережа — ресурс ХОСТА, адреса в ній — параметр групи.
#
# Одна адреса — звичайний випадок:
#   ADDRESSES=public:{ADDRESS}
# Дві й більше — коли група дивиться не лише в світ. Напр. поштовий
# вузол із сірою адресою в офісній мережі (рішення №27):
#   ADDRESSES=public:{ADDRESS},office:192.168.50.253
# Офісну адресу може мати й група, яка офісній мережі не довіряє —
# це різні речі, див. MYNETWORKS нижче.
ADDRESSES=public:{ADDRESS}

# Через яку мережу йде ВИХІДНА пошта: звідси і дефолтний маршрут
# контейнера, і smtp_bind_address у main.cf, тобто адреса, яку бачить
# приймальна сторона. При одній адресі можна не вказувати.
#PRIMARY_NET=public

# PUBLIC_IP тут БІЛЬШЕ НЕ ЗАДАЮТЬ. Він генерується як адреса мережі
# PRIMARY_NET і разом з LISTEN_ADDRESSES потрапляє у .compose.env.
# Тримати його ще й тут означало б дві змінні, які мусять
# узгоджуватись, — вони розійшлися б мовчки. `mailctl check` на такий
# рядок лається.
#
# PARENT_IFACE/PUBLIC_SUBNET/PUBLIC_GATEWAY — теж не тут, а в host.json.

# ── Довірені мережі (рішення №30) ──
# Кому дозволено релей БЕЗ SASL-авторизації. З ADDRESSES це НЕ
# виводиться, і не випадково: наявність адреси в мережі не означає
# довіри до цієї мережі. Три живі приклади на трьох серверах:
#   small  — офісна адреса Є, довіри НЕМА  -> MYNETWORKS порожній
#   office — офісна адреса Є, довіра Є     -> MYNETWORKS=192.168.50.0/24
#   isp  — довіра до блоків провайдера   -> MYNETWORKS=<4 блоки>
# Порожнє значення — нормальний і найбезпечніший випадок: лишається
# тільки loopback, усі інші шлють через submission із авторизацією.
#
# Ціна кожного рядка тут: заражена машина в цій мережі шле спам із
# репутацією сервера, не питаючи пароля. Компенсація — не звуження
# (на isp це вимога, не спадок), а abuse_block із терміном дії
# в БД. Разом із пасткою, що ліміти anvil за замовчуванням НЕ діють
# саме на довірених (smtpd_client_event_limit_exceptions).
#MYNETWORKS=192.168.50.0/24

# ── DKIM ──
# Селектор — довільне ім'я, під яким публічний ключ лежить у DNS
# (<селектор>._domainkey.<домен>). Різний між групами, і на джерелах
# теж різний.
#
# При МІГРАЦІЇ брати НОВИЙ, а не повторювати прод-овий: тоді старий
# запис у DNS живе далі й обслуговує чинний сервер, а новий
# публікується поруч. З тим самим селектором вийшло б вікно, коли
# запис уже не відповідає ключу, яким підписує старий сервер.
# Ключі генеруються самі, таблиці виводяться з БД — руками тут нічого.
DKIM_SELECTOR=ms{YYYY}

# ── SPF ──
# `mailctl dns` будує SPF із адреси, з якої група СПРАВДІ відправляє
# (адреса PRIMARY_NET). Решта адрес туди не йде: офісна сіра не
# маршрутизується й джерелом назовні не буває.
#
# Тут — ДОДАТКОВІ джерела, якщо пошта цих доменів виходить ще звідкись.
# Потрібно рівно в один момент: при переході, поки частина пошти йде зі
# старого сервера. Інакше новий SPF-запис відкидав би свою ж пошту.
# Квантор (`~all`) додає генератор, тут його НЕ писати.
#SPF_EXTRA=ip4:203.0.113.14

INTERNAL_PREFIX={INTERNAL_PREFIX}

# ── Власник поштових скриньок ──
# Числові uid/gid, якими володіють файли в /var/mail. РІЗНІ між групами:
# small історично на системному mail (8), office — на власному
# virtual (5000). Ім'я користувача теж різне, тому в конфігах і в
# entrypoint використовуємо ЧИСЛА, а не імена.
VMAIL_UID={VMAIL_UID}
VMAIL_GID={VMAIL_GID}

# ── MySQL ──
MYSQL_ROOT_PASSWORD={ROOT_PASSWORD}
MYSQL_MAIL_DB={MAIL_DB}
MYSQL_MAIL_USER={MAIL_USER}
MYSQL_MAIL_PASSWORD={MAIL_PASSWORD}

# ── Вебмейл (Roundcube) ───────────────────────────────────────────────
# Ім'я, за яким користувачі відкривають вебмейл у браузері. НЕ довільне:
# мусить існувати в DNS і вказувати на адресу ХОСТА, де стоїть спільний
# nginx (не на PUBLIC_IP групи — проксі віддає вебмейл зі своєї адреси).
# Це саме ім'я йде в сертифікат, у vhost і в trusted_host_patterns.
# Якщо групи рознесені по машинах — у DNS має бути адреса ТІЄЇ машини
# (рішення №23).
WEBMAIL_FQDN={WEBMAIL_FQDN}

# Своя база вебмейлу: сесії, контакти, налаштування, і схему в ній
# створює САМ образ Roundcube при старті.
ROUNDCUBE_DB={ROUNDCUBE_DB}

# Пароль ТРЬОХ користувачів БД, якими ходить вебмейл: roundcube (своя
# база), rcpasswd (рівно UPDATE пароля в поштовій) і rcprefs (рівно
# userpref у базі SpamAssassin). Поштовий MYSQL_MAIL_PASSWORD вебмейлу
# НЕ дається: з ним він бачив би хеші паролів усіх користувачів групи.
# Один пароль на трьох свідомо — усі три DSN лежать в одному конфізі
# Roundcube, тож сенс розділення в правах, а не в паролях.
# Не можна: лапку, зворотний слеш, двокрапку, @ (вони ламають SQL і DSN).
ROUNDCUBE_DB_PASSWORD={ROUNDCUBE_DB_PASSWORD}

# Ключ шифрування IMAP-пароля в сесії. РІВНО 24 символи (вимога
# дефолтного cipher_method). Обов'язковий: без нього образ генерує його
# сам при кожному створенні контейнера, а сесії лежать у базі й
# перестворення переживають — тобто всіх користувачів мовчки викидало б
# при кожному `up`.
#   openssl rand -base64 24 | cut -c1-24
ROUNDCUBE_DES_KEY={ROUNDCUBE_DES_KEY}

# Максимальний розмір вкладення. Мусить бути НЕ БІЛЬШЕ за
# client_max_body_size у vhost nginx, інакше проксі відрубає файл
# раніше, ніж Roundcube скаже про ліміт. Типово 25M.
#WEBMAIL_MAX_UPLOAD=25M

# Варіант схеми БД з _schemas/. Групи можуть відрізнятись і СУБД, і
# структурою — частина прод-серверів історично на PostgreSQL.
DB_SCHEMA=mysql-mail

# ── ACME: як Let's Encrypt перевіряє, що домен наш ────────────────────
# http (типово) — certbot підіймає сервер на :80 у netns постфікса,
# тобто на адресах групи. Потрібно, щоб перевірка на порт 80 імені
# MAIL_HOSTNAME доходила до групи. Нічого більше не потрібно: DNS-01 і
# токени обов'язкові лише для wildcard, а поштовому серверу wildcard не
# потрібен.
#
# dns-cloudflare — коли перевірка на :80 до групи не дійде: порт
# належить ІНШОМУ сервісу, група за NAT, або MAIL_HOSTNAME ще вказує на
# старий сервер, з якого ви переїжджаєте. A-запис при цьому не має
# значення взагалі — перевірка йде через TXT.
#
# Якщо зона домену на Cloudflare — токен дається на неї, і це все.
# Якщо зона в сторонньому DNS — переносити її НЕ треба: там достатньо
# одного статичного запису, раз і назавжди:
#
#   _acme-challenge.mail.example.com.  CNAME  mail-example.acme.<наша-зона>.
#
# Let's Encrypt іде за CNAME, і TXT створюється вже у НАШІЙ зоні в
# Cloudflare. Токен — до неї, у groups/<група>/acme.ini (права 600, під
# .gitignore):
#
#   dns_cloudflare_api_token = <токен з правами Zone:DNS:Edit>
#
# Зона-приймач може бути ОДНА на всі домени й усі групи.
#ACME_METHOD=http

# Скільки чекати поширення TXT, секунд (10..3600, типово 30). Типові для
# certbot 10 розраховані на запис у власній зоні; через CNAME ланцюжок
# довший, тож запас потрібен.
#ACME_DNS_WAIT=30

# ── SpamAssassin: окрема база під стан (рішення №33) ──────────────────
# bayes, AWL і userpref живуть у SQL, а НЕ у файлах — як і на джерелах,
# де SpamAssassin налаштований. Том зі станом через це не потрібен.
#
# Чому окрема база й окремий користувач, а не поштові: інакше контейнер
# SpamAssassin отримав би доступ до `usersdb`, тобто до хешів паролів
# усіх користувачів групи. Сканеру вмісту там нічого робити.
#
# Схему створює `mailctl db-schema` — вона дістає пакетні SQL прямо з
# образу spamassassin, тож відповідає встановленій версії за побудовою.
# Пароль ОБОВ'ЯЗКОВИЙ; без лапок, зворотних слешів, решіток і переносів
# (він їде і в SQL-літерал, і в конфіг SpamAssassin).
SA_DB_PASSWORD=змінити-на-свій
#SA_DB=spamassassin
#SA_DB_USER=spamd

# ── DNS-блоклисти для SpamAssassin ────────────────────────────────────
# yes (типово) — перевірки DNSBL увімкнені, як і дефолт SpamAssassin.
#
# Але користь від них повністю залежить від того, ЧИЙ резолвер бачить
# контейнер (він успадковує resolv.conf хоста). Зі своїм рекурсивним
# вони працюють як задумано. Через ПУБЛІЧНИЙ (8.8.8.8, 1.1.1.1) Spamhaus
# та інші відповідають відмовою, яка виглядає як «адреса занесена» —
# тобто правило спрацьовує НА ВСЕ, і раптом уся пошта стає спамом.
#
# Отже: свій резолвер — лишати yes; публічний — ставити no, поки не
# з'явиться свій. Застосовується не на льоту:
#   ./mailctl reload <група> spamassassin
#SA_DNSBL=yes

# ── Greylisting (postgrey) ───────────────────────────────────────────
# Відкладає ПЕРШИЙ лист від незнайомої трійки (підмережа, відправник,
# отримувач) на GREYLIST_DELAY секунд. Легальний сервер повторює й
# доставляє; більшість спамних ботів не повторює ніколи.
#
# ЩО ЗАТРИМУЄТЬСЯ, А ЩО НІ: лише пошта від ЧУЖИХ. Власні користувачі
# (SASL) і довірені мережі (MYNETWORKS) у списку обмежень стоять ВИЩЕ
# за greylisting, тобто їх він не бачить взагалі.
#
# GREYLIST=no вимикає його ПОВНІСТЮ — `check_policy_service` просто не
# потрапляє в main.cf. Це не косметика: вмикати перевірку на групі, де
# postgrey не піднятий, означає 451 на ВСЮ вхідну пошту.
#GREYLIST=yes
#
# ── postscreen: пауза перед привітанням ──────────────────────────────
# За RFC клієнт мусить дочекатись банера 220. Бот майже завжди починає
# говорити одразу — і на цьому його й видно, ще до того, як ми знаємо
# про нього будь-що. Пауза адаптивна: 6 секунд у нормальному стані, 2
# під навантаженням (Postfix сам скорочує тест, щоб не стати причиною
# відмов).
#
#   enforce — відмова 550 з причиною в лозі (типово);
#   ignore  — ЛИШЕ запис у лог. Це дефолт самого Postfix і наш ПЕРШИЙ
#             ЕТАП на групі, де фільтрації не було ніколи: подивитись
#             статистику, а вже потім вмикати відмову (рішення №21);
#   drop    — розірвати з'єднання. Економить мілісекунди й забирає
#             діагностику, тож без потреби не варто.
#
# Довірені мережі (MYNETWORKS) тестів не проходять узагалі, і 587 не
# зачіпається — там свої клієнти з паролем.
#POSTSCREEN_ACTION=enforce

# ── anvil: ліміти на клієнтську адресу (рішення №13) ──────────────────
# Postscreen ловить тих, хто не вміє чекати; smtpd_error_sleep_time —
# тих, хто помиляється в межах однієї сесії; anvil — тих, хто розкладає
# спроби по багатьох сесіях (перепідключається після кожної невдалої
# автентифікації, шле тисячу листів поспіль). Окремо кожна така сесія
# виглядає нормально, аномалія видна лише в сумі по адресі.
#
# Самі ліміти — у _configs/postfix/main.cf разом із поясненням, чому
# саме такі. Відмова при перевищенні — 450 для всіх п'яти лімітів,
# тобто тимчасова: легальний відправник повторить і пройде.
#
# Вимикач потрібен за рішенням №21: на isp-подібній групі, де 312
# абонентів ніколи не мали фільтрації, спершу дивляться, що anvil пише
# в лог (`max ... rate N/60s for (smtp:ADDR)`), і лише потім вмикають
# відмови. ANVIL=no обнуляє всі п'ять лімітів.
#ANVIL=yes

# Кому ліміти НЕ діють. 127.0.0.0/8 додається завжди (звідти ходять
# Dovecot і сам Postfix), решта — сюди, через кому або пробіл.
#
# ┌───────────────────────────────────────────────────────────────────┐
# │ ЦЕ НЕ MYNETWORKS, хоч формат однаковий.                           │
# │ MYNETWORKS = «звідси можна слати БЕЗ пароля».                     │
# │ ANVIL_EXCEPTIONS = «звідси можна слати БЕЗ обмежень».             │
# │                                                                   │
# │ Дефолт Postfix для другого — `$mynetworks`, тобто він ототожнює   │
# │ ці два різні дозволи. Проєкт від цього відходить свідомо:         │
# │ рішення №20 називає anvil компенсацією за широкий mynetworks на   │
# │ isp, а такий дефолт вимикав би його рівно там. Заражена         │
# │ робоча станція абонента не обмежувалась би ВЗАГАЛІ — мовчки, бо   │
# │ нічого не зламано.                                                │
# │ `validate()` відмовить, якщо написати сюди $mynetworks.           │
# └───────────────────────────────────────────────────────────────────┘
#
# Коли це справді потрібно: офіс за одним NAT, який упирається в ліміт.
# У логах це видно як `Connection rate limit exceeded` з конкретною
# адресою — тобто лікується додаванням саме її, а не навмання.
#ANVIL_EXCEPTIONS=192.168.50.0/24

# ── Автентифікація у ВІДКРИТОМУ вигляді, точково ─────────────────────
# Кому дозволено надсилати пароль БЕЗ шифрування. Порожньо — нікому, і
# це дефолт: на 110/143 обов'язковий STARTTLS (рішення №14).
#
# ┌───────────────────────────────────────────────────────────────────┐
# │ ЦЕ ТРЕТІЙ список мереж, і формат у всіх трьох однаковий, а зміст  │
# │ різний:                                                           │
# │   MYNETWORKS         = «звідси можна слати БЕЗ пароля».           │
# │   ANVIL_EXCEPTIONS   = «звідси можна слати БЕЗ обмежень».         │
# │   CLEARTEXT_NETWORKS = «звідси можна слати ПАРОЛЬ без шифру».     │
# │                                                                   │
# │ Спокуса написати сюди $mynetworks природна й хибна: на isp це   │
# │ чотири ПУБЛІЧНІ блоки провайдера, тобто виняток накрив би         │
# │ пів-міста. `validate()` на це відмовляє.                          │
# └───────────────────────────────────────────────────────────────────┘
#
# НАВІЩО ЦЕ ІСНУЄ (уточнення рішення №14 від 2026-11-13, вимога
# власника): на office більшість офісу ходить голим POP3 без
# шифрування, на isp — 312 абонентів провайдера, яким
# «перенастройте клієнт» сказати нікому. Жорстке `no` означало б, що в
# день міграції пошта зникає в більшості користувачів. Мета проєкту —
# перенести робочу пошту, а не зламати її заради правильності.
#
# ЦІНА, і вона реальна: всередині перелічених мереж паролі йдуть
# відкритим текстом, тобто заражена робоча станція їх бачить. Це той
# самий сценарій, під який існує abuse_block (рішення №20, №30).
#
# Звіряється адреса КЛІЄНТА (блок `remote` у Dovecot), тож на решту
# світу дозвіл не поширюється — там TLS лишається обов'язковим.
#CLEARTEXT_NETWORKS=192.168.50.0/24
#
# ОКРЕМЕ СЛОВО `any` — глобальний дозвіл, без жодного remote-блоку.
# Воно не для зручності й не скорочення: на isp точковий список
# НЕМОЖЛИВИЙ, і це факт із логів, а не припущення. Із десяти активних
# абонентів один заходить приблизно зі 130 адрес за місяць (Київстар,
# Укртелеком, мобільні — динаміка по всій країні), троє — це Gmail,
# що забирає пошту по POP3, ще один — Cloudflare. Мережами це не
# перелічується.
#
# Рішення власника (2026-11-16): `any` на день міграції, перемикання
# клієнтів на TLS — ОКРЕМОЮ роботою після. Для трьох офісних це
# реально, для Gmail — галочка в чужому акаунті, для динамічного
# абонента — ні.
#
# `0.0.0.0/0` для цього не годиться: `validate()` на нього відмовляє, і
# для MYNETWORKS ця заборона несуча (це був би відкритий релей). Два
# списки з однаковим форматом і протилежним змістом мусять мати різні
# способи сказати «усі» — інакше рядок, переставлений з одного в
# інший, зробить зовсім не те. Плюс `any` видно grep-ом і про нього
# попереджає кожен `mailctl check` і `mailctl health`.
#
# Змішувати не можна: або слово, або список.
#CLEARTEXT_NETWORKS=any
#
# ── Скільки redirect дозволено ОДНОМУ sieve-скрипту ──────────────────
# Дефолт 4 — той самий, що в Pigeonhole, тобто без цього рядка нічого
# не змінюється.
#
# Навіщо параметр: скриньки-носії пересилання (db-convert.pl
# --forward=sieve) мають рівно стільки redirect, скільки отримувачів
# було в колишньому аліасі. На small `info@charity.example.org` має чотири,
# тобто дефолт уже вичерпано — п'ятий отримувач повалив би скрипт.
#
# І він справді ВАЛИТЬ, а не обрізає: перевищення означає, що лист не
# піде НІКОМУ. Симптом у користувача — «пересилання просто зникло».
# Запас по кожному живому скрипту показує `mailctl health`.
#
# Ліміт ГЛОБАЛЬНИЙ: діє й на користувацькі фільтри з ManageSieve.
# Тому піднімати його безпечно, а опускати — ні: зламалися б чужі
# правила, і мовчки.
#SIEVE_MAX_REDIRECTS=4
#
# ── Чи розкладати спам у Junk ГЛОБАЛЬНО ──────────────────────────────
# yes — before-скрипт `_configs/dovecot/global-spam.sieve` кладе лист із
# `X-Spam-Flag: YES` у Junk ДО користувацьких правил, тобто спам
# розкладається всім, а не лише тим, хто налаштував собі фільтр.
# Дефолт no: для наявних груп без цього рядка нічого не змінюється.
#
# Звідки взялось: на office рівно це й стоїть
# (`sieve_before = /var/mail/sieve_global/skip-spam.sieve`) і діє на всіх
# 235 користувачів. НЕ відтворити його означало б, що в день міграції
# спам раптом посипався всім в INBOX.
#
# КОЛИ `yes` — ПОМИЛКА, і дорога: на isp-подібній групі всі активні
# клієнти ходять по POP3, а POP3 бачить лише INBOX. Хибне спрацювання
# поїхало б у теку, якої абонент не побачить НІКОЛИ, і виглядало б як
# «лист не дійшов». Рішення №21 (на isp спершу лише маркування) саме
# про це. Отже: office — yes, isp/backup — no, small — за власником
# (дев'ять скриньок, усі з IMAP, тека Junk видна).
#
# Приймається рівно `yes` або `no`: `true` dovecot не розуміє й падає.
#SPAM_TO_JUNK=no
#
# Затримка в секундах. Дефолт 20 — НЕ пакетний (пакетний 300), а той,
# що стояв і на office, і на isp; два незалежні сервери з тим самим
# значенням — це усталена практика, а не смак одного адміна.
# 300 с відчутно агресивніші: відправник, що повторює раз на 10 хвилин,
# доставить лист через 10 хвилин замість 20 секунд.
#GREYLIST_DELAY=20
#
# Скільки діб жити записові після останньої появи. Дефолт 60 (пакетний
# 35) — так само з обох джерел. Занадто мало означає, що постійний
# кореспондент знову затримується, бо запис устиг зникнути.
#GREYLIST_MAX_AGE=60
#
# Власні доповнення до whitelist-ів — НЕ тут, а файлами:
#   _configs/postgrey/whitelist_clients.local        (спільні)
#   groups/<група>/postgrey-config/whitelist_*.local (перекриття групи)
# Пакетні whitelist_clients / whitelist_recipients не чіпаємо.
#
# Застосовується не на льоту:
#   ./mailctl reload <група> postgrey postfix

# ── Слабкі схеми зберігання паролів ──────────────────────────────────
# Dovecot 2.4 за замовчуванням ВІДМОВЛЯЄ в автентифікації для MD5-CRYPT
# і DES-CRYPT (PLAIN і CRAM-MD5 не зачеплені). Дефолт `no` повторює
# поведінку самого Dovecot.
#
# Потрібно при міграції джерел, де історичні хеші саме такі: на isp
# це 167 записів `$1$` плюс 95 голих DES із 312, тобто при `no`
# більшість абонентів не заходить, а симптом виглядає як «пароль не
# підходить».
#
# Прапорець ГЛОБАЛЬНИЙ — вибірково слабкі схеми не вмикаються. Тому він
# же аргумент перехешувати те, що лежить відкритим текстом: чим менше
# таких записів, тим раніше його можна буде повернути в `no`.
#AUTH_ALLOW_WEAK_SCHEMES=no

# ── Тип ключа TLS-сертифіката ────────────────────────────────────────
# `ecdsa` (дефолт certbot і наш) або `rsa`.
#
# RSA потрібен там, де серед клієнтів є старі The Bat і Outlook: ECDSA
# вони не вміють, рукостискання падає, і для користувача це виглядає як
# «пошта раптом перестала працювати» — на сертифікат не вказує ніщо.
#
# УВАГА: на вже виданому сертифікаті зміна САМА НЕ ЗАСТОСУЄТЬСЯ —
# `--keep-until-expiring` побачить чинний файл і нічого не зробить.
# Потрібен `mailctl certs <група> --force`.
#CERT_KEY_TYPE=ecdsa
