# ─────────────────────────────────────────────────────────────
#  Параметри ХОСТА, а не групи.
#
#  Скопіювати в host.env і заповнити під конкретну машину.
#  host.env у .gitignore: він описує залізо й адресацію, які на
#  кожному хості свої. group.env лишається описом ГРУПИ.
#
#  Чому це окремий файл, а не частина group.env: публічна ipvlan-мережа
#  ОДНА на батьківський інтерфейс. Docker не створить другу на тому ж
#  parent — перевірено:
#      Error response from daemon: network di-... is already using
#      parent interface eno1
#  Отже PARENT_IFACE/PUBLIC_SUBNET/PUBLIC_GATEWAY описують спільну
#  мережу хоста, і дублювати їх у кожній групі означало б завести
#  чотири копії одного значення, які колись розійдуться.
#  У group.env лишається тільки PUBLIC_IP — адреса групи в цій мережі.
# ─────────────────────────────────────────────────────────────

# Ім'я спільної docker-мережі. Довільне, але мусить збігатися з тим, що
# бачить `docker network ls` — саме за ним шаблон групи знаходить мережу
# як external. Міняти є сенс лише якщо на хості кілька публічних
# префіксів на різних інтерфейсах (тоді й PARENT_IFACE інший).
PUBLIC_NET_NAME=mailstack-public

# Батьківський інтерфейс, на якому живе маршрутизований публічний
# префікс. Саме той, що в `ip a` тримає адресу лінка до маршрутизатора.
PARENT_IFACE=eno1

# Публічний префікс, ЗМАРШРУТОВАНИЙ на цей хост. Не адреса лінка!
# Приклад: лінк 203.0.113.37/31 (шлюз .36), а на хост змаршрутовано
# 203.0.113.80/28 — сюди пишемо саме /28.
PUBLIC_SUBNET=203.0.113.80/28

# Шлюз усередині публічного префікса, якщо він є.
# УВАГА: в ipvlan L3 Docker НЕ ставить контейнеру маршрут через next-hop —
# там просто `default dev eth0`, а далі маршрутизує хост (потрібен
# net.ipv4.ip_forward=1). Значення тут потрібне для двох інших речей:
#   - IPAM зарезервує цю адресу й не віддасть її контейнеру;
#   - mailctl check не дасть призначити її групі як PUBLIC_IP.
# Якщо шлюза в префіксі немає — рядок закоментувати.
PUBLIC_GATEWAY=203.0.113.81
